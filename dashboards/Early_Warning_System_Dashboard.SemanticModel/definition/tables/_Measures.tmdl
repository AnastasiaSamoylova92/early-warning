	measure 'Revenue FC' =
			
			VAR SelectedVersion = [Selected Forecast Version]
			RETURN
			    CALCULATE(
			        SUM(factForecast[forecast_revenue_eur]),
			        REMOVEFILTERS(factForecast[forecast_version]),
			        FILTER(
			            ALL(factForecast[forecast_version]),
			            factForecast[forecast_version] = SelectedVersion
			        )
			    )
		displayFolder: 03 Forecasting
		lineageTag: f3fa7971-be8f-43ae-b96d-bfd355aa3226

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue FC Variance' = [Revenue] - [Revenue FC]
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
		displayFolder: 03 Forecasting
		lineageTag: 9897ba7e-e95c-40bd-a179-516949277445

	measure 'Revenue FC Variance abs' = abs([Revenue] - [Revenue FC])
		displayFolder: 03 Forecasting
		lineageTag: f19173e2-c887-43be-a3dc-b472cffda9d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue FC Variance %' = DIVIDE([Revenue FC Variance], [Revenue FC])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 03 Forecasting
		lineageTag: 0e0b7508-be4e-4459-b30c-5ef7c9f10f96

	measure 'Revenue FC Accuracy %' = ```
			
			  VAR VariancePct = [Revenue FC Variance %]
			  RETURN
			      IF(
			          ISBLANK(VariancePct),
			          BLANK(),
			          MAX(0, 1 - ABS(VariancePct))
			      )
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 03 Forecasting
		lineageTag: 1717fff6-2537-43de-a2e9-5e9137513b1a

	measure 'Customers Active' = DISTINCTCOUNT(factSales[customer_id])
		formatString: #,0
