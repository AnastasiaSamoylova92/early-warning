	measure 'True Positives' = ```
			
			  VAR LabeledRows = [Evaluation Records]
			  RETURN
			      IF (
			          ISBLANK ( LabeledRows ),
			          BLANK (),
			          CALCULATE (
			              COUNTROWS ( factMlPredictions ),
			              KEEPFILTERS (
			                  FILTER (
			                      factMlPredictions,
			                      NOT ISBLANK ( factMlPredictions[actual_risk_label_num] )
			                          && factMlPredictions[actual_risk_label_num] = 2
			                          && factMlPredictions[predicted_risk_label_num] = 2
			                  )
			              )
			          )
			      )
			```
		formatString: 0
		displayFolder: 06 Model Performance
		lineageTag: ad6079e8-ccc4-43c3-844a-8c9bb2da0033

	measure 'False Positives' = ```
			
			  VAR LabeledRows = [Evaluation Records]
			  RETURN
			      IF (
			          ISBLANK ( LabeledRows ),
			          BLANK (),
			          CALCULATE (
			              COUNTROWS ( factMlPredictions ),
			              KEEPFILTERS (
			                  FILTER (
			                      factMlPredictions,
			                      NOT ISBLANK ( factMlPredictions[actual_risk_label_num] )
			                          && factMlPredictions[actual_risk_label_num] <> 2
			                          && factMlPredictions[predicted_risk_label_num] = 2
			                  )
			              )
			          )
			      )
			```
		formatString: 0
		displayFolder: 06 Model Performance
		lineageTag: aa2e769a-a4e9-4074-a85e-65a7bce69bd6

	measure 'False Negatives' = ```
			
			  VAR LabeledRows = [Evaluation Records]
			  RETURN
			      IF (
			          ISBLANK ( LabeledRows ),
			          BLANK (),
			          CALCULATE (
			              COUNTROWS ( factMlPredictions ),
			              KEEPFILTERS (
			                  FILTER (
			                      factMlPredictions,
			                      NOT ISBLANK ( factMlPredictions[actual_risk_label_num] )
			                          && factMlPredictions[actual_risk_label_num] = 2
