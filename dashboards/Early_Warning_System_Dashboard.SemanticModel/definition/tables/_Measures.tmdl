		displayFolder: 06 Model Performance
		lineageTag: 3df841e6-6d31-44a4-9246-75c856146018

	measure 'MQ Model Comparison HTML' =
			
			VAR _Classes =
			    DATATABLE (
			        "ClassID", INTEGER,
			        {
			            { 0 },
			            { 1 },
			            { 2 }
			        }
			    )
			
			-- Complete prediction data in the current filter context
			VAR _ModelData =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS (
			            factMlPredictions[actual_risk_label_num],
			            factMlPredictions[predicted_risk_label_num]
			        )
			    )
			
			VAR _TotalRows =
			    COUNTROWS ( _ModelData )
			
			
			-- Majority-class baseline
			VAR _ActualClassCounts =
			    ADDCOLUMNS (
			        _Classes,
			        "ActualCount",
			            VAR _Class = [ClassID]
			            RETURN
			                COUNTROWS (
			                    FILTER (
			                        _ModelData,
			                        factMlPredictions[actual_risk_label_num] = _Class
			                    )
			                )
			    )
			
			VAR _MajorityClassRow =
			    TOPN (
			        1,
			        _ActualClassCounts,
			        [ActualCount], DESC,
			        [ClassID], ASC
			    )
			
			VAR _MajorityClass =
			    MAXX (
			        _MajorityClassRow,
			        [ClassID]
			    )
			
			VAR _MajorityCount =
			    MAXX (
			        _MajorityClassRow,
			        [ActualCount]
			    )
			
			VAR _MajorityAccuracy =
			    DIVIDE (
			        _MajorityCount,
			        _TotalRows
			    )
			
			-- Only the majority class receives a non-zero F1 score
			VAR _MajorityClassF1 =
			    DIVIDE (
			        2 * _MajorityCount,
			        _TotalRows + _MajorityCount,
			        0
			    )
			
			VAR _MajorityMacroF1 =
			    DIVIDE (
			        _MajorityClassF1,
			        3
			    )
			
			VAR _MajorityHighRiskRecall =
			    IF (
			        _MajorityClass = 2,
			        1,
			        0
			    )
			
			
			-- Gaussian Naive Bayes test benchmark
			-- Replace these constants if the model is retrained
			VAR _GNBAccuracy =
			    0.4479
			
			VAR _GNBMacroF1 =
			    0.4421
			
			VAR _GNBHighRiskRecall =
			    0.5037
			
			
			-- Random Forest accuracy
			VAR _RFAccuracy =
			    DIVIDE (
			        COUNTROWS (
			            FILTER (
			                _ModelData,
			                factMlPredictions[actual_risk_label_num]
			                    = factMlPredictions[predicted_risk_label_num]
			            )
			        ),
			        _TotalRows
			    )
			
			
			-- Random Forest Macro F1
			VAR _RFMacroF1 =
			    AVERAGEX (
			        _Classes,
			        VAR _Class =
			            [ClassID]
			
			        VAR _TP =
			            COUNTROWS (
			                FILTER (
			                    _ModelData,
			                    factMlPredictions[actual_risk_label_num] = _Class
			                        && factMlPredictions[predicted_risk_label_num] = _Class
			                )
			            )
			
			        VAR _FP =
			            COUNTROWS (
			                FILTER (
			                    _ModelData,
			                    factMlPredictions[actual_risk_label_num] <> _Class
			                        && factMlPredictions[predicted_risk_label_num] = _Class
			                )
			            )
			
			        VAR _FN =
			            COUNTROWS (
			                FILTER (
			                    _ModelData,
			                    factMlPredictions[actual_risk_label_num] = _Class
			                        && factMlPredictions[predicted_risk_label_num] <> _Class
			                )
			            )
			
			        RETURN
			            DIVIDE (
			                2 * _TP,
			                2 * _TP + _FP + _FN,
			                0
			            )
			    )
			
			
			-- Random Forest high-risk recall
			VAR _RFHighRiskTP =
			    COUNTROWS (
			        FILTER (
			            _ModelData,
			            factMlPredictions[actual_risk_label_num] = 2
			                && factMlPredictions[predicted_risk_label_num] = 2
			        )
			    )
			
			VAR _RFHighRiskFN =
			    COUNTROWS (
			        FILTER (
			            _ModelData,
			            factMlPredictions[actual_risk_label_num] = 2
			                && factMlPredictions[predicted_risk_label_num] <> 2
			        )
			    )
			
			VAR _RFHighRiskRecall =
			    DIVIDE (
			        _RFHighRiskTP,
			        _RFHighRiskTP + _RFHighRiskFN
			    )
			
			
			-- Display formatting
			VAR _MajorityAccuracyFormatted =
			    FORMAT ( _MajorityAccuracy, "0.0%" )
			
			VAR _MajorityMacroF1Formatted =
			    FORMAT ( _MajorityMacroF1, "0.0%" )
			
			VAR _MajorityRecallFormatted =
			    FORMAT ( _MajorityHighRiskRecall, "0.0%" )
			
			VAR _GNBAccuracyFormatted =
			    FORMAT ( _GNBAccuracy, "0.0%" )
			
			VAR _GNBMacroF1Formatted =
			    FORMAT ( _GNBMacroF1, "0.0%" )
			
			VAR _GNBRecallFormatted =
			    FORMAT ( _GNBHighRiskRecall, "0.0%" )
			
			VAR _RFAccuracyFormatted =
			    FORMAT ( _RFAccuracy, "0.0%" )
			
			VAR _RFMacroF1Formatted =
			    FORMAT ( _RFMacroF1, "0.0%" )
			
			VAR _RFRecallFormatted =
			    FORMAT ( _RFHighRiskRecall, "0.0%" )
			
			VAR _TotalRowsFormatted =
			    FORMAT ( _TotalRows, "#,0" ) & " test records"
			
			
			-- CSS-compatible widths use en-US to ensure decimal points
			VAR _MajorityAccuracyWidth =
			    FORMAT (
			        MAX ( 0, MIN ( 1, _MajorityAccuracy ) ),
			        "0.0%",
			        "en-US"
			    )
			
			VAR _MajorityMacroF1Width =
			    FORMAT (
			        MAX ( 0, MIN ( 1, _MajorityMacroF1 ) ),
			        "0.0%",
			        "en-US"
			    )
			
			VAR _MajorityRecallWidth =
			    FORMAT (
			        MAX ( 0, MIN ( 1, _MajorityHighRiskRecall ) ),
			        "0.0%",
			        "en-US"
			    )
			
			VAR _GNBAccuracyWidth =
			    FORMAT ( _GNBAccuracy, "0.0%", "en-US" )
			
			VAR _GNBMacroF1Width =
			    FORMAT ( _GNBMacroF1, "0.0%", "en-US" )
			
			VAR _GNBRecallWidth =
			    FORMAT ( _GNBHighRiskRecall, "0.0%", "en-US" )
			
			VAR _RFAccuracyWidth =
			    FORMAT (
			        MAX ( 0, MIN ( 1, _RFAccuracy ) ),
			        "0.0%",
			        "en-US"
			    )
			
			VAR _RFMacroF1Width =
			    FORMAT (
			        MAX ( 0, MIN ( 1, _RFMacroF1 ) ),
			        "0.0%",
			        "en-US"
			    )
			
			VAR _RFRecallWidth =
			    FORMAT (
			        MAX ( 0, MIN ( 1, _RFHighRiskRecall ) ),
			        "0.0%",
			        "en-US"
			    )
			
			RETURN
			IF (
			    _TotalRows = 0,
			    "
			    <style>
			        html, body {
			            width:100%;
			            height:100%;
			            margin:0;
			            padding:0;
			            background:#FFFFFF;
			        }
			    </style>
			
			    <div style='
			        width:100vw;
			        height:100vh;
			        display:flex;
			        align-items:center;
			        justify-content:center;
			        padding:8px;
			        background:#FFFFFF;
			        color:#26232A;
			        font:11px Segoe UI,Arial,sans-serif;'>
			        No model-comparison data
			    </div>
			    ",
			    "
			    <style>
			
			        html,
			        body {
			            width:100%;
			            height:100%;
			            min-height:100%;
			            margin:0;
			            padding:0;
			            background:#FFFFFF;
			            overflow:hidden;
			        }
			
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .mc-wrap {
			            width:100%;
			            height:100vh;
			            min-height:100%;
