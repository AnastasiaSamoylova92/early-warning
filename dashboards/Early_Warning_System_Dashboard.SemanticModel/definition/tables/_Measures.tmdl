	measure 'Executive Health Score' =
			
			VAR RevenueScore =
			    [Revenue Health Score]
			
			VAR MarginScore =
			    [Margin Health Score]
			
			VAR NRRScore =
			    [NRR Health Score]
			
			VAR ForecastScore =
			    [Forecast Health Score]
			
			VAR CustomerScore =
			    [Customer Health Score]
			
			VAR RiskScore =
			    [Risk Health Score]
			
			RETURN
			
			RevenueScore * 0.30 +
			MarginScore * 0.25 +
			NRRScore * 0.15 +
			ForecastScore * 0.10 +
			CustomerScore * 0.10 +
			RiskScore * 0.10
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 08 Executive
		lineageTag: f361c5f6-0d12-48ad-b031-e7fade42635c

