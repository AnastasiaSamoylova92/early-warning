			            { "Kosovo", "kosovo", "M393.419,308.626L392.888,304.839L391.042,303.773L389.393,300.94L390.847,298.579L392.692,297.808L393.755,294.282L395.153,293.686L396.271,295.201L397.725,295.849L398.732,297.538L400.018,298.041L401.528,300.011L402.618,299.939L401.751,302.509L400.829,303.773L401.08,304.554L399.347,304.963L394.761,306.576L394.398,308.714Z" }
