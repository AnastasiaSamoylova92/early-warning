	measure 'KT Margin Change' =
			
			VAR MarginGap = [Gross Margin %] - [Gross Margin % PY]
			VAR MarginGapPP = MarginGap * 100
			RETURN
			IF(
			    MarginGap >= 0,
			    "📈 Margin +" & FORMAT(MarginGapPP, "0.0") & " pp driven by pricing",
			    "📉 Margin -" & FORMAT(ABS(MarginGapPP), "0.0") & " pp due to margin pressure"
			)
		displayFolder: 02 Margin
		lineageTag: 6c2a00ac-be00-46e7-b2f5-f4342627ecad

	measure 'KT Price Effect' =
			
			VAR PriceImpact = [PVM Price Effect]
			RETURN
			IF(
			    PriceImpact >= 0,
			    "⚙️ Price Effect contributed "
			        & FORMAT(PriceImpact / 1000000, "€ 0.0M"),
			    "⚙️ Price Effect reduced profit by "
			        & FORMAT(ABS(PriceImpact) / 1000000, "€ 0.0M")
			)
		displayFolder: 02 Margin
		lineageTag: 4d4c583f-8e1e-4f18-aa38-65f0407d2a3f

	measure 'KT Cost Impact' =
			
			VAR CostImpact = [PVM Cost Effect]
			RETURN
			IF(
			    CostImpact < 0,
			    "💰 Cost inflation reduced GP by "
			        & FORMAT(ABS(CostImpact) / 1000000, "€ 0.0M"),
			    "💰 Cost efficiency improved GP by "
			        & FORMAT(CostImpact / 1000000, "€ 0.0M")
			)
		displayFolder: 02 Margin
		lineageTag: a39b9769-130e-400b-9030-194a69aca03e

	measure 'KT Best Margin Product Group' =
			
			VAR TopProductGroup =
			    TOPN(
			        1,
			        ALL(dimProduct[product_group]),
			        [Gross Margin %],
			        DESC
			    )
			VAR ProductName =
			    CONCATENATEX(
			        TopProductGroup,
			        dimProduct[product_group],
			        ", "
			    )
			VAR ProductMargin =
			    CALCULATE(
			        [Gross Margin %],
			        TopProductGroup
			    )
			RETURN
			"🏆 " & ProductName
			    & " leads with "
			    & FORMAT(ProductMargin, "0.0%")
			    & " GM"
		displayFolder: 02 Margin
		lineageTag: 52c4cd29-151d-4f40-aea5-c95916b4691a

	measure 'KT Margin Erosion Product Group' =
			
			VAR ErosionTable =
			    ADDCOLUMNS(
			        ALL(dimProduct[product_group]),
			        "MarginChange", [Gross Margin %] - [Gross Margin % PY]
			    )
			VAR WorstProductGroup =
			    TOPN(
			        1,
			        ErosionTable,
			        [MarginChange],
			        ASC
			    )
			VAR ProductName =
			    CONCATENATEX(
			        WorstProductGroup,
			        dimProduct[product_group],
			        ", "
			    )
			RETURN
			"⚠️ " & ProductName & " shows margin erosion"
		displayFolder: 02 Margin
		lineageTag: 0253ca8f-9cb5-4eef-a9b3-1d3c458be9d1

