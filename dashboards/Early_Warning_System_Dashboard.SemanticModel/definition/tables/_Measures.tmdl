	measure 'FC Largest Driver' =
			
			VAR Vol = ABS([FC Volume Variance])
			VAR Price = ABS([FC Price Variance])
			VAR Mix = ABS([FC Other Variance])
			
			RETURN
			SWITCH(
			    TRUE(),
			    Vol > Price && Vol > Mix,
			        "Volume",
			    Price > Mix,
			        "Price",
			    "Mix"
			)
		displayFolder: 03 Forecasting
		lineageTag: d76cd403-6f5c-481e-8f38-3073988b52c6

