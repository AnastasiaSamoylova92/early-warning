	measure 'Revenue Largest Driver' =
			
			VAR Churn = ABS([Customers Churn Revenue Lost])
			VAR New = ABS([Customers New Revenue])
			VAR Existing_ = ABS([Customers Retained Revenue])
			
			RETURN
			SWITCH(
			    TRUE(),
			    Churn > New && Churn > Existing_,
			        "Churn",
			    New > Existing_,
			        "New",
			    "Existing"
			)
