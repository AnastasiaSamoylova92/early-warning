			VAR _MapData =
			    ADDCOLUMNS (
			        _EuropeShapes,
			        "@RevenueValue",
			            VAR _Aliases = "|" & [Aliases] & "|"
			            RETURN
			                MAXX (
			                    FILTER (
			                        _CountryRevenue,
			                        CONTAINSSTRING (
			                            _Aliases,
			                            "|" & [@CountryKey] & "|"
			                        )
			                    ),
			                    [@RevenueValue]
			                )
			    )
			
			VAR _CountriesWithRevenue =
			    FILTER (
			        _MapData,
			        NOT ISBLANK ( [@RevenueValue] )
			    )
			
			VAR _MappedCountryCount =
			    COUNTROWS ( _CountriesWithRevenue )
			
			VAR _MinimumRevenue =
			    MINX (
			        _CountriesWithRevenue,
			        [@RevenueValue]
			    )
			
			VAR _MaximumRevenue =
			    MAXX (
			        _CountriesWithRevenue,
			        [@RevenueValue]
			    )
			
			VAR _MinimumLabel =
			    SWITCH (
			        TRUE (),
			        ABS ( _MinimumRevenue ) >= 1000000000,
			            FORMAT ( DIVIDE ( _MinimumRevenue, 1000000000 ), "€0.0bn", "en-US" ),
			        ABS ( _MinimumRevenue ) >= 1000000,
			            FORMAT ( DIVIDE ( _MinimumRevenue, 1000000 ), "€0.0m", "en-US" ),
			        ABS ( _MinimumRevenue ) >= 1000,
			            FORMAT ( DIVIDE ( _MinimumRevenue, 1000 ), "€0.0k", "en-US" ),
			        FORMAT ( _MinimumRevenue, "€#,0", "en-US" )
			    )
			
			VAR _MaximumLabel =
			    SWITCH (
			        TRUE (),
			        ABS ( _MaximumRevenue ) >= 1000000000,
			            FORMAT ( DIVIDE ( _MaximumRevenue, 1000000000 ), "€0.0bn", "en-US" ),
			        ABS ( _MaximumRevenue ) >= 1000000,
			            FORMAT ( DIVIDE ( _MaximumRevenue, 1000000 ), "€0.0m", "en-US" ),
			        ABS ( _MaximumRevenue ) >= 1000,
			            FORMAT ( DIVIDE ( _MaximumRevenue, 1000 ), "€0.0k", "en-US" ),
			        FORMAT ( _MaximumRevenue, "€#,0", "en-US" )
			    )
			
			VAR _CountryPaths =
			    CONCATENATEX (
			        _MapData,
			        VAR _RevenueValue = [@RevenueValue]
			        VAR _HasRevenue = NOT ISBLANK ( _RevenueValue )
			        VAR _ColorRatio =
			            IF (
			                _HasRevenue,
			                IF (
			                    _MaximumRevenue = _MinimumRevenue,
			                    1,
			                    MAX (
			                        0,
			                        MIN (
			                            1,
			                            DIVIDE (
			                                _RevenueValue - _MinimumRevenue,
			                                _MaximumRevenue - _MinimumRevenue
			                            )
			                        )
			                    )
			                )
			            )
			        VAR _FillColor =
			            SWITCH (
			                TRUE (),
			                NOT _HasRevenue, "#EEF1F5",
			                _ColorRatio <= 0.20, "#DCE8F6",
			                _ColorRatio <= 0.40, "#B9D1EE",
			                _ColorRatio <= 0.60, "#8EB3E1",
			                _ColorRatio <= 0.80, "#5F91D0",
			                "#2F6CB4"
			            )
			        VAR _RevenueLabel =
			            SWITCH (
			                TRUE (),
			                NOT _HasRevenue, "No revenue in current filter context",
			                ABS ( _RevenueValue ) >= 1000000000,
			                    FORMAT ( DIVIDE ( _RevenueValue, 1000000000 ), "€0.00bn", "en-US" ),
			                ABS ( _RevenueValue ) >= 1000000,
			                    FORMAT ( DIVIDE ( _RevenueValue, 1000000 ), "€0.0m", "en-US" ),
			                ABS ( _RevenueValue ) >= 1000,
			                    FORMAT ( DIVIDE ( _RevenueValue, 1000 ), "€0.0k", "en-US" ),
			                FORMAT ( _RevenueValue, "€#,0", "en-US" )
			            )
			        RETURN
			            "<path d='" & [PathData]
			                & "' fill='" & _FillColor
			                & "' stroke='#FFFFFF' stroke-width='0.9' stroke-linejoin='round'>"
			                & "<title>" & [MapCountry] & ": " & _RevenueLabel & "</title>"
			                & "</path>",
			        "",
			        [MapCountry],
			        ASC
			    )
			-- calc(100% - 66px);
			RETURN
			    IF (
			        _MappedCountryCount = 0,
			        "
			        <div style='
			            width:100%;
			            height:100%;
			            min-height:220px;
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            padding:18px;
			            background:#FFFFFF;
			            border:1px solid #E3DEE6;
			            border-radius:5px;
			            color:#6F6872;
			            font:13px Segoe UI,Arial,sans-serif;
			            text-align:center;
			        '>
			            No European country revenue was found.<br/>
			            Check the values in dimRegion[country].
			        </div>
			        ",
			        "
			        <style>
			            * {
			                box-sizing:border-box;
			            }
			
			            html,
			            body {
			                width:100%;
			                height:100%;
			                margin:0;
			                padding:0;
			            }
			
			            .erm-card {
			                position:absolute;
			                inset:0;
			                padding:5px 5px 5px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:5px;
			                font-family:'Segoe UI',Arial,sans-serif;
			                display:flex;
			                flex-direction:column;
			            }
			
			            .erm-header {
			                flex:0 0 auto;
			                display:flex;
			                align-items:flex-start;
			                justify-content:space-between;
			                gap:12px;
			                margin-bottom:2px;
			            }
			
			            .erm-title {
			                color:#211D22;
			                font-size:15px;
			                font-weight:700;
			                text-transform:uppercase;
			            }
			
			            .erm-map {
			                display:block;
			                width:100%;
			                flex:1 1 auto;
			                min-height:0;
			            }
			
			            .erm-legend {
			                flex:0 0 auto;
			
			                display:grid;
			                grid-template-columns:auto minmax(90px,180px) auto;
			                align-items:center;
			                justify-content:center;
			                gap:7px;
			                margin-top:8px;
			
			                color:#625C64;
			                font-size:10px;
			                line-height:1;
			            }
			
			            .erm-gradient {
			                width:100%;
			                height:8px;
			                border:1px solid #D9DDE3;
			                border-radius:5px;
			                background:linear-gradient(
			                    90deg,
			                    #DCE8F6 0%,
			                    #B9D1EE 25%,
			                    #8EB3E1 50%,
			                    #5F91D0 75%,
			                    #2F6CB4 100%
			                );
			            }
			        </style>
			
			        <div class='erm-card'>
			            <div class='erm-header'>
			                <div>
			                    <div class='erm-title'>Revenue by Country</div>
			                </div>
			            </div>
			
			            <svg class='erm-map'
			                 viewBox='70 30 560 280'
			                 preserveAspectRatio='xMidYMid meet'
			                 role='img'
			                " & _CountryPaths & "
			            </svg>
			
			            <div class='erm-legend'>
			                <span>" & _MinimumLabel & "</span>
			                <span class='erm-gradient'></span>
			                <span>" & _MaximumLabel & "</span>
			            </div>
			        </div>
			        "
			    )
			
			
			```
		displayFolder: 08 Executive
		lineageTag: ce51addf-60dc-4c25-a586-89d7b2e4904b

	measure 'Revenue Growth by Segment HTML' =
			
			-- Customer segments in the current filter context
			VAR _SegmentScope =
			    FILTER (
			        VALUES ( dimCustomer[customer_segment] ),
			        NOT ISBLANK ( dimCustomer[customer_segment] )
			    )
			
			
			-- Revenue and prior-year revenue by segment
			VAR _SegmentMetrics =
			    FILTER (
			        ADDCOLUMNS (
			            _SegmentScope,
			
			            "@RevenueValue",
			                CALCULATE ( [Revenue] ),
			
			            "@RevenuePYValue",
			                CALCULATE ( [Revenue PY] )
			        ),
			        NOT ISBLANK ( [@RevenueValue] )
			    )
			
			
			VAR _AvailableSegmentCount =
			    COUNTROWS ( _SegmentMetrics )
			
			
			-- Display the five largest segments
			VAR _TopSegments =
			    TOPN (
			        5,
			        _SegmentMetrics,
			        [@RevenueValue], DESC,
			        dimCustomer[customer_segment], ASC
			    )
			
			
			-- Calculate YoY growth
			VAR _ChartData =
			    ADDCOLUMNS (
			        _TopSegments,
			
			        "@YoYGrowth",
			            VAR _RevenueCurrent =
			                [@RevenueValue]
			
			            VAR _RevenuePrevious =
			                [@RevenuePYValue]
			
			            RETURN
			                IF (
			                    NOT ISBLANK ( _RevenuePrevious )
			                        && _RevenuePrevious <> 0,
			                    DIVIDE (
			                        _RevenueCurrent - _RevenuePrevious,
			                        ABS ( _RevenuePrevious )
			                    )
			                )
			    )
			
			
			VAR _HasData =
			    COUNTROWS ( _ChartData ) > 0
			
			
			-- Create a deterministic row index
			VAR _IndexedData =
			    ADDCOLUMNS (
			        _ChartData,
			
			        "@Index",
			            VAR _CurrentRevenue =
			                [@RevenueValue]
			
			            VAR _CurrentSegment =
			                dimCustomer[customer_segment]
			
			            RETURN
			                COUNTROWS (
			                    FILTER (
			                        _ChartData,
			                        [@RevenueValue] > _CurrentRevenue
			                            || (
			                                [@RevenueValue] = _CurrentRevenue
			                                    && dimCustomer[customer_segment]
			                                        < _CurrentSegment
			                            )
			                    )
			                )
			    )
			
			
			-- Chart scaling
			VAR _RawMaximum =
			    MAXX (
			        _IndexedData,
			        [@RevenueValue]
			    )
			
			
			-- Select a readable axis interval
			VAR _AxisStep =
			    SWITCH (
			        TRUE (),
			        _RawMaximum <= 75000000, 25000000,
			        _RawMaximum <= 150000000, 50000000,
			        _RawMaximum <= 300000000, 100000000,
			        _RawMaximum <= 600000000, 200000000,
			        _RawMaximum <= 1500000000, 500000000,
			        _RawMaximum <= 3000000000, 1000000000,
			        2000000000
			    )
			
			
			VAR _AxisMaximum =
			    MAX (
			        _AxisStep,
			        CEILING (
			            _RawMaximum,
			            _AxisStep
			        )
			    )
			
			
			VAR _TickCount =
			    MAX (
			        1,
			        INT (
			            DIVIDE (
			                _AxisMaximum,
			                _AxisStep,
			                1
			            )
			        )
			    )
			
			
			-- SVG geometry
			VAR _ViewBoxWidth = 720
			VAR _ViewBoxHeight = 300
			
			VAR _Left = 90
			VAR _BarMaximumWidth = 500
			
			VAR _RowTop = 35
			VAR _RowStep = 52
			VAR _BarHeight = 27
			
			VAR _AxisY = 300
			VAR _AxisLabelY = 300
			VAR _LegendY = 365
			
			
			-- Axis ticks and labels
			VAR _AxisTicks =
			    CONCATENATEX (
			        GENERATESERIES (
			            0,
			            _TickCount,
			            1
			        ),
			
			        VAR _TickIndex =
			            [Value]
			
			        VAR _TickValue =
			            _TickIndex * _AxisStep
			
			        VAR _TickX =
			            _Left
			                + _BarMaximumWidth
			                    * DIVIDE (
			                        _TickValue,
			                        _AxisMaximum,
			                        0
			                    )
			
			        RETURN
			            "<line x1='" & FORMAT ( _TickX, "0" )
			                & "' y1='" & FORMAT ( _AxisY, "0" )
			                & "' x2='" & FORMAT ( _TickX, "0" )
			                & "' y2='" & FORMAT ( _AxisY + 5, "0" )
			                & "' stroke='#BEB9C0'
			                     stroke-width='1'/>"
			                &
			            "<text x='" & FORMAT ( _TickX, "0" )
			                & "' y='" & FORMAT ( _AxisLabelY, "0" )
			                & "' text-anchor='middle'
			                     class='rgs-axis'>"
			                & FORMAT (
			                    DIVIDE (
			                        _TickValue,
			                        1000000
			                    ),
			                    "€#,0m"
			                )
			                & "</text>",
			
			        ""
			    )
			
			
			-- Segment bars and value labels
			VAR _SegmentRows =
			    CONCATENATEX (
			        _IndexedData,
			
			        VAR _Segment =
			            dimCustomer[customer_segment]
			
			        VAR _RevenueValue =
			            [@RevenueValue]
			
			        VAR _RevenuePYValue =
			            [@RevenuePYValue]
			
			        VAR _YoYGrowth =
			            [@YoYGrowth]
			
			        VAR _RowY =
			            _RowTop
			                + [@Index] * _RowStep
			
			        VAR _BarWidth =
			            MAX (
			                1,
			                ROUND (
			                    _BarMaximumWidth
			                        * DIVIDE (
			                            _RevenueValue,
			                            _AxisMaximum,
			                            0
			                        ),
			                    0
			                )
			            )
			
			        VAR _RevenueLabelX =
			            _Left + _BarWidth + 13
			
			        VAR _GrowthLabelX =
			            MIN (
			                846,
			                _RevenueLabelX + 90
			            )
			
			        VAR _GrowthColor =
			            SWITCH (
			                TRUE (),
			                ISBLANK ( _YoYGrowth ), "#7A7480",
			                _YoYGrowth > 0, "#2F855A",
			                _YoYGrowth < 0, "#C53D3D",
			                "#7A7480"
			            )
			
			        VAR _GrowthArrow =
			            SWITCH (
			                TRUE (),
			                ISBLANK ( _YoYGrowth ), "",
			                _YoYGrowth > 0, "▲ ",
			                _YoYGrowth < 0, "▼ ",
			                "● "
			            )
			
			        VAR _GrowthLabel =
			            IF (
			                ISBLANK ( _YoYGrowth ),
			                "n/a",
			                _GrowthArrow
			                    & FORMAT (
			                        ABS ( _YoYGrowth ),
			                        "0.0%"
			                    )
			            )
			
			        VAR _RevenueLabel =
			            SWITCH (
			                TRUE (),
			                ABS ( _RevenueValue ) >= 1000000000,
			                    FORMAT (
			                        DIVIDE (
			                            _RevenueValue,
			                            1000000000
			                        ),
			                        "€0.00bn"
			                    ),
			
			                ABS ( _RevenueValue ) >= 1000000,
			                    FORMAT (
			                        DIVIDE (
			                            _RevenueValue,
			                            1000000
			                        ),
			                        "€0m"
			                    ),
			
			                ABS ( _RevenueValue ) >= 1000,
			                    FORMAT (
			                        DIVIDE (
			                            _RevenueValue,
			                            1000
			                        ),
			                        "€0k"
			                    ),
			
			                FORMAT (
			                    _RevenueValue,
			                    "€#,0"
			                )
			            )
			
			        VAR _RevenuePYLabel =
			            IF (
			                ISBLANK ( _RevenuePYValue ),
			                "n/a",
			                FORMAT (
			                    DIVIDE (
			                        _RevenuePYValue,
			                        1000000
			                    ),
			                    "€0.0m"
			                )
			            )
			
			        VAR _Tooltip =
			            _Segment
			                & " | Revenue: "
			                & FORMAT (
			                    DIVIDE (
			                        _RevenueValue,
			                        1000000
			                    ),
			                    "€0.0m"
			                )
			                & " | PY: "
			                & _RevenuePYLabel
			                & " | YoY: "
			                & IF (
			                    ISBLANK ( _YoYGrowth ),
			                    "n/a",
			                    FORMAT (
			                        _YoYGrowth,
			                        "0.0%"
			                    )
			                )
			
			        RETURN
			            "<g>"
			                &
			            "<title>"
			                & _Tooltip
			                & "</title>"
			                &
			            "<text x='" & FORMAT ( _Left - 14, "0" )
			                & "' y='" & FORMAT ( _RowY + 16, "0" )
			                & "' text-anchor='end'
			                     class='rgs-segment'>"
			                & _Segment
			                & "</text>"
			                &
			            "<rect x='" & FORMAT ( _Left, "0" )
			                & "' y='" & FORMAT ( _RowY, "0" )
			                & "' width='" & FORMAT ( _BarWidth, "0" )
			                & "' height='" & FORMAT ( _BarHeight, "0" )
			                & "' rx='1.5'
			                     fill='#331045'/>"
			                &
			            "<text x='" & FORMAT ( _RevenueLabelX, "0" )
			                & "' y='" & FORMAT ( _RowY + 16, "0" )
			                & "' class='rgs-revenue'>"
			                & _RevenueLabel
			                & "</text>"
			                &
			            "<text x='" & FORMAT ( _GrowthLabelX, "0" )
			                & "' y='" & FORMAT ( _RowY + 16, "0" )
			                & "' fill='" & _GrowthColor
			                & "' class='rgs-growth'>"
			                & _GrowthLabel
			                & "</text>"
			                &
			            "</g>",
			
			        "",
			        [@Index],
			        ASC
			    )
			
			
			VAR _StatusText =
			    IF (
			        _AvailableSegmentCount > 5,
			        "Top 5 of "
			            & FORMAT (
			                _AvailableSegmentCount,
			                "0"
			            )
			            & " segments",
			        FORMAT (
			            _AvailableSegmentCount,
			            "0"
			        )
			            & IF (
			                _AvailableSegmentCount = 1,
			                " segment",
			                " segments"
			            )
			    )
			
			
			RETURN
			    IF (
			        NOT _HasData,
			
			        "<div style='
			            width:100%;
			            min-height:100%;
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            padding:14px;
			            color:#C53D3D;
			            background:#FFFFFF;
			            border:1px solid #E3DEE6;
			            border-radius:5px;
			            font-family:Segoe UI,Arial,sans-serif;
			            font-size:12px;
			        '>
			            No customer-segment revenue was found.
			        </div>",
			
			        "
			        <style>
			            * {
			                box-sizing:border-box;
			            }
			
			            .rgs-card {
			                width:100%;
			                min-height:180px;
			                padding:5px 5px 5px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:5px;
			                font-family:'Segoe UI';
			                display:flex;
			                flex-direction:column;
			            }
			
			            .rgs-title-row {
			                display:flex;
			                align-items:center;
			                justify-content:space-between;
			                gap:8px;
			            }
			
			            .rgs-title {
			                overflow:hidden;
			                color:#211D22;
			                font-size:11px;
			                font-weight:700;
			                text-overflow:ellipsis;
			                white-space:nowrap;
			                text-transform:uppercase;
			            }
			
			            .rgs-status {
			                overflow:hidden;
			                color:#6F6872;
			                font-size:14px;
			                text-overflow:ellipsis;
			                white-space:nowrap;
			            }
			
			            .rgs-svg {
			                display:block;
			                width:100%;
			                height:200px;
			                flex: 1 1 auto;
			                min-height:0;
			            }
			
			            .rgs-segment {
			                fill:#302B31;
			                font-family:'Segoe UI';
			                font-size:14px;
			                font-weight:600;
			            }
			
			            .rgs-revenue {
			                fill:#302B31;
			                font-family:'Segoe UI';
			                font-size:14px;
			                font-weight:600;
			            }
			
			            .rgs-growth {
			                font-family:'Segoe UI';
			                font-size:14px;
			                font-weight:700;
			            }
			
			            .rgs-axis {
			                fill:#69636B;
			                font-family:'Segoe UI';
			                font-size:14px;
			            }
			
			            .rgs-legend {
			                fill:#4E4851;
			                font-family:'Segoe UI';
			                font-size:14px;
			            }
			
			            .rgs-growth-legend {
			                fill:#2F855A;
			                font-family:'Segoe UI';
			                font-size:14px;
			                font-weight:600;
			            }
			        </style>
			
			        <div class='rgs-card'>
			
			            <div class='rgs-title-row'>
			
			                <div class='rgs-title'>
			                    Revenue Growth by Segment
			                </div>
			
			                <div class='rgs-status'>"
			                    & _StatusText &
			                "</div>
			
			            </div>
			
			            <svg class='rgs-svg'
			                 viewBox='0 0 "
			                    & _ViewBoxWidth
			                    & " "
			                    & _ViewBoxHeight
			                    & "'
			                 preserveAspectRatio='none'>
			
			                "
			                    & _SegmentRows
			                    &
			
			                "<line x1='" & FORMAT ( _Left, "0" )
			                    & "' y1='" & FORMAT ( _AxisY, "0" )
			                    & "' x2='" & FORMAT ( _Left + _BarMaximumWidth, "0" )
			                    & "' y2='" & FORMAT ( _AxisY, "0" )
			                    & "' stroke='#BEB9C0'
			                         stroke-width='1'/>"
			
			                    & _AxisTicks
			                    &
			
			                "<rect x='155'
			                       y='246'
			                       width='13'
			                       height='11'
			                       rx='1'
			                       fill='#331045'/>
			
			                 <text x='176'
			                       y='" & FORMAT ( _LegendY, "0" ) & "'
			                       class='rgs-legend'>
			                    Revenue (€m)
			                 </text>
			
			                 <text x='366'
			                       y='" & FORMAT ( _LegendY, "0" ) & "'
			                       class='rgs-growth-legend'>
			                    ▲ YoY Growth (%)
			                 </text>
			
			            </svg>
			
			        </div>"
			    )
		displayFolder: 08 Executive
		lineageTag: d10c604a-be74-44df-aaf0-be855f847795

	measure 'Contribution by Product Country HTML' =
			
			-- Product families in the current filter context
			VAR _ProductSummary =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER (
			                ALLSELECTED ( dimProduct[product_family] ),
			                NOT ISBLANK ( dimProduct[product_family] )
			            ),
			            "@TotalRevenue",
			                CALCULATE ( [Revenue] )
			        ),
			        NOT ISBLANK ( [@TotalRevenue] )
			    )
			
			
			-- Countries in the current filter context
			VAR _CountrySummary =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER (
			                ALLSELECTED ( dimRegion[country] ),
			                NOT ISBLANK ( dimRegion[country] )
			            ),
			            "@TotalRevenue",
			                CALCULATE ( [Revenue] )
			        ),
			        NOT ISBLANK ( [@TotalRevenue] )
			    )
			
			
			-- Limit the matrix to the most relevant elements
			VAR _Products =
			    TOPN (
			        8,
			        _ProductSummary,
			        [@TotalRevenue], DESC,
			        dimProduct[product_family], ASC
			    )
			
			
			VAR _Countries =
			    TOPN (
			        10,
			        _CountrySummary,
			        [@TotalRevenue], DESC,
			        dimRegion[country], ASC
			    )
			
			
			VAR _ProductCount =
			    COUNTROWS ( _Products )
			
			VAR _CountryCount =
			    COUNTROWS ( _Countries )
			
			VAR _HasData =
			    _ProductCount > 0
			        && _CountryCount > 0
			
			
			-- Deterministic product-family row index
			VAR _IndexedProducts =
			    ADDCOLUMNS (
			        _Products,
			        "@RowIndex",
			            VAR _CurrentRevenue =
			                [@TotalRevenue]
			
			            VAR _CurrentProduct =
			                dimProduct[product_family]
			
			            RETURN
			                COUNTROWS (
			                    FILTER (
			                        _Products,
			                        [@TotalRevenue] > _CurrentRevenue
			                            || (
			                                [@TotalRevenue] = _CurrentRevenue
			                                    && dimProduct[product_family]
			                                        < _CurrentProduct
			                            )
			                    )
			                )
			    )
			
			
			-- Deterministic country column index
			VAR _IndexedCountries =
			    ADDCOLUMNS (
			        _Countries,
			        "@ColumnIndex",
			            VAR _CurrentRevenue =
			                [@TotalRevenue]
			
			            VAR _CurrentCountry =
			                dimRegion[country]
			
			            RETURN
			                COUNTROWS (
			                    FILTER (
			                        _Countries,
			                        [@TotalRevenue] > _CurrentRevenue
			                            || (
			                                [@TotalRevenue] = _CurrentRevenue
			                                    && dimRegion[country]
			                                        < _CurrentCountry
			                            )
			                    )
			                )
			    )
			
			
			-- Create every product-family and country combination
			VAR _CellBase =
			    CROSSJOIN (
			        SELECTCOLUMNS (
			            _IndexedProducts,
			            "@ProductFamily",
			                dimProduct[product_family],
			            "@RowIndex",
			                [@RowIndex]
			        ),
			        SELECTCOLUMNS (
			            _IndexedCountries,
			            "@Country",
			                dimRegion[country],
			            "@ColumnIndex",
			                [@ColumnIndex]
			        )
			    )
			
			
			-- Revenue values for every matrix cell
			VAR _CellValues =
			    ADDCOLUMNS (
			        _CellBase,
			
			        "@RevenueCurrent",
			            VAR _Product =
			                [@ProductFamily]
			
			            VAR _Country =
			                [@Country]
			
			            RETURN
			                CALCULATE (
			                    [Revenue],
			                    REMOVEFILTERS (
			                        dimProduct[product_family]
			                    ),
			                    REMOVEFILTERS (
			                        dimRegion[country]
			                    ),
			                    TREATAS (
			                        { _Product },
			                        dimProduct[product_family]
			                    ),
			                    TREATAS (
			                        { _Country },
			                        dimRegion[country]
			                    )
			                ),
			
			        "@RevenuePrevious",
			            VAR _Product =
			                [@ProductFamily]
			
			            VAR _Country =
			                [@Country]
			
			            RETURN
			                CALCULATE (
			                    [Revenue PY],
			                    REMOVEFILTERS (
			                        dimProduct[product_family]
			                    ),
			                    REMOVEFILTERS (
			                        dimRegion[country]
			                    ),
			                    TREATAS (
			                        { _Product },
			                        dimProduct[product_family]
			                    ),
			                    TREATAS (
			                        { _Country },
			                        dimRegion[country]
			                    )
			                )
			    )
			
			
			VAR _CellData =
			    ADDCOLUMNS (
			        _CellValues,
			
			        "@YoYGrowth",
			            VAR _CurrentRevenue =
			                [@RevenueCurrent]
			
			            VAR _PreviousRevenue =
			                [@RevenuePrevious]
			
			            RETURN
			                IF (
			                    NOT ISBLANK ( _PreviousRevenue )
			                        && _PreviousRevenue <> 0,
			                    DIVIDE (
			                        _CurrentRevenue - _PreviousRevenue,
			                        ABS ( _PreviousRevenue )
			                    )
			                )
			    )
			
			
			-- SVG geometry
			VAR _ViewBoxWidth = 1100
			VAR _ViewBoxHeight = 470
			
			VAR _Left = 50
			VAR _Right = 1070
			VAR _GridTop = 88
			VAR _GridHeight = 280
			VAR _GridWidth = _Right - _Left
			
			VAR _ColumnWidth =
			    DIVIDE (
			        _GridWidth,
			        _CountryCount,
			        0
			    )
			
			VAR _RowHeight =
			    DIVIDE (
			        _GridHeight,
			        _ProductCount,
			        0
			    )
			
			
			-- Country headers
			VAR _CountryHeaders =
			    CONCATENATEX (
			        _IndexedCountries,
			
			        VAR _X =
			            _Left
			                + (
			                    [@ColumnIndex] + 0.5
			                ) * _ColumnWidth
			
			        RETURN
			            "<text x='" & FORMAT ( _X, "0.0", "en-US" )
			                & "' y='73'
			                     text-anchor='middle'
			                     class='cpc-country'>"
			                & dimRegion[country]
			                & "</text>",
			
			        "",
			        [@ColumnIndex],
			        ASC
			    )
			
			
			-- Product-family labels
			VAR _ProductLabels =
			    CONCATENATEX (
			        _IndexedProducts,
			
			        VAR _Y =
			            _GridTop
			                + (
			                    [@RowIndex] + 0.5
			                ) * _RowHeight
			                + 4
			
			        RETURN
			            "<text x='" & FORMAT ( _Left - 12, "0" )
			                & "' y='" & FORMAT ( _Y, "0.0", "en-US" )
			                & "' text-anchor='end'
			                     class='cpc-product'>"
			                & dimProduct[product_family]
			                & "</text>",
			
			        "",
			        [@RowIndex],
			        ASC
			    )
			
			
			-- Heatmap cells
			VAR _Cells =
			    CONCATENATEX (
			        _CellData,
			
			        VAR _Growth =
			            [@YoYGrowth]
			
			        VAR _X =
			            _Left
			                + [@ColumnIndex] * _ColumnWidth
			
			        VAR _Y =
			            _GridTop
			                + [@RowIndex] * _RowHeight
			
			        VAR _FillColor =
			            SWITCH (
			                TRUE (),
			                ISBLANK ( _Growth ), "#F2F1F3",
			                _Growth <= -0.10, "#D90429",
			                _Growth <= -0.075, "#EC5E69",
			                _Growth <= -0.05, "#F28F97",
			                _Growth <= -0.025, "#F7C7CB",
			                _Growth < 0.025, "#F5F6F5",
			                _Growth < 0.05, "#D4EDDC",
			                _Growth < 0.075, "#A5DDB7",
			                _Growth < 0.10, "#57BC79",
			                "#0A8F49"
			            )
			
			        VAR _TextColor =
			            IF (
			                NOT ISBLANK ( _Growth )
			                    && ABS ( _Growth ) >= 0.075,
			                "#FFFFFF",
			                "#302B31"
			            )
			
			        VAR _GrowthLabel =
			            IF (
			                ISBLANK ( _Growth ),
			                "–",
			                FORMAT (
			                    _Growth,
			                    "0.0%"
			                )
			            )
			
			        VAR _Tooltip =
			            [@ProductFamily]
			                & " | "
			                & [@Country]
			                & " | Revenue: "
			                & FORMAT (
			                    DIVIDE (
			                        [@RevenueCurrent],
			                        1000000
			                    ),
			                    "€0.0m"
			                )
			                & " | PY: "
			                & FORMAT (
			                    DIVIDE (
			                        [@RevenuePrevious],
			                        1000000
			                    ),
			                    "€0.0m"
			                )
			                & " | YoY: "
			                & _GrowthLabel
			
			        RETURN
			            "<g>"
			                &
			            "<title>"
			                & _Tooltip
			                & "</title>"
			                &
			            "<rect x='" & FORMAT ( _X + 1, "0.0", "en-US" )
			                & "' y='" & FORMAT ( _Y + 1, "0.0", "en-US" )
			                & "' width='" & FORMAT ( MAX ( 1, _ColumnWidth - 2 ), "0.0", "en-US" )
			                & "' height='" & FORMAT ( MAX ( 1, _RowHeight - 2 ), "0.0", "en-US" )
			                & "' rx='2'
			                     fill='" & _FillColor & "'/>"
			                &
			            "<text x='" & FORMAT ( _X + DIVIDE ( _ColumnWidth, 2 ), "0.0", "en-US" )
			                & "' y='" & FORMAT ( _Y + DIVIDE ( _RowHeight, 2 ) + 4, "0.0", "en-US" )
			                & "' text-anchor='middle'
			                     fill='" & _TextColor & "'
			                     class='cpc-value'>"
			                & _GrowthLabel
			                & "</text>"
			                &
			            "</g>",
			
			        "",
			        [@RowIndex] * 100 + [@ColumnIndex],
			        ASC
			    )
			
			
			RETURN
			    IF (
			        NOT _HasData,
			
			        "<div style='
			            width:100%;
			            height:100%;
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            padding:14px;
			            background:#FFFFFF;
			            color:#C53D3D;
			            border:1px solid #E3DEE6;
			            border-radius:5px;
			            font:12px Segoe UI,Arial,sans-serif;
			        '>
			            No product and country revenue data was found.
			        </div>",
			
			        "
			        <style>
			            * {
			                box-sizing:border-box;
			            }
			
			            .cpc-card {
			                width:100%;
			                height:100%;
			                min-height:100px;
			                padding:5px 5px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:5px;
			                font-family:'Segoe UI';
			            }
			
			            .cpc-title-row {
			                display:flex;
			                align-items:center;
			                justify-content:space-between;
			                gap:8px;
			            }
			
			            .cpc-title {
			                overflow:hidden;
			                color:#211D22;
			                font-size:15px;
			                font-weight:700;
			                text-transform:uppercase;
			                text-overflow:ellipsis;
			                white-space:nowrap;
			            }
			
			            .cpc-status {
			                overflow:hidden;
			                color:#6F6872;
			                font-size:12px;
			                text-overflow:ellipsis;
			                white-space:nowrap;
			            }
			
			            .cpc-svg {
			                display:block;
			                width:100%;
			                height:calc(100% - 22px);
			                min-height:150px;
			            }
			
			            .cpc-product {
			                fill:#302B31;
			                font-family:'Segoe UI';
			                font-size:12px;
			                font-weight:600;
			            }
			
			            .cpc-country {
			                fill:#302B31;
			                font-family:'Segoe UI';
			                font-size:18px;
			                font-weight:600;
			            }
			
			            .cpc-value {
			                font-family:'Segoe UI';
			                font-size:18px;
			                font-weight:600;
			            }
			
			            .cpc-legend {
			                fill:#625C64;
			                font-family:'Segoe UI';
			                font-size:18px;
			            }
			
			            .cpc-legend-title {
			                fill:#4E4851;
			                font-family:'Segoe UI';
			                font-size:18px;
			                font-weight:600;
			            }
			        </style>
			
			        <div class='cpc-card'>
			
			            <div class='cpc-title-row'>
			
			                <div class='cpc-title'>
			                    Contribution by Product &amp; Country
			                </div>
			
			            </div>
			
			            <svg class='cpc-svg'
			                 viewBox='0 0 "
			                    & _ViewBoxWidth
			                    & " "
			                    & _ViewBoxHeight
			                    & "'
			                 preserveAspectRatio='xMidYMid meet'>
			
			                <defs>
			                    <linearGradient id='cpc-gradient'
			                                    x1='0%'
			                                    y1='0%'
			                                    x2='100%'
			                                    y2='0%'>
			                        <stop offset='0%'
			                              stop-color='#D90429'/>
			                        <stop offset='50%'
			                              stop-color='#F5F6F5'/>
			                        <stop offset='100%'
			                              stop-color='#0A8F49'/>
			                    </linearGradient>
			                </defs>
			
			                <text x='15'
			                      y='73'
			                      class='cpc-product'
			                      font-weight='700'>
			                    Product Family
			                </text>"
			
			                & _CountryHeaders
			                & _ProductLabels
			                & _Cells
			
			                & "<text x='365'
			                         y='414'
			                         text-anchor='end'
			                         class='cpc-legend'>
			                        −10%
			                   </text>
			
			                   <rect x='380'
			                         y='401'
			                         width='330'
			                         height='14'
			                         rx='4'
			                         fill='url(#cpc-gradient)'/>
			
			                   <text x='545'
			                         y='435'
			                         text-anchor='middle'
			                         class='cpc-legend-title'>
			                        YoY Contribution (%)
			                   </text>
			
			                   <text x='545'
			                         y='414'
			                         text-anchor='middle'
			                         class='cpc-legend'>
			                        0%
			                   </text>
			
			                   <text x='725'
			                         y='414'
			                         class='cpc-legend'>
			                        +10%
			                   </text>
			
			            </svg>
			
			        </div>"
			    )
		displayFolder: 05 Products
		lineageTag: f3c40b20-7443-4ab7-a63e-eefe8302b4c7

	measure 'Revenue Trend Growth HTML' =
			
			-- Months selected in the date slicer
			VAR _SelectedMonths =
			    CALCULATETABLE (
			        VALUES ( dimDate[MonthStartDate] ),
			        ALLSELECTED ( dimDate[MonthStartDate] )
			    )
			
			
			-- Last month selected by the date slicer
			VAR _SelectedEndMonth =
			    MAXX (
			        _SelectedMonths,
			        dimDate[MonthStartDate]
			    )
			
			
			-- Last available sales month in the selected date context
			VAR _LastAvailableMonth =
			    MAX ( dimDate[MonthStartDate] )
			
			
			VAR _EndMonth =
			    IF (
			        ISBLANK ( _LastAvailableMonth ),
			        BLANK (),
			        MIN (
			            COALESCE (
			                _SelectedEndMonth,
			                _LastAvailableMonth
			            ),
			            _LastAvailableMonth
			        )
			    )
			
			
			-- Keep selected months up to the last month containing sales
			VAR _SelectedMonthsInScope =
			    FILTER (
			        _SelectedMonths,
			        NOT ISBLANK ( dimDate[MonthStartDate] )
			            && dimDate[MonthStartDate] <= _EndMonth
			    )
			
			
			-- Display at most the last twelve selected months
			VAR _LastTwelveSelectedMonths =
			    TOPN (
			        12,
			        _SelectedMonthsInScope,
			        dimDate[MonthStartDate],
			        DESC
			    )
			
			
			VAR _Months =
			    SELECTCOLUMNS (
			        ADDCOLUMNS (
			            _LastTwelveSelectedMonths,
			            "@Index",
			                RANKX (
			                    _LastTwelveSelectedMonths,
			                    dimDate[MonthStartDate],
			                    ,
			                    ASC,
			                    DENSE
			                ) - 1
			        ),
			        "@Index", [@Index],
			        "@MonthDate", dimDate[MonthStartDate]
			    )
			
			
			VAR _MonthCount =
			    COUNTROWS ( _Months )
			
			
			-- Current and prior-year monthly revenue
			VAR _ChartData =
			    ADDCOLUMNS (
			        _Months,
			
			        "@RevenueCurrent",
			            VAR _Month =
			                [@MonthDate]
			
			            RETURN
			                CALCULATE (
			                    [Revenue],
			                    REMOVEFILTERS ( dimDate[MonthStartDate] ),
			                    TREATAS (
			                        { _Month },
			                        dimDate[MonthStartDate]
			                    )
			                ),
			
			        "@RevenuePrevious",
			            VAR _PreviousYearMonth =
			                EDATE (
			                    [@MonthDate],
			                    -12
			                )
			
			            RETURN
			                [Revenue PY]
			    )
			
			
			VAR _GrowthData =
			    ADDCOLUMNS (
			        _ChartData,
			
			        "@YoYGrowth",
			            VAR _CurrentRevenue =
			                [@RevenueCurrent]
			
			            VAR _PreviousRevenue =
			                [@RevenuePrevious]
			
			            RETURN
			                [Revenue YoY %]
			    )
			
			
			VAR _HasData =
			    COUNTROWS (
			        FILTER (
			            _GrowthData,
			            NOT ISBLANK ( [@RevenueCurrent] )
			                || NOT ISBLANK ( [@RevenuePrevious] )
			        )
			    ) > 0
			
			
			-- Revenue-axis scaling
			VAR _RawMaximum =
			    MAXX (
			        _GrowthData,
			        MAX (
			            COALESCE ( [@RevenueCurrent], 0 ),
			            COALESCE ( [@RevenuePrevious], 0 )
			        )
			    )
			
			
			VAR _AxisStep =
			    SWITCH (
			        TRUE (),
			        _RawMaximum <= 75000000, 25000000,
			        _RawMaximum <= 150000000, 50000000,
			        _RawMaximum <= 300000000, 100000000,
			        _RawMaximum <= 600000000, 200000000,
			        _RawMaximum <= 1500000000, 500000000,
			        1000000000
			    )
			
			
			VAR _AxisMaximum =
			    MAX (
			        _AxisStep,
			        CEILING (
			            _RawMaximum,
			            _AxisStep
			        )
			    )
			
			
			VAR _TickCount =
			    MAX (
			        1,
			        INT (
			            DIVIDE (
			                _AxisMaximum,
			                _AxisStep,
			                1
			            )
			        )
			    )
			
			
			-- Fixed geometry for Power BI visual: 458 x 269 px
			VAR _ViewBoxWidth = 458
			VAR _ViewBoxHeight = 225
			
			VAR _Left = 38
			VAR _Right = 450
			VAR _Top = 22
			VAR _PlotHeight = 135
			
			VAR _PlotWidth =
			    _Right - _Left
			
			VAR _Baseline =
			    _Top + _PlotHeight
			
			VAR _MonthLabelY = 176
			VAR _YearLabelY = 188
			VAR _GrowthBadgeY = 204
			VAR _GrowthTextY = 218
			
			
			VAR _Step =
			    DIVIDE (
			        _PlotWidth,
			        MAX ( 1, _MonthCount )
			    )
			
			
			-- Wider bars with smaller spaces
			VAR _BarWidth =
			    MIN (
			        30,
			        MAX (
			            22,
			            _Step * 0.76
			        )
			    )
			
			
			-- Chart coordinates
			VAR _Points =
			    ADDCOLUMNS (
			        _GrowthData,
			
			        "@X",
			            _Left
			                + (
			                    [@Index] + 0.5
			                ) * _Step,
			
			        "@CurrentY",
			            _Baseline
			                - _PlotHeight
			                    * DIVIDE (
			                        COALESCE (
			                            [@RevenueCurrent],
			                            0
			                        ),
			                        _AxisMaximum,
			                        0
			                    ),
			
			        "@PreviousY",
			            _Baseline
			                - _PlotHeight
			                    * DIVIDE (
			                        COALESCE (
			                            [@RevenuePrevious],
			                            0
			                        ),
			                        _AxisMaximum,
			                        0
			                    )
			    )
			
			
			-- Horizontal gridlines and revenue axis
			VAR _GridLines =
			    CONCATENATEX (
			        GENERATESERIES (
			            0,
			            _TickCount,
			            1
			        ),
			
			        VAR _TickIndex =
			            [Value]
			
			        VAR _TickValue =
			            _TickIndex * _AxisStep
			
			        VAR _Y =
			            _Baseline
			                - _PlotHeight
			                    * DIVIDE (
			                        _TickValue,
			                        _AxisMaximum,
			                        0
			                    )
			
			        RETURN
			            "<line x1='" & FORMAT ( _Left, "0" )
			                & "' y1='" & FORMAT ( _Y, "0.0", "en-US" )
			                & "' x2='" & FORMAT ( _Right, "0" )
			                & "' y2='" & FORMAT ( _Y, "0.0", "en-US" )
			                & "' stroke='#E7E2E9'
			                     stroke-width='1'/>"
			                &
			            "<text x='" & FORMAT ( _Left - 6, "0" )
			                & "' y='" & FORMAT ( _Y + 3, "0.0", "en-US" )
			                & "' text-anchor='end'
			                     class='rtg-axis'>"
			                & FORMAT (
			                    DIVIDE (
			                        _TickValue,
			                        1000000
			                    ),
			                    "€#,0m"
			                )
			                & "</text>",
			
			        ""
			    )
			
			
			-- Current-revenue bars
			VAR _RevenueBars =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@RevenueCurrent] )
			        ),
			
			        VAR _X =
			            [@X]
			                - DIVIDE (
			                    _BarWidth,
			                    2
			                )
			
			        VAR _Y =
			            [@CurrentY]
			
			        VAR _Height =
			            MAX (
			                0,
			                _Baseline - _Y
			            )
			
			        RETURN
			            "<rect x='" & FORMAT ( _X, "0.0", "en-US" )
			                & "' y='" & FORMAT ( _Y, "0.0", "en-US" )
			                & "' width='" & FORMAT ( _BarWidth, "0.0", "en-US" )
			                & "' height='" & FORMAT ( _Height, "0.0", "en-US" )
			                & "' rx='2'
			                     fill='url(#rtgBarGradient)'>"
			                &
			            "<title>"
			                & FORMAT (
			                    [@MonthDate],
			                    "MMM yyyy",
			                    "en-US"
			                )
			                & " revenue: "
			                & FORMAT (
			                    DIVIDE (
			                        [@RevenueCurrent],
			                        1000000
			                    ),
			                    "€0.0m"
			                )
			                & "</title></rect>",
			
			        "",
			        [@Index],
			        ASC
			    )
			
			
			-- Prior-year revenue line
			VAR _PriorYearPoints =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@RevenuePrevious] )
			        ),
			
			        FORMAT (
			            [@X],
			            "0.0",
			            "en-US"
			        )
			            & ","
			            & FORMAT (
			                [@PreviousY],
			                "0.0",
			                "en-US"
			            ),
			
			        " ",
			        [@Index],
			        ASC
			    )
			
			
			-- Prior-year markers
			VAR _PriorYearMarkers =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@RevenuePrevious] )
			        ),
			
			        "<circle cx='" & FORMAT ( [@X], "0.0", "en-US" )
			            & "' cy='" & FORMAT ( [@PreviousY], "0.0", "en-US" )
			            & "' r='2.5'
			                 fill='#8A858C'
			                 stroke='#FFFFFF'
			                 stroke-width='1.5'>"
			            &
			        "<title>"
			            & FORMAT (
			                [@MonthDate],
			                "MMM yyyy",
			                "en-US"
			            )
			            & " PY revenue: "
			            & FORMAT (
			                DIVIDE (
			                    [@RevenuePrevious],
			                    1000000
			                ),
			                "€0.0m"
			            )
			            & "</title></circle>",
			
			        "",
			        [@Index],
			        ASC
			    )
			
			
			-- Month labels
			VAR _MonthLabels =
			    CONCATENATEX (
			        _Points,
			
			        "<text x='" & FORMAT ( [@X], "0.0", "en-US" )
			            & "' y='" & FORMAT ( _MonthLabelY, "0" )
			            & "' text-anchor='middle'
			                 class='rtg-month'>"
			            & FORMAT (
			                [@MonthDate],
			                "MMM",
			                "en-US"
			            )
			            & "</text>"
			            &
			        "<text x='" & FORMAT ( [@X], "0.0", "en-US" )
			            & "' y='" & FORMAT ( _YearLabelY, "0" )
			            & "' text-anchor='middle'
			                 class='rtg-year'>"
			            & FORMAT (
			                [@MonthDate],
			                "yyyy"
			            )
			            & "</text>",
			
			        "",
			        [@Index],
			        ASC
			    )
			
			
			-- YoY growth badges
			VAR _GrowthBadges =
			    CONCATENATEX (
			        _Points,
			
			        VAR _Growth =
			            [@YoYGrowth]
			
			        VAR _BadgeColor =
			            SWITCH (
			                TRUE (),
			                ISBLANK ( _Growth ), "#7A7480",
			                _Growth > 0, "#2F855A",
			                _Growth < 0, "#C53D3D",
			                "#7A7480"
			            )
			
			        VAR _BadgeBackground =
			            SWITCH (
			                TRUE (),
			                ISBLANK ( _Growth ), "#F4F2F5",
			                _Growth > 0, "#EDF7F1",
			                _Growth < 0, "#FCEEEE",
			                "#F4F2F5"
			            )
			
			        VAR _GrowthLabel =
			            IF (
			                ISBLANK ( _Growth ),
			                "–",
			                FORMAT (
			                    _Growth,
			                    "+0%;-0%;0%"
			                )
			            )
			
			        RETURN
			            "<rect x='" & FORMAT ( [@X] - 17, "0.0", "en-US" )
			                & "' y='" & FORMAT ( _GrowthBadgeY, "0" )
			                & "' width='34'
			                     height='18'
			                     rx='4'
			                     fill='" & _BadgeBackground & "'
			                     stroke='#E3DEE6'
			                     stroke-width='1'/>"
			                &
			            "<text x='" & FORMAT ( [@X], "0.0", "en-US" )
			                & "' y='" & FORMAT ( _GrowthTextY, "0" )
			                & "' text-anchor='middle'
			                     fill='" & _BadgeColor & "'
			                     class='rtg-growth'>"
			                & _GrowthLabel
			                & "</text>",
			
			        "",
			        [@Index],
			        ASC
			    )
			
			
			RETURN
			    IF (
			        ISBLANK ( _EndMonth )
			            || NOT _HasData,
			
			        "<div style='
			            box-sizing:border-box;
			            width:458px;
			            height:269px;
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            padding:10px;
			            background:#FFFFFF;
			            color:#C53D3D;
			            border:1px solid #E3DEE6;
			            border-radius:6px;
			            font:12px Segoe UI,Arial,sans-serif;
			        '>
			            No monthly revenue data was found.
			        </div>",
			
			        "
			        <style>
			            * {
			                box-sizing:border-box;
			            }
			
			            html,
			            body {
			                width:458px;
			                height:269px;
			                margin:0;
			                padding:0;
			                overflow:hidden;
			                background:#FFFFFF;
			            }
			
			            .rtg-card {
			                width:458px;
			                height:269px;
			                min-width:458px;
			                min-height:269px;
			                padding:4px 5px 5px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:5px;
			                font-family:'Segoe UI',Arial,sans-serif;
			            }
			
			            .rtg-title-row {
			                display:flex;
			                align-items:center;
			                justify-content:space-between;
			                width:446px;
			                height:24px;
			                min-height:24px;
			                gap:8px;
			                padding:0 2px;
			            }
			
			            .rtg-title {
			                flex:0 1 auto;
			                overflow:hidden;
			                color:#211D22;
			                font-size:14px;
			                font-weight:700;
			                line-height:16px;
			                text-transform:uppercase;
			                text-overflow:ellipsis;
			                white-space:nowrap;
			            }
			
			            .rtg-legend {
			                display:flex;
			                flex:0 0 auto;
			                align-items:center;
			                justify-content:flex-end;
			                gap:10px;
			                margin-left:auto;
			                color:#4E4851;
			                font-size:11px;
			            }
			
			            .rtg-legend-item {
			                display:flex;
			                align-items:center;
			                gap:3px;
			                white-space:nowrap;
			            }
			
			            .rtg-bar-key {
			                width:10px;
			                height:7px;
			                border-radius:1px;
			                background:#331045;
			            }
			
			            .rtg-line-key {
			                width:16px;
			                border-top:2.5px solid #8A858C;
			            }
			
			            .rtg-growth-key {
			                min-width:18px;
			                padding:1px 4px;
			                border:1px solid #DDE2E5;
			                border-radius:4px;
			                color:#2F855A;
			                background:#EDF7F1;
			                font-weight:700;
			                text-align:center;
			            }
			
			            .rtg-svg {
			                display:block;
			                width:446px;
			                height:225px;
			                min-width:446px;
			                min-height:235px;
			            }
			
			            .rtg-axis {
			                fill:#625C65;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:9.5px;
			                font-weight:600;
			            }
			
			            .rtg-month {
			                fill:#373239;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:9.5px;
			                font-weight:700;
			            }
			
			            .rtg-year {
			                fill:#817A83;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:8px;
			                font-weight:500;
			            }
			
			            .rtg-growth {
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:8.5px;
			                font-weight:700;
			            }
			
			            .rtg-row-label {
			                fill:#4E4851;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:9px;
			                font-weight:700;
			            }
			        </style>
			
			        <div class='rtg-card'>
			
			            <div class='rtg-title-row'>
			
			                <div class='rtg-title'>
			                    Revenue Trend &amp; Growth
			                </div>
			
			                <div class='rtg-legend'>
			
			                    <div class='rtg-legend-item'>
			                        <span class='rtg-bar-key'></span>
			                        <span>Revenue</span>
			                    </div>
			
			                    <div class='rtg-legend-item'>
			                        <span class='rtg-line-key'></span>
			                        <span>PY</span>
			                    </div>
			
			                    <div class='rtg-legend-item'>
			                        <span class='rtg-growth-key'>%</span>
			                        <span>YoY</span>
			                    </div>
			
			                </div>
			
			            </div>
			
			            <svg class='rtg-svg'
			                 viewBox='0 0 "
			                    & _ViewBoxWidth
			                    & " "
			                    & _ViewBoxHeight
			                    & "'
			                 width='458'
			                 height='235'
			                 preserveAspectRatio='none'>
			
			                <defs>
			                    <linearGradient id='rtgBarGradient'
			                                    x1='0'
			                                    y1='0'
			                                    x2='0'
			                                    y2='1'>
			                        <stop offset='0%'
			                              stop-color='#331045'/>
			                        <stop offset='100%'
			                              stop-color='#331045'/>
			                    </linearGradient>
			                </defs>
			
			                "
			                    & _GridLines
			                    & _RevenueBars
			                    &
			
			                "<polyline points='"
			                    & _PriorYearPoints
			                    & "' fill='none'
			                         stroke='#8A858C'
			                         stroke-width='2.2'
			                         stroke-linejoin='round'
			                         stroke-linecap='round'/>"
			
			                    & _PriorYearMarkers
			                    & _MonthLabels
			                    &
			
			                "<text x='4'
			                       y='218'
			                       class='rtg-row-label'>
			                    YoY
			                 </text>"
			
			                    & _GrowthBadges
			                    &
			
			                "<line x1='" & FORMAT ( _Left, "0" )
			                    & "' y1='" & FORMAT ( _Baseline, "0" )
			                    & "' x2='" & FORMAT ( _Right, "0" )
			                    & "' y2='" & FORMAT ( _Baseline, "0" )
			                    & "' stroke='#AAA4AC'
			                         stroke-width='1'/>
			
			            </svg>
			
			        </div>"
			    )
		displayFolder: 08 Executive
		lineageTag: d78775fb-5b2f-460d-a2db-71ed2775e189

	measure 'Portfolio Profitability HTML' =
			
			VAR _TargetMargin = [Gross Margin Target %]
			
			
			-- Product-family metrics
			VAR _ProductFamilyData =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER (
			                ALLSELECTED ( dimProduct[product_family] ),
			                NOT ISBLANK ( dimProduct[product_family] )
			            ),
			
			            "@RevenueValue",
			                CALCULATE ( [Revenue] ),
			
			            "@GrossProfitValue",
			                CALCULATE ( [Gross Profit] ),
			
			            "@GrossMarginValue",
			                CALCULATE ( [Gross Margin %] ),
			
			            "@LifecycleStage",
			                VAR _StageRanking =
			                    TOPN (
			                        1,
			                        ADDCOLUMNS (
			                            CALCULATETABLE (
			                                VALUES (
			                                    dimProduct[lifecycle_stage]
			                                ),
			                                REMOVEFILTERS (
			                                    dimProduct[lifecycle_stage]
			                                )
			                            ),
			                            "@StageRevenue",
			                                CALCULATE ( [Revenue] )
			                        ),
			                        [@StageRevenue], DESC,
			                        dimProduct[lifecycle_stage], ASC
			                    )
			
			                RETURN
			                    MAXX (
			                        _StageRanking,
			                        dimProduct[lifecycle_stage]
			                    )
			        ),
			        NOT ISBLANK ( [@RevenueValue] )
			            && NOT ISBLANK ( [@GrossMarginValue] )
			    )
			
			
			VAR _ChartData =
			    TOPN (
			        10,
			        _ProductFamilyData,
			        [@RevenueValue], DESC,
			        dimProduct[product_family], ASC
			    )
			
			
			VAR _ProductFamilyCount =
			    COUNTROWS ( _ChartData )
			
			VAR _HasData =
			    _ProductFamilyCount > 0
			
			
			-- Revenue scale
			VAR _MaximumRevenueRaw =
			    MAXX (
			        _ChartData,
			        [@RevenueValue]
			    )
			
			
			VAR _RevenueStep =
			    SWITCH (
			        TRUE (),
			        _MaximumRevenueRaw <= 75000000, 25000000,
			        _MaximumRevenueRaw <= 150000000, 50000000,
			        _MaximumRevenueRaw <= 300000000, 100000000,
			        _MaximumRevenueRaw <= 600000000, 200000000,
			        _MaximumRevenueRaw <= 1500000000, 500000000,
			        1000000000
			    )
			
			
			VAR _RevenueMaximum =
			    MAX (
			        _RevenueStep,
			        CEILING (
			            _MaximumRevenueRaw,
			            _RevenueStep
			        )
			    )
			
			
			VAR _RevenueTickCount =
			    MAX (
			        1,
			        INT (
			            DIVIDE (
			                _RevenueMaximum,
			                _RevenueStep,
			                1
			            )
			        )
			    )
			
			
			-- Margin scale
			VAR _MaximumMarginRaw =
			    MAXX (
			        _ChartData,
			        [@GrossMarginValue]
			    )
			
			
			VAR _MarginMaximum =
			    MAX (
			        0.60,
			        CEILING (
			            _MaximumMarginRaw,
			            0.10
			        )
			    )
			
			
			-- Bubble-size scale
			VAR _MaximumGrossProfit =
			    MAX (
			        1,
			        MAXX (
			            _ChartData,
			            ABS ( [@GrossProfitValue] )
			        )
			    )
			
			
			VAR _AverageRevenue =
			    AVERAGEX (
			        _ChartData,
			        [@RevenueValue]
			    )
			
			
			-- SVG geometry
			VAR _ViewBoxWidth = 1100
			VAR _ViewBoxHeight = 500
			
			VAR _Left = 100
			VAR _Right = 1000
			VAR _Top = 55
			VAR _Bottom = 400
			
			VAR _PlotWidth = _Right - _Left
			VAR _PlotHeight = _Bottom - _Top
			
			
			-- Product-family coordinates
			VAR _Points =
			    ADDCOLUMNS (
			        _ChartData,
			
			        "@X",
			            _Left
			                + _PlotWidth
			                    * DIVIDE (
			                        [@RevenueValue],
			                        _RevenueMaximum,
			                        0
			                    ),
			
			        "@Y",
			            _Bottom
			                - _PlotHeight
			                    * DIVIDE (
			                        MAX (
			                            0,
			                            MIN (
			                                _MarginMaximum,
			                                [@GrossMarginValue]
			                            )
			                        ),
			                        _MarginMaximum,
			                        0
			                    ),
			
			        "@Radius",
			            8
			                + 20
			                    * SQRT (
			                        DIVIDE (
			                            ABS ( [@GrossProfitValue] ),
			                            _MaximumGrossProfit,
			                            0
			                        )
			                    )
			    )
			
			
			-- Revenue grid
			VAR _RevenueGrid =
			    CONCATENATEX (
			        GENERATESERIES (
			            0,
			            _RevenueTickCount,
			            1
			        ),
			
			        VAR _TickIndex =
			            [Value]
			
			        VAR _TickValue =
			            _TickIndex * _RevenueStep
			
			        VAR _X =
			            _Left
			                + _PlotWidth
			                    * DIVIDE (
			                        _TickValue,
			                        _RevenueMaximum,
			                        0
			                    )
			
			        RETURN
			            "<line x1='" & FORMAT ( _X, "0.0", "en-US" )
			                & "' y1='" & FORMAT ( _Top, "0" )
			                & "' x2='" & FORMAT ( _X, "0.0", "en-US" )
			                & "' y2='" & FORMAT ( _Bottom, "0" )
			                & "' stroke='#ECE8ED'
			                     stroke-width='1'/>"
			                &
			            "<text x='" & FORMAT ( _X, "0.0", "en-US" )
			                & "' y='" & FORMAT ( _Bottom + 24, "0" )
			                & "' text-anchor='middle'
			                     class='pp-axis'>"
			                & FORMAT (
			                    DIVIDE (
			                        _TickValue,
			                        1000000
			                    ),
			                    "€#,0m"
			                )
			                & "</text>",
			
			        ""
			    )
			
			
			-- Gross-margin grid
			VAR _MarginGrid =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 3, 1 ),
			
			        VAR _TickIndex =
			            [Value]
			
			        VAR _MarginValue =
			            _MarginMaximum
			                * DIVIDE (
			                    _TickIndex,
			                    3
			                )
			
			        VAR _Y =
			            _Bottom
			                - _PlotHeight
			                    * DIVIDE (
			                        _MarginValue,
			                        _MarginMaximum,
			                        0
			                    )
			
			        RETURN
			            "<line x1='" & FORMAT ( _Left, "0" )
			                & "' y1='" & FORMAT ( _Y, "0.0", "en-US" )
			                & "' x2='" & FORMAT ( _Right, "0" )
			                & "' y2='" & FORMAT ( _Y, "0.0", "en-US" )
			                & "' stroke='#ECE8ED'
			                     stroke-width='1'/>"
			                &
			            "<text x='" & FORMAT ( _Left - 14, "0" )
			                & "' y='" & FORMAT ( _Y + 4, "0.0", "en-US" )
			                & "' text-anchor='end'
			                     class='pp-axis'>"
			                & FORMAT (
			                    _MarginValue,
			                    "0%"
			                )
			                & "</text>",
			
			        ""
			    )
			
			
			-- Target-margin reference line
			VAR _TargetY =
			    _Bottom
			        - _PlotHeight
			            * DIVIDE (
			                _TargetMargin,
			                _MarginMaximum,
			                0
			            )
			
			
			VAR _TargetLine =
			    IF (
			        _TargetMargin <= _MarginMaximum,
			
			        "<line x1='" & FORMAT ( _Left, "0" )
			            & "' y1='" & FORMAT ( _TargetY, "0.0", "en-US" )
			            & "' x2='" & FORMAT ( _Right, "0" )
			            & "' y2='" & FORMAT ( _TargetY, "0.0", "en-US" )
			            & "' stroke='#F59E0B'
			                 stroke-width='2'
			                 stroke-dasharray='9 7'/>"
			            &
			        "<text x='" & FORMAT ( _Right - 4, "0" )
			            & "' y='" & FORMAT ( _TargetY - 8, "0.0", "en-US" )
			            & "' text-anchor='end'
			                 class='pp-target'>
			                Target ("
			            & FORMAT (
			                _TargetMargin,
			                "0%"
			            )
			            & ")
			         </text>",
			
			        ""
			    )
			
			
			-- Average-revenue reference line
			VAR _AverageRevenueX =
			    _Left
			        + _PlotWidth
			            * DIVIDE (
			                _AverageRevenue,
			                _RevenueMaximum,
			                0
			            )
			
			
			VAR _AverageRevenueLine =
			    "<line x1='" & FORMAT ( _AverageRevenueX, "0.0", "en-US" )
			        & "' y1='" & FORMAT ( _Top, "0" )
			        & "' x2='" & FORMAT ( _AverageRevenueX, "0.0", "en-US" )
			        & "' y2='" & FORMAT ( _Bottom, "0" )
			        & "' stroke='#BFC3C7'
			             stroke-width='1.5'
			             stroke-dasharray='8 7'/>"
			
			
			-- Bubbles and labels
			VAR _Bubbles =
			    CONCATENATEX (
			        _Points,
			
			        VAR _ProductFamily =
			            dimProduct[product_family]
			
			        VAR _RevenueValue =
			            [@RevenueValue]
			
			        VAR _GrossProfitValue =
			            [@GrossProfitValue]
			
			        VAR _GrossMarginValue =
			            [@GrossMarginValue]
			
			        VAR _LifecycleStage =
			            COALESCE (
			                [@LifecycleStage],
			                "Other"
			            )
			
			        VAR _LifecycleLower =
			            LOWER ( _LifecycleStage )
			
			        VAR _BubbleColor =
			            SWITCH (
			                TRUE (),
			                CONTAINSSTRING (
			                    _LifecycleLower,
			                    "growth"
			                ), "#19A66A",
			
			                CONTAINSSTRING (
			                    _LifecycleLower,
			                    "mature"
			                ), "#238CB8",
			
			                CONTAINSSTRING (
			                    _LifecycleLower,
			                    "declin"
			                ), "#F59E0B",
			
			                CONTAINSSTRING (
			                    _LifecycleLower,
			                    "new"
			                ), "#6F4A7C",
			
			                "#6F4A7C"
			            )
			
			        VAR _X =
			            [@X]
			
			        VAR _Y =
			            [@Y]
			
			        VAR _Radius =
			            [@Radius]
			
			        VAR _LabelOnLeft =
			            _X > _Right - 150
			
			        VAR _LabelX =
			            IF (
			                _LabelOnLeft,
			                _X - _Radius - 8,
			                _X + _Radius + 8
			            )
			
			        VAR _LabelAnchor =
			            IF (
			                _LabelOnLeft,
			                "end",
			                "start"
			            )
			
			        VAR _Tooltip =
			            _ProductFamily
			                & " | Revenue: "
			                & FORMAT (
			                    DIVIDE (
			                        _RevenueValue,
			                        1000000
			                    ),
			                    "€0.0m"
			                )
			                & " | Gross profit: "
			                & FORMAT (
			                    DIVIDE (
			                        _GrossProfitValue,
			                        1000000
			                    ),
			                    "€0.0m"
			                )
			                & " | Gross margin: "
			                & FORMAT (
			                    _GrossMarginValue,
			                    "0.0%"
			                )
			                & " | Lifecycle: "
			                & _LifecycleStage
			
			        RETURN
			            "<g>"
			                &
			            "<title>"
			                & _Tooltip
			                & "</title>"
			                &
			            "<circle cx='" & FORMAT ( _X, "0.0", "en-US" )
			                & "' cy='" & FORMAT ( _Y, "0.0", "en-US" )
			                & "' r='" & FORMAT ( _Radius, "0.0", "en-US" )
			                & "' fill='" & _BubbleColor
			                & "' fill-opacity='0.92'
			                     stroke='#FFFFFF'
			                     stroke-width='2'/>"
			                &
			            "<text x='" & FORMAT ( _LabelX, "0.0", "en-US" )
			                & "' y='" & FORMAT ( _Y + 5, "0.0", "en-US" )
			                & "' text-anchor='" & _LabelAnchor
			                & "' class='pp-label'>"
			                & _ProductFamily
			                & "</text>"
			                &
			            "</g>",
			
			        "",
			        [@GrossProfitValue],
			        DESC
			    )
			
			
			VAR _StatusText =
			    FORMAT (
			        _ProductFamilyCount,
			        "0"
			    )
			        & IF (
			            _ProductFamilyCount = 1,
			            " product family",
			            " product families"
			        )
			
			
			RETURN
			    IF (
			        NOT _HasData,
			
			        "<div style='
			            width:100%;
			            height:100%;
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            padding:14px;
			            background:#FFFFFF;
			            color:#C53D3D;
			            border:1px solid #E3DEE6;
			            border-radius:5px;
			            font:12px Segoe UI,Arial,sans-serif;
			        '>
			            No product profitability data was found.
			        </div>",
			
			        "
			        <style>
			            * {
			                box-sizing:border-box;
			            }
			
			            .pp-card {
			                width:100%;
			                height:100%;
			                min-height:180px;
			                padding:4px 5px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:5px;
			                font-family:'Segoe UI';
			            }
			
			            .pp-title-row {
			                display:flex;
			                align-items:center;
			                justify-content:space-between;
			                gap:8px;
			            }
			
			            .pp-title {
			                overflow:hidden;
			                color:#211D22;
			                font-size:15px;
			                font-weight:700;
			                text-transform:uppercase;
			                text-overflow:ellipsis;
			                white-space:nowrap;
			            }
			
			            .pp-status {
			                color:#6F6872;
			                font-size:12px;
			                white-space:nowrap;
			            }
			
			            .pp-legend {
			                display:flex;
			                align-items:center;
			                flex-wrap:wrap;
			                gap:13px;
			                margin-top:5px;
			                color:#4E4851;
			                font-size:10px;
			                font-weight:400;
			            }
			
			            .pp-legend-item {
			                display:flex;
			                align-items:center;
			                gap:5px;
			                white-space:nowrap;
			            }
			
			            .pp-dot {
			                width:10px;
			                height:13px;
			                border-radius:50%;
			            }
			
			            .pp-svg {
			                display:block;
			                width:100%;
			                height:calc(100% - 48px);
			                min-height:180px;
			            }
			
			            .pp-axis {
			                fill:#69636B;
			                font-family:'Segoe UI';
			                font-size:22px;
			            }
			
			            .pp-label {
			                fill:#302B31;
			                font-family:'Segoe UI';
			                font-size:24px;
			                font-weight:400;
			            }
			
			            .pp-axis-title {
			                fill:#4E4851;
			                font-family:'Segoe UI';
			                font-size:24px;
			                font-weight:400;
			            }
			
			            .pp-target {
			                fill:#F59E0B;
			                font-family:'Segoe UI';
			                font-size:26px;
			                font-weight:400;
			            }
			
			            .pp-note {
			                fill:#6F6872;
			                font-family:'Segoe UI';
			                font-size:12px;
			            }
			        </style>
			
			        <div class='pp-card'>
			
			            <div class='pp-title-row'>
			
			                <div class='pp-title'>
			                    Portfolio Profitability
			                </div>
			
			            </div>
			
			            <div class='pp-legend'>
			
			                <div class='pp-legend-item'>
			                    <span class='pp-dot'
			                          style='background:#6F4A7C'></span>
			                    <span>New</span>
			                </div>
			
			                <div class='pp-legend-item'>
			                    <span class='pp-dot'
			                          style='background:#19A66A'></span>
			                    <span>Growth</span>
			                </div>
			
			                <div class='pp-legend-item'>
			                    <span class='pp-dot'
			                          style='background:#238CB8'></span>
			                    <span>Mature</span>
			                </div>
			
			                <div class='pp-legend-item'>
			                    <span class='pp-dot'
			                          style='background:#F59E0B'></span>
			                    <span>Decline</span>
			                </div>
			
			            </div>
			
			            <svg class='pp-svg'
			                 viewBox='0 0 "
			                    & _ViewBoxWidth
			                    & " "
			                    & _ViewBoxHeight
			                    & "'
			                 preserveAspectRatio='xMidYMid meet'>
			
			                "
			                    & _RevenueGrid
			                    & _MarginGrid
			                    & _AverageRevenueLine
			                    & _TargetLine
			                    & _Bubbles
			                    &
			
			                "<line x1='" & FORMAT ( _Left, "0" )
			                    & "' y1='" & FORMAT ( _Bottom, "0" )
			                    & "' x2='" & FORMAT ( _Right, "0" )
			                    & "' y2='" & FORMAT ( _Bottom, "0" )
			                    & "' stroke='#BEB9C0'
			                         stroke-width='1.2'/>
			
			                 <line x1='" & FORMAT ( _Left, "0" )
			                    & "' y1='" & FORMAT ( _Top, "0" )
			                    & "' x2='" & FORMAT ( _Left, "0" )
			                    & "' y2='" & FORMAT ( _Bottom, "0" )
			                    & "' stroke='#BEB9C0'
			                         stroke-width='1.2'/>
			
			                 <text x='" & FORMAT ( DIVIDE ( _Left + _Right, 2 ), "0" )
			                    & "' y='454'
			                         text-anchor='middle'
			                         class='pp-axis-title'>
			                    Revenue (€m)
			                 </text>
			
			                 <text x='22'
			                       y='" & FORMAT ( DIVIDE ( _Top + _Bottom, 2 ), "0" )
			                    & "'
			                       text-anchor='middle'
			                       transform='rotate(-90 22 "
			                    & FORMAT ( DIVIDE ( _Top + _Bottom, 2 ), "0" )
			                    & ")'
			                       class='pp-axis-title'>
			                    Gross Margin (%)
			                 </text>
			
			            </svg>
			
			        </div>"
			    )
		displayFolder: 02 Margin
		lineageTag: ca1df0e0-f9b1-44cc-b1f5-d25c8aa688de

	measure 'GP Upside' = ```
			
			  VAR RevenueValue = [Revenue]
			  VAR CurrentMargin = [Gross Margin %]
			  VAR TargetMargin = [Gross Margin Target %]
			  RETURN
			      IF (
			          ISBLANK ( RevenueValue )
			              || ISBLANK ( CurrentMargin )
			              || ISBLANK ( TargetMargin )
			              || TargetMargin <= 0,
			          BLANK (),
			          RevenueValue
			              * DIVIDE ( TargetMargin - CurrentMargin, TargetMargin )
			      )
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: 02 Margin
		lineageTag: c9bc1c93-46c5-42c1-8de6-a6c5ce117565

		annotation PBI_FormatHint = {"currencyCulture":"en-DE"}

	measure 'Forecast Accuracy Country Product HTML' =
			
			-- Use the selected forecast version.
			-- If no single version is selected, use Latest Estimate.
			VAR _ForecastVersion =
			    COALESCE (
			        SELECTEDVALUE (
			            factForecast[forecast_version]
			        ),
			        "Latest Estimate"
			    )
			
			
			-- Countries with comparable actual and forecast data
			VAR _CountrySummary =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER (
			                ALLSELECTED ( dimRegion[country] ),
			                NOT ISBLANK ( dimRegion[country] )
			            ),
			
			            "@ForecastValue",
			                CALCULATE (
			                    [Revenue FC],
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			                    TREATAS (
			                        { _ForecastVersion },
			                        factForecast[forecast_version]
			                    )
			                ),
			
			            "@AccuracyValue",
			                CALCULATE (
			                    [Revenue FC Accuracy %],
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			                    TREATAS (
			                        { _ForecastVersion },
			                        factForecast[forecast_version]
			                    )
			                )
			        ),
			        NOT ISBLANK ( [@AccuracyValue] )
			    )
			
			
			-- Product families with comparable actual and forecast data
			VAR _ProductSummary =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER (
			                ALLSELECTED ( dimProduct[product_family] ),
			                NOT ISBLANK ( dimProduct[product_family] )
			            ),
			
			            "@ForecastValue",
			                CALCULATE (
			                    [Revenue FC],
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			                    TREATAS (
			                        { _ForecastVersion },
			                        factForecast[forecast_version]
			                    )
			                ),
			
			            "@AccuracyValue",
			                CALCULATE (
			                    [Revenue FC Accuracy %],
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			                    TREATAS (
			                        { _ForecastVersion },
			                        factForecast[forecast_version]
			                    )
			                )
			        ),
			        NOT ISBLANK ( [@AccuracyValue] )
			    )
			
			
			-- Display the ten most relevant countries
			VAR _Countries =
			    TOPN (
			        10,
			        _CountrySummary,
			        [@ForecastValue], DESC,
			        dimRegion[country], ASC
			    )
			
			
			-- Display up to eight product families
			VAR _Products =
			    TOPN (
			        8,
			        _ProductSummary,
			        [@ForecastValue], DESC,
			        dimProduct[product_family], ASC
			    )
			
			
			VAR _CountryCount =
			    COUNTROWS ( _Countries )
			
			VAR _ProductCount =
			    COUNTROWS ( _Products )
			
			VAR _HasData =
			    _CountryCount > 0
			        && _ProductCount > 0
			
			
			-- Deterministic country row index
			VAR _IndexedCountries =
			    ADDCOLUMNS (
			        _Countries,
			
			        "@RowIndex",
			            VAR _CurrentForecast =
			                [@ForecastValue]
			
			            VAR _CurrentCountry =
			                dimRegion[country]
			
			            RETURN
			                COUNTROWS (
			                    FILTER (
			                        _Countries,
			                        [@ForecastValue] > _CurrentForecast
			                            || (
			                                [@ForecastValue] = _CurrentForecast
			                                    && dimRegion[country]
			                                        < _CurrentCountry
			                            )
			                    )
			                )
			    )
			
			
			-- Deterministic product-family column index
			VAR _IndexedProducts =
			    ADDCOLUMNS (
			        _Products,
			
			        "@ColumnIndex",
			            VAR _CurrentForecast =
			                [@ForecastValue]
			
			            VAR _CurrentProduct =
			                dimProduct[product_family]
			
			            RETURN
			                COUNTROWS (
			                    FILTER (
			                        _Products,
			                        [@ForecastValue] > _CurrentForecast
			                            || (
			                                [@ForecastValue] = _CurrentForecast
			                                    && dimProduct[product_family]
			                                        < _CurrentProduct
			                            )
			                    )
			                )
			    )
			
			
			-- Create all country/product combinations
			VAR _CellBase =
			    CROSSJOIN (
			        SELECTCOLUMNS (
			            _IndexedCountries,
			            "@Country",
			                dimRegion[country],
			            "@RowIndex",
			                [@RowIndex]
			        ),
			        SELECTCOLUMNS (
			            _IndexedProducts,
			            "@ProductFamily",
			                dimProduct[product_family],
			            "@ColumnIndex",
			                [@ColumnIndex]
			        )
			    )
			
			
			-- Calculate actual, forecast and accuracy for every cell
			VAR _CellData =
			    ADDCOLUMNS (
			        _CellBase,
			
			        "@ActualRevenue",
			            VAR _Country =
			                [@Country]
			
			            VAR _Product =
			                [@ProductFamily]
			
			            RETURN
			                CALCULATE (
			                    [Revenue],
			                    REMOVEFILTERS (
			                        dimRegion[country]
			                    ),
			                    REMOVEFILTERS (
			                        dimProduct[product_family]
			                    ),
			                    TREATAS (
			                        { _Country },
			                        dimRegion[country]
			                    ),
			                    TREATAS (
			                        { _Product },
			                        dimProduct[product_family]
			                    )
			                ),
			
			        "@ForecastRevenue",
			            VAR _Country =
			                [@Country]
			
			            VAR _Product =
			                [@ProductFamily]
			
			            RETURN
			                CALCULATE (
			                    [Revenue FC],
			                    REMOVEFILTERS (
			                        dimRegion[country]
			                    ),
			                    REMOVEFILTERS (
			                        dimProduct[product_family]
			                    ),
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			                    TREATAS (
			                        { _Country },
			                        dimRegion[country]
			                    ),
			                    TREATAS (
			                        { _Product },
			                        dimProduct[product_family]
			                    ),
			                    TREATAS (
			                        { _ForecastVersion },
			                        factForecast[forecast_version]
			                    )
			                ),
			
			        "@Accuracy",
			            VAR _Country =
			                [@Country]
			
			            VAR _Product =
			                [@ProductFamily]
			
			            RETURN
			                CALCULATE (
			                    [Revenue FC Accuracy %],
			                    REMOVEFILTERS (
			                        dimRegion[country]
			                    ),
			                    REMOVEFILTERS (
			                        dimProduct[product_family]
			                    ),
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			                    TREATAS (
			                        { _Country },
			                        dimRegion[country]
			                    ),
			                    TREATAS (
			                        { _Product },
			                        dimProduct[product_family]
			                    ),
			                    TREATAS (
			                        { _ForecastVersion },
			                        factForecast[forecast_version]
			                    )
			                )
			    )
			
			
			-- Responsive SVG geometry
			VAR _ViewBoxWidth = 1100
			VAR _ViewBoxHeight = 520
			
			VAR _Left = 180
			VAR _Right = 1070
			
			VAR _GridTop = 105
			VAR _GridHeight = 330
			VAR _GridWidth = _Right - _Left
			
			VAR _ColumnWidth =
			    DIVIDE (
			        _GridWidth,
			        _ProductCount,
			        0
			    )
			
			VAR _RowHeight =
			    DIVIDE (
			        _GridHeight,
			        _CountryCount,
			        0
			    )
			
			
			-- Product-family headers
			VAR _ProductHeaders =
			    CONCATENATEX (
			        _IndexedProducts,
			
			        VAR _X =
			            _Left
			                + (
			                    [@ColumnIndex] + 0.5
			                ) * _ColumnWidth
			
			        RETURN
			            "<text x='" & FORMAT ( _X, "0.0", "en-US" )
			                & "' y='85'
			                     text-anchor='middle'
			                     class='fac-product'>"
			                & dimProduct[product_family]
			                & "</text>",
			
			        "",
			        [@ColumnIndex],
			        ASC
			    )
			
			
			-- Country labels
			VAR _CountryLabels =
			    CONCATENATEX (
			        _IndexedCountries,
			
			        VAR _Y =
			            _GridTop
			                + (
			                    [@RowIndex] + 0.5
			                ) * _RowHeight
			                + 5
			
			        RETURN
			            "<text x='" & FORMAT ( _Left - 13, "0" )
			                & "' y='" & FORMAT ( _Y, "0.0", "en-US" )
			                & "' text-anchor='end'
			                     class='fac-country'>"
			                & dimRegion[country]
			                & "</text>",
			
			        "",
			        [@RowIndex],
			        ASC
			    )
			
			
			-- Heatmap cells
			VAR _Cells =
			    CONCATENATEX (
			        _CellData,
			
			        VAR _Accuracy =
			            [@Accuracy]
			
			        VAR _ActualRevenue =
			            [@ActualRevenue]
			
			        VAR _ForecastRevenue =
			            [@ForecastRevenue]
			
			        VAR _X =
			            _Left
			                + [@ColumnIndex] * _ColumnWidth
			
			        VAR _Y =
			            _GridTop
			                + [@RowIndex] * _RowHeight
			
			        -- Forecast-accuracy thresholds:
			        -- Green  = at least 97.5%
			        -- Amber  = 95.0% to 97.5%
			        -- Red    = below 95.0%
			        VAR _FillColor =
			            SWITCH (
			                TRUE (),
			                ISBLANK ( _Accuracy ), "#F1F0F2",
			                _Accuracy >= 0.995, "#1FAD4E",
			                _Accuracy >= 0.975, "#3DBA5E",
			                _Accuracy >= 0.950, "#F2A512",
			                "#E34430"
			            )
			
			        VAR _TextColor =
			            SWITCH (
			                TRUE (),
			                ISBLANK ( _Accuracy ), "#928C94",
			                _Accuracy >= 0.975, "#FFFFFF",
			                _Accuracy >= 0.950, "#3E3422",
			                "#FFFFFF"
			            )
			
			        VAR _AccuracyLabel =
			            IF (
			                ISBLANK ( _Accuracy ),
			                "–",
			                FORMAT (
			                    _Accuracy,
			                    "0.0%"
			                )
			            )
			
			        VAR _ActualLabel =
			            IF (
			                ISBLANK ( _ActualRevenue ),
			                "n/a",
			                FORMAT (
			                    DIVIDE (
			                        _ActualRevenue,
			                        1000000
			                    ),
			                    "€0.0m"
			                )
			            )
			
			        VAR _ForecastLabel =
			            IF (
			                ISBLANK ( _ForecastRevenue ),
			                "n/a",
			                FORMAT (
			                    DIVIDE (
			                        _ForecastRevenue,
			                        1000000
			                    ),
			                    "€0.0m"
			                )
			            )
			
			        VAR _Tooltip =
			            [@Country]
			                & " | "
			                & [@ProductFamily]
			                & " | Accuracy: "
			                & _AccuracyLabel
			                & " | Actual: "
			                & _ActualLabel
			                & " | Forecast: "
			                & _ForecastLabel
			
			        RETURN
			            "<g>"
			                &
			            "<title>"
			                & _Tooltip
			                & "</title>"
			                &
			            "<rect x='" & FORMAT ( _X + 1, "0.0", "en-US" )
			                & "' y='" & FORMAT ( _Y + 1, "0.0", "en-US" )
			                & "' width='" & FORMAT ( MAX ( 1, _ColumnWidth - 2 ), "0.0", "en-US" )
			                & "' height='" & FORMAT ( MAX ( 1, _RowHeight - 2 ), "0.0", "en-US" )
			                & "' rx='2'
			                     fill='" & _FillColor & "'/>"
			                &
			            "<text x='" & FORMAT ( _X + DIVIDE ( _ColumnWidth, 2 ), "0.0", "en-US" )
			                & "' y='" & FORMAT ( _Y + DIVIDE ( _RowHeight, 2 ) + 5, "0.0", "en-US" )
			                & "' text-anchor='middle'
			                     fill='" & _TextColor
			                & "' class='fac-value'>"
			                & _AccuracyLabel
			                & "</text>"
			                &
			            "</g>",
			
			        "",
			        [@RowIndex] * 100 + [@ColumnIndex],
			        ASC
			    )
			
			
			VAR _StatusText =
			    _ForecastVersion
			        & " · "
			        & FORMAT ( _CountryCount, "0" )
			        & " countries"
			
			
			RETURN
			    IF (
			        NOT _HasData,
			
			        "<div style='
			            width:100%;
			            height:100%;
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            padding:14px;
			            background:#FFFFFF;
			            color:#C53D3D;
			            border:1px solid #E3DEE6;
			            border-radius:5px;
			            font:12px Segoe UI,Arial,sans-serif;
			            text-align:center;
			        '>
			            No comparable actual and forecast data was found.
			        </div>",
			
			        "
			        <style>
			            html,
			            body {
			                width:100%;
			                height:100%;
			                margin:0;
			            }
			
			            * {
			                box-sizing:border-box;
			            }
			
			            .fac-card {
			                width:100%;
			                height:100%;
			                min-height:160px;
			                padding:6px 12px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:5px;
			                font-family:'Segoe UI';
			            }
			
			            .fac-title-row {
			                display:flex;
			                align-items:center;
			                justify-content:space-between;
			                gap:8px;
			            }
			
			            .fac-title {
			                overflow:hidden;
			                color:#211D22;
			                font-size:11px;
			                font-weight:700;
			                text-transform:uppercase;
			                text-overflow:ellipsis;
			                white-space:nowrap;
			            }
			
			            .fac-status {
			                overflow:hidden;
			                color:#6F6872;
			                font-size:10px;
			                text-overflow:ellipsis;
			                white-space:nowrap;
			            }
			
			            .fac-svg {
			                display:block;
			                width:100%;
			                height:calc(100% - 22px);
			                min-height:130px;
			            }
			
			            .fac-product {
			                fill:#302B31;
			                font-family:'Segoe UI';
			                font-size:12px;
			                font-weight:700;
			            }
			
			            .fac-country {
			                fill:#302B31;
			                font-family:'Segoe UI';
			                font-size:13px;
			                font-weight:600;
			            }
			
			            .fac-value {
			                font-family:'Segoe UI';
			                font-size:15px;
			                font-weight:700;
			            }
			
			            .fac-legend {
			                fill:#625C64;
			                font-family:'Segoe UI';
			                font-size:11px;
			            }
			
			            .fac-legend-title {
			                fill:#4E4851;
			                font-family:'Segoe UI';
			                font-size:11px;
			                font-weight:600;
			            }
			        </style>
			
			        <div class='fac-card'>
			
			            <div class='fac-title-row'>
			
			                <div class='fac-title'>
			                    Forecast Accuracy by Country &amp; Product
			                </div>
			
			                <div class='fac-status'>"
			                    & _StatusText &
			                "</div>
			
			            </div>
			
			            <svg class='fac-svg'
			                 viewBox='0 0 "
			                    & _ViewBoxWidth
			                    & " "
			                    & _ViewBoxHeight
			                    & "'
			                 preserveAspectRatio='xMidYMid meet'
			                 role='img'
			                 aria-label='Forecast accuracy by country and product family'>
			
			                <text x='15'
			                      y='85'
			                      class='fac-country'
			                      font-weight='700'>
			                    Country
			                </text>"
			
			                & _ProductHeaders
			                & _CountryLabels
			                & _Cells
			
			                & "<g transform='translate(290 466)'>
			
			                    <text x='0'
			                          y='13'
			                          class='fac-legend-title'>
			                        Accuracy
			                    </text>
			
			                    <rect x='76'
			                          y='0'
			                          width='17'
			                          height='17'
			                          rx='3'
			                          fill='#3DBA5E'/>
			
			                    <text x='101'
			                          y='13'
			                          class='fac-legend'>
			                        ≥ 97.5%
			                    </text>
			
			                    <rect x='190'
			                          y='0'
			                          width='17'
			                          height='17'
			                          rx='3'
			                          fill='#F2A512'/>
			
			                    <text x='215'
			                          y='13'
			                          class='fac-legend'>
			                        95.0%–97.4%
			                    </text>
			
			                    <rect x='345'
			                          y='0'
			                          width='17'
			                          height='17'
			                          rx='3'
			                          fill='#E34430'/>
			
			                    <text x='370'
			                          y='13'
			                          class='fac-legend'>
			                        &lt; 95.0%
			                    </text>
			
			                    <rect x='460'
			                          y='0'
			                          width='17'
			                          height='17'
			                          rx='3'
			                          fill='#F1F0F2'/>
			
			                    <text x='485'
			                          y='13'
			                          class='fac-legend'>
			                        No data
			                    </text>
			
			                </g>
			
			            </svg>
			
			        </div>"
			    )
		displayFolder: 03 Forecasting
		lineageTag: fab83e6e-3e5f-45ca-82c6-285ca26fc2d2

	measure 'Title Product Risk Detail 2' = "PRODUCT RISK DETAIL - " & SELECTEDVALUE(dimProduct[product_name])
		displayFolder: 01 Risk
		lineageTag: f1c6e802-e5ff-4780-a09a-6d699241682b

	measure 'ASP vs Unit Cost HTML' =
			
			-- ============================================================
			-- SELECTED YTD PERIOD
			-- ============================================================
			
			-- The latest selected month becomes the YTD cutoff
			VAR _SelectedEndMonth =
			    MAXX (
			        ALLSELECTED ( dimDate[MonthStartDate] ),
			        dimDate[MonthStartDate]
			    )
			
			
			-- Last available month, removing only the MonthStartDate filter
			VAR _LastActualMonth =
			    CALCULATE (
			        MAX ( dimDate[Date]),
			        REMOVEFILTERS ( dimDate[MonthStartDate] )
			    )
			
			
			-- Do not move beyond the last available actual month
			VAR _EffectiveEndMonth =
			    IF (
			        ISBLANK ( _LastActualMonth ),
			        BLANK (),
			        MIN (
			            COALESCE (
			                _SelectedEndMonth,
			                _LastActualMonth
			            ),
			            _LastActualMonth
			        )
			    )
			
			
			VAR _SelectedYear =
			    YEAR (
			        COALESCE (
			            _EffectiveEndMonth,
			            TODAY ()
			        )
			    )
			
			
			VAR _YearStart =
			    DATE (
			        _SelectedYear,
			        1,
			        1
			    )
			
			
			-- Number of months from January through selected month
			VAR _MonthCount =
			    IF (
			        ISBLANK ( _EffectiveEndMonth ),
			        0,
			        DATEDIFF (
			            _YearStart,
			            _EffectiveEndMonth,
			            MONTH
			        ) + 1
			    )
			
			
			-- January through selected month only
			VAR _Months =
			    SELECTCOLUMNS (
			        GENERATESERIES (
			            0,
			            MAX ( 0, _MonthCount - 1 ),
			            1
			        ),
			        "@MonthNumber", [Value] + 1,
			        "@MonthDate",
			            EDATE (
			                _YearStart,
			                [Value]
			            )
			    )
			
			
			-- ============================================================
			-- MONTHLY ASP AND UNIT COST
			-- ============================================================
			
			VAR _ChartData =
			    ADDCOLUMNS (
			        _Months,
			
			        "@ASP",
			            VAR _Month =
			                [@MonthDate]
			
			            RETURN
			                CALCULATE (
			                    [ASP],
			
			                    -- Replace only the selected month filter
			                    -- with the month currently being plotted
			                    REMOVEFILTERS (
			                        dimDate[MonthStartDate]
			                    ),
			
			                    TREATAS (
			                        { _Month },
			                        dimDate[MonthStartDate]
			                    )
			                ),
			
			        "@UnitCost",
			            VAR _Month =
			                [@MonthDate]
			
			            RETURN
			                CALCULATE (
			                    [Unit Cost],
			
			                    -- Replace only the selected month filter
			                    -- with the month currently being plotted
			                    REMOVEFILTERS (
			                        dimDate[MonthStartDate]
			                    ),
			
			                    TREATAS (
			                        { _Month },
			                        dimDate[MonthStartDate]
			                    )
			                )
			    )
			
			
			VAR _ValidData =
			    FILTER (
			        _ChartData,
			        [@MonthDate] <= _EffectiveEndMonth
			            && NOT ISBLANK ( [@ASP] )
			            && NOT ISBLANK ( [@UnitCost] )
			    )
			
			
			VAR _ValueCount =
			    COUNTROWS ( _ValidData )
			
			
			-- ============================================================
			-- DYNAMIC Y-AXIS SCALE
			-- ============================================================
			
			VAR _AllValues =
			    UNION (
			        SELECTCOLUMNS (
			            _ValidData,
			            "@Value", [@ASP]
			        ),
			        SELECTCOLUMNS (
			            _ValidData,
			            "@Value", [@UnitCost]
			        )
			    )
			
			
			VAR _RawMinimum =
			    MINX (
			        _AllValues,
			        [@Value]
			    )
			
			
			VAR _RawMaximum =
			    MAXX (
			        _AllValues,
			        [@Value]
			    )
			
			
			VAR _RawRange =
			    MAX (
			        1,
			        _RawMaximum - _RawMinimum
			    )
			
			
			VAR _AxisPadding =
			    MAX (
			        _RawRange * 0.22,
			        _RawMaximum * 0.035
			    )
			
			
			VAR _YMinimum =
			    MAX (
			        0,
			        _RawMinimum - _AxisPadding
			    )
			
			
			VAR _YMaximum =
			    _RawMaximum + _AxisPadding
			
			
			VAR _YAxisRange =
			    MAX (
			        1,
			        _YMaximum - _YMinimum
			    )
			
			
			-- ============================================================
			-- SVG GEOMETRY
			-- ============================================================
			
			VAR _ViewBoxWidth =
			    720
			
			VAR _ViewBoxHeight =
			    280
			
			VAR _Left =
			    60
			
			VAR _Right =
			    650
			
			VAR _Top =
			    38
			
			VAR _PlotHeight =
			    195
			
			VAR _PlotWidth =
			    _Right - _Left
			
			
			-- Dynamic spacing based on displayed YTD months
			VAR _Step =
			    DIVIDE (
			        _PlotWidth,
			        MAX ( 1, _ValueCount )
			    )
			
			
			VAR _Baseline =
			    _Top + _PlotHeight
			
			VAR _MonthLabelY =
			    272
			
			
			-- ============================================================
			-- SVG COORDINATES
			-- ============================================================
			
			VAR _Points =
			    ADDCOLUMNS (
			        _ValidData,
			
			        "@X",
			            _Left
			                + (
			                    RANKX (
			                        _ValidData,
			                        [@MonthDate],
			                        ,
			                        ASC,
			                        DENSE
			                    ) - 0.5
			                ) * _Step,
			
			        "@ASPY",
			            _Baseline
			                - _PlotHeight
			                    * DIVIDE (
			                        [@ASP] - _YMinimum,
			                        _YAxisRange,
			                        0
			                    ),
			
			        "@UnitCostY",
			            _Baseline
			                - _PlotHeight
			                    * DIVIDE (
			                        [@UnitCost] - _YMinimum,
			                        _YAxisRange,
			                        0
			                    )
			    )
			
			
			-- ============================================================
			-- GRID AND Y-AXIS
			-- ============================================================
			
			VAR _GridLines =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 3, 1 ),
			
			        VAR _GridIndex =
			            [Value]
			
			        VAR _GridY =
			            _Top
			                + _PlotHeight
			                    * DIVIDE (
			                        _GridIndex,
			                        3
			                    )
			
			        VAR _GridValue =
			            _YMaximum
			                - _YAxisRange
			                    * DIVIDE (
			                        _GridIndex,
			                        3
			                    )
			
			        RETURN
			            "<line
			                x1='" & FORMAT ( _Left, "0", "en-US" ) & "'
			                y1='" & FORMAT ( _GridY, "0.0", "en-US" ) & "'
			                x2='" & FORMAT ( _Right, "0", "en-US" ) & "'
			                y2='" & FORMAT ( _GridY, "0.0", "en-US" ) & "'
			                stroke='#E7E3E8'
			                stroke-width='1'
			                vector-effect='non-scaling-stroke'
			            />"
			
			            &
			
			            "<text
			                x='" & FORMAT ( _Left - 13, "0", "en-US" ) & "'
			                y='" & FORMAT ( _GridY + 5, "0.0", "en-US" ) & "'
			                text-anchor='end'
			                class='auc-axis'
			            >"
			                & FORMAT ( _GridValue, "0", "en-US" )
			                & " €"
			            & "</text>",
			
			        ""
			    )
			
			
			-- ============================================================
			-- LINE AND AREA POINTS
			-- ============================================================
			
			VAR _ASPPoints =
			    CONCATENATEX (
			        _Points,
			        FORMAT ( [@X], "0.0", "en-US" )
			            & ","
			            & FORMAT ( [@ASPY], "0.0", "en-US" ),
			        " ",
			        [@MonthDate],
			        ASC
			    )
			
			
			VAR _UnitCostPoints =
			    CONCATENATEX (
			        _Points,
			        FORMAT ( [@X], "0.0", "en-US" )
			            & ","
			            & FORMAT ( [@UnitCostY], "0.0", "en-US" ),
			        " ",
			        [@MonthDate],
			        ASC
			    )
			
			
			VAR _UnitCostPointsReverse =
			    CONCATENATEX (
			        _Points,
			        FORMAT ( [@X], "0.0", "en-US" )
			            & ","
			            & FORMAT ( [@UnitCostY], "0.0", "en-US" ),
			        " ",
			        [@MonthDate],
			        DESC
			    )
			
			
			VAR _SpreadAreaPoints =
			    _ASPPoints
			        & " "
			        & _UnitCostPointsReverse
			
			
			VAR _SpreadArea =
			    IF (
			        _ValueCount >= 2,
			
			        "<polygon
			            points='" & _SpreadAreaPoints & "'
			            fill='#C5DDE2'
			            fill-opacity='0.58'
			            stroke='none'
			        />",
			
			        ""
			    )
			
			
			-- ============================================================
			-- ASP MARKERS AND VALUES
			-- ============================================================
			
			VAR _ASPMarkers =
			    CONCATENATEX (
			        _Points,
			
			        "<g>
			            <circle
			                cx='" & FORMAT ( [@X], "0.0", "en-US" ) & "'
			                cy='" & FORMAT ( [@ASPY], "0.0", "en-US" ) & "'
			                r='4.5'
			                fill='#138F96'
			                stroke='#FFFFFF'
			                stroke-width='1.5'
			                vector-effect='non-scaling-stroke'
			            >
			                <title>"
			                    & FORMAT (
			                        [@MonthDate],
			                        "MMM yyyy",
			                        "en-US"
			                    )
			                    & " ASP: "
			                    & FORMAT (
			                        [@ASP],
			                        "0.0",
			                        "en-US"
			                    )
			                    & " €"
			                & "</title>
			            </circle>
			
			            <text
			                x='" & FORMAT ( [@X], "0.0", "en-US" ) & "'
			                y='" & FORMAT ( [@ASPY] - 14, "0.0", "en-US" ) & "'
			                text-anchor='middle'
			                class='auc-asp-label'
			            >"
			                & FORMAT ( [@ASP], "0", "en-US" )
			                & " €"
			            & "</text>
			        </g>",
			
			        "",
			        [@MonthDate],
			        ASC
			    )
			
			
			-- ============================================================
			-- UNIT-COST MARKERS AND VALUES
			-- ============================================================
			
			VAR _UnitCostMarkers =
			    CONCATENATEX (
			        _Points,
			
			        "<g>
			            <circle
			                cx='" & FORMAT ( [@X], "0.0", "en-US" ) & "'
			                cy='" & FORMAT ( [@UnitCostY], "0.0", "en-US" ) & "'
			                r='4.5'
			                fill='#642B73'
			                stroke='#FFFFFF'
			                stroke-width='1.5'
			                vector-effect='non-scaling-stroke'
			            >
			                <title>"
			                    & FORMAT (
			                        [@MonthDate],
			                        "MMM yyyy",
			                        "en-US"
			                    )
			                    & " unit cost: "
			                    & FORMAT (
			                        [@UnitCost],
			                        "0.0",
			                        "en-US"
			                    )
			                    & " €"
			                & "</title>
			            </circle>
			
			            <text
			                x='" & FORMAT ( [@X], "0.0", "en-US" ) & "'
			                y='" & FORMAT ( [@UnitCostY] + 23, "0.0", "en-US" ) & "'
			                text-anchor='middle'
			                class='auc-cost-label'
			            >"
			                & FORMAT ( [@UnitCost], "0", "en-US" )
			                & " €"
			            & "</text>
			        </g>",
			
			        "",
			        [@MonthDate],
			        ASC
			    )
			
			
			-- ============================================================
			-- MONTH LABELS
			-- ============================================================
			
			VAR _MonthLabels =
			    CONCATENATEX (
			        _Points,
			
			        "<text
			            x='" & FORMAT ( [@X], "0.0", "en-US" ) & "'
			            y='" & FORMAT ( _MonthLabelY, "0", "en-US" ) & "'
			            text-anchor='middle'
			            class='auc-month'
			        >"
			            & FORMAT (
			                [@MonthDate],
			                "MMM",
			                "en-US"
			            )
			        & "</text>",
			
			        "",
			        [@MonthDate],
			        ASC
			    )
			
			
			-- ============================================================
			-- CURRENT SPREAD BRACKET
			-- ============================================================
			
			VAR _LastPoint =
			    TOPN (
			        1,
			        _Points,
			        [@MonthDate], DESC
			    )
			
			
			VAR _LastASP =
			    MAXX (
			        _LastPoint,
			        [@ASP]
			    )
			
			
			VAR _LastUnitCost =
			    MAXX (
			        _LastPoint,
			        [@UnitCost]
			    )
			
			
			VAR _LastASPY =
			    MAXX (
			        _LastPoint,
			        [@ASPY]
			    )
			
			
			VAR _LastUnitCostY =
			    MAXX (
			        _LastPoint,
			        [@UnitCostY]
			    )
			
			
			VAR _Spread =
			    _LastASP - _LastUnitCost
			
			
			VAR _BracketX =
			    _Right + 31
			
			
			VAR _BracketMiddleY =
			    DIVIDE (
			        _LastASPY + _LastUnitCostY,
			        2
			    )
			
			
			VAR _SpreadBracket =
			    IF (
			        NOT ISBLANK ( _Spread ),
			
			        "<g>
			            <line
			                x1='" & FORMAT ( _BracketX, "0", "en-US" ) & "'
			                y1='" & FORMAT ( _LastASPY, "0.0", "en-US" ) & "'
			                x2='" & FORMAT ( _BracketX, "0", "en-US" ) & "'
			                y2='" & FORMAT ( _LastUnitCostY, "0.0", "en-US" ) & "'
			                stroke='#138F96'
			                stroke-width='2.5'
			                vector-effect='non-scaling-stroke'
			            />
			
			            <line
			                x1='" & FORMAT ( _BracketX - 11, "0", "en-US" ) & "'
			                y1='" & FORMAT ( _LastASPY, "0.0", "en-US" ) & "'
			                x2='" & FORMAT ( _BracketX, "0", "en-US" ) & "'
			                y2='" & FORMAT ( _LastASPY, "0.0", "en-US" ) & "'
			                stroke='#138F96'
			                stroke-width='2.5'
			                vector-effect='non-scaling-stroke'
			            />
			
			            <line
			                x1='" & FORMAT ( _BracketX - 11, "0", "en-US" ) & "'
			                y1='" & FORMAT ( _LastUnitCostY, "0.0", "en-US" ) & "'
			                x2='" & FORMAT ( _BracketX, "0", "en-US" ) & "'
			                y2='" & FORMAT ( _LastUnitCostY, "0.0", "en-US" ) & "'
			                stroke='#138F96'
			                stroke-width='2.5'
			                vector-effect='non-scaling-stroke'
			            />
			
			            <text
			                x='" & FORMAT ( _BracketX + 12, "0", "en-US" ) & "'
			                y='" & FORMAT ( _BracketMiddleY + 6, "0.0", "en-US" ) & "'
			                class='auc-spread-label'
			            >"
			                & FORMAT ( _Spread, "0", "en-US" )
			                & " €"
			            & "</text>
			        </g>",
			
			        ""
			    )
			
			
			-- ============================================================
			-- PERIOD LABEL
			-- ============================================================
			
			VAR _PeriodText =
			    "Jan "
			        & FORMAT (
			            _EffectiveEndMonth,
			            "yyyy",
			            "en-US"
			        )
			        & " – "
			        & FORMAT (
			            _EffectiveEndMonth,
			            "MMM yyyy",
			            "en-US"
			        )
			
			
			-- ============================================================
			-- OUTPUT
			-- ============================================================
			
			RETURN
			    IF (
			        ISBLANK ( _EffectiveEndMonth )
			            || _ValueCount = 0,
			
			        "
			        <div style='
			            width:100%;
			            height:100vh;
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            padding:12px;
			            color:#C53D3D;
			            background:#FFFFFF;
			            font-family:Segoe UI,Arial,sans-serif;
			            font-size:13px;
			        '>
			            No ASP or unit-cost values were found for the selected YTD period.
			        </div>
			        ",
			
			        "
			        <style>
			            * {
			                box-sizing:border-box;
			            }
			
			            html,
			            body {
			                width:100%;
			                height:100%;
			                margin:0;
			                padding:0;
			                overflow:hidden;
			            }
			
			            .auc-card {
			                width:100%;
			                height:100vh;
			                min-width:0;
			                min-height:0;
			                display:flex;
			                flex-direction:column;
			                padding:5px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:5px;
			                font-family:'Segoe UI',Arial,sans-serif;
			            }
			
			            .auc-title-row {
			                flex:0 0 auto;
			                width:100%;
			                display:flex;
			                align-items:center;
			                justify-content:space-between;
			                gap:10px;
			                min-width:0;
			            }
			
			            .auc-title {
			                flex:0 1 auto;
			                min-width:0;
			                overflow:hidden;
			                color:#211D22;
			                font-size:15px;
			                font-weight:700;
			                text-overflow:ellipsis;
			                white-space:nowrap;
			                text-transform:uppercase;
			            }
			
			            .auc-header-right {
			                flex:0 0 auto;
			                display:flex;
			                align-items:center;
			                justify-content:flex-end;
			                gap:12px;
			                margin-left:auto;
			                min-width:0;
			            }
			
			            .auc-period {
			                color:#777079;
			                font-size:9px;
			                font-weight:500;
			                white-space:nowrap;
			            }
			
			            .auc-legend {
			                display:flex;
			                align-items:center;
			                justify-content:flex-end;
			                flex-wrap:nowrap;
			                gap:10px;
			                color:#4E4851;
			                font-size:9px;
			                line-height:1;
			                white-space:nowrap;
			            }
			
			            .auc-legend-item {
			                display:flex;
			                align-items:center;
			                gap:4px;
			                white-space:nowrap;
			            }
			
			            .auc-line-key {
			                flex:0 0 auto;
			                width:15px;
			                height:0;
			            }
			
			            .auc-asp-key {
			                border-top:3px solid #138F96;
			            }
			
			            .auc-cost-key {
			                border-top:3px solid #642B73;
			            }
			
			            .auc-area-key {
			                flex:0 0 auto;
			                width:13px;
			                height:9px;
			                background:#C5DDE2;
			                border-radius:1px;
			            }
			
			            .auc-chart {
			                flex:1 1 auto;
			                width:100%;
			                min-width:0;
			                min-height:0;
			                display:flex;
			                overflow:hidden;
			            }
			
			            .auc-svg {
			                display:block;
			                width:100%;
			                height:100%;
			                min-width:0;
			                min-height:0;
			            }
			
			            .auc-axis {
			                fill:#4F4951;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:12px;
			                font-weight:400;
			            }
			
			            .auc-month {
			                fill:#413C42;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:12px;
			                font-weight:400;
			            }
			
			            .auc-asp-label {
			                fill:#087B82;
			                stroke:#FFFFFF;
			                stroke-width:2.5px;
			                stroke-linejoin:round;
			                paint-order:stroke fill;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:12px;
			                font-weight:400;
			            }
			
			            .auc-cost-label {
			                fill:#542064;
			                stroke:#FFFFFF;
			                stroke-width:2.5px;
			                stroke-linejoin:round;
			                paint-order:stroke fill;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:12px;
			                font-weight:400;
			            }
			
			            .auc-spread-label {
			                fill:#087B82;
			                stroke:#FFFFFF;
			                stroke-width:3px;
			                stroke-linejoin:round;
			                paint-order:stroke fill;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:16px;
			                font-weight:650;
			            }
			
			            .auc-spread-short {
			                display:none;
			            }
			
			            @media (max-width:620px) {
			                .auc-title-row {
			                    gap:6px;
			                }
			
			                .auc-title {
			                    font-size:13px;
			                }
			
			                .auc-header-right {
			                    gap:6px;
			                }
			
			                .auc-period {
			                    font-size:8px;
			                }
			
			                .auc-legend {
			                    gap:6px;
			                    font-size:8px;
			                }
			
			                .auc-line-key {
			                    width:12px;
			                }
			
			                .auc-area-key {
			                    width:10px;
			                    height:7px;
			                }
			            }
			
			            @media (max-width:480px) {
			                .auc-period {
			                    display:none;
			                }
			
			                .auc-spread-description {
			                    display:none;
			                }
			
			                .auc-spread-short {
			                    display:inline;
			                }
			            }
			        </style>
			
			        <div class='auc-card'>
			
			            <div class='auc-title-row'>
			
			                <div class='auc-title'>
			                    ASP vs Unit Cost
			                </div>
			
			                <div class='auc-header-right'>
			
			                    <div class='auc-period'>"
			                        & _PeriodText &
			                    "</div>
			
			                    <div class='auc-legend'>
			
			                        <div class='auc-legend-item'>
			                            <span class='auc-line-key auc-asp-key'></span>
			                            <span>ASP</span>
			                        </div>
			
			                        <div class='auc-legend-item'>
			                            <span class='auc-line-key auc-cost-key'></span>
			                            <span>Unit Cost</span>
			                        </div>
			
			                        <div class='auc-legend-item'>
			                            <span class='auc-area-key'></span>
			
			                            <span class='auc-spread-description'>
			                                Spread (ASP - Unit Cost)
			                            </span>
			
			                            <span class='auc-spread-short'>
			                                Spread
			                            </span>
			                        </div>
			
			                    </div>
			
			                </div>
			
			            </div>
			
			            <div class='auc-chart'>
			
			                <svg
			                    class='auc-svg'
			                    viewBox='0 0 "
			                        & _ViewBoxWidth
			                        & " "
			                        & _ViewBoxHeight
			                        & "'
			                    preserveAspectRatio='none'
			                >"
			
			                    & _GridLines
			
			                    & "<line
			                        x1='" & FORMAT ( _Left, "0", "en-US" ) & "'
			                        y1='" & FORMAT ( _Baseline, "0", "en-US" ) & "'
			                        x2='" & FORMAT ( _Right, "0", "en-US" ) & "'
			                        y2='" & FORMAT ( _Baseline, "0", "en-US" ) & "'
			                        stroke='#BEB9C0'
			                        stroke-width='1'
			                        vector-effect='non-scaling-stroke'
			                    />"
			
			                    & _SpreadArea
			
			                    & "<polyline
			                        points='" & _ASPPoints & "'
			                        fill='none'
			                        stroke='#138F96'
			                        stroke-width='3'
			                        stroke-linejoin='round'
			                        stroke-linecap='round'
			                        vector-effect='non-scaling-stroke'
			                    />"
			
			                    & "<polyline
			                        points='" & _UnitCostPoints & "'
			                        fill='none'
			                        stroke='#642B73'
			                        stroke-width='3'
			                        stroke-linejoin='round'
			                        stroke-linecap='round'
			                        vector-effect='non-scaling-stroke'
			                    />"
			
			                    & _ASPMarkers
			                    & _UnitCostMarkers
			                    & _SpreadBracket
			                    & _MonthLabels
			
			                & "</svg>
			
			            </div>
			
			        </div>
			        "
			    )
		displayFolder: 02 Margin
		lineageTag: b4635b5b-9e1d-4ad8-ab38-b9056530cc07

	measure 'Title Risk Operations' =
			
			VAR _region = SELECTEDVALUE(dimRegion[region])
			RETURN
			"RISK OPERATIONS - REGION: "&_region
		displayFolder: 01 Risk
		lineageTag: 1271b23f-2432-473f-b5c4-a68f631a8a30

	measure 'Product Risk Assessment HTML' =
			
			VAR _RiskScore =
			    [Risk Score normalized AVG]
			
			VAR _Probability =
			    [High-Risk Probability AVG]
			
			VAR _RiskPosition =
			    MAX (
			        0,
			        MIN (
			            1,
			            DIVIDE ( _RiskScore, 10 )
			        )
			    )
			
			VAR _RiskColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _RiskScore ), "#7A7480",
			        _RiskScore >= 7.5, "#C53D3D",
			        _RiskScore >= 4.0, "#D99A2B",
			        "#2F855A"
			    )
			
			VAR _RiskBackground =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _RiskScore ), "#F4F2F5",
			        _RiskScore >= 7.5, "#FCEEEE",
			        _RiskScore >= 4.0, "#FFF7E8",
			        "#EDF7F1"
			    )
			
			VAR _RiskLevel =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _RiskScore ), "NO SCORE",
			        _RiskScore >= 7.5, "HIGH RISK",
			        _RiskScore >= 4.0, "MEDIUM RISK",
			        "LOW RISK"
			    )
			
			VAR _RiskFormatted =
			    IF (
			        ISBLANK ( _RiskScore ),
			        "—",
			        FORMAT ( _RiskScore, "0.0" ) & " / 10"
			    )
			
			VAR _ProbabilityFormatted =
			    IF (
			        ISBLANK ( _Probability ),
			        "—",
			        FORMAT ( _Probability, "0.0%" )
			    )
			
			-- SVG gauge
			VAR _Radius =
			    42
			
			VAR _Circumference =
			    263.89
			
			VAR _DashLength =
			    _Circumference * _RiskPosition
			
			VAR _DashLengthFormatted =
			    FORMAT (
			        _DashLength,
			        "0.00",
			        "en-US"
			    )
			
			VAR _CircumferenceFormatted =
			    FORMAT (
			        _Circumference,
			        "0.00",
			        "en-US"
			    )
			
			RETURN
			"
			<style>
			
			* {
			    box-sizing:border-box;
			    margin:0;
			    padding:0;
			    font-family:'Segoe UI',Arial,sans-serif;
			}
			
			.pra-card {
			    width:100%;
			    height:100%;
			    padding:16px 20px;
			    overflow:hidden;
			
			    color:#26232A;
			    background:#FFFFFF;
			
			    border:1px solid rgba(51,16,69,.14);
			    border-radius:12px;
			}
			
			.pra-title {
			    margin-bottom:14px;
			
			    color:#26232A;
			
			    font-size:17px;
			    line-height:1.2;
			    font-weight:700;
			
			    text-transform:uppercase;
			}
			
			.pra-content {
			    display:grid;
			    grid-template-columns:minmax(0,1fr) 130px;
			    align-items:center;
			    gap:18px;
			}
			
			.pra-value {
			    color:" & _RiskColor & ";
			
			    font-size:42px;
			    line-height:1;
			    font-weight:700;
			
			    letter-spacing:-.04em;
			    white-space:nowrap;
			}
			
			.pra-status {
			    display:inline-block;
			
			    margin-top:10px;
			    padding:4px 8px;
			
			    color:" & _RiskColor & ";
			    background:" & _RiskBackground & ";
			
			    border-radius:5px;
			
			    font-size:12px;
			    line-height:1;
			    font-weight:700;
			}
			
			.pra-probability {
			    margin-top:10px;
			
			    color:#6E6871;
			
			    font-size:13px;
			    line-height:1.3;
			}
			
			.pra-gauge {
			    display:flex;
			    align-items:center;
			    justify-content:center;
			}
			
			.pra-gauge-wrap {
			    position:relative;
			
			    width:118px;
			    height:118px;
			}
			
			.pra-gauge-svg {
			    width:118px;
			    height:118px;
			
			    transform:rotate(-90deg);
			}
			
			.pra-gauge-value {
			    position:absolute;
			    inset:0;
			
			    display:flex;
			    flex-direction:column;
			    align-items:center;
			    justify-content:center;
			
			    color:#26232A;
			}
			
			.pra-gauge-number {
			    color:" & _RiskColor & ";
			
			    font-size:18px;
			    font-weight:700;
			}
			
			.pra-gauge-label {
			    margin-top:1px;
			
			    color:#7A7480;
			
			    font-size:9px;
			    text-transform:uppercase;
			}
			
			</style>
			
			
			<div class='pra-card'>
			
			    <div class='pra-title'>
			        Current Risk Assessment
			    </div>
			
			    <div class='pra-content'>
			
			        <div>
			
			            <div class='pra-value'>
			                " & _RiskFormatted & "
			            </div>
			
			            <div class='pra-status'>
			                " & _RiskLevel & "
			            </div>
			
			            <div class='pra-probability'>
			                High-risk probability
			                <strong>" & _ProbabilityFormatted & "</strong>
			            </div>
			
			        </div>
			
			
			        <div class='pra-gauge'>
			
			            <div class='pra-gauge-wrap'>
			
			                <svg
			                    class='pra-gauge-svg'
			                    viewBox='0 0 100 100'>
			
			                    <circle
			                        cx='50'
			                        cy='50'
			                        r='42'
			                        fill='none'
			                        stroke='#ECEAEC'
			                        stroke-width='12'>
			                    </circle>
			
			                    <circle
			                        cx='50'
			                        cy='50'
			                        r='42'
			                        fill='none'
			                        stroke='" & _RiskColor & "'
			                        stroke-width='12'
			                        stroke-linecap='round'
			                        stroke-dasharray='"
			                            & _DashLengthFormatted
			                            & " "
			                            & _CircumferenceFormatted
			                            & "'>
			                    </circle>
			
			                </svg>
			
			                <div class='pra-gauge-value'>
			
			                    <div class='pra-gauge-number'>
			                        "
			                        & IF (
			                            ISBLANK ( _RiskScore ),
			                            "—",
			                            FORMAT ( _RiskScore, "0.0" )
			                        )
			                        & "
			                    </div>
			
			                    <div class='pra-gauge-label'>
			                        risk
			                    </div>
			
			                </div>
			
			            </div>
			
			        </div>
			
			    </div>
			
			</div>
			"
		displayFolder: 01 Risk
		lineageTag: 68de2b7b-7453-4683-a4bd-beec9b490931

	measure 'Product Risk Explanation HTML' =
			
			VAR _RiskScore =
			    [Risk Score normalized AVG]
			
			VAR _GrossMargin =
			    [Gross Margin %]
			
			VAR _MarginTarget =
			    [Gross Margin Target %]
			
			VAR _CategoryShare =
			    [Category-Region Share %]
			
			VAR _CategorySharePM =
			    CALCULATE (
			        [Category-Region Share %],
			        DATEADD (
			            dimDate[Date],
			            -1,
			            MONTH
			        )
			    )
			
			VAR _ShareDelta =
			    _CategoryShare - _CategorySharePM
			
			VAR _Customers =
			    [Customers Active]
			
			VAR _CustomersPM =
			    CALCULATE (
			        [Customers Active],
			        DATEADD (
			            dimDate[Date],
			            -1,
			            MONTH
			        )
			    )
			
			VAR _CustomerDelta =
			    DIVIDE (
			        _Customers - _CustomersPM,
			        ABS ( _CustomersPM )
			    )
			
			VAR _RevenueMoM =
			    [Revenue MoM %]
			
			VAR _Competition =
			    [Competitor Pressure Score AVG]
			
			
			-- ============================================================
			-- BUSINESS DRIVER FLAGS
			-- ============================================================
			
			VAR _MarginIssue =
			    NOT ISBLANK ( _GrossMargin )
			        && NOT ISBLANK ( _MarginTarget )
			        && _GrossMargin < _MarginTarget
			
			VAR _SalesIssue =
			    NOT ISBLANK ( _RevenueMoM )
			        && _RevenueMoM < 0
			
			VAR _CustomerIssue =
			    NOT ISBLANK ( _CustomerDelta )
			        && _CustomerDelta < 0
			
			VAR _CompetitionIssue =
			    NOT ISBLANK ( _Competition )
			        && _Competition >= 70
			
			VAR _IssueCount =
			      IF ( _MarginIssue, 1, 0 )
			    + IF ( _SalesIssue, 1, 0 )
			    + IF ( _CustomerIssue, 1, 0 )
			    + IF ( _CompetitionIssue, 1, 0 )
			
			
			-- ============================================================
			-- OVERALL STATE
			-- ============================================================
			
			VAR _StateColor =
			    SWITCH (
			        TRUE (),
			        _RiskScore >= 7.5, "#C53D3D",
			        _RiskScore >= 4.0, "#D99A2B",
			        "#2F855A"
			    )
			
			VAR _StateBackground =
			    SWITCH (
			        TRUE (),
			        _RiskScore >= 7.5, "#FDF1F1",
			        _RiskScore >= 4.0, "#FFF8EB",
			        "#F0F7F2"
			    )
			
			VAR _Title =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _RiskScore ),
			            "RISK INTERPRETATION",
			
			        _RiskScore >= 7.5,
			            "WHY THIS PRODUCT NEEDS ATTENTION",
			
			        _RiskScore >= 4.0,
			            "WHY THE MODEL IS WATCHING",
			
			        "WHY THE MODEL IS CALM"
			    )
			
			
			-- ============================================================
			-- FORMATTING
			-- ============================================================
			
			VAR _MarginFormatted =
			    IF (
			        ISBLANK ( _GrossMargin ),
			        "—",
			        FORMAT ( _GrossMargin, "0.0%" )
			    )
			
			VAR _TargetFormatted =
			    IF (
			        ISBLANK ( _MarginTarget ),
			        "—",
			        FORMAT ( _MarginTarget, "0.0%" )
			    )
			
			VAR _ShareFormatted =
			    IF (
			        ISBLANK ( _CategoryShare ),
			        "—",
			        FORMAT ( _CategoryShare, "0.0%" )
			    )
			
			VAR _CustomerFormatted =
			    IF (
			        ISBLANK ( _Customers ),
			        "—",
			        FORMAT ( _Customers, "#,0" ) & " active"
			    )
			
			VAR _ShareDeltaFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _CategorySharePM ),
			            "No PM",
			
			        _ShareDelta > 0,
			            "▲ "
			                & FORMAT (
			                    ABS ( _ShareDelta ) * 100,
			                    "0.0"
			                )
			                & " pp",
			
			        _ShareDelta < 0,
			            "▼ "
			                & FORMAT (
			                    ABS ( _ShareDelta ) * 100,
			                    "0.0"
			                )
			                & " pp",
			
			        "0.0 pp"
			    )
			
			VAR _CustomerDeltaFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _CustomersPM ),
			            "No PM",
			
			        _CustomerDelta > 0,
			            "▲ "
			                & FORMAT (
			                    ABS ( _CustomerDelta ),
			                    "0.0%"
			                ),
			
			        _CustomerDelta < 0,
			            "▼ "
			                & FORMAT (
			                    ABS ( _CustomerDelta ),
			                    "0.0%"
			                ),
			
			        "0.0%"
			    )
			
			
			VAR _MarginColor =
			    IF (
			        _MarginIssue,
			        "#C53D3D",
			        "#2F855A"
			    )
			
			VAR _ShareColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _CategorySharePM ), "#7A7480",
			        _ShareDelta < 0, "#C53D3D",
			        _ShareDelta > 0, "#2F855A",
			        "#7A7480"
			    )
			
			VAR _CustomerColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _CustomersPM ), "#7A7480",
			        _CustomerDelta < 0, "#C53D3D",
			        _CustomerDelta > 0, "#2F855A",
			        "#7A7480"
			    )
			
			
			VAR _Footer =
			    SWITCH (
			        TRUE (),
			
			        _IssueCount = 0,
			            "No major local business drivers currently exceed their thresholds.",
			
			        _IssueCount = 1,
			            "1 local business risk indicator currently requires attention.",
			
			        FORMAT (
			            _IssueCount,
			            "0"
			        )
			            & " local business risk indicators currently require attention."
			    )
			
			
			RETURN
			"
			<style>
			
			* {
			    box-sizing:border-box;
			    margin:0;
			    padding:0;
			    font-family:'Segoe UI',Arial,sans-serif;
			}
			
			.pre-card {
			    width:100%;
			    height:220px;
			    padding:5px 5px;
			
			    color:#26232A;
			    background:#FFFFFF;
			
			    border:1px solid rgba(51,16,69,.14);
			    border-radius:5px;
			}
			
			.pre-title {
			
			    color:#26232A;
			
			    font-size:15px;
			    font-weight:700;
			
			    text-transform:uppercase;
			}
			
			.pre-row {
			    display:grid;
			    grid-template-columns:minmax(0,1fr) auto auto;
			    align-items:center;
			    gap:8px;
			
			    min-height:30px;
			    font-size:11px;
			}
			
			.pre-label {
			    color:#26232A;
			}
			
			.pre-value {
			    font-weight:400;
			    white-space:nowrap;
			}
			
			.pre-delta {
			    min-width:55px;
			
			    text-align:right;
			
			    color:#7A7480;
			
			    font-size:11px;
			    white-space:nowrap;
			}
			
			.pre-footer {
			    margin-top:11px;
			    padding:9px 10px;
			
			    color:" & _StateColor & ";
			    background:" & _StateBackground & ";
			
			    border-radius:6px;
			
			    font-size:11px;
			}
			
			</style>
			
			
			<div class='pre-card'>
			
			    <div class='pre-title'>
			        " & _Title & "
			    </div>
			
			
			    <div class='pre-row'>
			
			        <div class='pre-label'>
			            Gross margin
			        </div>
			
			        <div
			            class='pre-value'
			            style='color:" & _MarginColor & ";'>
			
			            " & _MarginFormatted & "
			
			        </div>
			
			        <div class='pre-delta'></div>
			
			    </div>
			
			
			    <div class='pre-row'>
			
			        <div class='pre-label'>
			            Target margin
			        </div>
			
			        <div class='pre-value'>
			            " & _TargetFormatted & "
			        </div>
			
			        <div class='pre-delta'></div>
			
			    </div>
			
			
			    <div class='pre-row'>
			
			        <div class='pre-label'>
			            Category-region share
			        </div>
			
			        <div class='pre-value'>
			            " & _ShareFormatted & "
			        </div>
			
			        <div
			            class='pre-delta'
			            style='color:" & _ShareColor & ";'>
			
			            " & _ShareDeltaFormatted & "
			
			        </div>
			
			    </div>
			
			
			    <div class='pre-row'>
			
			        <div class='pre-label'>
			            Customer base
			        </div>
			
			        <div class='pre-value'>
			            " & _CustomerFormatted & "
			        </div>
			
			        <div
			            class='pre-delta'
			            style='color:" & _CustomerColor & ";'>
			
			            " & _CustomerDeltaFormatted & "
			
			        </div>
			
			    </div>
			
			
			    <div class='pre-footer'>
			        " & _Footer & "
			    </div>
			
			</div>
			"
		displayFolder: 01 Risk
		lineageTag: 586844bc-9873-4425-a1d5-70e3648a4a44

	measure 'Product Commercial Snapshot HTML' =
			
			VAR _Revenue =
			    [Revenue]
			
			VAR _Units =
			    [Units]
			
			VAR _Customers =
			    [Customers Active]
			
			VAR _Demand =
			    [Market Demand Score]
			
			VAR _Competition =
			    [Competitor Pressure Score AVG]
			
			
			-- Previous month
			VAR _RevenuePM =
			    CALCULATE (
			        [Revenue],
			        DATEADD (
			            dimDate[Date],
			            -1,
			            MONTH
			        )
			    )
			
			VAR _UnitsPM =
			    CALCULATE (
			        [Units],
			        DATEADD (
			            dimDate[Date],
			            -1,
			            MONTH
			        )
			    )
			
			VAR _CustomersPM =
			    CALCULATE (
			        [Customers Active],
			        DATEADD (
			            dimDate[Date],
			            -1,
			            MONTH
			        )
			    )
			
			
			-- Changes
			VAR _RevenueDelta =
			    DIVIDE (
			        _Revenue - _RevenuePM,
			        ABS ( _RevenuePM )
			    )
			
			VAR _UnitsDelta =
			    DIVIDE (
			        _Units - _UnitsPM,
			        ABS ( _UnitsPM )
			    )
			
			VAR _CustomersDelta =
			    DIVIDE (
			        _Customers - _CustomersPM,
			        ABS ( _CustomersPM )
			    )
			
			
			-- Formatting
			VAR _RevenueFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Revenue ), "—",
			        ABS ( _Revenue ) >= 1000000,
			            "€"
			                & FORMAT (
			                    DIVIDE (
			                        _Revenue,
			                        1000000
			                    ),
			                    "0.00"
			                )
			                & "M",
			
			        ABS ( _Revenue ) >= 1000,
			            "€"
			                & FORMAT (
			                    DIVIDE (
			                        _Revenue,
			                        1000
			                    ),
			                    "0.0"
			                )
			                & "K",
			
			        "€" & FORMAT ( _Revenue, "#,0" )
			    )
			
			VAR _UnitsFormatted =
			    IF (
			        ISBLANK ( _Units ),
			        "—",
			        FORMAT ( _Units, "#,0" )
			    )
			
			VAR _CustomersFormatted =
			    IF (
			        ISBLANK ( _Customers ),
			        "—",
			        FORMAT ( _Customers, "#,0" )
			    )
			
			VAR _DemandFormatted =
			    IF (
			        ISBLANK ( _Demand ),
			        "—",
			        FORMAT ( _Demand, "0" ) & " / 100"
			    )
			
			VAR _CompetitionFormatted =
			    IF (
			        ISBLANK ( _Competition ),
			        "—",
			        FORMAT ( _Competition, "0" ) & " / 100"
			    )
			
			
			VAR _RevenueDeltaText =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _RevenuePM ), "",
			        _RevenueDelta > 0,
			            "▲ " & FORMAT ( ABS ( _RevenueDelta ), "0.0%" ),
			        _RevenueDelta < 0,
			            "▼ " & FORMAT ( ABS ( _RevenueDelta ), "0.0%" ),
			        "— 0.0%"
			    )
			
			VAR _UnitsDeltaText =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _UnitsPM ), "",
			        _UnitsDelta > 0,
			            "▲ " & FORMAT ( ABS ( _UnitsDelta ), "0.0%" ),
			        _UnitsDelta < 0,
			            "▼ " & FORMAT ( ABS ( _UnitsDelta ), "0.0%" ),
			        "— 0.0%"
			    )
			
			VAR _CustomersDeltaText =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _CustomersPM ), "",
			        _CustomersDelta > 0,
			            "▲ " & FORMAT ( ABS ( _CustomersDelta ), "0.0%" ),
			        _CustomersDelta < 0,
			            "▼ " & FORMAT ( ABS ( _CustomersDelta ), "0.0%" ),
			        "— 0.0%"
			    )
			
			
			VAR _RevenueColor =
			    IF (
			        _RevenueDelta < 0,
			        "#C53D3D",
			        "#2F855A"
			    )
			
			VAR _UnitsColor =
			    IF (
			        _UnitsDelta < 0,
			        "#C53D3D",
			        "#2F855A"
			    )
			
			VAR _CustomersColor =
			    IF (
			        _CustomersDelta < 0,
			        "#C53D3D",
			        "#2F855A"
			    )
			
			VAR _CompetitionColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Competition ), "#7A7480",
			        _Competition >= 70, "#C53D3D",
			        _Competition >= 40, "#D99A2B",
			        "#2F855A"
			    )
			
			
			RETURN
			"
			<style>
			
			* {
			    box-sizing:border-box;
			    margin:0;
			    padding:0;
			    font-family:'Segoe UI',Arial,sans-serif;
			}
			
			.pcs-card {
			    width:100%;
			    height:100%;
			    padding:16px 20px;
			
			    color:#26232A;
			    background:#FFFFFF;
			
			    border:1px solid rgba(51,16,69,.14);
			    border-radius:12px;
			}
			
			.pcs-title {
			    margin-bottom:14px;
			
			    font-size:17px;
			    font-weight:700;
			
			    text-transform:uppercase;
			}
			
			.pcs-row {
			    display:grid;
			    grid-template-columns:minmax(0,1fr) auto 72px;
			    align-items:center;
			    gap:8px;
			
			    min-height:31px;
			}
			
			.pcs-label {
			    color:#26232A;
			
			    font-size:14px;
			}
			
			.pcs-value {
			    color:#26232A;
			
			    font-size:14px;
			    font-weight:700;
			
			    text-align:right;
			    white-space:nowrap;
			}
			
			.pcs-change {
			    font-size:11px;
			    font-weight:600;
			
			    text-align:right;
			    white-space:nowrap;
			}
			
			.pcs-divider {
			    height:1px;
			    margin:4px 0;
			
			    background:rgba(51,16,69,.08);
			}
			
			</style>
			
			
			<div class='pcs-card'>
			
			    <div class='pcs-title'>
			        Commercial Snapshot
			    </div>
			
			
			    <div class='pcs-row'>
			
			        <div class='pcs-label'>
			            Revenue
			        </div>
			
			        <div class='pcs-value'>
			            " & _RevenueFormatted & "
			        </div>
			
			        <div
			            class='pcs-change'
			            style='color:" & _RevenueColor & ";'>
			
			            " & _RevenueDeltaText & "
			
			        </div>
			
			    </div>
			
			
			    <div class='pcs-row'>
			
			        <div class='pcs-label'>
			            Units
			        </div>
			
			        <div class='pcs-value'>
			            " & _UnitsFormatted & "
			        </div>
			
			        <div
			            class='pcs-change'
			            style='color:" & _UnitsColor & ";'>
			
			            " & _UnitsDeltaText & "
			
			        </div>
			
			    </div>
			
			
			    <div class='pcs-row'>
			
			        <div class='pcs-label'>
			            Customers
			        </div>
			
			        <div class='pcs-value'>
			            " & _CustomersFormatted & "
			        </div>
			
			        <div
			            class='pcs-change'
			            style='color:" & _CustomersColor & ";'>
			
			            " & _CustomersDeltaText & "
			
			        </div>
			
			    </div>
			
			
			    <div class='pcs-divider'></div>
			
			
			    <div class='pcs-row'>
			
			        <div class='pcs-label'>
			            Market demand
			        </div>
			
			        <div class='pcs-value'>
			            " & _DemandFormatted & "
			        </div>
			
			        <div></div>
			
			    </div>
			
			
			    <div class='pcs-row'>
			
			        <div class='pcs-label'>
			            Competitive pressure
			        </div>
			
			        <div
			            class='pcs-value'
			            style='color:" & _CompetitionColor & ";'>
			
			            " & _CompetitionFormatted & "
			
			        </div>
			
			        <div></div>
			
			    </div>
			
			</div>
			"
		displayFolder: 00 Core Measures
		lineageTag: fd4e9257-bd5d-4125-97f9-c870da230763

	measure 'Risk Product Count' =
			
			DISTINCTCOUNT( factMlPredictions[product_id] )
		formatString: 0
