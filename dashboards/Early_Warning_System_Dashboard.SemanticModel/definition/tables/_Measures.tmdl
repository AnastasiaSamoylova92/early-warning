			                            width:" & _GNBAccuracyWidth & ";
			                            background:#331045;
			                         '>
			                    </div>
			
			                    <span class='mc-value'
			                          style='left:" & _GNBAccuracyWidth & "'>
			                        " & _GNBAccuracyFormatted & "
			                    </span>
			
			                </div>
			
			
			                <div class='mc-track'
			                     title='Macro F1: " & _GNBMacroF1Formatted & "'>
			
			                    <div class='mc-fill'
			                         style='
			                            width:" & _GNBMacroF1Width & ";
			                            background:#7D46C1;
			                         '>
			                    </div>
			
			                    <span class='mc-value'
			                          style='left:" & _GNBMacroF1Width & "'>
			                        " & _GNBMacroF1Formatted & "
			                    </span>
			
			                </div>
			
			
			                <div class='mc-track'
			                     title='High-Risk Recall: " & _GNBRecallFormatted & "'>
			
			                    <div class='mc-fill'
			                         style='
			                            width:" & _GNBRecallWidth & ";
			                            background:#C6A9E5;
			                         '>
			                    </div>
			
			                    <span class='mc-value'
			                          style='left:" & _GNBRecallWidth & "'>
			                        " & _GNBRecallFormatted & "
			                    </span>
			
			                </div>
			
			            </div>
			
			        </div>
			
			
			
			        <div class='mc-row mc-row-best'>
			
			            <div class='mc-model'>
			                Random Forest &#183; 0.43
			            </div>
			
			            <div class='mc-bars'>
			
			                <div class='mc-track'
			                     title='Accuracy: " & _RFAccuracyFormatted & "'>
			
			                    <div class='mc-fill'
			                         style='
			                            width:" & _RFAccuracyWidth & ";
			                            background:#331045;
			                         '>
			                    </div>
			
			                    <span class='mc-value'
			                          style='left:" & _RFAccuracyWidth & "'>
			                        " & _RFAccuracyFormatted & "
			                    </span>
			
			                </div>
			
			
			                <div class='mc-track'
			                     title='Macro F1: " & _RFMacroF1Formatted & "'>
			
			                    <div class='mc-fill'
			                         style='
			                            width:" & _RFMacroF1Width & ";
			                            background:#7D46C1;
			                         '>
			                    </div>
			
			                    <span class='mc-value'
			                          style='left:" & _RFMacroF1Width & "'>
			                        " & _RFMacroF1Formatted & "
			                    </span>
			
			                </div>
			
			
			                <div class='mc-track'
			                     title='High-Risk Recall: " & _RFRecallFormatted & "'>
			
			                    <div class='mc-fill'
			                         style='
			                            width:" & _RFRecallWidth & ";
			                            background:#C6A9E5;
			                         '>
			                    </div>
			
			                    <span class='mc-value'
			                          style='left:" & _RFRecallWidth & "'>
			                        " & _RFRecallFormatted & "
			                    </span>
			
			                </div>
			
			            </div>
			
			        </div>
			
			
			    </div>
			    "
			)
		displayFolder: 06 Model Performance
		lineageTag: 3da58515-71ee-4519-be9b-43afafeacfb5

	measure 'Product Risk Detail HTML' =
			
			-- Current KPI values
			VAR _RiskScore =
			    [Risk Score normalized AVG]
			
			VAR _HighRiskProbability =
			    [High-Risk Probability AVG]
			
			VAR _Revenue =
			    [Revenue]
			
			VAR _Units =
			    [Units]
			
			VAR _UniqueCustomers =
			    [Customers Active]
			
			
			-- Previous-month values
			VAR _RevenuePM =
			    CALCULATE (
			        [Revenue],
			        DATEADD ( dimDate[Date], -1, MONTH )
			    )
			
			VAR _UnitsPM =
			    CALCULATE (
			        [Units],
			        DATEADD ( dimDate[Date], -1, MONTH )
			    )
			
			VAR _UniqueCustomersPM =
			    CALCULATE (
			        [Customers Active],
			        DATEADD ( dimDate[Date], -1, MONTH )
			    )
			
			
			-- Month-over-month changes
			VAR _RevenueDelta =
			    DIVIDE (
			        _Revenue - _RevenuePM,
			        ABS ( _RevenuePM )
			    )
			
			VAR _UnitsDelta =
			    DIVIDE (
			        _Units - _UnitsPM,
			        ABS ( _UnitsPM )
			    )
			
			VAR _CustomersDelta =
			    DIVIDE (
			        _UniqueCustomers - _UniqueCustomersPM,
			        ABS ( _UniqueCustomersPM )
			    )
			
			
			-- Comparable previous-month baselines
			VAR _CanCompareRevenue =
			    NOT ISBLANK ( _Revenue )
			        && NOT ISBLANK ( _RevenuePM )
			        && _RevenuePM <> 0
			
			VAR _CanCompareUnits =
			    NOT ISBLANK ( _Units )
			        && NOT ISBLANK ( _UnitsPM )
			        && _UnitsPM <> 0
			
			VAR _CanCompareCustomers =
			    NOT ISBLANK ( _UniqueCustomers )
			        && NOT ISBLANK ( _UniqueCustomersPM )
			        && _UniqueCustomersPM <> 0
			
			
			-- Risk classification
			VAR _RiskColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _RiskScore ), "#7A7480",
			        _RiskScore >= 7.5,       "#C53D3D",
			        _RiskScore >= 4,         "#D99A2B",
			        "#2F855A"
			    )
			
			VAR _RiskLevel =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _RiskScore ), "No risk score",
			        _RiskScore >= 7.5,       "High risk",
			        _RiskScore >= 4,         "Medium risk",
			        "Low risk"
			    )
			
			VAR _ProbabilityColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _HighRiskProbability ), "#7A7480",
			        _HighRiskProbability >= 0.70,      "#C53D3D",
			        _HighRiskProbability >= 0.40,      "#D99A2B",
			        "#2F855A"
			    )
			
			VAR _ProbabilityLevel =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _HighRiskProbability ), "No probability",
			        _HighRiskProbability >= 0.70,      "High confidence",
			        _HighRiskProbability >= 0.40,      "Medium confidence",
			        "Low confidence"
			    )
			
			
			-- MoM trend colors
			VAR _RevenueDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareRevenue ), "#7A7480",
			        _RevenueDelta > 0,          "#2F855A",
			        _RevenueDelta < 0,          "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _UnitsDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareUnits ), "#7A7480",
			        _UnitsDelta > 0,          "#2F855A",
			        _UnitsDelta < 0,          "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _CustomersDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareCustomers ), "#7A7480",
			        _CustomersDelta > 0,          "#2F855A",
			        _CustomersDelta < 0,          "#C53D3D",
			        "#7A7480"
			    )
			
			
			-- Direction arrows
			VAR _RevenueArrow =
			    IF (
			        _RevenueDelta > 0,
			        "▲ ",
			        IF ( _RevenueDelta < 0, "▼ ", "— " )
			    )
			
			VAR _UnitsArrow =
			    IF (
			        _UnitsDelta > 0,
			        "▲ ",
			        IF ( _UnitsDelta < 0, "▼ ", "— " )
			    )
			
			VAR _CustomersArrow =
			    IF (
			        _CustomersDelta > 0,
			        "▲ ",
			        IF ( _CustomersDelta < 0, "▼ ", "— " )
			    )
			
			
			-- KPI formatting
			VAR _RiskScoreFormatted =
			    IF (
			        ISBLANK ( _RiskScore ),
			        "—",
			        FORMAT ( _RiskScore, "0.0","de-DE" ) & " / 10"
			    )
			
			VAR _ProbabilityFormatted =
			    IF (
			        ISBLANK ( _HighRiskProbability ),
			        "—",
			        FORMAT ( _HighRiskProbability, "0.0%", "de-DE" )
			    )
			
			VAR _RevenueFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Revenue ), "—",
			        ABS ( _Revenue ) >= 1000000000,
			            FORMAT ( _Revenue / 1000000000, "€0.00", "de-DE" ) & "B",
			        ABS ( _Revenue ) >= 1000000,
			            FORMAT ( _Revenue / 1000000, "€0.00", "de-DE" ) & "M",
			        ABS ( _Revenue ) >= 1000,
			            FORMAT ( _Revenue / 1000, "€0.0", "de-DE" ) & "K",
			        FORMAT ( _Revenue, "€#,0", "de-DE" )
			    )
			
			VAR _UnitsFormatted =
			    IF (
			        ISBLANK ( _Units ),
			        "—",
			        FORMAT ( _Units, "#,0", "de-DE" )
			    )
			
			VAR _CustomersFormatted =
			    IF (
			        ISBLANK ( _UniqueCustomers ),
			        "—",
			        FORMAT ( _UniqueCustomers, "#,0", "de-DE" )
			    )
			
			
			-- Comparison labels
			VAR _RevenueComparison =
			    IF (
			        NOT ( _CanCompareRevenue ),
			        "— No PM data",
			        _RevenueArrow
			            & FORMAT ( ABS ( _RevenueDelta ), "0.0%", "de-DE" )
			            & " vs PM"
			    )
			
			VAR _UnitsComparison =
			    IF (
			        NOT ( _CanCompareUnits ),
			        "— No PM data",
			        _UnitsArrow
			            & FORMAT ( ABS ( _UnitsDelta ), "0.0%", "de-DE" )
			            & " vs PM"
			    )
			
			VAR _CustomersComparison =
			    IF (
			        NOT ( _CanCompareCustomers ),
			        "— No PM data",
			        _CustomersArrow
			            & FORMAT ( ABS ( _CustomersDelta ), "0.0%", "de-DE" )
			            & " vs PM"
			    )
			
			
			RETURN
			IF (
			    ISBLANK ( _RiskScore )
			        && ISBLANK ( _HighRiskProbability )
			        && ISBLANK ( _Revenue )
			        && ISBLANK ( _Units )
			        && ISBLANK ( _UniqueCustomers ),
			    "
			    <div style='
			        padding:8px;
			        background:transparent;
			        color:#7A7480;
			        font:8px Segoe UI,Arial,sans-serif;'>
			        No product-risk data
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .prd-grid {
			            display:grid;
			            grid-template-columns:repeat(5,minmax(0,1fr));
			            gap:6px;
			            width:100%;
			            background:transparent;
			        }
			
			        .prd-card {
			            position:relative;
			            min-width:0;
			            padding:9px 10px 8px;
			            overflow:hidden;
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.14);
			            border-radius:8px;
			        }
			
			        .prd-accent {
			            position:absolute;
			            top:0;
			            left:0;
			            width:100%;
			            height:3px;
			        }
			
			        .prd-label {
			            margin-bottom:4px;
			            overflow:hidden;
			            color:#000000;
			            font-size:10px;
			            font-weight:700;
			            letter-spacing:.03em;
			            text-transform:uppercase;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .prd-value {
			            margin-bottom:5px;
			            overflow:hidden;
			            font-size:clamp(18px,1.8vw,24px);
			            line-height:1;
			            font-weight:700;
			            letter-spacing:-.03em;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .prd-bottom {
			            display:flex;
			            align-items:center;
			            gap:4px;
			            min-width:0;
			            min-height:14px;
			            overflow:hidden;
			        }
			
			        .prd-delta,
			        .prd-status {
			            flex-shrink:0;
			            padding:1px 2px;
			            border:1px solid;
			            border-radius:3px;
			            font-size:10px;
			            font-weight:600;
			            white-space:nowrap;
			        }
			
			        .prd-meta {
			            min-width:0;
			            overflow:hidden;
			            color:#7A7480;
			            font-size:10px;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			    </style>
			
			    <div class='prd-grid'>
			
			        <div class='prd-card'>
			            <div class='prd-accent'
			                 style='background:" & _RiskColor & "'></div>
			
			            <div class='prd-label'>Risk Score</div>
			
			            <div class='prd-value'
			                 style='color:" & _RiskColor & "'>
			                " & _RiskScoreFormatted & "
			            </div>
			
			            <div class='prd-bottom'>
			                <span class='prd-status'
			                      style='color:" & _RiskColor & ";
			                             border-color:" & _RiskColor & "55;
			                             background:" & _RiskColor & "10'>
			                    " & _RiskLevel & "
			                </span>
			
			                <span class='prd-meta'>normalized 0–10</span>
			            </div>
			        </div>
			
			
			        <div class='prd-card'>
			            <div class='prd-accent'
			                 style='background:" & _ProbabilityColor & "'></div>
			
			            <div class='prd-label'>High-Risk Probability</div>
			
			            <div class='prd-value'
			                 style='color:" & _ProbabilityColor & "'>
			                " & _ProbabilityFormatted & "
			            </div>
			
			            <div class='prd-bottom'>
			                <span class='prd-status'
			                      style='color:" & _ProbabilityColor & ";
			                             border-color:" & _ProbabilityColor & "55;
			                             background:" & _ProbabilityColor & "10'>
			                    " & _ProbabilityLevel & "
			                </span>
			
			                <span class='prd-meta'>model probability</span>
			            </div>
			        </div>
			
			
			        <div class='prd-card'>
			            <div class='prd-accent'
			                 style='background:#331045'></div>
			
			            <div class='prd-label'>Revenue</div>
			
			            <div class='prd-value'
			                 style='color:#331045'>
			                " & _RevenueFormatted & "
			            </div>
			
			            <div class='prd-bottom'>
			                <span class='prd-delta'
			                      style='color:" & _RevenueDeltaColor & ";
			                             border-color:" & _RevenueDeltaColor & "55;
			                             background:" & _RevenueDeltaColor & "10'>
			                    " & _RevenueComparison & "
			                </span>
			
			                <span class='prd-meta'>sales value</span>
			            </div>
			        </div>
			
			
			        <div class='prd-card'>
			            <div class='prd-accent'
			                 style='background:#6F4A7C'></div>
			
			            <div class='prd-label'>Units</div>
			
			            <div class='prd-value'
			                 style='color:#6F4A7C'>
			                " & _UnitsFormatted & "
			            </div>
			
			            <div class='prd-bottom'>
			                <span class='prd-delta'
			                      style='color:" & _UnitsDeltaColor & ";
			                             border-color:" & _UnitsDeltaColor & "55;
			                             background:" & _UnitsDeltaColor & "10'>
			                    " & _UnitsComparison & "
			                </span>
			
			                <span class='prd-meta'>units sold</span>
			            </div>
			        </div>
			
			
			        <div class='prd-card'>
			            <div class='prd-accent'
			                 style='background:#2F855A'></div>
			
			            <div class='prd-label'>Unique Customers</div>
			
			            <div class='prd-value'
			                 style='color:#2F855A'>
			                " & _CustomersFormatted & "
			            </div>
			
			            <div class='prd-bottom'>
			                <span class='prd-delta'
			                      style='color:" & _CustomersDeltaColor & ";
			                             border-color:" & _CustomersDeltaColor & "55;
			                             background:" & _CustomersDeltaColor & "10'>
			                    " & _CustomersComparison & "
			                </span>
			
			                <span class='prd-meta'>active buyers</span>
			            </div>
			        </div>
			
			    </div>
			    "
			)
		displayFolder: 01 Risk
		lineageTag: 159e62ed-167b-42eb-affe-e2b3e0ee2cb8

	measure 'Risk Score normalized AVG' = AVERAGE(factMlPredictions[risk_score_normalized])
		formatString: 0.0
		displayFolder: 00 Core Measures
		lineageTag: 35de2532-856b-4fba-9c80-4cc09cbe6f3c

	measure 'High-Risk Probability AVG' = AVERAGE(factMlPredictions[high_risk_probability])
		displayFolder: 01 Risk
		lineageTag: c030c140-ae29-4214-b581-4ed72cac41cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Market Context HTML' =
			
			VAR _Demand =
			    [Market Demand Score]
			
			VAR _Pressure =
			    [Competitor Pressure Score AVG]
			
			VAR _DemandWidth =
			    FORMAT (
			        DIVIDE (
			            MAX ( 0, MIN ( 100, _Demand ) ),
			            100
			        ),
			        "0.0%",
			        "en-US"
			    )
			
			VAR _PressureWidth =
			    FORMAT (
			        DIVIDE (
			            MAX ( 0, MIN ( 100, _Pressure ) ),
			            100
			        ),
			        "0.0%",
			        "en-US"
			    )
			
			VAR _PressureColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Pressure ), "#7A7480",
			        _Pressure >= 70,        "#C53D3D",
			        _Pressure >= 40,        "#D99A2B",
			        "#2F855A"
			    )
			
			VAR _DemandFormatted =
			    IF (
			        ISBLANK ( _Demand ),
			        "—",
			        FORMAT ( _Demand, "0" )
			    )
			
			VAR _PressureFormatted =
			    IF (
			        ISBLANK ( _Pressure ),
			        "—",
			        FORMAT ( _Pressure, "0" )
			    )
			
			RETURN
			IF (
			    ISBLANK ( _Demand )
			        && ISBLANK ( _Pressure ),
			    "
			    <div style='
			        padding:8px;
			        color:#7A7480;
			        background:transparent;
			        font:8px Segoe UI,Arial,sans-serif;'>
			        No market-context data
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .mk-card {
			            width:100%;
			            height:100%;
			            padding:5px 5px;
			            color:#26232A;
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.14);
			            border-radius:5px;
			        }
			
			        .mk-title {
			            margin-bottom:17px;
			            color:#26232A;
			            font-size:15px;
			            font-weight:700;
			            text-transform:uppercase;
			        }
			
			        .mk-metric {
			            margin-bottom:23px;
			        }
			
			        .mk-metric:last-child {
			            margin-bottom:0;
			        }
			
			        .mk-header {
			            display:flex;
			            align-items:flex-end;
			            justify-content:space-between;
			            gap:8px;
			            margin-bottom:8px;
			        }
			
			        .mk-label {
			            color:#4F4952;
			            font-size:13px;
			            line-height:1.2;
			            font-weight:600;
			        }
			
			        .mk-value {
			            color:#331045;
			            font-size:25px;
			            font-weight:700;
			            letter-spacing:-.03em;
			            white-space:nowrap;
			        }
			
			        .mk-out-of {
			            color:#7A7480;
			            font-size:13px;
			            font-weight:500;
			        }
			
			        .mk-track {
			            position:relative;
			            width:100%;
			            height:13px;
			            overflow:hidden;
			            background:#ECE9EE;
			            border-radius:4px;
			        }
			
			        .mk-fill {
			            height:100%;
			            border-radius:4px;
			        }
			
			        .mk-scale {
			            display:flex;
			            justify-content:space-between;
			            margin-top:4px;
			            color:#7A7480;
			            font-size:13px;
			            line-height:1;
			        }
			    </style>
			
			    <div class='mk-card'>
			
			        <div class='mk-title'>
			            Market Context
			        </div>
			
			        <div class='mk-metric'>
			            <div class='mk-header'>
			                <div class='mk-label'>
			                    Market Demand
			                </div>
			
			                <div class='mk-value'>
			                    " & _DemandFormatted & "
			                    <span class='mk-out-of'>/ 100</span>
			                </div>
			            </div>
			
			            <div class='mk-track'>
			                <div class='mk-fill'
			                     style='width:" & _DemandWidth & ";
			                            background:#331045'>
			                </div>
			            </div>
			
			            <div class='mk-scale'>
			                <span>0</span>
			                <span>50</span>
			                <span>100</span>
			            </div>
			        </div>
			
			        <div class='mk-metric'>
			            <div class='mk-header'>
			                <div class='mk-label'>
			                    Competitor Pressure
			                </div>
			
			                <div class='mk-value'
			                     style='color:" & _PressureColor & "'>
			                    " & _PressureFormatted & "
			                    <span class='mk-out-of'>/ 100</span>
			                </div>
			            </div>
			
			            <div class='mk-track'>
			                <div class='mk-fill'
			                     style='width:" & _PressureWidth & ";
			                            background:" & _PressureColor & "'>
			                </div>
			            </div>
			
			            <div class='mk-scale'>
			                <span>0</span>
			                <span>50</span>
			                <span>100</span>
			            </div>
			        </div>
			
			    </div>
			    "
			)
		displayFolder: 00 Core Measures
		lineageTag: 3690af58-918b-4652-9579-dba2ff8fea01

	measure 'Commercial Position HTML' =
			
			VAR _CategoryRegionShare =
			    [Category-Region Share %]
			
			VAR _CategoryRegionSharePM =
			    CALCULATE (
			        [Category-Region Share %],
			        DATEADD (
			            dimDate[Date],
			            -1,
			            MONTH
			        )
			    )
			
			VAR _GrossMargin =
			    [Gross Margin %]
			
			VAR _MarginTarget =
			    COALESCE (
			        [Gross Margin Target %],
			        0.24
			    )
			
			VAR _ShareDelta =
			    _CategoryRegionShare
			        - _CategoryRegionSharePM
			
			VAR _MarginGap =
			    _GrossMargin
			        - _MarginTarget
			
			VAR _GaugeMaximum =
			    MAX (
			        0.36,
			        _MarginTarget * 1.5
			    )
			
			
			-- Gauge positions
			VAR _MarginPosition =
			    MAX (
			        0,
			        MIN (
			            1,
			            DIVIDE (
			                _GrossMargin,
			                _GaugeMaximum
			            )
			        )
			    )
			
			VAR _TargetGaugePosition =
			    MAX (
			        0,
			        MIN (
			            1,
			            DIVIDE (
			                _MarginTarget,
			                _GaugeMaximum
			            )
			        )
			    )
			
			VAR _MarginWidth =
			    FORMAT (
			        _MarginPosition,
			        "0.0%",
			        "en-US"
			    )
			
			VAR _TargetPosition =
			    FORMAT (
			        _TargetGaugePosition,
			        "0.0%",
			        "en-US"
			    )
			
			
			-- Conditional colors
			VAR _ShareColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _CategoryRegionSharePM ), "#7A7480",
			        _ShareDelta > 0, "#2F855A",
			        _ShareDelta < 0, "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _MarginColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _GrossMargin ), "#7A7480",
			        _MarginGap >= 0, "#2F855A",
			        "#C53D3D"
			    )
			
			
			-- Formatted values
			VAR _ShareFormatted =
			    IF (
			        ISBLANK ( _CategoryRegionShare ),
			        "—",
			        FORMAT (
			            _CategoryRegionShare,
			            "0.0%"
			        )
			    )
			
			VAR _GrossMarginFormatted =
			    IF (
			        ISBLANK ( _GrossMargin ),
			        "—",
			        FORMAT (
			            _GrossMargin,
			            "0.0%"
			        )
			    )
			
			VAR _TargetFormatted =
			    FORMAT (
			        _MarginTarget,
			        "0.0%"
			    )
			
			VAR _ShareDeltaFormatted =
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( _CategoryRegionSharePM ),
			            "— No PM data",
			
			        _ShareDelta > 0,
			            "▲ "
			                & FORMAT (
			                    ABS ( _ShareDelta ) * 100,
			                    "0.0"
			                )
			                & " pp MoM",
			
			        _ShareDelta < 0,
			            "▼ "
			                & FORMAT (
			                    ABS ( _ShareDelta ) * 100,
			                    "0.0"
			                )
			                & " pp MoM",
			
			        "— 0.0 pp MoM"
			    )
			
			VAR _MarginGapFormatted =
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( _GrossMargin ),
			            "—",
			
			        _MarginGap > 0,
			            "+"
			                & FORMAT (
			                    ABS ( _MarginGap ) * 100,
			                    "0.0"
			                )
			                & " pp",
			
			        _MarginGap < 0,
			            "−"
			                & FORMAT (
			                    ABS ( _MarginGap ) * 100,
			                    "0.0"
			                )
			                & " pp",
			
			        "0.0 pp"
			    )
			
			VAR _ScaleMidFormatted =
			    FORMAT (
			        _MarginTarget / 2,
			        "0%"
			    )
			
			VAR _ScaleMaximumFormatted =
			    FORMAT (
			        _GaugeMaximum,
			        "0%"
			    )
			
			
			RETURN
			IF (
			    ISBLANK ( _CategoryRegionShare )
			        && ISBLANK ( _GrossMargin ),
			
			    "
			    <div style='
			        width:100%;
			        padding:8px;
			        color:#7A7480;
			        background:transparent;
			        font:9px Segoe UI,Arial,sans-serif;'>
			
			        No commercial-position data
			
			    </div>
			    ",
			
			    "
			    <style>
			
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .cp-card {
			            width:100%;
			            height:auto;
			            padding:5px;
			            overflow:hidden;
			            color:#26232A;
			            background:#FFFFFF;
			            border-radius:5px;
			        }
			
			        .cp-title {
			            margin-bottom:17px;
			            color:#26232A;
			            font-size:15px;
			            font-weight:700;
			            text-transform:uppercase;
			            white-space:nowrap;
			        }
			
			        .cp-share-row {
			            display:grid;
			            grid-template-columns:minmax(0,1fr) auto;
			            align-items:start;
			            gap:8px;
			            width:100%;
			            min-width:0;
			        }
			
			        .cp-label {
			            min-width:0;
			            color:#4F4952;
			            font-size:13px;
			            line-height:1.25;
			            font-weight:600;
			        }
			
			        .cp-value-group {
			            min-width:0;
			            text-align:right;
			        }
			
			        .cp-value {
			            color:#331045;
			            font-size:25px;
			            line-height:1;
			            font-weight:700;
			            letter-spacing:-.03em;
			            white-space:nowrap;
			        }
			
			        .cp-delta {
			            display:inline-block;
			            max-width:100%;
			            margin-top:4px;
			            padding:2px 4px;
			            overflow:hidden;
			            border:1px solid;
			            border-radius:3px;
			            font-size:12px;
			            line-height:1.2;
			            font-weight:400;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .cp-divider {
			            width:100%;
			            height:1px;
			            margin:10px 0;
			            background:rgba(51,16,69,.12);
			        }
			
			        .cp-margin-header {
			            display:grid;
			            grid-template-columns:minmax(0,1fr) auto;
			            align-items:center;
			            gap:8px;
			            margin-bottom:9px;
			        }
			
			        .cp-margin-current {
			            display:flex;
			            align-items:flex-end;
			            justify-content:space-between;
			            gap:8px;
			            min-width:0;
			        }
			
			        .cp-target {
			            flex-shrink:0;
			            padding-left:8px;
			            text-align:center;
			            border-left:2px solid rgba(51,16,69,.2);
			        }
			
			        .cp-target-label {
			            margin-bottom:2px;
			            color:#7A7480;
			            font-size:12px;
			            line-height:1.2;
			            font-weight:400;
			        }
			
			        .cp-target-value {
			            color:#331045;
			            font-size:12px;
			            line-height:1.2;
			            font-weight:500;
			            white-space:nowrap;
			        }
			
			        .cp-gauge {
			            position:relative;
			            width:100%;
			            height:12px;
			            overflow:visible;
			            background:#ECE9EE;
			            border-radius:4px;
			        }
			
			        .cp-gauge-fill {
			            height:100%;
			            min-width:0;
			            border-radius:4px 0 0 4px;
			        }
			
			        .cp-target-marker {
			            position:absolute;
			            top:-4px;
			            bottom:-4px;
			            width:0;
			            transform:translateX(-1px);
			            border-left:1px dashed #7A7480;
			        }
			
			        .cp-scale {
			            display:flex;
			            align-items:center;
			            justify-content:space-between;
			            margin-top:5px;
			            color:#7A7480;
			            font-size:11px;
			            line-height:1.2;
			            white-space:nowrap;
			        }
			
			        .cp-gap {
			            margin-top:7px;
			            text-align:right;
			            font-size:12px;
			            font-weight:700;
			            white-space:nowrap;
			        }
			
			    </style>
			
			
			    <div class='cp-card'>
			
			        <div class='cp-title'>
			            Commercial Position
			        </div>
			
			
			        <div class='cp-share-row'>
			
			            <div class='cp-label'>
			                Category-Region Share
			            </div>
			
			            <div class='cp-value-group'>
			
			                <div class='cp-value'>
			                    " & _ShareFormatted & "
			                </div>
			
			                <div
			                    class='cp-delta'
			                    style='
			                        color:" & _ShareColor & ";
			                        border-color:" & _ShareColor & "55;
			                        background:" & _ShareColor & "10;'>
			
			                    " & _ShareDeltaFormatted & "
			
			                </div>
			
			            </div>
			
			        </div>
			
			
			        <div class='cp-divider'></div>
			
			
			        <div class='cp-margin-header'>
			
			            <div class='cp-margin-current'>
			
			                <div class='cp-label'>
			                    Gross Margin
			                </div>
			
			                <div
			                    class='cp-value'
			                    style='color:" & _MarginColor & ";'>
			
			                    " & _GrossMarginFormatted & "
			
			                </div>
			
			            </div>
			
			
			            <div class='cp-target'>
			
			                <div class='cp-target-label'>
			                    Target
			                </div>
			
			                <div class='cp-target-value'>
			                    " & _TargetFormatted & "
			                </div>
			
			            </div>
			
			        </div>
			
			
			        <div class='cp-gauge'>
			
			            <div
			                class='cp-gauge-fill'
			                style='
			                    width:" & _MarginWidth & ";
			                    background:" & _MarginColor & ";'>
			            </div>
			
			            <div
			                class='cp-target-marker'
			                style='left:" & _TargetPosition & ";'>
			            </div>
			
			        </div>
			
			
			        <div class='cp-scale'>
			
			            <span>0%</span>
			
			            <span>
			                " & _ScaleMidFormatted & "
			            </span>
			
			            <span>
			                " & _TargetFormatted & "
			            </span>
			
			            <span>
			                " & _ScaleMaximumFormatted & "
			            </span>
			
			        </div>
			
			
			        <div
			            class='cp-gap'
			            style='color:" & _MarginColor & ";'>
			
			            " & _MarginGapFormatted & " vs target
			
			        </div>
			
			    </div>
			    "
			)
		displayFolder: 00 Core Measures
		lineageTag: 42579841-359a-4ce1-a511-b6acf8d6ff9e

	measure 'High-Risk Drivers HTML' =
			
			VAR _SalesVolatility =
			    [Sales Volatility %]
			
			VAR _RevenueMoM =
			    [Revenue MoM %]
			
			VAR _CompetitorPressure =
			    [Competitor Pressure Score AVG]
			
			VAR _GrossMargin =
			    [Gross Margin %]
			
			VAR _MarginTarget = [Gross Margin Target %]
			
			-- Driver thresholds
			VAR _VolatilityThreshold =
			    0.20
			
			VAR _CompetitorPressureThreshold =
			    70
			
			-- Driver conditions
			VAR _HasVolatilityDriver =
			    NOT ISBLANK ( _SalesVolatility )
			        && _SalesVolatility >= _VolatilityThreshold
			
			VAR _HasSalesDropDriver =
			    NOT ISBLANK ( _RevenueMoM )
			        && _RevenueMoM < 0
			
			VAR _HasCompetitorDriver =
			    NOT ISBLANK ( _CompetitorPressure )
			        && _CompetitorPressure >= _CompetitorPressureThreshold
			
			VAR _HasMarginDriver =
			    NOT ISBLANK ( _GrossMargin )
			        && _GrossMargin < _MarginTarget
			
			VAR _DriverCount =
			    IF ( _HasVolatilityDriver, 1, 0 )
			        + IF ( _HasSalesDropDriver, 1, 0 )
			        + IF ( _HasCompetitorDriver, 1, 0 )
			        + IF ( _HasMarginDriver, 1, 0 )
			
			VAR _MarginGap =
			    _MarginTarget - _GrossMargin
			
			
			-- Dynamic driver descriptions
			VAR _VolatilityDescription =
			    "Sales volatility is "
			        & FORMAT ( _SalesVolatility, "0.0%" )
			        & ", above normal recent variation."
			
			VAR _SalesDropDescription =
			    "Revenue declined "
			        & FORMAT ( ABS ( _RevenueMoM ), "0.0%" )
			        & " versus the previous month."
			
			VAR _CompetitorDescription =
			    "Competitor pressure is "
			        & FORMAT ( _CompetitorPressure, "0" )
			        & "/100, increasing price and share pressure."
			
			VAR _MarginDescription =
			    "Gross margin is "
			        & FORMAT ( _MarginGap * 100, "0.0" )
			        & " pp below the commercial target."
			
			
			-- Conditional HTML rows
			VAR _VolatilityRow =
			    IF (
			        _HasVolatilityDriver,
			        "
			        <div class='rd-row'>
			            <div class='rd-icon'>∿</div>
			            <div class='rd-content'>
			                <div class='rd-name'>High sales volatility</div>
			                <div class='rd-description'>
			                    " & _VolatilityDescription & "
			                </div>
			            </div>
			        </div>
			        ",
			        ""
			    )
			
			VAR _SalesDropRow =
			    IF (
			        _HasSalesDropDriver,
			        "
			        <div class='rd-row'>
			            <div class='rd-icon'>↘</div>
			            <div class='rd-content'>
			                <div class='rd-name'>Recent sales drop</div>
			                <div class='rd-description'>
			                    " & _SalesDropDescription & "
			                </div>
			            </div>
			        </div>
			        ",
			        ""
			    )
			
			VAR _CompetitorRow =
			    IF (
			        _HasCompetitorDriver,
			        "
			        <div class='rd-row'>
			            <div class='rd-icon rd-people'>●●●</div>
			            <div class='rd-content'>
			                <div class='rd-name'>High competitor pressure</div>
			                <div class='rd-description'>
			                    " & _CompetitorDescription & "
			                </div>
			            </div>
			        </div>
			        ",
			        ""
			    )
			
			VAR _MarginRow =
			    IF (
			        _HasMarginDriver,
			        "
			        <div class='rd-row'>
			            <div class='rd-icon'>◎</div>
			            <div class='rd-content'>
			                <div class='rd-name'>Margin below target</div>
			                <div class='rd-description'>
			                    " & _MarginDescription & "
			                </div>
			            </div>
			        </div>
			        ",
			        ""
			    )
			
			VAR _NoDriversRow =
			    IF (
			        _DriverCount = 0,
			        "
			        <div class='rd-empty'>
			            <div class='rd-empty-icon'>✓</div>
			            <div>
			                <div class='rd-empty-title'>
			                    No major local risk drivers
			                </div>
			                <div class='rd-empty-text'>
			                    Current commercial and market indicators are within the defined thresholds.
			                </div>
			            </div>
			        </div>
			        ",
			        ""
			    )
			
			VAR _TitleColor =
			    IF (
			        _DriverCount > 0,
			        "#C53D3D",
			        "#2F855A"
			    )
			
			VAR _FooterText =
			    IF (
			        _DriverCount > 0,
			        FORMAT ( _DriverCount, "0" )
			            & " local business driver"
			            & IF ( _DriverCount = 1, "", "s" )
			            & " detected for this product-region alert",
			        "No local business drivers currently exceed their thresholds"
			    )
			
			RETURN
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .rd-card {
			            width:100%;
			            height:100%;
			            padding:5px 13px 5px;
			            color:#26232A;
			            background:#FFFFFF;
			            border:1px solid " & _TitleColor & "55;
			            border-radius:8px;
			        }
			
			        .rd-title {
			            margin-bottom:7px;
			            color:" & _TitleColor & ";
			            font-size:15px;
			            font-weight:700;
			            text-transform:uppercase;
			        }
			
			        .rd-list {
			            width:100%;
			            overflow:hidden;
			            border:1px solid " & _TitleColor & "35;
			            border-radius:6px;
			        }
			
			        .rd-row {
			            display:grid;
			            grid-template-columns:40px minmax(0,1fr);
			            align-items:center;
			            min-width:0;
			            min-height:46px;
			            border-bottom:1px solid " & _TitleColor & "30;
			        }
			
			        .rd-row:last-child {
			            border-bottom:none;
			        }
			
			        .rd-icon {
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            height:100%;
			            color:#C53D3D;
			            font-family:'Segoe UI Symbol','Segoe UI',sans-serif;
			            font-size:27px;
			            line-height:1;
			            font-weight:700;
			            border-right:1px solid " & _TitleColor & "30;
			        }
			
			        .rd-people {
			            font-size:10px;
			            letter-spacing:-2px;
			        }
			
			        .rd-content {
			            min-width:0;
			            padding:5px 5px;
			        }
			
			        .rd-name {
			            margin-bottom:2px;
			            overflow:hidden;
			            color:#3E3941;
			            font-size:10px;
			            line-height:1.15;
			            font-weight:700;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .rd-description {
			            overflow:hidden;
			            color:#6E6871;
			            font-size:10px;
			            line-height:1.25;
			        }
			
			        .rd-empty {
			            display:grid;
			            grid-template-columns:40px minmax(0,1fr);
			            align-items:center;
			            min-height:72px;
			            padding:8px;
			            color:#2F855A;
			            background:#F0F7F2;
			        }
			
			        .rd-empty-icon {
			            font-size:25px;
			            font-weight:700;
			            text-align:center;
			        }
			
			        .rd-empty-title {
			            margin-bottom:3px;
			            font-size:10px;
			            font-weight:700;
			        }
			
			        .rd-empty-text {
			            color:#5F7667;
			            font-size:10px;
			            line-height:1.3;
			        }
			
			        .rd-footer {
			            margin-top:7px;
			            color:" & _TitleColor & ";
			            font-size:10px;
			            line-height:1.2;
			            font-style:italic;
			        }
			    </style>
			
			    <div class='rd-card'>
			
			        <div class='rd-title'>
			            "
			            & IF (
			                _DriverCount > 0,
			                "Why this product is High Risk",
			                "Product Risk Drivers"
			            )
			            & "
			        </div>
			
			        <div class='rd-list'>
			            "
			            & _VolatilityRow
			            & _SalesDropRow
			            & _CompetitorRow
			            & _MarginRow
			            & _NoDriversRow
			            & "
			        </div>
			
			        <div class='rd-footer'>
			            " & _FooterText & "
			        </div>
			
			    </div>
			    "
		displayFolder: 01 Risk
		lineageTag: cd17975a-33e0-49dc-b39b-75da1176334d

	measure 'Gross Margin Target %' = AVERAGE(dimProduct[target_margin_pct])
		displayFolder: 02 Margin
		lineageTag: 1c97806e-3e13-4c5d-9908-77b67e318224

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Category-Region Share %' =
			
			VAR _ProductUnits =
			    [Units]
			
			VAR _CategoryRegionUnits =
			    CALCULATE (
			        [Units],
			        REMOVEFILTERS (
			            dimProduct[product_id],
			            dimProduct[product_name]
			        )
			    )
			
			RETURN
			    DIVIDE (
			        _ProductUnits,
			        _CategoryRegionUnits
			    )
		displayFolder: 05 Products
		lineageTag: dbc4bec7-2459-4d51-8981-1ea92294e134

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Volatility %' =
			
			VAR _EndDate =
			    MAX ( dimDate[Date] )
			
			VAR _Last6Months =
			    CALCULATETABLE (
			        VALUES ( dimDate[MonthStartDate] ),
			        REMOVEFILTERS ( dimDate ),
			        DATESINPERIOD (
			            dimDate[Date],
			            _EndDate,
			            -6,
			            MONTH
			        )
			    )
			
			VAR _MonthlyRevenue =
			    FILTER (
			        ADDCOLUMNS (
			            _Last6Months,
			            "@Revenue",
			                CALCULATE ( [Revenue] )
			        ),
			        NOT ISBLANK ( [@Revenue] )
			    )
			
			VAR _AverageRevenue =
			    AVERAGEX (
			        _MonthlyRevenue,
			        [@Revenue]
			    )
			
			VAR _RevenueStandardDeviation =
			    STDEVX.P (
			        _MonthlyRevenue,
			        [@Revenue]
			    )
			
			VAR _AvailableMonths =
			    COUNTROWS ( _MonthlyRevenue )
			
			RETURN
			    IF (
			        _AvailableMonths >= 3,
			        DIVIDE (
			            _RevenueStandardDeviation,
			            ABS ( _AverageRevenue )
			        )
			    )
		displayFolder: 00 Core Measures
		lineageTag: 86563ce0-bdae-4363-955a-823b927fcbff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue PM' =
			
			CALCULATE (
			    [Revenue],
			    DATEADD ( dimDate[Date], -1, MONTH ))
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 00 Core Measures
		lineageTag: c75eb492-6664-45a1-8c4e-429ac7f64dc6

		annotation PBI_FormatHint = {"currencyCulture":"en-DE"}

	measure 'Revenue MoM %' =
			
			VAR _CurrentRevenue =
			    [Revenue]
			VAR _PreviousMonthRevenue =
			    [Revenue PM]
			RETURN
			    DIVIDE (
			        _CurrentRevenue - _PreviousMonthRevenue,
			        ABS ( _PreviousMonthRevenue )
			    )
		displayFolder: 00 Core Measures
		lineageTag: 6bcdf8e3-dc09-4440-8bdf-d2c804acc694

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Market Demand Score' =
			
			VAR _Score =
			    AVERAGE (
			        factMlPredictions[market_demand_index]
			    )
			VAR _Min = 42
			VAR _Max = 180
			RETURN
			    MIN (
			        100,
			        MAX (
			            0,
			            DIVIDE ( _Score - _Min, _Max - _Min ) * 100))
		displayFolder: 00 Core Measures
		lineageTag: f2e79dea-cafd-4a5f-ae93-ba4847ddb2d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Competitor Pressure Score AVG' = AVERAGE(factMlPredictions[competitor_pressure_index])
		displayFolder: 00 Core Measures
		lineageTag: d14a55b3-0ea6-442e-b2b0-cb28993f78cf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Units 3M Avg' =
			
			VAR _EndDate =
			    MAX ( dimDate[Date] )
			
			VAR _Months =
			    CALCULATETABLE (
			        VALUES ( dimDate[MonthStartDate] ),
			        REMOVEFILTERS ( dimDate ),
			        DATESINPERIOD (
			            dimDate[Date],
			            _EndDate,
			            -3,
			            MONTH
			        )
			    )
			
			RETURN
			    AVERAGEX (
			        _Months,
			        CALCULATE ( [Units] )
			    )
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 00 Core Measures
		lineageTag: 0c8cc531-995f-41a3-a592-b2e6f97d488b

		annotation PBI_FormatHint = {"currencyCulture":"en-DE"}

	measure 'Units 6M Avg' =
			
			VAR _EndDate =
			    MAX ( dimDate[Date] )
			
			VAR _Months =
			    CALCULATETABLE (
			        VALUES ( dimDate[MonthStartDate] ),
			        REMOVEFILTERS ( dimDate ),
			        DATESINPERIOD (
			            dimDate[Date],
			            _EndDate,
			            -6,
			            MONTH
			        )
			    )
			
			RETURN
			    AVERAGEX (
			        _Months,
			        CALCULATE ( [Units] )
			    )
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 00 Core Measures
		lineageTag: 8bc321ee-3395-46c6-b9d3-68f2114e8478

		annotation PBI_FormatHint = {"currencyCulture":"en-DE"}

	measure 'Revenue Risks HTML' =
			
			VAR _DecliningCustomers =
			    [Declining Customers]
			
			VAR _DecliningCustomersPY =
			    CALCULATE (
			        [Declining Customers],
			        SAMEPERIODLASTYEAR ( dimDate[Date] )
			    )
			
			VAR _DecliningCustomersVsPY =
			    _DecliningCustomers - _DecliningCustomersPY
			
			VAR _HasCustomersPY =
			    NOT ISBLANK ( _DecliningCustomersPY )
			
			
			VAR _DecliningProducts =
			    [Declining Products]
			
			VAR _DecliningProductsPY =
			    CALCULATE (
			        [Declining Products],
			        SAMEPERIODLASTYEAR ( dimDate[Date] )
			    )
			
			VAR _DecliningProductsVsPY =
			    _DecliningProducts - _DecliningProductsPY
			
			VAR _HasProductsPY =
			    NOT ISBLANK ( _DecliningProductsPY )
			
			
			VAR _RevenueAtRisk =
			    [Revenue at Risk]
			
			VAR _RevenueAtRiskVsPY =
			    [Revenue at Risk % of Total YoY pp]
			
			VAR _HasRevenueRiskPY =
			    NOT ISBLANK ( _RevenueAtRiskVsPY )
			
			
			-- KPI values
			VAR _DecliningCustomersFormatted =
			    IF (
			        ISBLANK ( _DecliningCustomers ),
			        "—",
			        FORMAT ( _DecliningCustomers, "#,0" )
			    )
			
			VAR _DecliningProductsFormatted =
			    IF (
			        ISBLANK ( _DecliningProducts ),
			        "—",
			        FORMAT ( _DecliningProducts, "#,0" )
			    )
			
			VAR _RevenueAtRiskFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _RevenueAtRisk ),
			            "—",
			        ABS ( _RevenueAtRisk ) >= 1000000000,
			            "€"
			                & FORMAT ( _RevenueAtRisk / 1000000000, "0.#" )
			                & "B",
			        ABS ( _RevenueAtRisk ) >= 1000000,
			            "€"
			                & FORMAT ( _RevenueAtRisk / 1000000, "0.#" )
			                & "M",
			        ABS ( _RevenueAtRisk ) >= 1000,
			            "€"
			                & FORMAT ( _RevenueAtRisk / 1000, "0.#" )
			                & "K",
			        "€" & FORMAT ( _RevenueAtRisk, "#,0" )
			    )
			
			
			-- Direction arrows
			VAR _CustomersArrow =
			    SWITCH (
			        TRUE (),
			        _DecliningCustomersVsPY > 0, "▲ ",
			        _DecliningCustomersVsPY < 0, "▼ ",
			        "— "
			    )
			
			VAR _ProductsArrow =
			    SWITCH (
			        TRUE (),
			        _DecliningProductsVsPY > 0, "▲ ",
			        _DecliningProductsVsPY < 0, "▼ ",
			        "— "
			    )
			
			VAR _RevenueRiskArrow =
			    SWITCH (
			        TRUE (),
			        _RevenueAtRiskVsPY > 0, "▲ ",
			        _RevenueAtRiskVsPY < 0, "▼ ",
			        "— "
			    )
			
			
			-- Lower risk is better
			VAR _CustomersTrendColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _HasCustomersPY ),     "#7A7480",
			        _DecliningCustomersVsPY < 0, "#2F855A",
			        _DecliningCustomersVsPY > 0, "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _ProductsTrendColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _HasProductsPY ),     "#7A7480",
			        _DecliningProductsVsPY < 0, "#2F855A",
			        _DecliningProductsVsPY > 0, "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _RevenueRiskTrendColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _HasRevenueRiskPY ), "#7A7480",
			        _RevenueAtRiskVsPY < 0,    "#2F855A",
			        _RevenueAtRiskVsPY > 0,    "#C53D3D",
			        "#7A7480"
			    )
			
			
			-- Comparison labels
			VAR _CustomersComparison =
			    IF (
			        NOT ( _HasCustomersPY ),
			        "— No PY data",
			        _CustomersArrow
			            & FORMAT (
			                ABS ( _DecliningCustomersVsPY ),
			                "#,0"
			            )
			            & " vs PY"
			    )
			
			VAR _ProductsComparison =
			    IF (
			        NOT ( _HasProductsPY ),
			        "— No PY data",
			        _ProductsArrow
			            & FORMAT (
			                ABS ( _DecliningProductsVsPY ),
			                "#,0"
			            )
			            & " vs PY"
			    )
			
			VAR _RevenueRiskComparison =
			    IF (
			        NOT ( _HasRevenueRiskPY ),
			        "— No PY data",
			        _RevenueRiskArrow
			            & FORMAT (
			                ABS ( _RevenueAtRiskVsPY ) * 100,
			                "0.0"
			            )
			            & " pp vs PY"
			    )
			
			
			RETURN
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .rr-container {
			            width:100%;
			            background:transparent;
			        }
			
			        .rr-title {
			            padding:1px 2px 6px;
			            color:#26232A;
			            font-size:10px;
			            line-height:1.2;
			            font-weight:700;
			            letter-spacing:.035em;
			            text-transform:uppercase;
			        }
			
			        .rr-grid {
			            display:grid;
			            grid-template-columns:repeat(3,minmax(0,1fr));
			            gap:6px;
			            width:100%;
			            background:transparent;
			        }
			
			        .rr-card {
			            position:relative;
			            min-width:0;
			            padding:9px 10px 8px;
			            overflow:hidden;
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.14);
			            border-radius:8px;
			        }
			
			        .rr-accent {
			            position:absolute;
			            top:0;
			            left:0;
			            width:100%;
			            height:3px;
			        }
			
			        .rr-label {
			            margin-bottom:4px;
			            overflow:hidden;
			            color:#5F5962;
			            font-size:9px;
			            line-height:1.2;
			            font-weight:700;
			            letter-spacing:.035em;
			            text-transform:uppercase;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .rr-value {
			            margin-bottom:5px;
			            overflow:hidden;
			            font-size:clamp(18px,2vw,24px);
			            line-height:1;
			            font-weight:700;
			            letter-spacing:-.03em;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .rr-bottom {
			            display:flex;
			            align-items:center;
			            gap:4px;
			            min-width:0;
			            overflow:hidden;
			        }
			
			        .rr-delta {
			            flex-shrink:0;
			            padding:1px 4px;
			            border:1px solid;
			            border-radius:3px;
			            font-size:8px;
			            line-height:1.25;
			            font-weight:600;
			            white-space:nowrap;
			        }
			
			        .rr-meta {
			            min-width:0;
			            overflow:hidden;
			            color:#7A7480;
			            font-size:8px;
			            line-height:1.25;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        @media (max-width:420px) {
			            .rr-grid {
			                gap:4px;
			            }
			
			            .rr-card {
			                padding:8px 6px 7px;
			            }
			
			            .rr-label {
			                font-size:8px;
			            }
			
			            .rr-value {
			                font-size:16px;
			            }
			
			            .rr-delta,
			            .rr-meta {
			                font-size:7px;
			            }
			        }
			    </style>
			
			    <div class='rr-container'>
			
			        <div class='rr-title'>
			            Revenue Risks
			        </div>
			
			        <div class='rr-grid'>
			
			            <div class='rr-card'>
			
			                <div class='rr-accent'
			                     style='background:#C53D3D'>
			                </div>
			
			                <div class='rr-label'>
			                    Declining Customers
			                </div>
			
			                <div class='rr-value'
			                     style='color:#C53D3D'>
			                    " & _DecliningCustomersFormatted & "
			                </div>
			
			                <div class='rr-bottom'>
			
			                    <span class='rr-delta'
			                          style='
			                              color:" & _CustomersTrendColor & ";
			                              border-color:" & _CustomersTrendColor & "55;
			                              background:" & _CustomersTrendColor & "10;'>
			                        " & _CustomersComparison & "
			                    </span>
			
			                    <span class='rr-meta'>
			                        customers declining
			                    </span>
			
			                </div>
			
			            </div>
			
			
			            <div class='rr-card'>
			
			                <div class='rr-accent'
			                     style='background:#D99A2B'>
			                </div>
			
			                <div class='rr-label'>
			                    Declining Products
			                </div>
			
			                <div class='rr-value'
			                     style='color:#D99A2B'>
			                    " & _DecliningProductsFormatted & "
			                </div>
			
			                <div class='rr-bottom'>
			
			                    <span class='rr-delta'
			                          style='
			                              color:" & _ProductsTrendColor & ";
			                              border-color:" & _ProductsTrendColor & "55;
			                              background:" & _ProductsTrendColor & "10;'>
			                        " & _ProductsComparison & "
			                    </span>
			
			                    <span class='rr-meta'>
			                        products declining
			                    </span>
			
			                </div>
			
			            </div>
			
			
			            <div class='rr-card'>
			
			                <div class='rr-accent'
			                     style='background:#331045'>
			                </div>
			
			                <div class='rr-label'>
			                    Revenue at Risk
			                </div>
			
			                <div class='rr-value'
			                     style='color:#331045'>
			                    " & _RevenueAtRiskFormatted & "
			                </div>
			
			                <div class='rr-bottom'>
			
			                    <span class='rr-delta'
			                          style='
			                              color:" & _RevenueRiskTrendColor & ";
			                              border-color:" & _RevenueRiskTrendColor & "55;
			                              background:" & _RevenueRiskTrendColor & "10;'>
			                        " & _RevenueRiskComparison & "
			                    </span>
			
			                    <span class='rr-meta'>
			                        revenue exposed
			                    </span>
			
			                </div>
			
			            </div>
			
			        </div>
			
			    </div>
			    "
		displayFolder: 01 Risk
		lineageTag: 73d8626e-5803-4119-b939-be6813987070

	measure 'Ex Priority Actions HTML' =
			
			VAR _LatestMonth =
			    CALCULATE (
			        MAX ( dimDate[Date])
			    )
			
			VAR _LatestMonthLabel =
			    FORMAT (
			        _LatestMonth,
			        "MMM yyyy",
			        "en-US"
			    )
			
			
			-- Product-region data for the latest ML month
			VAR _BaseData =
			    CALCULATETABLE (
			        SUMMARIZECOLUMNS (
			            dimProduct[product_id],
			            dimProduct[sku],
			            dimProduct[product_name],
			            dimProduct[lifecycle_stage],
			            dimRegion[region],
			
			            "@RiskScore", [Risk Score normalized AVG],
			            "@Revenue", [Revenue],
			            "@RevenuePM",
			                CALCULATE (
			                    [Revenue],
			                    DATEADD ( dimDate[Date], -1, MONTH )
			                ),
			
			            "@Units", [Units],
			            "@UnitsPM",
			                CALCULATE (
			                    [Units],
			                    DATEADD ( dimDate[Date], -1, MONTH )
			                ),
			
			            "@Customers", [Customers Active],
			            "@CustomersPM",
			                CALCULATE (
			                    [Customers Active],
			                    DATEADD ( dimDate[Date], -1, MONTH )
			                ),
			
			            "@Share", [Category-Region Share %],
			            "@SharePM",
			                CALCULATE (
			                    [Category-Region Share %],
			                    DATEADD ( dimDate[Date], -1, MONTH )
			                ),
			
			            "@GrossMargin", [Gross Margin %],
			
			            "@TargetMargin",
			                SELECTEDVALUE (
			                    dimProduct[target_margin_pct]
			                ),
			
			            "@Volatility", [Sales Volatility %],
			            "@Competition", [Competitor Pressure Score AVG]
			        ),
			
			        REMOVEFILTERS ( dimDate ),
			
			        TREATAS (
			            { _LatestMonth },dimDate[Date]),
			
			        TREATAS (
			            { _LatestMonth },
			            dimDate[MonthStartDate]
			        )
			    )
			
			
			-- Changes and risk gaps
			VAR _EnrichedData =
			    ADDCOLUMNS (
			        _BaseData,
			
			        "@RevenueMoM",
			            DIVIDE (
			                [@Revenue] - [@RevenuePM],
			                ABS ( [@RevenuePM] )
			            ),
			
			        "@UnitsMoM",
			            DIVIDE (
			                [@Units] - [@UnitsPM],
			                ABS ( [@UnitsPM] )
			            ),
			
			        "@CustomerMoM",
			            DIVIDE (
			                [@Customers] - [@CustomersPM],
			                ABS ( [@CustomersPM] )
			            ),
			
			        "@CustomerDelta",
			            [@Customers] - [@CustomersPM],
			
			        "@ShareDelta",
			            [@Share] - [@SharePM],
			
			        "@MarginGap",
			            [@GrossMargin] - [@TargetMargin]
			    )
			
			
			-- High-risk threshold
			VAR _CriticalProducts =
			    FILTER (
			        _EnrichedData,
			        NOT ISBLANK ( [@RiskScore] )
			            && [@RiskScore] >= 8
			    )
			
			VAR _CriticalCount =
			    COUNTROWS ( _CriticalProducts )
			
			VAR _TopCriticalProducts =
			    TOPN (
			        5,
			        _CriticalProducts,
			        [@RiskScore], DESC,
			        [@Revenue], DESC,
			        dimProduct[product_id], ASC
			    )
			
			VAR _BadgeText =
			    IF (
			        _CriticalCount > 5,
			        "Top 5 of "
			            & FORMAT ( _CriticalCount, "#,0" )
			            & " critical products",
			        FORMAT ( _CriticalCount, "#,0" )
			            & " critical product"
			            & IF ( _CriticalCount = 1, "", "s" )
			    )
			
			
			-- Generate the HTML table rows
			VAR _TableRows =
			    CONCATENATEX (
			        _TopCriticalProducts,
			
			        VAR _SKU =
			            COALESCE (
			                dimProduct[sku],
			                "No SKU"
			            )
			
			        VAR _ProductName =
			            COALESCE (
			                dimProduct[product_name],
			                "Unnamed product"
			            )
			
			        VAR _Region =
			            COALESCE (
			                dimRegion[region],
			                "Not assigned"
			            )
			
			        VAR _Lifecycle =
			            COALESCE (
			                dimProduct[lifecycle_stage],
			                "Unknown"
			            )
			
			        VAR _RiskScore =
			            [@RiskScore]
			
			        VAR _Revenue =
			            [@Revenue]
			
			        VAR _RevenueMoM =
			            [@RevenueMoM]
			
			        VAR _UnitsMoM =
			            [@UnitsMoM]
			
			        VAR _CustomerMoM =
			            [@CustomerMoM]
			
			        VAR _CustomerDelta =
			            [@CustomerDelta]
			
			        VAR _ShareDelta =
			            [@ShareDelta]
			
			        VAR _MarginGap =
			            [@MarginGap]
			
			        VAR _Volatility =
			            [@Volatility]
			
			        VAR _Competition =
			            [@Competition]
			
			
			        -- Driver conditions
			        VAR _HighVolatility =
			            NOT ISBLANK ( _Volatility )
			                && _Volatility >= 0.40
			
			        VAR _SalesDrop =
			            NOT ISBLANK ( _RevenueMoM )
			                && _RevenueMoM < 0
			
			        VAR _HighCompetition =
			            NOT ISBLANK ( _Competition )
			                && _Competition >= 70
			
			        VAR _MarginBelowTarget =
			            NOT ISBLANK ( _MarginGap )
			                && _MarginGap < 0
			
			        VAR _CustomerDrop =
			            NOT ISBLANK ( _CustomerMoM )
			                && _CustomerMoM < 0
			
			        VAR _ShareDrop =
			            NOT ISBLANK ( _ShareDelta )
			                && _ShareDelta < 0
			
			
			        -- Select a maximum of two primary drivers
			        VAR _AvailableDrivers =
			            FILTER (
			                UNION (
			                    ROW (
			                        "DriverPriority", 1,
			                        "DriverLabel", "High sales volatility",
			                        "ShowDriver", _HighVolatility
			                    ),
			                    ROW (
			                        "DriverPriority", 2,
			                        "DriverLabel", "Recent sales drop",
			                        "ShowDriver", _SalesDrop
			                    ),
			                    ROW (
			                        "DriverPriority", 3,
			                        "DriverLabel", "Margin below target",
			                        "ShowDriver", _MarginBelowTarget
			                    ),
			                    ROW (
			                        "DriverPriority", 4,
			                        "DriverLabel", "High competition",
			                        "ShowDriver", _HighCompetition
			                    ),
			                    ROW (
			                        "DriverPriority", 5,
			                        "DriverLabel", "Customer drop",
			                        "ShowDriver", _CustomerDrop
			                    ),
			                    ROW (
			                        "DriverPriority", 6,
			                        "DriverLabel", "Category share drop",
			                        "ShowDriver", _ShareDrop
			                    )
			                ),
			                [ShowDriver]
			            )
			
			        VAR _TopDrivers =
			            TOPN (
			                2,
			                _AvailableDrivers,
			                [DriverPriority], ASC
			            )
			
			        VAR _DriverTags =
			            IF (
			                COUNTROWS ( _TopDrivers ) = 0,
			                "<span class='pa-tag'>Elevated model risk</span>",
			                CONCATENATEX (
			                    _TopDrivers,
			                    "<span class='pa-tag'>"
			                        & [DriverLabel]
			                        & "</span>",
			                    ""
			                )
			            )
			
			
			        -- Find the most material negative change
			        VAR _ChangeCandidates =
			            FILTER (
			                UNION (
			                    ROW (
			                        "ChangePriority", 1,
			                        "Severity",
			                            IF (
			                                _UnitsMoM < 0,
			                                DIVIDE ( ABS ( _UnitsMoM ), 0.20 ),
			                                -1
			                            ),
			                        "ChangeText",
			                            "−"
			                                & FORMAT ( ABS ( _UnitsMoM ), "0.0%" )
			                                & " units"
			                    ),
			                    ROW (
			                        "ChangePriority", 2,
			                        "Severity",
			                            IF (
			                                _RevenueMoM < 0,
			                                DIVIDE ( ABS ( _RevenueMoM ), 0.20 ),
			                                -1
			                            ),
			                        "ChangeText",
			                            "−"
			                                & FORMAT ( ABS ( _RevenueMoM ), "0.0%" )
			                                & " revenue"
			                    ),
			                    ROW (
			                        "ChangePriority", 3,
			                        "Severity",
			                            IF (
			                                _CustomerMoM < 0,
			                                DIVIDE ( ABS ( _CustomerMoM ), 0.20 ),
			                                -1
			                            ),
			                        "ChangeText",
			                            "−"
			                                & FORMAT ( ABS ( _CustomerDelta ), "#,0" )
			                                & " customers"
			                    ),
			                    ROW (
			                        "ChangePriority", 4,
			                        "Severity",
			                            IF (
			                                _ShareDelta < 0,
			                                DIVIDE ( ABS ( _ShareDelta ), 0.05 ),
			                                -1
			                            ),
			                        "ChangeText",
			                            "−"
			                                & FORMAT (
			                                    ABS ( _ShareDelta ) * 100,
			                                    "0.0"
			                                )
			                                & " pp share"
			                    ),
			                    ROW (
			                        "ChangePriority", 5,
			                        "Severity",
			                            IF (
			                                _MarginGap < 0,
			                                DIVIDE ( ABS ( _MarginGap ), 0.10 ),
			                                -1
			                            ),
			                        "ChangeText",
			                            "−"
			                                & FORMAT (
			                                    ABS ( _MarginGap ) * 100,
			                                    "0.0"
			                                )
			                                & " pp margin"
			                    )
			                ),
			                [Severity] >= 0
			            )
			
			        VAR _MostMaterialChange =
			            TOPN (
			                1,
			                _ChangeCandidates,
			                [Severity], DESC,
			                [ChangePriority], ASC
			            )
			
			        VAR _LatestChangeText =
			            IF (
			                COUNTROWS ( _MostMaterialChange ) = 0,
			                "— Stable",
			                MAXX (
			                    _MostMaterialChange,
			                    [ChangeText]
			                )
			            )
			
			        VAR _LatestChangeColor =
			            IF (
			                COUNTROWS ( _MostMaterialChange ) = 0,
			                "#7A7480",
			                "#C53D3D"
			            )
			
			
			        -- Formatting
			        VAR _RiskWidth =
			            FORMAT (
			                DIVIDE (
			                    MAX ( 0, MIN ( 10, _RiskScore ) ),
			                    10
			                ),
			                "0.0%",
			                "en-US"
			            )
			
			        VAR _RiskFormatted =
			            FORMAT ( _RiskScore, "0.0" )
			
			        VAR _RevenueFormatted =
			            SWITCH (
			                TRUE (),
			                ISBLANK ( _Revenue ), "—",
			                ABS ( _Revenue ) >= 1000000000,
			                    FORMAT ( _Revenue / 1000000000, "€0.00" ) & "B",
			                ABS ( _Revenue ) >= 1000000,
			                    FORMAT ( _Revenue / 1000000, "€0.00" ) & "M",
			                ABS ( _Revenue ) >= 1000,
			                    FORMAT ( _Revenue / 1000, "€0.0" ) & "K",
			                FORMAT ( _Revenue, "€#,0" )
			            )
			
			        RETURN
			            "
			            <div class='pa-row'>
			
			                <div class='pa-product'>
			                    <span class='pa-sku'>" & _SKU & "</span>
			                    <span class='pa-product-name'>" & _ProductName & "</span>
			                </div>
			
			                <div class='pa-cell pa-ellipsis'>
			                    " & _Region & "
			                </div>
			
			                <div class='pa-risk'>
			                    <div class='pa-risk-track'>
			                        <div class='pa-risk-fill'
			                             style='width:" & _RiskWidth & "'>
			                        </div>
			
			                        <span class='pa-risk-value'>
			                            " & _RiskFormatted & "
			                        </span>
			                    </div>
			                </div>
			
			                <div class='pa-cell pa-revenue'>
			                    " & _RevenueFormatted & "
			                </div>
			
			                <div class='pa-drivers'>
			                    " & _DriverTags & "
			                </div>
			
			                <div class='pa-cell pa-lifecycle'>
			                    " & _Lifecycle & "
			                </div>
			
			                <div class='pa-cell pa-change'
			                     style='color:" & _LatestChangeColor & "'>
			                    " & _LatestChangeText & "
			                </div>
			
			            </div>
			            ",
			        "",
			        [@RiskScore], DESC
			    )
			
			
			RETURN
			IF (
			    ISBLANK ( _LatestMonth ),
			    "
			    <div style='
			        padding:8px;
			        color:#7A7480;
			        background:transparent;
			        font:8px Segoe UI,Arial,sans-serif;'>
			        No priority-action data
			    </div>
			    ",
			    IF (
			        _CriticalCount = 0,
			        "
			        <style>
			            * {
			                box-sizing:border-box;
			                margin:0;
			                padding:0;
			                font-family:'Segoe UI',Arial,sans-serif;
			            }
			
			            .pa-empty {
			                padding:14px;
			                color:#2F855A;
			                background:#F0F7F2;
			                border:1px solid rgba(47,133,90,.25);
			                border-radius:8px;
			            }
			
			            .pa-empty-title {
			                margin-bottom:4px;
			                font-size:11px;
			                font-weight:700;
			            }
			
			            .pa-empty-text {
			                color:#587060;
			                font-size:8px;
			                line-height:1.3;
			            }
			        </style>
			
			        <div class='pa-empty'>
			            <div class='pa-empty-title'>
			                No critical products
			            </div>
			
			            <div class='pa-empty-text'>
			                No product-region combinations exceed the 7.5 risk-score threshold for "
			                    & _LatestMonthLabel & ".
			            </div>
			        </div>
			        ",
			        "
			        <style>
			            * {
			                box-sizing:border-box;
			                margin:0;
			                padding:0;
			                font-family:'Segoe UI',Arial,sans-serif;
			            }
			
			            .pa-card {
			                width:100%;
			                overflow:hidden;
			                color:#26232A;
			                background:#FFFFFF;
			                border:1px solid rgba(51,16,69,.12);
			                border-radius:8px;
			            }
			
			            .pa-titlebar {
			                display:flex;
			                align-items:center;
			                gap:7px;
			                padding:7px 9px 6px;
			                border-bottom:1px solid rgba(51,16,69,.12);
			            }
			
			            .pa-title {
			                color:#331045;
			                font-size:10px;
			                line-height:1.2;
			                font-weight:700;
			                white-space:nowrap;
			            }
			
			            .pa-month {
			                color:#7A7480;
			                font-size:8px;
			                line-height:1.2;
			                white-space:nowrap;
			            }
			
			            .pa-badge {
			                padding:1px 5px;
			                color:#C53D3D;
			                background:#FFF3F3;
			                border:1px solid rgba(197,61,61,.3);
			                border-radius:3px;
			                font-size:7px;
			                line-height:1.3;
			                font-weight:600;
			                white-space:nowrap;
			            }
			
			            .pa-grid,
			            .pa-row {
			                display:grid;
			                grid-template-columns:
			                    minmax(150px,1.8fr)
			                    minmax(75px,.9fr)
			                    minmax(80px,.8fr)
			                    minmax(70px,.75fr)
			                    minmax(160px,1.7fr)
			                    minmax(65px,.7fr)
			                    minmax(95px,1fr);
			                align-items:center;
			                min-width:0;
			            }
			
			            .pa-grid {
			                min-height:23px;
			                color:#5F5962;
			                background:#F7F5F7;
			                border-bottom:1px solid rgba(51,16,69,.12);
			                font-size:7px;
			                line-height:1.1;
			                font-weight:700;
			                text-transform:uppercase;
			                letter-spacing:.03em;
			            }
			
			            .pa-grid > div,
			            .pa-row > div {
			                min-width:0;
			                padding:5px 7px;
			                border-right:1px solid rgba(51,16,69,.08);
			            }
			
			            .pa-grid > div:last-child,
			            .pa-row > div:last-child {
			                border-right:none;
			            }
			
			            .pa-row {
			                min-height:31px;
			                color:#4F4952;
			                border-bottom:1px solid rgba(51,16,69,.08);
			                font-size:8px;
			                line-height:1.15;
			            }
			
			            .pa-row:last-child {
			                border-bottom:none;
			            }
			
			            .pa-row:nth-child(even) {
			                background:#FBFAFB;
			            }
			
			            .pa-product {
			                display:flex;
			                align-items:center;
			                gap:4px;
			                overflow:hidden;
			                white-space:nowrap;
			            }
			
			            .pa-sku {
			                flex-shrink:0;
			                color:#331045;
			                font-weight:700;
			            }
			
			            .pa-product-name,
			            .pa-ellipsis,
			            .pa-change {
			                overflow:hidden;
			                white-space:nowrap;
			                text-overflow:ellipsis;
			            }
			
			            .pa-product-name {
			                color:#4F4952;
			            }
			
			            .pa-risk-track {
			                position:relative;
			                width:100%;
			                height:14px;
			                overflow:hidden;
			                background:#F3E8E8;
			                border-radius:3px;
			            }
			
			            .pa-risk-fill {
			                position:absolute;
			                inset:0 auto 0 0;
			                background:#C53D3D;
			                border-radius:3px;
			            }
			
			            .pa-risk-value {
			                position:relative;
			                z-index:1;
			                display:flex;
			                align-items:center;
			                height:100%;
			                padding-left:5px;
			                color:#FFFFFF;
			                font-size:8px;
			                font-weight:700;
			            }
			
			            .pa-revenue {
			                color:#331045;
			                font-weight:600;
			                white-space:nowrap;
			            }
			
			            .pa-drivers {
			                display:flex;
			                align-items:center;
			                gap:3px;
			                overflow:hidden;
			                white-space:nowrap;
			            }
			
			            .pa-tag {
			                display:inline-block;
			                max-width:105px;
			                padding:2px 4px;
			                overflow:hidden;
			                color:#625B66;
			                background:#F0EEF1;
			                border-radius:3px;
			                font-size:6.5px;
			                line-height:1.1;
			                white-space:nowrap;
			                text-overflow:ellipsis;
			            }
			
			            .pa-lifecycle {
			                white-space:nowrap;
			            }
			
			            .pa-change {
			                font-weight:700;
			            }
			        </style>
			
			        <div class='pa-card'>
			
			            <div class='pa-titlebar'>
			                <div class='pa-title'>
			                    Priority Actions &#183; Latest Month
			                </div>
			
			                <div class='pa-month'>
			                    " & _LatestMonthLabel & "
			                </div>
			
			                <div class='pa-badge'>
			                    " & _BadgeText & "
			                </div>
			            </div>
			
			            <div class='pa-grid'>
			                <div>Product</div>
			                <div>Region</div>
			                <div>Risk Score</div>
			                <div>Revenue</div>
			                <div>Primary Drivers</div>
			                <div>Lifecycle</div>
			                <div>Latest Change</div>
			            </div>
			
			            " & _TableRows & "
			
			        </div>
			        "
			    )
			)
		displayFolder: 08 Executive
		lineageTag: 7cbda494-252e-4ab2-8b1b-aeefbc6f6736

	measure 'Risk Matrix HTML' =
			
			VAR _LatestMonth =
			    CALCULATE (
			        MAX ( factMlPredictions[year_month] ),
			        REMOVEFILTERS ( dimDate ),
			        REMOVEFILTERS ( factMlPredictions[year_month] )
			    )
			
			VAR _MonthStart =
			    DATE (
			        YEAR ( _LatestMonth ),
			        MONTH ( _LatestMonth ),
			        1
			    )
			
			VAR _MonthEnd =
			    EOMONTH ( _MonthStart, 0 )
			
			VAR _LatestMonthLabel =
			    FORMAT (
			        _MonthStart,
			        "MMM yyyy",
			        "en-US"
			    )
			
			
			-- Visible regions
			VAR _RegionValues =
			    FILTER (
			        VALUES ( dimRegion[country] ),
			        NOT ISBLANK ( dimRegion[country] )
			    )
			
			VAR _RegionTable =
			    ADDCOLUMNS (
			        _RegionValues,
			        "@RegionSort",
			            SWITCH (
			                dimRegion[country],
			                "Germany", 1,
			                "France", 2,
			                "Spain", 3,
			                "Slovakia", 4,
			                "Italy", 5,
			                "United Kingdom", 6,
			                "Ireland", 7,
			                "Poland", 8,
			                "Belgium", 9,
			                "Finland", 10,
			                99
			            )
			    )
			
			
			-- Visible product groups
			VAR _GroupValues =
			    FILTER (
			        VALUES ( dimProduct[product_family] ),
			        NOT ISBLANK ( dimProduct[product_family] )
			    )
			
			VAR _GroupTable =
			    ADDCOLUMNS (
			        _GroupValues,
			        "@GroupSort",
			            SWITCH (
			                dimProduct[product_family],
			                "IT", 1,
			                "Medical", 2,
			                "Accessories", 3,
			                "Services", 4,
			                99
			            )
			    )
			
			VAR _RegionCount =
			    COUNTROWS ( _RegionTable )
			
			VAR _GroupCount =
			    COUNTROWS ( _GroupTable )
			
			
			-- Product-group column headers
			VAR _ColumnHeaders =
			    CONCATENATEX (
			        _GroupTable,
			        VAR _GroupName =
			            dimProduct[product_family]
			        RETURN
			            "
			            <div class='rm-column-label'
			                 title='" & _GroupName & "'>
			                " & _GroupName & "
			            </div>
			            ",
			        "",
			        [@GroupSort], ASC,
			        dimProduct[product_family], ASC
			    )
			
			
			-- Matrix rows and cells
			VAR _MatrixRows =
			    CONCATENATEX (
			        _RegionTable,
			
			        VAR _RegionName =
			            dimRegion[country]
			
			        VAR _Cells =
			            CONCATENATEX (
			                _GroupTable,
			
			                VAR _GroupName =
			                    dimProduct[product_family]
			
			                VAR _AverageRiskScore =
			                    CALCULATE (
			                        [Risk Score normalized AVG],
			                        REMOVEFILTERS ( dimDate ),
			                        FILTER (
			                            ALL ( factMlPredictions[year_month] ),
			                            factMlPredictions[year_month] >= _MonthStart
			                                && factMlPredictions[year_month] <= _MonthEnd
			                        ),
			                        TREATAS (
			                            { _RegionName },
			                            dimRegion[country]
			                        ),
			                        TREATAS (
			                            { _GroupName },
			                            dimProduct[product_family]
			                        )
			                    )
			
			                VAR _ProductCount =
			                    CALCULATE (
			                        DISTINCTCOUNT (
			                            factMlPredictions[product_id]
			                        ),
			                        REMOVEFILTERS ( dimDate ),
			                        FILTER (
			                            ALL ( factMlPredictions[year_month] ),
			                            factMlPredictions[year_month] >= _MonthStart
			                                && factMlPredictions[year_month] <= _MonthEnd
			                        ),
			                        TREATAS (
			                            { _RegionName },
			                            dimRegion[country]
			                        ),
			                        TREATAS (
			                            { _GroupName },
			                            dimProduct[product_family]
			                        )
			                    )
			
			
			                -- Heat-map colors
			                VAR _CellColor =
			                    SWITCH (
			                        TRUE (),
			                        ISBLANK ( _AverageRiskScore ), "#F1EFF2",
			                        _AverageRiskScore <= 2.25,      "#A8C73A",
			                        _AverageRiskScore <= 2.75,      "#CAD73A",
			                        _AverageRiskScore <= 3.25,      "#E7D234",
			                        _AverageRiskScore <= 3.75,      "#F4BD3D",
			                        _AverageRiskScore <= 4.25,      "#F59D3B",
			                        _AverageRiskScore <= 4.75,      "#F47C35",
			                        _AverageRiskScore <= 5.25,      "#EF5B38",
			                        "#DC3535"
			                    )
			
			                VAR _TextColor =
			                    IF (
			                        _AverageRiskScore >= 4.5,
			                        "#FFFFFF",
			                        "#26232A"
			                    )
			
			                VAR _SecondaryTextColor =
			                    IF (
			                        _AverageRiskScore >= 4.5,
			                        "rgba(255,255,255,.88)",
			                        "rgba(38,35,42,.72)"
			                    )
			
			                VAR _RiskFormatted =
			                    IF (
			                        ISBLANK ( _AverageRiskScore ),
			                        "—",
			                        FORMAT ( _AverageRiskScore, "0.0" )
			                    )
			
			                VAR _CountFormatted =
			                    IF (
			                        ISBLANK ( _AverageRiskScore ),
			                        "",
			                        FORMAT ( _ProductCount, "#,0" )
			                    )
			
			                VAR _Tooltip =
			                    _RegionName
			                        & " · "
			                        & _GroupName
			                        & " · Average risk "
			                        & _RiskFormatted
			                        & " · "
			                        & FORMAT ( _ProductCount, "#,0" )
			                        & " products"
			
			                RETURN
			                    "
			                    <div class='rm-cell'
			                         style='background:" & _CellColor & ";
			                                color:" & _TextColor & ";'
			                         title='" & _Tooltip & "'>
			
			                        <div class='rm-score'>
			                            " & _RiskFormatted & "
			                        </div>
			
			                        <div class='rm-count'
			                             style='color:" & _SecondaryTextColor & ";'>
			                            " & _CountFormatted & "
			                        </div>
			
			                    </div>
			                    ",
			                "",
			                [@GroupSort], ASC,
			                dimProduct[product_family], ASC
			            )
			
			        RETURN
			            "
			            <div class='rm-row'>
			
			                <div class='rm-region-label'
			                     title='" & _RegionName & "'>
			                    " & _RegionName & "
			                </div>
			
			                " & _Cells & "
			
			            </div>
			            ",
			        "",
			        [@RegionSort], ASC,
			        dimRegion[country], ASC
			    )
			
			
			RETURN
			IF (
			    ISBLANK ( _LatestMonth )
			        || _RegionCount = 0
			        || _GroupCount = 0,
			    "
			    <div style='
			        padding:10px;
			        color:#7A7480;
			        background:transparent;
			        font:11px Segoe UI,Arial,sans-serif;'>
			        No risk-matrix data
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .rm-card {
			            width:100%;
			            max-width:620px;
			            overflow:hidden;
			            color:#26232A;
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.12);
			            border-radius:7px;
			        }
			
			        .rm-titlebar {
			            display:flex;
			            align-items:flex-start;
			            justify-content:space-between;
			            gap:10px;
			            padding:6px 8px 4px;
			        }
			
			        .rm-title {
			            color:#26232A;
			            font-size:15px;
			            line-height:1.0;
			            font-weight:700;
			            letter-spacing:.035em;
			            text-transform:uppercase;
			        }
			
			        .rm-month {
			            margin-top:1px;
			            color:#7A7480;
			            font-size:12px;
			            line-height:1.0;
			        }
			
			        .rm-legend {
			            flex-shrink:0;
			        }
			
			        .rm-legend-title {
			            margin-bottom:2px;
			            color:#5F5962;
			            font-size:12px;
			            line-height:1;
			            text-align:right;
			        }
			
			        .rm-legend-scale {
			            display:flex;
			            align-items:center;
			            gap:2px;
			        }
			
			        .rm-legend-label {
			            color:#7A7480;
			            font-size:12px;
			            line-height:1;
			        }
			
			        .rm-swatch {
			            width:8px;
			            height:7px;
			            border-radius:1px;
			        }
			
			        .rm-columns,
			
			        .rm-row {
			            display:grid;
			            grid-template-columns:
			                minmax(78px,.9fr)
			                repeat(" & FORMAT ( _GroupCount, "0" ) & ",
			                       minmax(50px,1fr));
			            width:100%;
			            min-width:0;
			        }
			
			        .rm-columns {
			            align-items:end;
			            min-height:30px;
			            border-bottom:1px solid rgba(51,16,69,.10);
			        }
			
			        .rm-corner {
			            min-width:0;
			        }
			
			        .rm-column-label {
			            min-width:0;
			            padding:3px 2px 4px;
			            overflow:hidden;
			            color:#5F5962;
			            font-size:11px;
			            line-height:1;
			            font-weight:600;
			            text-align:center;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .rm-row {
			            min-height:29px;}
			
			        .rm-region-label {
			            display:flex;
			            align-items:center;
			            min-width:0;
			            padding:3px 5px;
			            overflow:hidden;
			            color:#4F4952;
			            background:#FFFFFF;
			            border-bottom:1px solid rgba(51,16,69,.08);
			            font-size:11px;
			            line-height:1.15;
			            font-weight:600;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .rm-cell {
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            min-width:0;
			            min-height:29px;
			            padding:2px;
			            flex-direction:column;
			            overflow:hidden;
			            border-right:1px solid rgba(255,255,255,.8);
			            border-bottom:1px solid rgba(255,255,255,.8);
			            text-align:center;
			            transition:filter .12s ease;
			        }
			
			        .rm-cell:hover {
			            filter:brightness(.94);
			        }
			
			        .rm-score {
			            font-size:12px;
			            line-height:1;
			            font-weight:700;
			        }
			
			        .rm-count {
			            margin-top:1px;
			            font-size:11px;
			            line-height:1;
			            font-weight:600;
			        }
			    </style>
			
			    <div class='rm-card'>
			
			        <div class='rm-titlebar'>
			
			            <div>
			                <div class='rm-title'>
			                    Risk Matrix
			                </div>
			
			            </div>
			
			            <div class='rm-legend'>
			                <div class='rm-legend-title'>
			                    Average Risk Score
			                </div>
			
			                <div class='rm-legend-scale'>
			                    <span class='rm-legend-label'>Low</span>
			
			                    <span class='rm-swatch'
			                          style='background:#A8C73A'></span>
			                    <span class='rm-swatch'
			                          style='background:#CAD73A'></span>
			                    <span class='rm-swatch'
			                          style='background:#E7D234'></span>
			                    <span class='rm-swatch'
			                          style='background:#F4BD3D'></span>
			                    <span class='rm-swatch'
			                          style='background:#F59D3B'></span>
			                    <span class='rm-swatch'
			                          style='background:#F47C35'></span>
			                    <span class='rm-swatch'
			                          style='background:#EF5B38'></span>
			                    <span class='rm-swatch'
			                          style='background:#DC3535'></span>
			
			                    <span class='rm-legend-label'>High</span>
			                </div>
			            </div>
			
			        </div>
			
			        <div class='rm-columns'>
			            <div class='rm-corner'></div>
			            " & _ColumnHeaders & "
			        </div>
			
			        " & _MatrixRows & "
			
			    </div>
			    "
			)
		displayFolder: 01 Risk
		lineageTag: 5e5f7759-7345-4937-a37b-5b49014dcfe3

	measure 'Driver Distribution HTML' =
			
			VAR _LatestMonth =
			    CALCULATE (
			        MAX ( factMlPredictions[year_month] ),
			        REMOVEFILTERS ( dimDate ),
			        REMOVEFILTERS ( factMlPredictions[year_month] )
			    )
			
			VAR _MonthStart =
			    DATE (
			        YEAR ( _LatestMonth ),
			        MONTH ( _LatestMonth ),
			        1
			    )
			
			VAR _MonthEnd =
			    EOMONTH ( _MonthStart, 0 )
			
			VAR _PreviousMonthStart =
			    EDATE ( _MonthStart, -1 )
			
			VAR _PreviousMonthEnd =
			    EOMONTH ( _MonthStart, -1 )
			
			VAR _LatestMonthLabel =
			    FORMAT (
			        _MonthStart,
			        "MMM yyyy",
			        "en-US"
			    )
			
			
			-- Existing product-region combinations in the latest month
			VAR _LatestPredictionRows =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS ( dimDate ),
			        FILTER (
			            ALL ( factMlPredictions[year_month] ),
			            factMlPredictions[year_month] >= _MonthStart
			                && factMlPredictions[year_month] <= _MonthEnd
			        )
			    )
			
			VAR _ProductRegionKeys =
			    SUMMARIZE (
			        _LatestPredictionRows,
			        factMlPredictions[product_id],
			        factMlPredictions[region_id]
			    )
			
			
			-- Calculate driver metrics for every product-region combination
			VAR _ProductRegionMetrics =
			    ADDCOLUMNS (
			        _ProductRegionKeys,
			
			        "@Revenue",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            VAR _RegionID =
			                factMlPredictions[region_id]
			            RETURN
			                CALCULATE (
			                    [Revenue],
			                    REMOVEFILTERS ( dimDate ),
			                    DATESBETWEEN (
			                        dimDate[Date],
			                        _MonthStart,
			                        _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        dimProduct[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        dimRegion[region_id]
			                    )
			                ),
			
			        "@Revenue6MAvg",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            VAR _RegionID =
			                factMlPredictions[region_id]
			            RETURN
			                CALCULATE (
			                    [Revenue 6M Avg],
			                    REMOVEFILTERS ( dimDate ),
			                    DATESBETWEEN (
			                        dimDate[Date],
			                        _MonthStart,
			                        _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        dimProduct[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        dimRegion[region_id]
			                    )
			                ),
			
			        "@RevenueMoM",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            VAR _RegionID =
			                factMlPredictions[region_id]
			
			            VAR _CurrentRevenue =
			                CALCULATE (
			                    [Revenue],
			                    REMOVEFILTERS ( dimDate ),
			                    DATESBETWEEN (
			                        dimDate[Date],
			                        _MonthStart,
			                        _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        dimProduct[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        dimRegion[region_id]
			                    )
			                )
			
			            VAR _PreviousRevenue =
			                CALCULATE (
			                    [Revenue],
			                    REMOVEFILTERS ( dimDate ),
			                    DATESBETWEEN (
			                        dimDate[Date],
			                        _PreviousMonthStart,
			                        _PreviousMonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        dimProduct[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        dimRegion[region_id]
			                    )
			                )
			
			            RETURN
			                DIVIDE (
			                    _CurrentRevenue - _PreviousRevenue,
			                    ABS ( _PreviousRevenue )
			                ),
			
			        "@Volatility",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            VAR _RegionID =
			                factMlPredictions[region_id]
			            RETURN
			                CALCULATE (
			                    [Sales Volatility %],
			                    REMOVEFILTERS ( dimDate ),
			                    DATESBETWEEN (
			                        dimDate[Date],
			                        _MonthStart,
			                        _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        dimProduct[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        dimRegion[region_id]
			                    )
			                ),
			
			        "@Customers",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            VAR _RegionID =
			                factMlPredictions[region_id]
			            RETURN
			                CALCULATE (
			                    [Customers Active],
			                    REMOVEFILTERS ( dimDate ),
			                    DATESBETWEEN (
			                        dimDate[Date],
			                        _MonthStart,
			                        _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        dimProduct[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        dimRegion[region_id]
			                    )
			                ),
			
			        "@CustomersPM",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            VAR _RegionID =
			                factMlPredictions[region_id]
			            RETURN
			                CALCULATE (
			                    [Customers Active],
			                    REMOVEFILTERS ( dimDate ),
			                    DATESBETWEEN (
			                        dimDate[Date],
			                        _PreviousMonthStart,
			                        _PreviousMonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        dimProduct[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        dimRegion[region_id]
			                    )
			                ),
			
			        "@Competition",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            VAR _RegionID =
			                factMlPredictions[region_id]
			            RETURN
			                CALCULATE (
			                    [Competitor Pressure Score AVG],
			                    REMOVEFILTERS ( dimDate ),
			                    FILTER (
			                        ALL ( factMlPredictions[year_month] ),
			                        factMlPredictions[year_month] >= _MonthStart
			                            && factMlPredictions[year_month] <= _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        factMlPredictions[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        factMlPredictions[region_id]
			                    )
			                ),
			
			        "@GrossMargin",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            VAR _RegionID =
			                factMlPredictions[region_id]
			            RETURN
			                CALCULATE (
			                    [Gross Margin %],
			                    REMOVEFILTERS ( dimDate ),
			                    DATESBETWEEN (
			                        dimDate[Date],
			                        _MonthStart,
			                        _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        dimProduct[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        dimRegion[region_id]
			                    )
			                ),
			
			        "@TargetMargin",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            RETURN
			                LOOKUPVALUE (
			                    dimProduct[target_margin_pct],
			                    dimProduct[product_id], _ProductID
			                )
			    )
			
			
			-- Convert metrics into driver flags
			VAR _DriverFlags =
			    ADDCOLUMNS (
			        _ProductRegionMetrics,
			
			        "@SalesBelowTrend",
			            NOT ISBLANK ( [@Revenue] )
			                && NOT ISBLANK ( [@Revenue6MAvg] )
			                && [@Revenue] < [@Revenue6MAvg],
			
			        "@HighVolatility",
			            NOT ISBLANK ( [@Volatility] )
			                && [@Volatility] >= 0.20,
			
			        "@RecentSalesDrop",
			            NOT ISBLANK ( [@RevenueMoM] )
			                && [@RevenueMoM] < 0,
			
			        "@CustomerDrop",
			            NOT ISBLANK ( [@Customers] )
			                && NOT ISBLANK ( [@CustomersPM] )
			                && [@Customers] < [@CustomersPM],
			
			        "@HighCompetition",
			            NOT ISBLANK ( [@Competition] )
			                && [@Competition] >= 70,
			
			        "@MarginBelowTarget",
			            NOT ISBLANK ( [@GrossMargin] )
			                && NOT ISBLANK ( [@TargetMargin] )
			                && [@GrossMargin] < [@TargetMargin]
			    )
			
			
			-- Driver counts
			VAR _SalesBelowTrendCount =
			    COUNTROWS (
			        FILTER (
			            _DriverFlags,
			            [@SalesBelowTrend]
			        )
			    )
			
			VAR _HighVolatilityCount =
			    COUNTROWS (
			        FILTER (
			            _DriverFlags,
			            [@HighVolatility]
			        )
			    )
			
			VAR _RecentSalesDropCount =
			    COUNTROWS (
			        FILTER (
			            _DriverFlags,
			            [@RecentSalesDrop]
			        )
			    )
			
			VAR _CustomerDropCount =
			    COUNTROWS (
			        FILTER (
			            _DriverFlags,
			            [@CustomerDrop]
			        )
			    )
			
			VAR _HighCompetitionCount =
			    COUNTROWS (
			        FILTER (
			            _DriverFlags,
			            [@HighCompetition]
			        )
			    )
			
			VAR _MarginBelowTargetCount =
			    COUNTROWS (
			        FILTER (
			            _DriverFlags,
			            [@MarginBelowTarget]
			        )
			    )
			
			
			-- Driver table
			VAR _Drivers =
			    UNION (
			        ROW (
			            "Driver", "Sales below trend",
			            "DriverCount", _SalesBelowTrendCount,
			            "DriverOrder", 1
			        ),
			        ROW (
			            "Driver", "High sales volatility",
			            "DriverCount", _HighVolatilityCount,
			            "DriverOrder", 2
			        ),
			        ROW (
			            "Driver", "Recent sales drop",
			            "DriverCount", _RecentSalesDropCount,
			            "DriverOrder", 3
			        ),
			        ROW (
			            "Driver", "Customer drop",
			            "DriverCount", _CustomerDropCount,
			            "DriverOrder", 4
			        ),
			        ROW (
			            "Driver", "High competition",
			            "DriverCount", _HighCompetitionCount,
			            "DriverOrder", 5
			        ),
			        ROW (
			            "Driver", "Margin below target",
			            "DriverCount", _MarginBelowTargetCount,
			            "DriverOrder", 6
			        )
			    )
			
			VAR _VisibleDrivers =
			    FILTER (
			        _Drivers,
			        [DriverCount] > 0
			    )
			
			VAR _MaximumCount =
			    MAXX (
			        _VisibleDrivers,
			        [DriverCount]
			    )
			
			VAR _AxisStep =
			    SWITCH (
			        TRUE (),
			        _MaximumCount <= 25,  5,
			        _MaximumCount <= 50,  10,
			        _MaximumCount <= 100, 20,
			        _MaximumCount <= 250, 50,
			        _MaximumCount <= 500, 100,
			        200
			    )
			
			VAR _AxisMaximum =
			    MAX (
			        _AxisStep,
			        CEILING (
			            _MaximumCount,
			            _AxisStep
			        )
			    )
			
			
			-- Generate bars
			VAR _DriverBars =
			    CONCATENATEX (
			        _VisibleDrivers,
			
			        VAR _DriverName =
			            [Driver]
			
			        VAR _Count =
			            [DriverCount]
			
			        VAR _BarWidth =
			            FORMAT (
			                DIVIDE (
			                    _Count,
			                    _AxisMaximum
			                ),
			                "0.0%",
			                "en-US"
			            )
			
			        VAR _Tooltip =
			            _DriverName
			                & ": "
			                & FORMAT ( _Count, "#,0" )
			                & " product-region combinations"
			
			        RETURN
			            "
			            <div class='dd-row'
			                 title='" & _Tooltip & "'>
			
			                <div class='dd-label'>
			                    " & _DriverName & "
			                </div>
			
			                <div class='dd-track'>
			                    <div class='dd-fill'
			                         style='width:" & _BarWidth & "'>
			                    </div>
			                </div>
			
			                <div class='dd-value'>
			                    " & FORMAT ( _Count, "#,0" ) & "
			                </div>
			
			            </div>
			            ",
			        "",
			        [DriverCount], DESC,
			        [DriverOrder], ASC
			    )
			
			
			-- X-axis labels
			VAR _AxisLabels =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 5, 1 ),
			
			        VAR _TickIndex =
			            [Value]
			
			        VAR _TickValue =
			            DIVIDE (
			                _AxisMaximum * _TickIndex,
			                5
			            )
			
			        RETURN
			            "<span>"
			                & FORMAT ( _TickValue, "0" )
			                & "</span>",
			        "",
			        [Value], ASC
			    )
			
			VAR _ProductRegionCount =
			    COUNTROWS ( _ProductRegionKeys )
			
			RETURN
			IF (
			    ISBLANK ( _LatestMonth )
			        || _ProductRegionCount = 0
			        || COUNTROWS ( _VisibleDrivers ) = 0,
			    "
			    <div style='
			        padding:10px;
			        color:#7A7480;
			        background:transparent;
			        font:11px Segoe UI,Arial,sans-serif;'>
			        No driver-distribution data
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .dd-card {
			            width:100%;
			            height:230px;
			            padding:5px 5px 5px;
			            color:#26232A;
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.12);
			            border-radius:5px;
			        }
			
			        .dd-header {
			            display:flex;
			            align-items:flex-start;
			            justify-content:space-between;
			            gap:10px;
			            margin-bottom:11px;
			        }
			
			        .dd-title {
			            color:#26232A;
			            font-size:15px;
			            font-weight:700;
			            text-transform:uppercase;
			        }
			
			        .dd-subtitle {
			            margin-top:2px;
			            color:#7A7480;
			            font-size:12px;
			        }
			
			        .dd-context {
			            color:#7A7480;
			            font-size:12px;
			            text-align:right;
			            white-space:nowrap;
			        }
			
			        .dd-chart {
			            width:100%;
			        }
			
			        .dd-row {
			            display:grid;
			            grid-template-columns:
			                minmax(105px,125px)
			                minmax(0,1fr)
			                32px;
			            align-items:center;
			            gap:7px;
			            min-width:0;
			            margin-bottom:7px;
			        }
			
			        .dd-label {
			            overflow:hidden;
			            color:#000000;
			            font-size:12px;
			            font-weight:300;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .dd-track {
			            position:relative;
			            width:100%;
			            height:20px;
			            overflow:hidden;
			            background:
			                repeating-linear-gradient(
			                    to right,
			                    transparent 0,
			                    transparent calc(20% - 1px),
			                    rgba(51,16,69,.07) calc(20% - 1px),
			                    rgba(51,16,69,.07) 20%
			                );
			            border-bottom:1px solid rgba(51,16,69,.10);
			        }
			
			        .dd-fill {
			            height:230px;
			            background:#331045;
			            border-radius:0 2px 2px 0;
			            transition:filter .12s ease;
			        }
			
			        .dd-row:hover .dd-fill {
			            filter:brightness(1.25);
			        }
			
			        .dd-value {
			            color:#4F4952;
			            font-size:12px;
			            font-weight:300;
			            text-align:left;
			            white-space:nowrap;
			        }
			
			        .dd-axis {
			            display:grid;
			            grid-template-columns:
			                minmax(105px,125px)
			                minmax(0,1fr)
			                32px;
			            gap:7px;
			            margin-top:1px;
			        }
			
			        .dd-axis-labels {
			            display:flex;
			            justify-content:space-between;
			            color:#7A7480;
			            font-size:12px;
			        }
			    </style>
			
			    <div class='dd-card'>
			
			        <div class='dd-header'>
			            <div>
			                <div class='dd-title'>
			                    Driver Distribution
			                </div>
			
			                <div class='dd-subtitle'>
			                    Product-region combinations by triggered driver
			                </div>
			            </div>
			        </div>
			
			        <div class='dd-chart'>
			            " & _DriverBars & "
			        </div>
			
			        <div class='dd-axis'>
			            <div></div>
			
			            <div class='dd-axis-labels'>
			                " & _AxisLabels & "
			            </div>
			
			            <div></div>
			        </div>
			
			    </div>
			    "
			)
		displayFolder: 01 Risk
		lineageTag: 42ef92e6-2c55-4336-899a-eea08076b005

	measure 'Revenue 6M Avg' =
			
			VAR _EndDate =
			    MAX ( dimDate[Date] )
			
			VAR _Months =
			    CALCULATETABLE (
			        VALUES ( dimDate[MonthStartDate] ),
			        REMOVEFILTERS ( dimDate ),
			        DATESINPERIOD (
			            dimDate[Date],
			            _EndDate,
			            -6,
			            MONTH
			        )
			    )
			
			RETURN
			    AVERAGEX (
			        _Months,
			        CALCULATE ( [Revenue] )
			    )
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 00 Core Measures
		lineageTag: ce3b14d4-e458-431b-b42b-7885209372f2

		annotation PBI_FormatHint = {"currencyCulture":"en-DE"}

	measure 'Prioritized Alert Worklist HTML' = ```
			
			VAR _CurrentMonth =
			    MAX ( factMlPredictions[year_month] )
			
			VAR _MonthStart =
			    DATE (
			        YEAR ( _CurrentMonth ),
			        MONTH ( _CurrentMonth ),
			        1
			    )
			
			VAR _MonthEnd =
			    EOMONTH ( _CurrentMonth, 0 )
			
			VAR _PreviousMonthStart =
			    EOMONTH ( _CurrentMonth, -2 ) + 1
			
			VAR _PreviousMonthEnd =
			    EOMONTH ( _CurrentMonth, -1 )
			
			-- ============================================================
			-- HIGH-RISK PRODUCT-REGION COMBINATIONS IN CURRENT MONTH
			-- ============================================================
			
			VAR _CurrentPredictions =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS ( dimDate ),
			        FILTER (
			            ALL ( factMlPredictions[year_month] ),
			            factMlPredictions[year_month] = _CurrentMonth
			        ),
			        factMlPredictions[predicted_risk_label_num] = 2
			    )
			
			VAR _ProductRegionKeys =
			    SUMMARIZE (
			        _CurrentPredictions,
			        factMlPredictions[product_id],
			        factMlPredictions[region_id]
			    )
			
			-- ============================================================
			-- BUILD WORKLIST BASE
			-- ============================================================
			
			VAR _WorklistBase =
			    ADDCOLUMNS (
			        _ProductRegionKeys,
			
			        "@SKU",
			            CALCULATE (
			                SELECTEDVALUE ( dimProduct[sku] )
			            ),
			
			        "@ProductName",
			            CALCULATE (
			                SELECTEDVALUE ( dimProduct[product_name] )
			            ),
			
			        "@Region",
			            CALCULATE (
			                SELECTEDVALUE ( dimRegion[region] )
			            ),
			
			        "@Lifecycle",
			            CALCULATE (
			                SELECTEDVALUE ( dimProduct[lifecycle_stage] )
			            ),
			
			        "@RiskScore",
			            CALCULATE (
			                [Risk Score normalized AVG],
			                REMOVEFILTERS ( dimDate ),
			                FILTER (
			                    ALL ( factMlPredictions[year_month] ),
			                    factMlPredictions[year_month] = _CurrentMonth
			                )
			            ),
			
			        "@Revenue",
			            CALCULATE (
			                [Revenue],
			                REMOVEFILTERS ( dimDate ),
			                DATESBETWEEN (
			                    dimDate[Date],
			                    _MonthStart,
			                    _MonthEnd
			                )
			            ),
			
			        "@Units",
			            CALCULATE (
			                [Units],
			                REMOVEFILTERS ( dimDate ),
			                DATESBETWEEN (
			                    dimDate[Date],
			                    _MonthStart,
			                    _MonthEnd
			                )
			            ),
			
			        "@Customers",
			            CALCULATE (
			                [Customers Active],
			                REMOVEFILTERS ( dimDate ),
			                DATESBETWEEN (
			                    dimDate[Date],
			                    _MonthStart,
			                    _MonthEnd
			                )
			            ),
			
			        "@CustomersPM",
			            CALCULATE (
			                [Customers Active],
			                REMOVEFILTERS ( dimDate ),
			                DATESBETWEEN (
			                    dimDate[Date],
			                    _PreviousMonthStart,
			                    _PreviousMonthEnd
			                )
			            ),
			
			        "@Revenue6MAvg",
			            CALCULATE (
			                [Revenue 6M Avg],
			                REMOVEFILTERS ( dimDate ),
			                DATESBETWEEN (
			                    dimDate[Date],
			                    _MonthStart,
			                    _MonthEnd
			                )
			            ),
			
			        "@RevenueMoM",
			            CALCULATE (
			                [Revenue MoM %],
			                REMOVEFILTERS ( dimDate ),
			                DATESBETWEEN (
			                    dimDate[Date],
			                    _MonthStart,
			                    _MonthEnd
			                )
			            ),
			
			        "@Volatility",
			            CALCULATE (
			                [Sales Volatility %],
			                REMOVEFILTERS ( dimDate ),
			                DATESBETWEEN (
			                    dimDate[Date],
			                    _MonthStart,
			                    _MonthEnd
			                )
			            ),
			
			        "@Competition",
			            CALCULATE (
			                [Competitor Pressure Score AVG],
			                REMOVEFILTERS ( dimDate ),
			                DATESBETWEEN (
			                    dimDate[Date],
			                    _MonthStart,
			                    _MonthEnd
			                )
			            ),
			
			        "@GrossMargin",
			            CALCULATE (
			                [Gross Margin %],
			                REMOVEFILTERS ( dimDate ),
			                DATESBETWEEN (
			                    dimDate[Date],
			                    _MonthStart,
			                    _MonthEnd
			                )
			            ),
			
			        "@TargetMargin",
			            CALCULATE (
			                SELECTEDVALUE (
			                    dimProduct[target_margin_pct]
			                )
			            )
			    )
			
			-- ============================================================
			-- RISK DRIVERS
			-- ============================================================
			
			VAR _WorklistWithDrivers =
			    ADDCOLUMNS (
			        _WorklistBase,
			
			        "@Drivers",
			
			            VAR _SalesBelowTrend =
			                NOT ISBLANK ( [@Revenue6MAvg] )
			                    && [@Revenue] < [@Revenue6MAvg]
			
			            VAR _HighVolatility =
			                [@Volatility] >= 0.20
			
			            VAR _RecentSalesDrop =
			                [@RevenueMoM] < 0
			
			            VAR _CustomerDrop =
			                NOT ISBLANK ( [@CustomersPM] )
			                    && [@Customers] < [@CustomersPM]
			
			            VAR _HighCompetition =
			                [@Competition] >= 70
			
			            VAR _MarginBelowTarget =
			                NOT ISBLANK ( [@TargetMargin] )
			                    && [@GrossMargin] < [@TargetMargin]
			
			            VAR _DriverText =
			                    IF (
			                        _SalesBelowTrend,
			                        "Sales below trend; ",
			                        ""
			                    )
			                &   IF (
			                        _HighVolatility,
			                        "High sales volatility; ",
			                        ""
			                    )
			                &   IF (
			                        _RecentSalesDrop,
			                        "Recent sales drop; ",
			                        ""
			                    )
			                &   IF (
			                        _CustomerDrop,
			                        "Customer drop; ",
			                        ""
			                    )
			                &   IF (
			                        _HighCompetition,
			                        "High competition; ",
			                        ""
			                    )
			                &   IF (
			                        _MarginBelowTarget,
			                        "Margin below target; ",
			                        ""
			                    )
			
			            RETURN
			
			                IF (
			                    _DriverText = "",
			
			                    "Elevated composite risk",
			
			                    LEFT (
			                        _DriverText,
			                        LEN ( _DriverText ) - 2
			                    )
			                )
			    )
			
			-- ============================================================
			-- SIX HIGHEST-PRIORITY ALERTS
			-- ============================================================
			
			VAR _TopAlerts =
			    TOPN (
			        6,
			
			        FILTER (
			            _WorklistWithDrivers,
			            NOT ISBLANK ( [@RiskScore] )
			        ),
			
			        [@RiskScore], DESC,
			        [@Revenue], DESC
			    )
			
			-- ============================================================
			-- RANK ALERTS
			-- ============================================================
			
			VAR _RankedAlerts =
			    ADDCOLUMNS (
			        _TopAlerts,
			
			        "@Rank",
			
			            VAR _CurrentRisk =
			                [@RiskScore]
			
			            VAR _CurrentRevenue =
			                [@Revenue]
			
			            RETURN
			
			                1
			                    + COUNTROWS (
			                        FILTER (
			                            _TopAlerts,
			
			                            [@RiskScore] > _CurrentRisk
			
			                                || (
			                                    [@RiskScore] = _CurrentRisk
			                                        && [@Revenue] > _CurrentRevenue
			                                )
			                        )
			                    )
			    )
			
			VAR _AlertCount =
			    COUNTROWS ( _RankedAlerts )
			
			-- ============================================================
			-- CREATE HTML ROWS
			-- ============================================================
			
			VAR _RowsHTML =
			    CONCATENATEX (
			        _RankedAlerts,
			
			        VAR _Rank =
			            [@Rank]
			
			        VAR _SKU =
			            COALESCE (
			                [@SKU],
			                "—"
			            )
			
			        VAR _ProductName =
			            COALESCE (
			                [@ProductName],
			                "Unknown product"
			            )
			
			        VAR _Region =
			            COALESCE (
			                [@Region],
			                "—"
			            )
			
			        VAR _Lifecycle =
			            COALESCE (
			                [@Lifecycle],
			                "—"
			            )
			
			        VAR _RiskScore =
			            [@RiskScore]
			
			        VAR _RiskWidth =
			            MIN (
			                100,
			                MAX (
			                    0,
			                    _RiskScore * 10
			                )
			            )
			
			        VAR _RevenueFormatted =
			            IF (
			                ISBLANK ( [@Revenue] ),
			
			                "—",
			
			                FORMAT (
			                    [@Revenue],
			                    "€#,##0"
			                )
			            )
			
			        VAR _UnitsFormatted =
			            IF (
			                ISBLANK ( [@Units] ),
			
			                "—",
			
			                FORMAT (
			                    [@Units],
			                    "#,##0"
			                )
			            )
			
			        VAR _CustomersFormatted =
			            IF (
			                ISBLANK ( [@Customers] ),
			
			                "—",
			
			                FORMAT (
			                    [@Customers],
			                    "#,##0"
			                )
			            )
			
			        RETURN
			
			            "
			            <div class='aw-row'>
			
			                <!-- RANK -->
			
			                <div class='aw-rank'>
			                    "
			                        & FORMAT (
			                            _Rank,
			                            "0"
			                        )
			                        & "
			                </div>
			
			                <!-- PRODUCT -->
			
			                <div class='aw-product'>
			
			                    <span class='aw-sku'>
			                        "
			                            & _SKU
			                            & "
			                    </span>
			
			                    <span class='aw-name'>
			                        "
			                            & _ProductName
			                            & "
			                    </span>
			
			                </div>
			
			                <!-- REGION -->
			
			                <div class='aw-cell'>
			                    "
			                        & _Region
			                        & "
			                </div>
			
			                <!-- RISK -->
			
			                <div class='aw-risk'>
			
			                    <span class='aw-risk-number'>
			                        "
			                            & FORMAT (
			                                _RiskScore,
			                                "0.0"
			                            )
			                            & "
			                    </span>
			
			                    <div class='aw-risk-track'>
			
			                        <div
			                            class='aw-risk-fill'
			                            style='width:"
			                                & FORMAT (
			                                    _RiskWidth,
			                                    "0"
			                                )
			                                & "%'>
			                        </div>
			
			                    </div>
			
			                    <span class='aw-badge'>
			                        HIGH RISK
			                    </span>
			
			                </div>
			
			                <!-- REVENUE -->
			
			                <div class='aw-cell aw-number'>
			                    "
			                        & _RevenueFormatted
			                        & "
			                </div>
			
			                <!-- UNITS -->
			
			                <div class='aw-cell aw-number'>
			                    "
			                        & _UnitsFormatted
			                        & "
			                </div>
			
			                <!-- CUSTOMERS -->
			
			                <div class='aw-cell aw-number'>
			                    "
			                        & _CustomersFormatted
			                        & "
			                </div>
			
			                <!-- LIFECYCLE -->
			
			                <div class='aw-cell aw-center'>
			                    "
			                        & _Lifecycle
			                        & "
			                </div>
			
			                <!-- DRIVERS -->
			
			                <div class='aw-drivers'>
			                    "
			                        & [@Drivers]
			                        & "
			                </div>
			
			            </div>
			            ",
			
			        "",
			
			        [@Rank], ASC
			    )
			
			-- ============================================================
			-- FINAL HTML
			-- ============================================================
			
			RETURN
			
			IF (
			    ISBLANK ( _CurrentMonth )
			        || _AlertCount = 0,
			
			    "
			    <div style='
			        padding:12px;
			        color:#7A7480;
			        background:#FFFFFF;
			        border:1px solid #E2DEE4;
			        border-radius:5px;
			        font:11px Segoe UI,Arial,sans-serif;'>
			
			        No high-risk alerts available
			
			    </div>
			    ",
			
			    "
			    <style>
			
			        /* ====================================================
			           GLOBAL
			           ==================================================== */
			
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        /* ====================================================
			           CONTAINER
			           ==================================================== */
			
			        .aw-container {
			            width:100%;
			
			            overflow-x:auto;
			
			            background:#FFFFFF;
			
			            border:1px solid rgba(51,16,69,.14);
			            border-radius:5px;
			        }
			
			        /* ====================================================
			           TITLE
			           ==================================================== */
			
			        .aw-titlebar {
			            display:flex;
			            align-items:center;
			            gap:8px;
			
			            min-width:780px;
			
			            padding:5px;
			
			            border-bottom:1px solid #DDD8DF;
			        }
			
			        .aw-title {
			            color:#000000;
			
			            font-size:15px;
			            font-weight:700;
			
			            text-transform:uppercase;
			        }
			
			        .aw-count {
			            padding:2px 5px;
			
			            color:#C53D3D;
			            background:#FFF2F2;
			
			            border:1px solid #F1BABA;
			            border-radius:3px;
			
			            font-size:12px;
			            font-weight:400;
			
			            white-space:nowrap;
			        }
			
			        /* ====================================================
			           TABLE GRID
			           ==================================================== */
			
			        .aw-header,
			        .aw-row {
			
			            display:grid;
			
			            grid-template-columns:
			                25px
			                minmax(175px,1.25fr)
			                minmax(95px,.70fr)
			                minmax(180px,1.25fr)
			                minmax(95px,.72fr)
			                66px
			                70px
			                78px
			                minmax(205px,1.45fr);
			
			            align-items:center;
			
			            min-width:940px;
			        }
			
			        /* ====================================================
			           HEADER
			           ==================================================== */
			
			        .aw-header {
			
			            min-height:24px;
			
			            color:#000000;
			            background:#F7F5F7;
			
			            border-bottom:1px solid #DDD8DF;
			
			            font-size:12px;
			            font-weight:700;
			        }
			
			        /*
			            ALL COLUMN HEADERS CENTERED
			        */
			
			        .aw-header > div {
			            text-align:center;
			        }
			
			        /* ====================================================
			           COMMON CELLS
			           ==================================================== */
			
			        .aw-header > div,
			        .aw-row > div {
			
			            min-width:0;
			
			            padding:5px 7px;
			
			            border-right:1px solid #ECE8ED;
			        }
			
			        .aw-header > div:last-child,
			        .aw-row > div:last-child {
			
			            border-right:none;
			        }
			
			        /* ====================================================
			           DATA ROWS
			           ==================================================== */
			
			        .aw-row {
			
			            min-height:31px;
			
			            color:#26232A;
			
			            border-bottom:1px solid #EEEAEF;
			
			            font-size:11px;
			        }
			
			        .aw-row:last-child {
			            border-bottom:none;
			        }
			
			        .aw-row:nth-child(even) {
			            background:#FBFAFB;
			        }
			
			        .aw-row:hover {
			            background:#F4F0F6;
			        }
			
			        /* ====================================================
			           RANK
			           ==================================================== */
			
			        .aw-rank {
			
			            color:#7A7480;
			
			            text-align:center;
			
			            font-weight:400;
			        }
			
			        /* ====================================================
			           PRODUCT
			           ==================================================== */
			
			        .aw-product {
			
			            display:flex;
			            align-items:center;
			            gap:5px;
			
			            overflow:hidden;
			
			            white-space:nowrap;
			        }
			
			        .aw-sku {
			
			            flex-shrink:0;
			
			            color:#26232A;
			
			            font-weight:400;
			        }
			
			        .aw-name {
			
			            overflow:hidden;
			
			            color:#000000;
			
			            text-overflow:ellipsis;
			        }
			
			        /* ====================================================
			           STANDARD CELLS
			           ==================================================== */
			
			        .aw-cell {
			
			            overflow:hidden;
			
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .aw-number {
			
			            text-align:center;
			
			            font-variant-numeric:tabular-nums;
			        }
			
			        .aw-center {
			            text-align:center;
			        }
			
			        /* ====================================================
			           RISK SCORE
			           ==================================================== */
			
			        .aw-risk {
			
			            display:flex;
			            align-items:center;
			            gap:5px;
			
			            min-width:0;
			        }
			
			        .aw-risk-number {
			
			            width:24px;
			
			            flex-shrink:0;
			
			            color:#331045;
			
			            font-size:11px;
			            font-weight:400;
			
			            font-variant-numeric:tabular-nums;
			        }
			
			        .aw-risk-track {
			
			            position:relative;
			
			            height:11px;
			
			            min-width:35px;
			
			            flex:1;
			
			            overflow:hidden;
			
			            background:#E8E4E9;
			
			            border-radius:2px;
			        }
			
			        .aw-risk-fill {
			
			            height:100%;
			
			            min-width:3px;
			
			            background:linear-gradient(
			                90deg,
			                #C53D3D,
			                #EB1717
			            );
			
			            border-radius:2px;
			        }
			
			        .aw-badge {
			
			            flex-shrink:0;
			
			            padding:2px 4px;
			
			            color:#FFFFFF;
			            background:#D50000;
			
			            border-radius:3px;
			
			            font-size:11px;
			            font-weight:400;
			
			            white-space:nowrap;
			        }
			
			        /* ====================================================
			           DRIVERS
			           ==================================================== */
			
			        .aw-drivers {
			
			            overflow:hidden;
			
			            color:#4F4952;
			
			            font-size:11px;
			
			            white-space:normal;
			        }
			
			    </style>
			
			    <div class='aw-container'>
			
			        <!-- ================================================
			             TITLE
			             ================================================ -->
			
			        <div class='aw-titlebar'>
			
			            <div class='aw-title'>
			                Prioritized Alert Worklist
			            </div>
			
			            <div class='aw-count'>
			                "
			                    & FORMAT (
			                        _AlertCount,
			                        "0"
			                    )
			                    & " CRITICAL PRODUCTS
			            </div>
			
			        </div>
			
			        <!-- ================================================
			             COLUMN HEADERS
			             ================================================ -->
			
			        <div class='aw-header'>
			
			            <div>
			                #
			            </div>
			
			            <div>
			                Product
			            </div>
			
			            <div>
			                Region
			            </div>
			
			            <div>
			                Risk Score
			            </div>
			
			            <div>
			                Revenue
			            </div>
			
			            <div>
			                Units
			            </div>
			
			            <div>
			                Customers
			            </div>
			
			            <div>
			                Lifecycle
			            </div>
			
			            <div>
			                Risk Drivers
			            </div>
			
			        </div>
			
			        <!-- ================================================
			             DATA ROWS
			             ================================================ -->
			
			        "
			            & _RowsHTML
			            & "
			
			    </div>
			    "
			)
			
			
			```
		displayFolder: 01 Risk
		lineageTag: 8875150b-c07c-436e-a351-984a9240512e

	measure 'Gross Margin % vs Target pp' = ([Gross Margin %] - [Gross Margin Target %])*100
		formatString: 0.0
		displayFolder: 00 Core Measures
		lineageTag: 6d447179-dd3a-42ad-9408-2c38b97f1c9c

	measure 'Gross Margin % vs Target pp Display' =
			
			VAR Gap = [Gross Margin % vs Target pp]
			RETURN
			IF(Gap < 0,
			FORMAT(Gap, "0.0")&" pp",
			FORMAT(Gap, "0.0")&" pp")
		displayFolder: 02 Margin
		lineageTag: 8c4d807a-59c8-4050-9988-6fdb689e4c5e

	measure 'Executive Revenue PY Forecast HTML' =
			
			VAR _LatestForecastVersion =
			    "Latest Estimate"
			
			
			-- Last selected month from the date slicer
			VAR _SelectedEndMonth =
			    MAXX (
			        ALLSELECTED ( dimDate[MonthStartDate] ),
			        dimDate[MonthStartDate]
			    )
			
			
			-- Last available actual-sales month
			VAR _LastActualMonth =
			    CALCULATE (
			        MAX ( dimDate[MonthStartDate] )
			    )
			
			
			-- Last available Latest Estimate month
			VAR _LastForecastMonth =
			    CALCULATE (
			        MAX ( dimDate[MonthStartDate] ),
			        factForecast[forecast_version] = _LatestForecastVersion
			    )
			
			
			-- Last available month across actual and forecast data
			VAR _LastAvailableMonth =
			    MAX (
			        _LastActualMonth,
			        _LastForecastMonth
			    )
			
			
			-- Prevent the date table from moving the chart
			-- into a year without actual or forecast data
			VAR _EffectiveSelectedEndMonth =
			    IF (
			        ISBLANK ( _LastAvailableMonth ),
			        BLANK (),
			        MIN (
			            COALESCE (
			                _SelectedEndMonth,
			                _LastAvailableMonth
			            ),
			            _LastAvailableMonth
			        )
			    )
			
			
			VAR _SelectedYear =
			    IF (
			        NOT ISBLANK ( _EffectiveSelectedEndMonth ),
			        YEAR ( _EffectiveSelectedEndMonth ),
			        YEAR ( TODAY () )
			    )
			
			
			VAR _YearStart =
			    DATE (
			        _SelectedYear,
			        1,
			        1
			    )
			
			
			VAR _NextYearStart =
			    DATE (
			        _SelectedYear + 1,
			        1,
			        1
			    )
			
			
			-- Last actual month in the selected reporting year
			VAR _LastActualMonthInYear =
			    CALCULATE (
			        MAX ( dimDate[MonthStartDate] ),
			        REMOVEFILTERS ( dimDate ),
			        FILTER (
			            ALL ( dimDate[MonthStartDate] ),
			            dimDate[MonthStartDate] >= _YearStart
			                && dimDate[MonthStartDate] < _NextYearStart
			        )
			    )
			
			
			-- If the selected year has no actuals,
			-- show it as a forecast-only year
			VAR _CutoffMonth =
			    IF (
			        ISBLANK ( _LastActualMonthInYear ),
			        EDATE ( _YearStart, -1 ),
			        MIN (
			            _EffectiveSelectedEndMonth,
			            _LastActualMonthInYear
			        )
			    )
			
			
			-- January to December
			VAR _Months =
			    SELECTCOLUMNS (
			        GENERATESERIES ( 1, 12, 1 ),
			        "@MonthNumber", [Value],
			        "@MonthDate",
			            DATE (
			                _SelectedYear,
			                [Value],
			                1
			            )
			    )
			
			
			-- Monthly actual, prior-year and latest-forecast values
			VAR _ChartData =
			    ADDCOLUMNS (
			        _Months,
			
			        "@Actual",
			            VAR _Month =
			                [@MonthDate]
			
			            VAR _NextMonth =
			                EDATE ( _Month, 1 )
			
			            RETURN
			                CALCULATE (
			                    [Revenue],
			                    REMOVEFILTERS ( dimDate ),
			                    FILTER (
			                        ALL ( dimDate[MonthStartDate] ),
			                        dimDate[MonthStartDate] >= _Month
			                            && dimDate[MonthStartDate] < _NextMonth
			                    )
			                ),
			
			        "@PriorYear",
			            VAR _Month =
			                EDATE (
			                    [@MonthDate],
			                    -12
			                )
			
			            VAR _NextMonth =
			                EDATE ( _Month, 1 )
			
			            RETURN
			                CALCULATE (
			                    [Revenue],
			                    REMOVEFILTERS ( dimDate ),
			                    FILTER (
			                        ALL ( dimDate[MonthStartDate] ),
			                        dimDate[MonthStartDate] >= _Month
			                            && dimDate[MonthStartDate] < _NextMonth
			                    )
			                ),
			
			        "@Forecast",
			            VAR _Month =
			                [@MonthDate]
			
			            VAR _NextMonth =
			                EDATE ( _Month, 1 )
			
			            RETURN
			                CALCULATE (
			                    SUM (
			                        factForecast[forecast_revenue_eur]
			                    ),
			                    REMOVEFILTERS ( dimDate ),
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			                    factForecast[forecast_version]
			                        = _LatestForecastVersion,
			                    FILTER (
			                        ALL ( dimDate[MonthStartDate] ),
			                        dimDate[MonthStartDate] >= _Month
			                            && dimDate[MonthStartDate] < _NextMonth
			                    )
			                )
			    )
			
			
			-- Only displayed values affect the Y-axis
			VAR _VisibleData =
			    ADDCOLUMNS (
			        _ChartData,
			
			        "@VisibleActual",
			            IF (
			                [@MonthDate] <= _CutoffMonth,
			                [@Actual]
			            ),
			
			        "@VisiblePriorYear",
			            [@PriorYear],
			
			        "@VisibleForecast",
			            IF (
			                [@MonthDate] > _CutoffMonth,
			                [@Forecast]
			            )
			    )
			
			
			VAR _HasData =
			    COUNTROWS (
			        FILTER (
			            _VisibleData,
			            NOT ISBLANK ( [@VisibleActual] )
			                || NOT ISBLANK ( [@VisiblePriorYear] )
			                || NOT ISBLANK ( [@VisibleForecast] )
			        )
			    ) > 0
			
			
			VAR _HasFutureForecast =
			    COUNTROWS (
			        FILTER (
			            _VisibleData,
			            NOT ISBLANK ( [@VisibleForecast] )
			        )
			    ) > 0
			
			
			-- ============================================================
			-- SVG GEOMETRY
			-- Taller / more vertical chart
			-- ============================================================
			VAR _ViewBoxWidth = 920
			VAR _ViewBoxHeight = 430
			
			VAR _Left = 62
			VAR _Right = 888
			
			VAR _Top = 42
			VAR _PlotHeight = 310
			
			VAR _PlotWidth =
			    _Right - _Left
			
			VAR _Step =
			    DIVIDE (
			        _PlotWidth,
			        12
			    )
			
			VAR _BarWidth = 42
			
			VAR _Baseline =
			    _Top + _PlotHeight
			
			
			-- Maximum of displayed values
			VAR _RawMaximum =
			    MAXX (
			        _VisibleData,
			        MAX (
			            COALESCE ( [@VisibleActual], 0 ),
			            MAX (
			                COALESCE ( [@VisiblePriorYear], 0 ),
			                COALESCE ( [@VisibleForecast], 0 )
			            )
			        )
			    )
			
			
			VAR _YMaximum =
			    MAX (
			        1,
			        _RawMaximum * 1.10
			    )
			
			
			-- SVG coordinates
			VAR _Points =
			    ADDCOLUMNS (
			        _VisibleData,
			
			        "@X",
			            _Left
			                + (
			                    [@MonthNumber] - 0.5
			                ) * _Step,
			
			        "@ActualY",
			            _Baseline
			                - ROUND (
			                    _PlotHeight
			                        * DIVIDE (
			                            COALESCE (
			                                [@VisibleActual],
			                                0
			                            ),
			                            _YMaximum,
			                            0
			                        ),
			                    0
			                ),
			
			        "@PriorYearY",
			            _Baseline
			                - ROUND (
			                    _PlotHeight
			                        * DIVIDE (
			                            COALESCE (
			                                [@VisiblePriorYear],
			                                0
			                            ),
			                            _YMaximum,
			                            0
			                        ),
			                    0
			                ),
			
			        "@ForecastY",
			            _Baseline
			                - ROUND (
			                    _PlotHeight
			                        * DIVIDE (
			                            COALESCE (
			                                [@VisibleForecast],
			                                0
			                            ),
			                            _YMaximum,
			                            0
			                        ),
			                    0
			                )
			    )
			
			
			-- Grid and Y-axis labels
			VAR _GridLines =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 4, 1 ),
			
			        VAR _GridIndex =
			            [Value]
			
			        VAR _GridY =
			            _Top
			                + ROUND (
			                    _PlotHeight
			                        * DIVIDE (
			                            _GridIndex,
			                            4
			                        ),
			                    0
			                )
			
			        VAR _GridValue =
			            _YMaximum
			                * DIVIDE (
			                    4 - _GridIndex,
			                    4
			                )
			
			        RETURN
			            "<line x1='" & FORMAT ( _Left, "0" )
			                & "' y1='" & FORMAT ( _GridY, "0" )
			                & "' x2='" & FORMAT ( _Right, "0" )
			                & "' y2='" & FORMAT ( _GridY, "0" )
			                & "' stroke='#E7E3E8'
			                     stroke-width='1'/>"
			                &
			            "<text x='" & FORMAT ( _Left - 10, "0" )
			                & "' y='" & FORMAT ( _GridY + 7, "0" )
			                & "' text-anchor='end'
			                     class='rf-axis'>"
			                & FORMAT (
			                    _GridValue / 1000000,
			                    "0"
			                )
			                & "</text>",
			
			        ""
			    )
			
			
			-- Actual-revenue bars
			VAR _ActualBars =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@VisibleActual] )
			        ),
			
			        VAR _X =
			            [@X]
			                - DIVIDE (
			                    _BarWidth,
			                    2
			                )
			
			        VAR _Y =
			            [@ActualY]
			
			        VAR _Height =
			            MAX (
			                0,
			                _Baseline - _Y
			            )
			
			        RETURN
			            "<rect x='" & FORMAT ( _X, "0" )
			                & "' y='" & FORMAT ( _Y, "0" )
			                & "' width='" & FORMAT ( _BarWidth, "0" )
			                & "' height='" & FORMAT ( _Height, "0" )
			                & "' rx='3'
			                     fill='#331045'>"
			                &
			                "<title>"
			                & FORMAT (
			                    [@MonthDate],
			                    "MMM yyyy"
			                )
			                & ": "
			                & FORMAT (
			                    [@VisibleActual] / 1000000,
			                    "€0.0m"
			                )
			                & "</title></rect>",
			
			        "",
			        [@MonthNumber],
			        ASC
			    )
			
			
			-- Prior-year line
			VAR _PriorYearPoints =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@VisiblePriorYear] )
			        ),
			        FORMAT ( [@X], "0" )
			            & ","
			            & FORMAT ( [@PriorYearY], "0" ),
			        " ",
			        [@MonthNumber],
			        ASC
			    )
			
			
			VAR _PriorYearMarkers =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@VisiblePriorYear] )
			        ),
			
			        "<circle cx='" & FORMAT ( [@X], "0" )
			            & "' cy='" & FORMAT ( [@PriorYearY], "0" )
			            & "' r='3.5'
			                 fill='#9C999D'>"
			            &
			            "<title>"
			            & FORMAT (
			                [@MonthDate],
			                "MMM yyyy"
			            )
			            & " PY: "
			            & FORMAT (
			                [@VisiblePriorYear] / 1000000,
			                "€0.0m"
			            )
			            & "</title></circle>",
			
			        "",
			        [@MonthNumber],
			        ASC
			    )
			
			
			-- Latest forecast after the cutoff month
			VAR _ForecastRows =
			    FILTER (
			        _Points,
			        NOT ISBLANK ( [@VisibleForecast] )
			    )
			
			
			VAR _ForecastPoints =
			    CONCATENATEX (
			        _ForecastRows,
			        FORMAT ( [@X], "0" )
			            & ","
			            & FORMAT ( [@ForecastY], "0" ),
			        " ",
			        [@MonthNumber],
			        ASC
			    )
			
			
			VAR _ForecastMarkers =
			    CONCATENATEX (
			        _ForecastRows,
			
			        "<circle cx='" & FORMAT ( [@X], "0" )
			            & "' cy='" & FORMAT ( [@ForecastY], "0" )
			            & "' r='4'
			                 fill='#138F96'>"
			            &
			            "<title>"
			            & FORMAT (
			                [@MonthDate],
			                "MMM yyyy"
			            )
			            & " forecast: "
			            & FORMAT (
			                [@VisibleForecast] / 1000000,
			                "€0.0m"
			            )
			            & "</title></circle>",
			
			        "",
			        [@MonthNumber],
			        ASC
			    )
			
			
			-- Month labels
			VAR _MonthLabels =
			    CONCATENATEX (
			        _Points,
			
			        "<text x='" & FORMAT ( [@X], "0" )
			            & "' y='401'
			                 text-anchor='middle'
			                 class='rf-month'>"
			            & FORMAT (
			                [@MonthDate],
			                "MMM"
			            )
			            & "</text>",
			
			        "",
			        [@MonthNumber],
			        ASC
			    )
			
			
			-- Forecast-horizon divider
			VAR _CutoffIsInSelectedYear =
			    NOT ISBLANK ( _LastActualMonthInYear )
			        && YEAR ( _CutoffMonth ) = _SelectedYear
			
			
			VAR _CutoffMonthNumber =
			    IF (
			        _CutoffIsInSelectedYear,
			        MONTH ( _CutoffMonth )
			    )
			
			
			VAR _DividerX =
			    _Left
			        + COALESCE (
			            _CutoffMonthNumber,
			            0
			        ) * _Step
			
			
			VAR _CurrentMonthDivider =
			    IF (
			        _CutoffIsInSelectedYear
			            && _CutoffMonthNumber < 12,
			
			        "<line x1='" & FORMAT ( _DividerX, "0" )
			            & "' y1='" & FORMAT ( _Top, "0" )
			            & "' x2='" & FORMAT ( _DividerX, "0" )
			            & "' y2='" & FORMAT ( _Baseline, "0" )
			            & "' stroke='#777177'
			                 stroke-width='1.5'
			                 stroke-dasharray='6 5'/>"
			            &
			        "<text x='" & FORMAT ( _DividerX + 10, "0" )
			            & "' y='" & FORMAT ( _Top + 22, "0" )
			            & "' class='rf-current'>Forecast</text>"
			            &
			        "<text x='" & FORMAT ( _DividerX + 10, "0" )
			            & "' y='" & FORMAT ( _Top + 44, "0" )
			            & "' class='rf-current'>Horizon</text>",
			
			        ""
			    )
			
			
			VAR _StatusText =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _LastActualMonthInYear )
			            && _HasFutureForecast,
			            "Forecast-only year",
			
			        _HasFutureForecast,
			            "Actual through "
			                & FORMAT (
			                    _CutoffMonth,
			                    "MMM yyyy"
			                ),
			
			        "No future forecast values"
			    )
			
			
			VAR _StatusColor =
			    IF (
			        _HasFutureForecast,
			        "#6F6872",
			        "#C53D3D"
			    )
			
			
			RETURN
			    IF (
			        NOT _HasData,
			
			        "<div style='
			            padding:14px;
			            color:#C53D3D;
			            font-family:Segoe UI,Arial,sans-serif;
			            font-size:14px;
			        '>
			            No revenue or Latest Estimate data was found.
			        </div>",
			
			        "
			        <style>
			            * {
			                box-sizing:border-box;
			            }
			
			            .rf-card {
			                width:100%;
			                padding:5px 5px 5px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:5px;
			                font-family:'Segoe UI',Arial,sans-serif;
			            }
			
			            .rf-title-row {
			                display:flex;
			                align-items:center;
			                justify-content:space-between;
			                gap:8px;
			            }
			
			            .rf-title {
			                overflow:hidden;
			                color:#211D22;
			                font-size:15px;
			                font-weight:700;
			                text-overflow:ellipsis;
			                text-transform:uppercase;
			            }
			
			            .rf-legend {
			                display:flex;
			                align-items:center;
			                flex-wrap:wrap;
			                gap:8px 18px;
			                margin:8px 0 2px;
			                color:#4E4851;
			                font-size:10px;
			            }
			
			            .rf-legend-item {
			                display:flex;
			                align-items:center;
			                gap:6px;
			                white-space:nowrap;
			            }
			
			            .rf-bar-key {
			                width:9px;
			                height:11px;
			                background:#331045;
			                border-radius:1px;
			            }
			
			            .rf-line-key {
			                width:24px;
			                border-top:2px solid #9C999D;
			            }
			
			            .rf-forecast-key {
			                width:24px;
			                border-top:2px dashed #138F96;
			            }
			            .rf-svg {
			                display:block;
			                width:100%;
			                height:210px;
			                aspect-ratio:920 / 430;
			                margin-top:2px;
			                overflow:visible;
			            }
			
			            .rf-axis {
			                fill:#69636B;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:24px;
			                font-weight:400;
			            }
			
			            .rf-month {
			                fill:#413C42;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:25px;
			                font-weight:400;
			            }
			
			            .rf-current {
			                fill:#4E4851;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:22px;
			                font-weight:600;
			            }
			        </style>
			
			        <div class='rf-card'>
			
			            <div class='rf-title-row'>
			                <div class='rf-title'>
			                    Revenue vs PY &amp; Latest Forecast
			                </div>
			            </div>
			
			            <div class='rf-legend'>
			
			                <div class='rf-legend-item'>
			                    <span class='rf-bar-key'></span>
			                    <span>Actual Revenue</span>
			                </div>
			
			                <div class='rf-legend-item'>
			                    <span class='rf-line-key'></span>
			                    <span>Prior Year</span>
			                </div>
			
			                <div class='rf-legend-item'>
			                    <span class='rf-forecast-key'></span>
			                    <span>Latest Forecast</span>
			                </div>
			
			            </div>
			
			            <svg class='rf-svg'
			                 viewBox='0 0 "
			                    & _ViewBoxWidth
			                    & " "
			                    & _ViewBoxHeight
			                    & "'
			                 preserveAspectRatio='xMidYMid meet'>
			
			                <text x='8'
			                      y='29'
			                      class='rf-axis'>
			                    €m
			                </text>"
			
			                & _GridLines
			
			                & "<line x1='" & FORMAT ( _Left, "0" )
			                & "' y1='" & FORMAT ( _Baseline, "0" )
			                & "' x2='" & FORMAT ( _Right, "0" )
			                & "' y2='" & FORMAT ( _Baseline, "0" )
			                & "' stroke='#BEB9C0'
			                     stroke-width='1.5'/>"
			
			                & _ActualBars
			
			                & "<polyline points='"
			                & _PriorYearPoints
			                & "' fill='none'
			                     stroke='#9C999D'
			                     stroke-width='2.5'
			                     stroke-linejoin='round'
			                     stroke-linecap='round'/>"
			
			                & _PriorYearMarkers
			
			                & "<polyline points='"
			                & _ForecastPoints
			                & "' fill='none'
			                     stroke='#138F96'
			                     stroke-width='3'
			                     stroke-dasharray='9 7'
			                     stroke-linejoin='round'
			                     stroke-linecap='round'/>"
			
			                & _ForecastMarkers
			                & _CurrentMonthDivider
			                & _MonthLabels
			
			                & "</svg>
			
			        </div>"
			    )
		displayFolder: 08 Executive
		lineageTag: 532d8156-542c-4bfe-996a-640efeda9855

	measure 'Executive Decision Brief HTML' =
			
			VAR _TotalRevenue =
			    [Revenue]
			
			
			-- Regional performance
			VAR _RegionalPerformance =
			    FILTER (
			        ADDCOLUMNS (
			            ALLSELECTED ( dimRegion[region] ),
			            "@Revenue", [Revenue],
			            "@Growth", [Revenue YoY %],
			            "@MarginChange", [Gross Margin % YoY pp],
			            "@ForecastAccuracy", [Revenue FC Accuracy %]
			        ),
			        NOT ISBLANK ( [@Revenue] )
			            && [@Revenue] >= _TotalRevenue * 0.02
			    )
			
			
			VAR _WinningRegionRow =
			    TOPN (
			        1,
			        _RegionalPerformance,
			        [@Growth], DESC,
			        [@Revenue], DESC,
			        dimRegion[region], ASC
			    )
			
			
			VAR _WinningRegion =
			    COALESCE (
			        MAXX (
			            _WinningRegionRow,
			            dimRegion[region]
			        ),
			        "selected portfolio"
			    )
			
			
			VAR _WinningGrowth =
			    MAXX (
			        _WinningRegionRow,
			        [@Growth]
			    )
			
			
			VAR _WinningMarginChange =
			    MAXX (
			        _WinningRegionRow,
			        [@MarginChange]
			    )
			
			
			VAR _WinningForecastAccuracy =
			    MAXX (
			        _WinningRegionRow,
			        [@ForecastAccuracy]
			    )
			
			
			-- Driver values in the winning region
			VAR _PriceEffect =
			    MAXX (
			        _WinningRegionRow,
			        [PVM Price Effect]
			    )
			
			
			VAR _VolumeEffect =
			    MAXX (
			        _WinningRegionRow,
			        [PVM Volume Effect]
			    )
			
			
			VAR _MixEffect =
			    MAXX (
			        _WinningRegionRow,
			        [PVM Revenue Mix Effect]
			    )
			
			
			VAR _WinningDriver =
			    SWITCH (
			        TRUE (),
			
			        _VolumeEffect >= _PriceEffect
			            && _VolumeEffect >= _MixEffect,
			            "volume",
			
			        _PriceEffect >= _VolumeEffect
			            && _PriceEffect >= _MixEffect,
			            "price",
			
			        "mix"
			    )
			
			
			-- Product family with highest revenue at risk
			VAR _ProductRiskTable =
			    FILTER (
			        ADDCOLUMNS (
			            ALLSELECTED ( dimProduct[product_family] ),
			            "@Risk", [Revenue at Risk]
			        ),
			        NOT ISBLANK ( [@Risk] )
			    )
			
			
			VAR _TopRiskProductRow =
			    TOPN (
			        1,
			        _ProductRiskTable,
			        [@Risk], DESC,
			        dimProduct[product_family], ASC
			    )
			
			
			VAR _TopRiskProduct =
			    COALESCE (
			        MAXX (
			            _TopRiskProductRow,
			            dimProduct[product_family]
			        ),
			        "the highest-risk product family"
			    )
			
			
			-- Region with highest revenue at risk
			VAR _RegionRiskTable =
			    FILTER (
			        ADDCOLUMNS (
			            ALLSELECTED ( dimRegion[region] ),
			            "@Risk", [Revenue at Risk]
			        ),
			        NOT ISBLANK ( [@Risk] )
			    )
			
			
			VAR _TopRiskRegionRow =
			    TOPN (
			        1,
			        _RegionRiskTable,
			        [@Risk], DESC,
			        dimRegion[region], ASC
			    )
			
			
			VAR _TopRiskRegion =
			    COALESCE (
			        MAXX (
			            _TopRiskRegionRow,
			            dimRegion[region]
			        ),
			        "the highest-risk region"
			    )
			
			
			-- Risk values
			VAR _RevenueAtRisk =
			    [Revenue at Risk]
			
			
			VAR _RevenueAtRiskShare =
			    [Revenue at Risk % of Total]
			
			
			VAR _RevenueAtRiskFormatted =
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( _RevenueAtRisk ),
			            "—",
			
			        ABS ( _RevenueAtRisk ) >= 1000000000,
			            FORMAT (
			                _RevenueAtRisk / 1000000000,
			                "€0.00bn"
			            ),
			
			        ABS ( _RevenueAtRisk ) >= 1000000,
			            FORMAT (
			                _RevenueAtRisk / 1000000,
			                "€0.0m"
			            ),
			
			        ABS ( _RevenueAtRisk ) >= 1000,
			            FORMAT (
			                _RevenueAtRisk / 1000,
			                "€0.0k"
			            ),
			
			        FORMAT (
			            _RevenueAtRisk,
			            "€#,0"
			        )
			    )
			
			
			-- Win text
			VAR _WinTitle =
			    "Growth led by "
			        & _WinningDriver
			        & " in "
			        & _WinningRegion
			
			
			VAR _WinLineOne =
			    _WinningRegion
			        & " grew "
			        & FORMAT (
			            _WinningGrowth,
			            "+0.0%;-0.0%;0.0%"
			        )
			        & " YoY, driven by "
			        & _WinningDriver
			        & "."
			
			
			VAR _WinLineTwo =
			    "Margin changed "
			        & FORMAT (
			            _WinningMarginChange,
			            "+0.0;-0.0;0.0"
			        )
			        & " pp with "
			        & FORMAT (
			            _WinningForecastAccuracy,
			            "0.0%"
			        )
			        & " forecast accuracy."
			
			
			-- Risk text
			VAR _RiskTitle =
			    _RevenueAtRiskFormatted
			        & " exposed, concentrated in "
			        & _TopRiskProduct
			
			
			VAR _RiskLineOne =
			    _RevenueAtRiskFormatted
			        & " ("
			        & FORMAT (
			            _RevenueAtRiskShare,
			            "0.0%"
			        )
			        & ") of revenue at risk."
			
			
			VAR _RiskLineTwo =
			    "Highest exposure is in "
			        & _TopRiskProduct
			        & " and "
			        & _TopRiskRegion
			        & "."
			
			
			-- Dynamic action
			VAR _GrossMargin =
			    [Gross Margin %]
			
			
			VAR _GrossMarginTarget =
			    [Gross Margin Target %]
			
			
			VAR _NRR =
			    [NRR %]
			
			
			VAR _ActionTitle =
			    SWITCH (
			        TRUE (),
			
			        _GrossMargin < _GrossMarginTarget,
			            "Protect margin and prioritize at-risk accounts",
			
			        _NRR < 1,
			            "Protect retention and recover customer value",
			
			        "Scale growth while protecting account quality"
			    )
			
			
			VAR _ActionLineOne =
			    SWITCH (
			        TRUE (),
			
			        _GrossMargin < _GrossMarginTarget,
			            "Focus on retention in "
			                & _TopRiskProduct
			                & " and at-risk accounts.",
			
			        _NRR < 1,
			            "Prioritize expansion and churn prevention in "
			                & _TopRiskProduct
			                & ".",
			
			        "Concentrate commercial activity on high-value opportunities."
			    )
			
			
			VAR _ActionLineTwo =
			    SWITCH (
			        TRUE (),
			
			        _GrossMargin < _GrossMarginTarget,
			            "Use pricing and mix levers to protect margin.",
			
			        _NRR < 1,
			            "Target accounts with declining revenue and weak health scores.",
			
			        "Maintain pricing discipline while scaling volume."
			    )
			
			
			RETURN
			    "
			    <style>
			
			        * {
			            box-sizing: border-box;
			        }
			
			        html,
			        body {
			            width: 100%;
			            height: 100%;
			            margin: 0;
			            padding: 0;
			            overflow: hidden;
			        }
			
			
			        /* =========================================================
			           MAIN CONTAINER
			           ========================================================= */
			
			        .db-wrapper {
			            width: 100%;
			            height: 100%;
			            min-height:275px;
			
			            display: flex;
			            flex-direction: column;
			
			            padding: 5px;
			
			            overflow: hidden;
			
			            background: #FFFFFF;
			            border: 1px solid #E3DEE6;
			            border-radius: 5px;
			
			            font-family:
			                'Segoe UI',
			                Arial,
			                sans-serif;
			        }
			
			
			        /* =========================================================
			           TITLE
			           ========================================================= */
			
			        .db-title {
			            flex: 0 0 auto;
			
			            margin:
			                0
			                0
			                clamp(6px, 1.3vh, 11px)
			                1px;
			
			            color: #211D22;
			
			            font-size: 15px;
			            font-weight: 700;
			
			            line-height: 1.15;
			
			            text-transform: uppercase;
			
			            overflow: hidden;
			            text-overflow: ellipsis;
			            white-space: nowrap;
			        }
			
			
			        /* =========================================================
			           GRID
			           ========================================================= */
			
			        .db-grid {
			            flex: 1 1 auto;
			
			            min-height: 0;
			
			            display: grid;
			
			            grid-template-rows:
			                repeat(
			                    3,
			                    minmax(0, 1fr)
			                );
			
			            gap:
			                clamp(
			                    6px,
			                    min(1.1vw, 1.7vh),
			                    11px
			                );
			        }
			
			
			        /* =========================================================
			           INDIVIDUAL ROW
			           ========================================================= */
			
			        .db-row {
			            width: 100%;
			
			            min-width: 0;
			            min-height: 0;
			
			            display: grid;
			
			            grid-template-columns:
			                clamp(
			                    58px,
			                    16vw,
			                    118px
			                )
			                minmax(0, 1fr);
			
			            overflow: hidden;
			
			            background: #FFFFFF;
			
			            border: 1px solid #E1DDE3;
			
			            border-radius:
			                clamp(
			                    5px,
			                    min(1vw, 1.5vh),
			                    9px
			                );
			        }
			
			
			        /* =========================================================
			           STATUS BLOCK
			           ========================================================= */
			
			        .db-status {
			            min-width: 0;
			            min-height: 0;
			
			            display: flex;
			            flex-direction: column;
			
			            align-items: center;
			            justify-content: center;
			
			            padding:
			                clamp(
			                    6px,
			                    min(1.2vw, 1.6vh),
			                    12px
			                )
			                clamp(
			                    4px,
			                    1vw,
			                    8px
			                );
			
			            overflow: hidden;
			
			            color: #FFFFFF;
			
			            text-align: center;
			        }
			
			
			        .db-status-icon {
			            margin-bottom:
			                clamp(
			                    3px,
			                    0.8vh,
			                    7px
			                );
			
			            font-size:
			                clamp(
			                    20px,
			                    min(4vw, 5.5vh),
			                    37px
			                );
			
			            line-height: 0.95;
			
			            font-weight: 400;
			        }
			
			
			        .db-status-label {
			            max-width: 100%;
			
			            font-size:
			                clamp(
			                    10px,
			                    min(1.4vw, 2vh),
			                    14px
			                );
			
			            line-height: 1;
			
			            font-weight: 600;
			
			            white-space: nowrap;
			
			            overflow: hidden;
			            text-overflow: ellipsis;
			        }
			
			        .db-content {
			            min-width: 0;
			            min-height: 0;
			
			            display: flex;
			            flex-direction: column;
			
			            justify-content: center;
			
			            /*
			               Extra left padding creates visual separation
			               between the status block and the text.
			            */
			            padding:
			                clamp(
			                    7px,
			                    1.5vh,
			                    13px
			                )
			                clamp(
			                    10px,
			                    1.8vw,
			                    18px
			                )
			                clamp(
			                    7px,
			                    1.5vh,
			                    13px
			                )
			                clamp(
			                    14px,
			                    2.5vw,
			                    24px
			                );
			
			            overflow: hidden;
			        }
			
			
			        .db-headline {
			            flex: 0 1 auto;
			
			            margin-bottom:
			                clamp(
			                    4px,
			                    0.9vh,
			                    8px
			                );
			
			            overflow: hidden;
			
			            color: #211D22;
			
			            font-size:
			                clamp(
			                    11px,
			                    min(1.4vw, 2.3vh),
			                    14px
			                );
			
			            line-height: 1.2;
			
			            font-weight: 700;
			
			            white-space: nowrap;
			
			            text-overflow: ellipsis;
			        }
			
			
			        .db-description {
			            min-width: 0;
			            min-height: 0;
			
			            overflow: hidden;
			
			            color: #565057;
			
			            font-size:
			                clamp(
			                    10px,
			                    min(1.2vw, 1.9vh),
			                    12px
			                );
			
			            line-height: 1.35;
			        }
			
			
			        .db-description div {
			            min-width: 0;
			
			            overflow: hidden;
			
			            white-space: nowrap;
			
			            text-overflow: ellipsis;
			        }
			
			
			        .db-description div + div {
			            margin-top:
			                clamp(
			                    1px,
			                    0.35vh,
			                    3px
			                );
			        }
			
			        /* Narrow visual */
			        @media (max-width: 600px) {
			
			            .db-row {
			                grid-template-columns:
			                    clamp(
			                        58px,
			                        17vw,
			                        82px
			                    )
			                    minmax(0, 1fr);
			            }
			
			
			            .db-content {
			                padding:
			                    clamp(
			                        7px,
			                        1.5vh,
			                        11px
			                    )
			                    10px
			                    clamp(
			                        7px,
			                        1.5vh,
			                        11px
			                    )
			                    clamp(
			                        13px,
			                        3vw,
			                        20px
			                    );
			            }
			
			
			            .db-headline {
			                font-size:
			                    clamp(
			                        11px,
			                        3vw,
			                        13px
			                    );
			            }
			
			
			            .db-description {
			                font-size:
			                    clamp(
			                        10px,
			                        2.6vw,
			                        12px
			                    );
			            }
			
			
			            .db-status-icon {
			                font-size:
			                    clamp(
			                        20px,
			                        6vw,
			                        27px
			                    );
			            }
			
			
			            .db-status-label {
			                font-size:
			                    clamp(
			                        9px,
			                        2.7vw,
			                        12px
			                    );
			            }
			        }
			
			
			        /* Very narrow visual */
			        @media (max-width: 420px) {
			
			            .db-wrapper {
			                padding: 4px;
			            }
			
			
			            .db-title {
			                margin-bottom: 6px;
			            }
			
			
			            .db-grid {
			                gap: 5px;
			            }
			
			
			            .db-row {
			                grid-template-columns:
			                    clamp(
			                        58px,
			                        17vw,
			                        70px
			                    )
			                    minmax(0, 1fr);
			            }
			
			
			            .db-content {
			                padding:
			                    7px
			                    8px
			                    7px
			                    14px;
			            }
			        }
			
			
			        /* Low-height visual */
			        @media (max-height: 360px) {
			
			            .db-wrapper {
			                padding: 4px;
			            }
			
			
			            .db-title {
			                font-size: 15px;
			
			                margin-bottom: 5px;
			            }
			
			
			            .db-grid {
			                gap: 5px;
			            }
			
			
			            .db-row {
			                border-radius: 5px;
			            }
			
			
			            .db-status {
			                padding:
			                    5px
			                    4px;
			            }
			
			
			            .db-content {
			                padding:
			                    5px
			                    8px
			                    5px
			                    14px;
			            }
			
			
			            .db-headline {
			                margin-bottom: 2px;
			
			                font-size: 13px;
			
			                line-height: 1.1;
			            }
			
			
			            .db-description {
			                font-size: 12px;
			
			                line-height: 1.2;
			            }
			
			
			            .db-description div + div {
			                margin-top: 1px;
			            }
			
			
			            .db-status-icon {
			                margin-bottom: 2px;
			
			                font-size: 20px;
			            }
			
			
			            .db-status-label {
			                font-size: 12px;
			            }
			        }
			
			
			        /* Extremely low-height visual */
			        @media (max-height: 250px) {
			
			            .db-title {
			                font-size: 14px;
			
			                margin-bottom: 3px;
			            }
			
			
			            .db-grid {
			                gap: 3px;
			            }
			
			
			            .db-status {
			                padding:
			                    3px
			                    4px;
			            }
			
			
			            .db-status-icon {
			                font-size: 16px;
			
			                margin-bottom: 1px;
			            }
			
			
			            .db-status-label {
			                font-size: 10px;
			            }
			
			
			            .db-content {
			                padding:
			                    3px
			                    7px
			                    3px
			                    12px;
			            }
			
			
			            .db-headline {
			                font-size: 11px;
			
			                margin-bottom: 1px;
			            }
			
			
			            .db-description {
			                font-size: 10px;
			
			                line-height: 1.1;
			            }
			        }
			
			    </style>
			
			
			    <div class='db-wrapper'>
			
			
			        <div class='db-title'>
			            Decision Brief
			        </div>
			
			
			        <div class='db-grid'>
			
			
			            <!-- WIN -->
			            <div class='db-row'>
			
			
			                <div
			                    class='db-status'
			                    style='background:#2F855A'
			                >
			
			                    <div class='db-status-icon'>
			                        ★
			                    </div>
			
			                    <div class='db-status-label'>
			                        WIN
			                    </div>
			
			                </div>
			
			
			                <div class='db-content'>
			
			                    <div class='db-headline'>
			                        "
			                            & _WinTitle &
			                        "
			                    </div>
			
			                    <div class='db-description'>
			
			                        <div>
			                            "
			                                & _WinLineOne &
			                            "
			                        </div>
			
			                        <div>
			                            "
			                                & _WinLineTwo &
			                            "
			                        </div>
			
			                    </div>
			
			                </div>
			
			            </div>
			
			
			
			            <!-- RISK -->
			            <div class='db-row'>
			
			
			                <div
			                    class='db-status'
			                    style='background:#C53D3D'
			                >
			
			                    <div class='db-status-icon'>
			                        !
			                    </div>
			
			                    <div class='db-status-label'>
			                        RISK
			                    </div>
			
			                </div>
			
			
			                <div class='db-content'>
			
			                    <div class='db-headline'>
			                        "
			                            & _RiskTitle &
			                        "
			                    </div>
			
			                    <div class='db-description'>
			
			                        <div>
			                            "
			                                & _RiskLineOne &
			                            "
			                        </div>
			
			                        <div>
			                            "
			                                & _RiskLineTwo &
			                            "
			                        </div>
			
			                    </div>
			
			                </div>
			
			            </div>
			
			
			
			            <!-- ACTION -->
			            <div class='db-row'>
			
			
			                <div
			                    class='db-status'
			                    style='background:#D99A2B'
			                >
			
			                    <div class='db-status-icon'>
			                        →
			                    </div>
			
			                    <div class='db-status-label'>
			                        ACTION
			                    </div>
			
			                </div>
			
			
			                <div class='db-content'>
			
			                    <div class='db-headline'>
			                        "
			                            & _ActionTitle &
			                        "
			                    </div>
			
			                    <div class='db-description'>
			
			                        <div>
			                            "
			                                & _ActionLineOne &
			                            "
			                        </div>
			
			                        <div>
			                            "
			                                & _ActionLineTwo &
			                            "
			                        </div>
			
			                    </div>
			
			                </div>
			
			            </div>
			
			
			        </div>
			
			    </div>
			    "
		displayFolder: 08 Executive
		lineageTag: 4b406af7-b77d-49be-8139-d72424570442

	measure 'Customer Concentration HTML' =
			
			VAR _CustomerBase =
			    FILTER (
			        ADDCOLUMNS (
			            ALLSELECTED ( dimCustomer[customer_code] ),
			            "@Revenue", [Revenue]
			        ),
			        NOT ISBLANK ( [@Revenue] )
			            && [@Revenue] > 0
			    )
			
			VAR _TopCustomers =
			    TOPN (
			        50,
			        _CustomerBase,
			        [@Revenue], DESC,
			        dimCustomer[customer_code], ASC
			    )
			
			VAR _CustomerCount =
			    COUNTROWS ( _TopCustomers )
			
			VAR _DisplayedRevenue =
			    SUMX (
			        _TopCustomers,
			        [@Revenue]
			    )
			
			VAR _RankedCustomers =
			    ADDCOLUMNS (
			        _TopCustomers,
			        "@Rank",
			            RANKX (
			                _TopCustomers,
			                [@Revenue],
			                ,
			                DESC,
			                DENSE
			            )
			    )
			
			VAR _CustomerData =
			    ADDCOLUMNS (
			        _RankedCustomers,
			        "@CumulativePct",
			            VAR _CurrentRank = [@Rank]
			            VAR _CumulativeRevenue =
			                SUMX (
			                    TOPN (
			                        _CurrentRank,
			                        _TopCustomers,
			                        [@Revenue], DESC,
			                        dimCustomer[customer_code], ASC
			                    ),
			                    [@Revenue]
			                )
			            RETURN
			                DIVIDE (
			                    _CumulativeRevenue,
			                    _DisplayedRevenue
			                )
			    )
			
			
			-- Top-20-percent calculation
			VAR _Top20Count =
			    MAX (
			        1,
			        ROUNDUP (
			            _CustomerCount * 0.20,
			            0
			        )
			    )
			
			VAR _Top20Revenue =
			    SUMX (
			        TOPN (
			            _Top20Count,
			            _TopCustomers,
			            [@Revenue], DESC,
			            dimCustomer[customer_code], ASC
			        ),
			        [@Revenue]
			    )
			
			VAR _Top20RevenuePct =
			    DIVIDE (
			        _Top20Revenue,
			        _DisplayedRevenue
			    )
			
			
			-- SVG dimensions
			VAR _Left = 82
			VAR _Top = 44
			VAR _PlotWidth = 700
			VAR _PlotHeight = 255
			
			VAR _Step =
			    DIVIDE (
			        _PlotWidth,
			        MAX ( 1, _CustomerCount )
			    )
			
			VAR _BarWidth =
			    MAX (
			        3,
			        _Step * 0.70
			    )
			
			VAR _MaximumRevenue =
			    MAXX (
			        _CustomerData,
			        [@Revenue]
			    ) * 1.10
			
			
			-- SVG coordinates
			VAR _Points =
			    ADDCOLUMNS (
			        _CustomerData,
			
			        "@X",
			            _Left
			                + ( [@Rank] - 0.5 ) * _Step,
			
			        "@RevenueY",
			            _Top
			                + _PlotHeight
			                - ROUND (
			                    _PlotHeight
			                        * DIVIDE (
			                            [@Revenue],
			                            _MaximumRevenue,
			                            0
			                        ),
			                    0
			                ),
			
			        "@CumulativeY",
			            _Top
			                + _PlotHeight
			                - ROUND (
			                    _PlotHeight
			                        * [@CumulativePct],
			                    0
			                )
			    )
			
			
			-- Grid and revenue-axis labels
			VAR _GridLines =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 4, 1 ),
			
			        VAR _Index = [Value]
			
			        VAR _Y =
			            _Top
			                + ROUND (
			                    _PlotHeight
			                        * DIVIDE ( _Index, 4 ),
			                    0
			                )
			
			        VAR _RevenueValue =
			            _MaximumRevenue
			                * DIVIDE ( 4 - _Index, 4 )
			
			        VAR _RevenueLabel =
			            SWITCH (
			                TRUE (),
			                _RevenueValue >= 1000000000,
			                    "€"
			                        & FORMAT (
			                            _RevenueValue / 1000000000,
			                            "0.0"
			                        )
			                        & "bn",
			                _RevenueValue >= 1000000,
			                    "€"
			                        & FORMAT (
			                            _RevenueValue / 1000000,
			                            "0"
			                        )
			                        & "m",
			                _RevenueValue >= 1000,
			                    "€"
			                        & FORMAT (
			                            _RevenueValue / 1000,
			                            "0"
			                        )
			                        & "k",
			                "€"
			                    & FORMAT (
			                        _RevenueValue,
			                        "0"
			                    )
			            )
			
			        RETURN
			            "<line x1='" & _Left
			                & "' y1='" & FORMAT ( _Y, "0" )
			                & "' x2='" & FORMAT ( _Left + _PlotWidth, "0" )
			                & "' y2='" & FORMAT ( _Y, "0" )
			                & "' stroke='#E7E3E8' stroke-width='1'/>"
			                &
			            "<text x='68'
			                   y='" & FORMAT ( _Y + 4, "0" ) & "'
			                   text-anchor='end'
			                   class='cc-axis'>"
			                & _RevenueLabel
			                & "</text>",
			
			        ""
			    )
			
			
			-- Right percentage axis
			VAR _PercentageLabels =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 4, 1 ),
			
			        VAR _Index = [Value]
			
			        VAR _Y =
			            _Top
			                + ROUND (
			                    _PlotHeight
			                        * DIVIDE ( _Index, 4 ),
			                    0
			                )
			
			        VAR _Percentage =
			            100 - _Index * 25
			
			        RETURN
			            "<text x='800'
			                   y='" & FORMAT ( _Y + 4, "0" ) & "'
			                   class='cc-axis'>"
			                & FORMAT ( _Percentage, "0" )
			                & "%</text>",
			
			        ""
			    )
			
			
			-- Revenue bars
			VAR _RevenueBars =
			    CONCATENATEX (
			        _Points,
			
			        VAR _X =
			            [@X] - DIVIDE ( _BarWidth, 2 )
			
			        VAR _Y =
			            [@RevenueY]
			
			        VAR _Height =
			            _Top + _PlotHeight - _Y
			
			        RETURN
			            "<rect x='" & FORMAT ( _X, "0" )
			                & "' y='" & FORMAT ( _Y, "0" )
			                & "' width='" & FORMAT ( _BarWidth, "0.0" )
			                & "' height='" & FORMAT ( MAX ( 0, _Height ), "0" )
			                & "' rx='1'
			                     fill='#6FA9B9'
			                     opacity='.92'/>",
			
			        "",
			        [@Rank],
			        ASC
			    )
			
			
			-- Cumulative line
			VAR _CumulativePoints =
			    CONCATENATEX (
			        _Points,
			        FORMAT ( [@X], "0" )
			            & ","
			            & FORMAT ( [@CumulativeY], "0" ),
			        " ",
			        [@Rank],
			        ASC
			    )
			
			VAR _CumulativeMarkers =
			    CONCATENATEX (
			        _Points,
			        "<circle cx='" & FORMAT ( [@X], "0" )
			            & "' cy='" & FORMAT ( [@CumulativeY], "0" )
			            & "' r='3.2'
			                 fill='#331045'/>",
			        "",
			        [@Rank],
			        ASC
			    )
			
			
			-- X-axis labels
			VAR _RankLabels =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            [@Rank] = 1
			                || MOD ( [@Rank], 10 ) = 0
			                || [@Rank] = _CustomerCount
			        ),
			        "<text x='" & FORMAT ( [@X], "0" )
			            & "' y='326'
			                 text-anchor='middle'
			                 class='cc-rank'>"
			            & FORMAT ( [@Rank], "0" )
			            & "</text>",
			        "",
			        [@Rank],
			        ASC
			    )
			
			
			-- Top-20-percent divider
			VAR _Top20DividerX =
			    _Left + _Top20Count * _Step
			
			VAR _Top20Divider =
			    "<line x1='" & FORMAT ( _Top20DividerX, "0" )
			        & "' y1='" & FORMAT ( _Top, "0" )
			        & "' x2='" & FORMAT ( _Top20DividerX, "0" )
			        & "' y2='" & FORMAT ( _Top + _PlotHeight, "0" )
			        & "' stroke='#777177'
			             stroke-width='2'
			             stroke-dasharray='7 6'/>"
			
			
			RETURN
			    IF (
			        _CustomerCount = 0,
			        BLANK (),
			
			        "
			        <style>
			            * { box-sizing:border-box; }
			
			            .cc-card {
			                width:100%;
			                min-height:430px;
			                padding:16px 18px 10px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:10px;
			                box-shadow:0 2px 5px rgba(51,16,69,.06);
			                font-family:'Segoe UI',Arial,sans-serif;
			            }
			
			            .cc-title {
			                color:#211D22;
			                font-size:18px;
			                font-weight:700;
			                line-height:1.2;
			            }
			
			            .cc-legend {
			                display:flex;
			                gap:25px;
			                margin:10px 0 2px;
			                color:#4E4851;
			                font-size:12px;
			            }
			
			            .cc-legend-item {
			                display:flex;
			                align-items:center;
			                gap:7px;
			            }
			
			            .cc-bar-key {
			                width:12px;
			                height:12px;
			                border-radius:50%;
			                background:#6FA9B9;
			            }
			
			            .cc-line-key {
			                width:28px;
			                height:0;
			                position:relative;
			                border-top:3px solid #331045;
			            }
			
			            .cc-line-key:after {
			                content:'';
			                position:absolute;
			                width:7px;
			                height:7px;
			                left:10px;
			                top:-5px;
			                border-radius:50%;
			                background:#331045;
			            }
			
			            .cc-svg {
			                width:100%;
			                height:350px;
			                display:block;
			            }
			
			            .cc-axis,
			            .cc-rank {
			                fill:#5F5962;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:11px;
			            }
			
			            .cc-note {
			                fill:#211D22;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:15px;
			            }
			
			            .cc-note-strong {
			                fill:#211D22;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:18px;
			                font-weight:700;
			            }
			        </style>
			
			        <div class='cc-card'>
			
			            <div class='cc-title'>Customer Concentration</div>
			
			            <div class='cc-legend'>
			                <div class='cc-legend-item'>
			                    <span class='cc-bar-key'></span>
			                    <span>Revenue (€)</span>
			                </div>
			
			                <div class='cc-legend-item'>
			                    <span class='cc-line-key'></span>
			                    <span>Cumulative Revenue (%)</span>
			                </div>
			            </div>
			
			            <svg class='cc-svg'
			                 viewBox='0 0 840 390'
			                 preserveAspectRatio='xMidYMid meet'>
			
			                " & _GridLines & "
			                " & _PercentageLabels & "
			                " & _RevenueBars & "
			
			                <polyline points='" & _CumulativePoints & "'
			                          fill='none'
			                          stroke='#331045'
			                          stroke-width='3'
			                          stroke-linejoin='round'
			                          stroke-linecap='round'/>
			
			                " & _CumulativeMarkers & "
			                " & _Top20Divider & "
			                " & _RankLabels & "
			
			                <rect x='490'
			                      y='104'
			                      width='260'
			                      height='91'
			                      rx='9'
			                      fill='#FFFFFF'
			                      stroke='#6F4A7C'
			                      stroke-width='1.5'/>
			
			                <text x='620'
			                      y='139'
			                      text-anchor='middle'
			                      class='cc-note'>
			                    Top 20% =
			                </text>
			
			                <text x='620'
			                      y='170'
			                      text-anchor='middle'
			                      class='cc-note-strong'>
			                    " & FORMAT ( _Top20RevenuePct, "0%" ) & " of revenue
			                </text>
			
			                <text x='430'
			                      y='367'
			                      text-anchor='middle'
			                      class='cc-note'>
			                    Customers ranked by revenue
			                </text>
			
			            </svg>
			        </div>
			        "
			    )
		displayFolder: 04 Customers
		lineageTag: 3c8985da-92cd-4dcc-8ae2-d66177aa5665

	measure 'Margin Leakage HTML' =
			
			VAR _FamilyComponents =
			    ADDCOLUMNS (
			        ALLSELECTED ( dimProduct[product_family] ),
			
			        "@Discount",
			            - ABS (
			                CALCULATE (
			                    SUM ( factSales[discount_value_eur] )
			                )
			            ),
			
			        "@Returns",
			            - ABS (
			                CALCULATE ( [Returns EUR] )
			            ),
			
			        "@CostVariance",
			            VAR _CostPairs =
			                CALCULATETABLE (
			                    SUMMARIZE (
			                        factCosts,
			                        dimDate[Date],
			                        factCosts[product_id],
			                        "@VariancePerUnit",
			                            MAX (
			                                factCosts[cost_variance_eur]
			                            )
			                    )
			                )
			
			            VAR _CostImpact =
			                SUMX (
			                    _CostPairs,
			
			                    VAR _Month =
			                        dimDate[Date]
			
			                    VAR _Product =
			                        factCosts[product_id]
			
			                    VAR _VariancePerUnit =
			                        MAX (
			                            0,
			                            [@VariancePerUnit]
			                        )
			
			                    VAR _UnitsAtGrain =
			                        CALCULATE (
			                            [Units],
			                            REMOVEFILTERS ( dimDate ),
			                            TREATAS (
			                                { _Month },
			                                dimDate[Date]
			                            ),
			                            TREATAS (
			                                { _Product },
			                                factSales[product_id]
			                            )
			                        )
			
			                    RETURN
			                        _VariancePerUnit
			                            * COALESCE (
			                                _UnitsAtGrain,
			                                0
			                            )
			                )
			
			            RETURN
			                - ABS ( _CostImpact )
			    )
			
			VAR _FamilyLeakage =
			    ADDCOLUMNS (
			        _FamilyComponents,
			        "@Total",
			            [@Discount]
			                + [@CostVariance]
			                + [@Returns]
			    )
			
			VAR _ValidFamilies =
			    FILTER (
			        _FamilyLeakage,
			        NOT ISBLANK ( dimProduct[product_family] )
			            && [@Total] < 0
			    )
			
			VAR _TopFamilies =
			    TOPN (
			        6,
			        _ValidFamilies,
			        ABS ( [@Total] ), DESC,
			        dimProduct[product_family], ASC
			    )
			
			VAR _FamilyCount =
			    COUNTROWS ( _TopFamilies )
			
			VAR _MaximumLeakage =
			    MAXX (
			        _TopFamilies,
			        ABS ( [@Total] )
			    )
			
			
			-- SVG geometry
			VAR _SvgWidth = 500
			
			VAR _PlotLeft = 100
			VAR _PlotRight = 420
			VAR _PlotWidth =
			    _PlotRight - _PlotLeft
			
			VAR _FirstRowY = 28
			VAR _RowHeight = 54
			VAR _BarHeight = 34
			
			VAR _LastRowY =
			    _FirstRowY
			        + ( _FamilyCount - 1 ) * _RowHeight
			
			VAR _SvgHeight =
			    _LastRowY
			        + _BarHeight
			        + 20
			
			
			-- Product-family rows
			VAR _Rows =
			    CONCATENATEX (
			        _TopFamilies,
			
			        VAR _Rank =
			            RANKX (
			                _TopFamilies,
			                [@Total],
			                ,
			                ASC,
			                DENSE
			            )
			
			        VAR _Y =
			            _FirstRowY
			                + ( _Rank - 1 ) * _RowHeight
			
			        VAR _Discount =
			            ABS ( [@Discount] )
			
			        VAR _Cost =
			            ABS ( [@CostVariance] )
			
			        VAR _Returns =
			            ABS ( [@Returns] )
			
			        VAR _Total =
			            _Discount + _Cost + _Returns
			
			        VAR _DiscountWidth =
			            ROUND (
			                _PlotWidth
			                    * DIVIDE (
			                        _Discount,
			                        _MaximumLeakage,
			                        0
			                    ),
			                0
			            )
			
			        VAR _CostWidth =
			            ROUND (
			                _PlotWidth
			                    * DIVIDE (
			                        _Cost,
			                        _MaximumLeakage,
			                        0
			                    ),
			                0
			            )
			
			        VAR _ReturnWidth =
			            ROUND (
			                _PlotWidth
			                    * DIVIDE (
			                        _Returns,
			                        _MaximumLeakage,
			                        0
			                    ),
			                0
			            )
			
			        VAR _DiscountX =
			            _PlotRight
			                - _DiscountWidth
			                - _CostWidth
			                - _ReturnWidth
			
			        VAR _CostX =
			            _PlotRight
			                - _CostWidth
			                - _ReturnWidth
			
			        VAR _ReturnX =
			            _PlotRight
			                - _ReturnWidth
			
			        VAR _DiscountLabel =
			            IF (
			                _DiscountWidth >= 60,
			                "<text x='"
			                    & FORMAT (
			                        _DiscountX
			                            + DIVIDE (
			                                _DiscountWidth,
			                                2
			                            ),
			                        "0"
			                    )
			                    & "' y='"
			                    & FORMAT ( _Y + 22, "0" )
			                    & "' text-anchor='middle'
			                         class='ml-value-light'>−"
			                    & FORMAT (
			                        _Discount / 1000000,
			                        "0.0"
			                    )
			                    & " M€</text>",
			                ""
			            )
			
			        VAR _CostLabel =
			            IF (
			                _CostWidth >= 60,
			                "<text x='"
			                    & FORMAT (
			                        _CostX
			                            + DIVIDE (
			                                _CostWidth,
			                                2
			                            ),
			                        "0"
			                    )
			                    & "' y='"
			                    & FORMAT ( _Y + 22, "0" )
			                    & "' text-anchor='middle'
			                         class='ml-value-light'>−"
			                    & FORMAT (
			                        _Cost / 1000000,
			                        "0.0"
			                    )
			                    & " M€</text>",
			                ""
			            )
			
			        VAR _ReturnLabel =
			            IF (
			                _ReturnWidth >= 60,
			                "<text x='"
			                    & FORMAT (
			                        _ReturnX
			                            + DIVIDE (
			                                _ReturnWidth,
			                                2
			                            ),
			                        "0"
			                    )
			                    & "' y='"
			                    & FORMAT ( _Y + 22, "0" )
			                    & "' text-anchor='middle'
			                         class='ml-value-dark'>−"
			                    & FORMAT (
			                        _Returns / 1000000,
			                        "0.0"
			                    )
			                    & " M€</text>",
			                ""
			            )
			
			        RETURN
			            "<text x='12'
			                   y='" & FORMAT ( _Y + 22, "0" ) & "'
			                   class='ml-family'>"
			                & dimProduct[product_family]
			                & "</text>"
			
			                &
			
			            "<rect x='" & FORMAT ( _DiscountX, "0" )
			                & "' y='" & FORMAT ( _Y, "0" )
			                & "' width='" & FORMAT ( _DiscountWidth, "0" )
			                & "' height='" & _BarHeight
			                & "' fill='#6F2C79'/>"
			
			                &
			
			            "<rect x='" & FORMAT ( _CostX, "0" )
			                & "' y='" & FORMAT ( _Y, "0" )
			                & "' width='" & FORMAT ( _CostWidth, "0" )
			                & "' height='" & _BarHeight
			                & "' fill='#2D8792'/>"
			
			                &
			
			            "<rect x='" & FORMAT ( _ReturnX, "0" )
			                & "' y='" & FORMAT ( _Y, "0" )
			                & "' width='" & FORMAT ( _ReturnWidth, "0" )
			                & "' height='" & _BarHeight
			                & "' fill='#E69A1A'/>"
			
			                &
			
			            _DiscountLabel
			                & _CostLabel
			                & _ReturnLabel
			
			                &
			
			            "<text x='790'
			                   y='" & FORMAT ( _Y + 22, "0" ) & "'
			                   class='ml-total'>−"
			                & FORMAT (
			                    _Total / 1000000,
			                    "0.0"
			                )
			                & " M€</text>",
			
			        "",
			        [@Total],
			        ASC
			    )
			
			RETURN
			    IF (
			        _FamilyCount = 0,
			        BLANK (),
			
			        "
			<style>
			    * {
			        box-sizing:border-box;
			    }
			
			    html,
			    body {
			        margin:0;
			        padding:0;
			        width:100%;
			    }
			
			    .ml-card {
			        width:100%;
			        height:280px;
			        padding:5px 5px 5px;
			        overflow:hidden;
			        background:#FFFFFF;
			        border:1px solid #E3DEE6;
			        border-radius:5px;
			        font-family:'Segoe UI',Arial,sans-serif;
			    }
			
			    .ml-title {
			        color:#211D22;
			        font-size:15px;
			        font-weight:700;
			        text-transform:uppercase;
			        margin-bottom:6px;
			    }
			
			    .ml-legend {
			        display:flex;
			        flex-wrap:wrap;
			        align-items:center;
			        justify-content:flex-end;
			        column-gap:11px;
			        row-gap:5px;
			
			        color:#4E4851;
			        font-size:11px;
			        font-weight:400;
			        margin-bottom:4px;
			    }
			
			    .ml-legend-item {
			        display:flex;
			        align-items:center;
			        gap:5px;
			        white-space:nowrap;
			    }
			
			    .ml-key {
			        flex:0 0 auto;
			        width:11px;
			        height:11px;
			    }
			
			    .ml-svg {
			        display:block;
			        width:100%;
			        height:220px;
			        overflow:visible;
			    }
			
			    .ml-family {
			        fill:#302B31;
			        font-family:'Segoe UI',Arial,sans-serif;
			        font-size:15px;
			        font-weight:400;
			    }
			
			    .ml-total {
			        fill:#302B31;
			        font-family:'Segoe UI',Arial,sans-serif;
			        font-size:15px;
			        font-weight:700;
			    }
			
			    .ml-value-light {
			        fill:#FFFFFF;
			        font-family:'Segoe UI',Arial,sans-serif;
			        font-size:12px;
			        font-weight:700;
			    }
			
			    .ml-value-dark {
			        fill:#302B31;
			        font-family:'Segoe UI',Arial,sans-serif;
			        font-size:12px;
			        font-weight:700;
			    }
			
			</style>
			
			        <div class='ml-card'>
			
			            <div class='ml-title'>Margin Leakage</div>
			
			            <div class='ml-legend'>
			                <div class='ml-legend-item'>
			                    <span class='ml-key'
			                          style='background:#6F2C79'></span>
			                    <span>Discount</span>
			                </div>
			
			                <div class='ml-legend-item'>
			                    <span class='ml-key'
			                          style='background:#2D8792'></span>
			                    <span>Cost Variance</span>
			                </div>
			
			                <div class='ml-legend-item'>
			                    <span class='ml-key'
			                          style='background:#E69A1A'></span>
			                    <span>Returns</span>
			                </div>
			            </div>
			
			            <svg class='ml-svg'
			                viewBox='0 0 " & FORMAT ( _SvgWidth, "0" ) & " "
			                                & FORMAT ( _SvgHeight, "0" ) & "'
			                preserveAspectRatio='xMidYMin meet'>
			
			                " & _Rows & "
			
			            </svg>
			        </div>
			        "
			    )
		displayFolder: 02 Margin
		lineageTag: cd8b61d0-8fbe-4aa9-8ed5-02539ccfb41d

	measure 'Actual vs Forecast Versions HTML' =
			
			-- Exact forecast-version values
			VAR _BudgetVersion =
			    "Budget"
			
			VAR _RollingVersion =
			    "Rolling Forecast"
			
			VAR _LatestVersion =
			    "Latest Estimate"
			
			
			-- Last selected month from the date slicer
			VAR _SelectedEndMonth = MAXX (
			        ALLSELECTED ( dimDate[MonthStartDate] ),
			        dimDate[MonthStartDate]
			    )
			
			-- Last available actual-sales month
			VAR _LastSalesMonth =
			    MAXX (
			        FILTER (
			            ALLSELECTED ( dimDate[MonthStartDate] ),
			            NOT ISBLANK (
			                CALCULATE ( [Revenue] )
			            )
			        ),
			        dimDate[MonthStartDate]
			    )
			
			-- Last available forecast month
			VAR _LastForecastMonth =
			    MAXX (
			        FILTER (
			            ALLSELECTED ( dimDate[MonthStartDate] ),
			
			            VAR _ForecastValue =
			                CALCULATE (
			                    [Revenue FC],
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    )
			                )
			
			            RETURN
			                NOT ISBLANK ( _ForecastValue )
			        ),
			        dimDate[MonthStartDate]
			    )
			
			-- Last available month across actual and forecast data
			VAR _LastDataMonth =
			    MAX (
			        _LastSalesMonth,
			        _LastForecastMonth
			    )
			
			
			-- Keep the chart within the available data range
			VAR _EndMonth = IF (
			        ISBLANK ( _LastDataMonth ),
			        BLANK (),
			        MIN (
			            _SelectedEndMonth,
			            _LastDataMonth
			        )
			    )
			
			
			VAR _StartMonth =
			    EDATE (
			        _EndMonth,
			        -11
			    )
			
			
			-- Final three months are the forecast horizon
			VAR _CurrentMonth =
			    EDATE (
			        _EndMonth,
			        -2
			    )
			
			
			VAR _LastActualDisplayMonth =
			    EDATE (
			        _CurrentMonth,
			        -1
			    )
			
			
			-- Rolling twelve-month table
			VAR _SelectedMonths =
			    CALCULATETABLE (
			        VALUES ( dimDate[MonthStartDate] ),
			        ALLSELECTED ( dimDate[MonthStartDate] )
			    )
			
			
			VAR _LastTwelveSelectedMonths =
			    TOPN (
			        12,
			        _SelectedMonths,
			        dimDate[MonthStartDate],
			        DESC
			    )
			
			
			VAR _Months =
			    SELECTCOLUMNS (
			        ADDCOLUMNS (
			            _LastTwelveSelectedMonths,
			
			            "@MonthNumber",
			                RANKX (
			                    _LastTwelveSelectedMonths,
			                    dimDate[MonthStartDate],
			                    ,
			                    ASC,
			                    DENSE
			                )
			        ),
			
			        "@MonthNumber", [@MonthNumber],
			        "@MonthDate", dimDate[MonthStartDate]
			    )
			
			-- Monthly actual and forecast-version values
			VAR _ChartData =
			    ADDCOLUMNS (_Months,
			        "@Actual",
			            VAR _Month =
			                [@MonthDate]
			
			            RETURN
			                CALCULATE (
			                    [Revenue],
			                    KEEPFILTERS (
			                        TREATAS (
			                            { _Month },
			                            dimDate[MonthStartDate]
			                        )
			                    )
			                ),
			
			        "@Budget",
			            VAR _Month =
			                [@MonthDate]
			
			            RETURN
			                CALCULATE (
			                    [Revenue FC],
			
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			
			                    TREATAS (
			                        { _BudgetVersion },
			                        factForecast[forecast_version]
			                    ),
			
			                    KEEPFILTERS (
			                        TREATAS (
			                            { _Month },
			                            dimDate[MonthStartDate]
			                        )
			                    )
			                ),
			
			        "@Rolling",
			            VAR _Month =
			                [@MonthDate]
			
			            VAR _NextMonth =
			                EDATE ( _Month, 1 )
			
			            RETURN
			                CALCULATE (
			                    [Revenue FC],
			                    REMOVEFILTERS ( dimDate ),
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			                    TREATAS (
			                        { _RollingVersion },
			                        factForecast[forecast_version]
			                    ),
			                    FILTER (
			                        ALL ( dimDate[MonthStartDate] ),
			                        dimDate[MonthStartDate] >= _Month
			                            && dimDate[MonthStartDate] < _NextMonth
			                    )
			                ),
			
			        "@Latest",
			            VAR _Month =
			                [@MonthDate]
			
			            VAR _NextMonth =
			                EDATE ( _Month, 1 )
			
			            RETURN
			                CALCULATE (
			                    [Revenue FC],
			                    REMOVEFILTERS ( dimDate ),
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			                    TREATAS (
			                        { _LatestVersion },
			                        factForecast[forecast_version]
			                    ),
			                    FILTER (
			                        ALL ( dimDate[MonthStartDate] ),
			                        dimDate[MonthStartDate] >= _Month
			                            && dimDate[MonthStartDate] < _NextMonth
			                    )
			                )
			    )
			
			
			-- Actuals before the forecast horizon,
			-- Latest Estimate within the forecast horizon
			VAR _VisibleData =
			    ADDCOLUMNS (
			        _ChartData,
			
			        "@VisibleActual",
			            IF (
			                [@MonthDate] < _CurrentMonth,
			                [@Actual]
			            ),
			
			        "@VisibleBudget",
			            [@Budget],
			
			        "@VisibleRolling",
			            [@Rolling],
			
			        "@VisibleLatest",
			            IF (
			                [@MonthDate] >= _CurrentMonth,
			                [@Latest]
			            )
			    )
			
			
			-- Values used for scaling
			VAR _AllValues =
			    UNION (
			        SELECTCOLUMNS (
			            FILTER (
			                _VisibleData,
			                NOT ISBLANK ( [@VisibleActual] )
			            ),
			            "@ChartValue",
			                [@VisibleActual]
			        ),
			        SELECTCOLUMNS (
			            FILTER (
			                _VisibleData,
			                NOT ISBLANK ( [@VisibleBudget] )
			            ),
			            "@ChartValue",
			                [@VisibleBudget]
			        ),
			        SELECTCOLUMNS (
			            FILTER (
			                _VisibleData,
			                NOT ISBLANK ( [@VisibleRolling] )
			            ),
			            "@ChartValue",
			                [@VisibleRolling]
			        ),
			        SELECTCOLUMNS (
			            FILTER (
			                _VisibleData,
			                NOT ISBLANK ( [@VisibleLatest] )
			            ),
			            "@ChartValue",
			                [@VisibleLatest]
			        )
			    )
			
			
			VAR _ValueCount =
			    COUNTROWS ( _AllValues )
			
			
			VAR _RawMinimum =
			    MINX (
			        _AllValues,
			        [@ChartValue]
			    )
			
			
			VAR _RawMaximum =
			    MAXX (
			        _AllValues,
			        [@ChartValue]
			    )
			
			
			VAR _ValueRange =
			    MAX (
			        1,
			        _RawMaximum - _RawMinimum
			    )
			
			
			VAR _YMinimum =
			    MAX (
			        0,
			        _RawMinimum
			            - _ValueRange * 0.18
			    )
			
			
			VAR _YMaximum =
			    _RawMaximum
			        + _ValueRange * 0.12
			
			
			VAR _YAxisRange =
			    MAX (
			        1,
			        _YMaximum - _YMinimum
			    )
			
			
			-- SVG geometry
			VAR _ViewBoxWidth = 920
			VAR _ViewBoxHeight = 280
			
			VAR _Left = 56
			VAR _Right = 902
			VAR _Top = 24
			VAR _PlotHeight = 170
			
			VAR _PlotWidth =
			    _Right - _Left
			
			VAR _Step =
			    DIVIDE (
			        _PlotWidth,
			        12
			    )
			
			VAR _Baseline =
			    _Top + _PlotHeight
			
			VAR _MonthLabelY = 222
			
			
			-- SVG coordinates
			VAR _Points =
			    ADDCOLUMNS (
			        _VisibleData,
			
			        "@X",
			            _Left
			                + (
			                    [@MonthNumber] - 0.5
			                ) * _Step,
			
			        "@ActualY",
			            _Baseline
			                - ROUND (
			                    _PlotHeight
			                        * DIVIDE (
			                            COALESCE (
			                                [@VisibleActual],
			                                _YMinimum
			                            ) - _YMinimum,
			                            _YAxisRange,
			                            0
			                        ),
			                    0
			                ),
			
			        "@BudgetY",
			            _Baseline
			                - ROUND (
			                    _PlotHeight
			                        * DIVIDE (
			                            COALESCE (
			                                [@VisibleBudget],
			                                _YMinimum
			                            ) - _YMinimum,
			                            _YAxisRange,
			                            0
			                        ),
			                    0
			                ),
			
			        "@RollingY",
			            _Baseline
			                - ROUND (
			                    _PlotHeight
			                        * DIVIDE (
			                            COALESCE (
			                                [@VisibleRolling],
			                                _YMinimum
			                            ) - _YMinimum,
			                            _YAxisRange,
			                            0
			                        ),
			                    0
			                ),
			
			        "@LatestY",
			            _Baseline
			                - ROUND (
			                    _PlotHeight
			                        * DIVIDE (
			                            COALESCE (
			                                [@VisibleLatest],
			                                _YMinimum
			                            ) - _YMinimum,
			                            _YAxisRange,
			                            0
			                        ),
			                    0
			                )
			    )
			
			
			-- Grid and Y-axis labels
			VAR _GridLines =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 4, 1 ),
			
			        VAR _GridIndex =
			            [Value]
			
			        VAR _GridY =
			            _Top
			                + ROUND (
			                    _PlotHeight
			                        * DIVIDE (
			                            _GridIndex,
			                            4
			                        ),
			                    0
			                )
			
			        VAR _GridValue =
			            _YMaximum
			                - _YAxisRange
			                    * DIVIDE (
			                        _GridIndex,
			                        4
			                    )
			
			        RETURN
			            "<line x1='" & FORMAT ( _Left, "0" )
			                & "' y1='" & FORMAT ( _GridY, "0" )
			                & "' x2='" & FORMAT ( _Right, "0" )
			                & "' y2='" & FORMAT ( _GridY, "0" )
			                & "' stroke='#E7E3E8'
			                     stroke-width='1'/>"
			                &
			            "<text x='" & FORMAT ( _Left - 10, "0" )
			                & "' y='" & FORMAT ( _GridY + 4, "0" )
			                & "' text-anchor='end'
			                     class='afv-axis'>"
			                & FORMAT (
			                    DIVIDE (
			                        _GridValue,
			                        1000000
			                    ),
			                    "0"
			                )
			                & "</text>",
			
			        ""
			    )
			
			
			-- Actual series
			VAR _ActualPoints =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@VisibleActual] )
			        ),
			        FORMAT ( [@X], "0" )
			            & ","
			            & FORMAT ( [@ActualY], "0" ),
			        " ",
			        [@MonthNumber],
			        ASC
			    )
			
			
			VAR _ActualMarkers =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@VisibleActual] )
			        ),
			
			        "<circle cx='" & FORMAT ( [@X], "0" )
			            & "' cy='" & FORMAT ( [@ActualY], "0" )
			            & "' r='3'
			                 fill='#331045'>"
			            &
			        "<title>"
			            & FORMAT (
			                [@MonthDate],
			                "MMM yyyy"
			            )
			            & " actual: "
			            & FORMAT (
			                DIVIDE (
			                    [@VisibleActual],
			                    1000000
			                ),
			                "€0.0m"
			            )
			            & "</title></circle>",
			
			        "",
			        [@MonthNumber],
			        ASC
			    )
			
			
			-- Budget series
			VAR _BudgetPoints =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@VisibleBudget] )
			        ),
			        FORMAT ( [@X], "0" )
			            & ","
			            & FORMAT ( [@BudgetY], "0" ),
			        " ",
			        [@MonthNumber],
			        ASC
			    )
			
			
			VAR _BudgetMarkers =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@VisibleBudget] )
			        ),
			
			        "<circle cx='" & FORMAT ( [@X], "0" )
			            & "' cy='" & FORMAT ( [@BudgetY], "0" )
			            & "' r='2.4'
			                 fill='#8F8B90'/>",
			
			        "",
			        [@MonthNumber],
			        ASC
			    )
			
			
			-- Rolling Forecast series
			VAR _RollingPoints =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@VisibleRolling] )
			        ),
			        FORMAT ( [@X], "0" )
			            & ","
			            & FORMAT ( [@RollingY], "0" ),
			        " ",
			        [@MonthNumber],
			        ASC
			    )
			
			
			VAR _RollingMarkers =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@VisibleRolling] )
			        ),
			
			        "<circle cx='" & FORMAT ( [@X], "0" )
			            & "' cy='" & FORMAT ( [@RollingY], "0" )
			            & "' r='2.4'
			                 fill='#4E98AA'/>",
			
			        "",
			        [@MonthNumber],
			        ASC
			    )
			
			
			-- Latest Estimate series
			VAR _LatestPoints =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@VisibleLatest] )
			        ),
			        FORMAT ( [@X], "0" )
			            & ","
			            & FORMAT ( [@LatestY], "0" ),
			        " ",
			        [@MonthNumber],
			        ASC
			    )
			
			
			VAR _LatestMarkers =
			    CONCATENATEX (
			        FILTER (
			            _Points,
			            NOT ISBLANK ( [@VisibleLatest] )
			        ),
			
			        "<circle cx='" & FORMAT ( [@X], "0" )
			            & "' cy='" & FORMAT ( [@LatestY], "0" )
			            & "' r='3.2'
			                 fill='#D99A2B'/>",
			
			        "",
			        [@MonthNumber],
			        ASC
			    )
			
			
			-- Month labels
			VAR _MonthLabels =
			    CONCATENATEX (
			        _Points,
			
			        "<text x='" & FORMAT ( [@X], "0" )
			            & "' y='" & FORMAT ( _MonthLabelY, "0" )
			            & "' text-anchor='middle'
			                 class='afv-month'>"
			            & FORMAT (
			                [@MonthDate],
			                "MMM yy"
			            )
			            & "</text>",
			
			        "",
			        [@MonthNumber],
			        ASC
			    )
			
			
			-- Forecast-horizon divider
			VAR _CurrentMonthX =
			    MAXX (
			        FILTER (
			            _Points,
			            [@MonthDate] = _CurrentMonth
			        ),
			        [@X]
			    )
			
			
			VAR _DividerX =
			    _CurrentMonthX
			        - DIVIDE (
			            _Step,
			            2
			        )
			
			
			VAR _CurrentDivider =
			    IF (
			        NOT ISBLANK ( _CurrentMonthX ),
			
			        "<line x1='" & FORMAT ( _DividerX, "0" )
			            & "' y1='" & FORMAT ( _Top, "0" )
			            & "' x2='" & FORMAT ( _DividerX, "0" )
			            & "' y2='" & FORMAT ( _Baseline, "0" )
			            & "' stroke='#777177'
			                 stroke-width='1.3'
			                 stroke-dasharray='5 5'/>"
			            &
			        "<text x='" & FORMAT ( _DividerX + 8, "0" )
			            & "' y='" & FORMAT ( _Top + 12, "0" )
			            & "' class='afv-current'>
			            Forecast
			         </text>"
			            &
			        "<text x='" & FORMAT ( _DividerX + 8, "0" )
			            & "' y='" & FORMAT ( _Top + 25, "0" )
			            & "' class='afv-current'>
			            Horizon
			         </text>",
			
			        ""
			    )
			
			
			VAR _StatusText =
			    IF (
			        NOT ISBLANK ( _LastActualDisplayMonth ),
			        "Actual through "
			            & FORMAT (
			                _LastActualDisplayMonth,
			                "MMM yyyy"
			            ),
			        ""
			    )
			
			
			RETURN
			    IF (
			        _ValueCount = 0,
			
			        "<div style='
			            width:100%;
			            height:100vh;
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            padding:14px;
			            background:#FFFFFF;
			            color:#C53D3D;
			            border:1px solid #E3DEE6;
			            border-radius:5px;
			            font:12px Segoe UI,Arial,sans-serif;
			        '>
			            No actual or forecast data was found.
			        </div>",
			
			        "
			        <style>
			            html,
			            body {
			                width:100%;
			                height:100%;
			                margin:0;
			                padding:0;
			                overflow:hidden;
			            }
			
			            * {
			                box-sizing:border-box;
			            }
			
			            .afv-card {
			                width:100%;
			                height:100%;
			                min-height:200px;
			                display:flex;
			                flex-direction:column;
			                padding:5px 7px 4px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:5px;
			                font-family:'Segoe UI',Arial,sans-serif;
			            }
			
			            .afv-title-row {
			                flex:0 0 auto;
			                display:flex;
			                align-items:center;
			                justify-content:space-between;
			            }
			
			            .afv-title {
			                overflow:hidden;
			                color:#211D22;
			                font-size:15px;
			                font-weight:700;
			                text-overflow:ellipsis;
			                text-transform:uppercase;
			                white-space:nowrap;
			            }
			
			            .afv-status {
			                overflow:hidden;
			                color:#6F6872;
			                font-size:10px;
			                text-overflow:ellipsis;
			                white-space:nowrap;
			            }
			
			            .afv-legend {
			                flex:0 0 auto;
			                display:flex;
			                align-items:center;
			                flex-wrap:nowrap;
			                gap:clamp(9px,2vw,20px);
			                margin:6px 0 3px;
			                overflow:hidden;
			                color:#4E4851;
			                font-size:10px;
			            }
			
			            .afv-legend-item {
			                display:flex;
			                align-items:center;
			                gap:5px;
			                white-space:nowrap;
			            }
			
			            .afv-key {
			                flex:0 0 auto;
			                width:clamp(16px,2.8vw,24px);
			                height:0;
			            }
			
			            .afv-actual-key {
			                border-top:3px solid #331045;
			            }
			
			            .afv-budget-key {
			                border-top:2px dashed #8F8B90;
			            }
			
			            .afv-rolling-key {
			                border-top:2px dashed #4E98AA;
			            }
			
			            .afv-latest-key {
			                border-top:3px solid #D99A2B;
			            }
			
			            .afv-chart {
			                flex:1 1 auto;
			                width:100%;
			                min-height:0;
			                overflow:hidden;
			            }
			
			            .afv-svg {
			                display:block;
			                width:100%;
			                height:100%;
			            }
			
			            .afv-axis {
			                fill:#69636B;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:14px;
			                font-weight:500;
			            }
			
			            .afv-month {
			                fill:#413C42;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:13px;
			                font-weight:500;
			            }
			
			            .afv-current {
			                fill:#4E4851;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:12px;
			                font-weight:600;
			            }
			
			        </style>
			
			        <div class='afv-card'>
			
			            <div class='afv-title-row'>
			
			                <div class='afv-title'>
			                    Actual vs Forecast Versions
			                </div>
			
			            </div>
			
			            <div class='afv-legend'>
			
			                <div class='afv-legend-item'>
			                    <span class='afv-key afv-actual-key'></span>
			                    <span>Actual</span>
			                </div>
			
			                <div class='afv-legend-item'>
			                    <span class='afv-key afv-budget-key'></span>
			                    <span>Budget</span>
			                </div>
			
			                <div class='afv-legend-item'>
			                    <span class='afv-key afv-rolling-key'></span>
			                    <span>Rolling Forecast</span>
			                </div>
			
			                <div class='afv-legend-item'>
			                    <span class='afv-key afv-latest-key'></span>
			                    <span>Latest Estimate</span>
			                </div>
			
			            </div>
			
			            <div class='afv-chart'>
			
			                <svg class='afv-svg'
			                     viewBox='0 0 "
			                        & _ViewBoxWidth
			                        & " "
			                        & _ViewBoxHeight
			                        & "'
			                     preserveAspectRatio='xMidYMid meet'>
			
			                    <text x='8'
			                          y='16'
			                          class='afv-axis'>
			                        €m
			                    </text>"
			
			                    & _GridLines
			
			                    & "<line x1='" & FORMAT ( _Left, "0" )
			                    & "' y1='" & FORMAT ( _Baseline, "0" )
			                    & "' x2='" & FORMAT ( _Right, "0" )
			                    & "' y2='" & FORMAT ( _Baseline, "0" )
			                    & "' stroke='#BEB9C0'
			                         stroke-width='1'/>"
			
			                    & "<polyline points='"
			                    & _ActualPoints
			                    & "' fill='none'
			                         stroke='#331045'
			                         stroke-width='3'
			                         stroke-linejoin='round'
			                         stroke-linecap='round'/>"
			
			                    & _ActualMarkers
			
			                    & "<polyline points='"
			                    & _BudgetPoints
			                    & "' fill='none'
			                         stroke='#8F8B90'
			                         stroke-width='2'
			                         stroke-dasharray='8 6'
			                         stroke-linejoin='round'
			                         stroke-linecap='round'/>"
			
			                    & _BudgetMarkers
			
			                    & "<polyline points='"
			                    & _RollingPoints
			                    & "' fill='none'
			                         stroke='#4E98AA'
			                         stroke-width='2.2'
			                         stroke-dasharray='8 6'
			                         stroke-linejoin='round'
			                         stroke-linecap='round'/>"
			
			                    & _RollingMarkers
			
			                    & "<polyline points='"
			                    & _LatestPoints
			                    & "' fill='none'
			                         stroke='#D99A2B'
			                         stroke-width='3'
			                         stroke-linejoin='round'
			                         stroke-linecap='round'/>"
			
			                    & _LatestMarkers
			                    & _CurrentDivider
			                    & _MonthLabels
			
			                    & "</svg>
			
			            </div>
			
			        </div>"
			    )
		displayFolder: 03 Forecasting
		lineageTag: e8bebc5e-f2eb-4d7a-a9f3-893113724d43

	measure 'Customer Concentration HTML v2' =
			
			VAR _CustomerBase =
			    FILTER (
			        ADDCOLUMNS (
			            ALLSELECTED ( dimCustomer[customer_code] ),
			            "@Revenue", [Revenue]
			        ),
			        NOT ISBLANK ( [@Revenue] )
			            && [@Revenue] > 0
			    )
			
			VAR _TopCustomers =
			    TOPN (
			        50,
			        _CustomerBase,
			        [@Revenue], DESC,
			        dimCustomer[customer_code], ASC
			    )
			
			VAR _CustomerCount =
			    COUNTROWS ( _TopCustomers )
			
			VAR _DisplayedRevenue =
			    SUMX (
			        _TopCustomers,
			        [@Revenue]
			    )
			
			VAR _RankedCustomers =
			    ADDCOLUMNS (
			        _TopCustomers,
			        "@Rank",
			            RANKX (
			                _TopCustomers,
			                [@Revenue],
			                ,
			                DESC,
			                DENSE
			            )
			    )
			
			VAR _CustomerData =
			    ADDCOLUMNS (
			        _RankedCustomers,
			
			        "@CumulativePct",
			            VAR _CurrentRank =
			                [@Rank]
			
			            VAR _CumulativeRevenue =
			                SUMX (
			                    TOPN (
			                        _CurrentRank,
			                        _TopCustomers,
			                        [@Revenue], DESC,
			                        dimCustomer[customer_code], ASC
			                    ),
			                    [@Revenue]
			                )
			
			            RETURN
			                DIVIDE (
			                    _CumulativeRevenue,
			                    _DisplayedRevenue
			                )
			    )
			
			
			-- Top 20% of displayed customers
			VAR _Top20Count =
			    MAX (
			        1,
			        ROUNDUP (
			            _CustomerCount * 0.20,
			            0
			        )
			    )
			
			VAR _Top20Revenue =
			    SUMX (
			        TOPN (
			            _Top20Count,
			            _TopCustomers,
			            [@Revenue], DESC,
			            dimCustomer[customer_code], ASC
			        ),
			        [@Revenue]
			    )
			
			VAR _Top20RevenuePct =
			    DIVIDE (
			        _Top20Revenue,
			        _DisplayedRevenue
			    )
			
			
			-- SVG geometry
			VAR _Left = 80
			VAR _Top = 30
			VAR _PlotWidth = 700
			VAR _PlotHeight = 170
			
			VAR _Step =
			    DIVIDE (
			        _PlotWidth,
			        MAX ( 1, _CustomerCount )
			    )
			
			VAR _BarWidth =
			    MAX (
			        3,
			        _Step * 0.72
			    )
			
			VAR _MaximumRevenue =
			    MAXX (
			        _CustomerData,
			        [@Revenue]
			    ) * 1.10
			
			
			-- Coordinates
			VAR _Points =
			    ADDCOLUMNS (
			        _CustomerData,
			
			        "@X",
			            _Left
			                + ( [@Rank] - 0.5 ) * _Step,
			
			        "@RevenueY",
			            _Top
			                + _PlotHeight
			                - ROUND (
			                    _PlotHeight
			                        * DIVIDE (
			                            [@Revenue],
			                            _MaximumRevenue,
			                            0
			                        ),
			                    0
			                ),
			
			        "@CumulativeY",
			            _Top
			                + _PlotHeight
			                - ROUND (
			                    _PlotHeight
			                        * [@CumulativePct],
			                    0
			                )
			    )
			
			
			-- Horizontal grid and left axis
			VAR _GridLines =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 4, 1 ),
			
			        VAR _Index = [Value]
			
			        VAR _Y =
			            _Top
			                + ROUND (
			                    _PlotHeight
			                        * DIVIDE ( _Index, 4 ),
			                    0
			                )
			
			        VAR _RevenueValue =
			            _MaximumRevenue
			                * DIVIDE ( 4 - _Index, 4 )
			
			        RETURN
			            "<line x1='" & _Left
			                & "' y1='" & FORMAT ( _Y, "0" )
			                & "' x2='" & FORMAT ( _Left + _PlotWidth, "0" )
			                & "' y2='" & FORMAT ( _Y, "0" )
			                & "' stroke='#E7E3E8'
			                     stroke-width='1'/>"
			                &
			            "<text x='65'
			                   y='" & FORMAT ( _Y + 4, "0" ) & "'
			                   text-anchor='end'
			                   class='cc-axis'>"
			                & FORMAT (
			                    _RevenueValue / 1000000,
			                    "0"
			                )
			                & "</text>",
			
			        ""
			    )
			
			
			-- Right cumulative-percentage axis
			VAR _RightAxis =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 4, 1 ),
			
			        VAR _Index = [Value]
			
			        VAR _Y =
			            _Top
			                + ROUND (
			                    _PlotHeight
			                        * DIVIDE ( _Index, 4 ),
			                    0
			                )
			
			        VAR _Pct =
			            100 - _Index * 25
			
			        RETURN
			            "<text x='796'
			                   y='" & FORMAT ( _Y + 4, "0" ) & "'
			                   class='cc-axis'>"
			                & FORMAT ( _Pct, "0" )
			                & "%</text>",
			
			        ""
			    )
			
			
			-- Revenue bars
			VAR _Bars =
			    CONCATENATEX (
			        _Points,
			
			        VAR _X =
			            [@X] - DIVIDE ( _BarWidth, 2 )
			
			        VAR _Y =
			            [@RevenueY]
			
			        VAR _Height =
			            _Top + _PlotHeight - _Y
			
			        RETURN
			            "<rect x='" & FORMAT ( _X, "0" )
			                & "' y='" & FORMAT ( _Y, "0" )
			                & "' width='" & FORMAT ( _BarWidth, "0.0" )
			                & "' height='" & FORMAT ( MAX ( 0, _Height ), "0" )
			                & "' rx='1'
			                     fill='#6FA9B9'/>",
			
			        "",
			        [@Rank],
			        ASC
			    )
			
			
			-- Cumulative line
			VAR _LinePoints =
			    CONCATENATEX (
			        _Points,
			        FORMAT ( [@X], "0" )
			            & ","
			            & FORMAT ( [@CumulativeY], "0" ),
			        " ",
			        [@Rank],
			        ASC
			    )
			
			VAR _Markers =
			    CONCATENATEX (
			        _Points,
			        "<circle cx='" & FORMAT ( [@X], "0" )
			            & "' cy='" & FORMAT ( [@CumulativeY], "0" )
			            & "' r='2'
			                 fill='#331045'/>",
			        "",
			        [@Rank],
			        ASC
			    )
			
			
			-- Percentage-based X axis
			VAR _XAxis =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 5, 1 ),
			
			        VAR _Index = [Value]
			
			        VAR _X =
			            _Left
			                + _PlotWidth
			                    * DIVIDE ( _Index, 5 )
			
			        RETURN
			            "<text x='" & FORMAT ( _X, "0" )
			                & "' y='222'
			                     text-anchor='middle'
			                     class='cc-axis'>"
			                & FORMAT ( _Index * 20, "0" )
			                & "%</text>",
			
			        ""
			    )
			
			
			-- Top-20-percent divider and annotation
			VAR _DividerX =
			    _Left + _PlotWidth * 0.20
			
			RETURN
			    IF (
			        _CustomerCount = 0,
			        BLANK (),
			
			        "
			        <style>
			            * { box-sizing:border-box; }
			
			            .cc-card {
			                width:100%;
			                min-height:305px;
			                padding:10px 14px 6px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:10px;
			                box-shadow:0 2px 5px rgba(51,16,69,.06);
			                font-family:'Segoe UI',Arial,sans-serif;
			            }
			
			            .cc-title {
			                color:#211D22;
			                font-size:15px;
			                font-weight:700;
			            }
			
			            .cc-legend {
			                display:flex;
			                gap:16px;
			                margin:6px 0 0;
			                color:#4E4851;
			                font-size:10px;
			            }
			
			            .cc-legend-item {
			                display:flex;
			                align-items:center;
			                gap:5px;
			            }
			
			            .cc-bar-key {
			                width:9px;
			                height:9px;
			                border-radius:50%;
			                background:#6FA9B9;
			            }
			
			            .cc-line-key {
			                width:22px;
			                position:relative;
			                border-top:2px solid #331045;
			            }
			
			            .cc-line-key:after {
			                content:'';
			                position:absolute;
			                width:6px;
			                height:6px;
			                left:8px;
			                top:-4px;
			                border-radius:50%;
			                background:#331045;
			            }
			
			            .cc-svg {
			                width:100%;
			                height:240px;
			                display:block;
			            }
			
			            .cc-axis {
			                fill:#5F5962;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:9px;
			            }
			
			            .cc-label {
			                fill:#302B31;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:10px;
			            }
			
			            .cc-strong {
			                fill:#211D22;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:13px;
			                font-weight:700;
			            }
			        </style>
			
			        <div class='cc-card'>
			
			            <div class='cc-title'>Customer Concentration</div>
			
			            <div class='cc-legend'>
			                <div class='cc-legend-item'>
			                    <span class='cc-bar-key'></span>
			                    <span>Revenue (€m)</span>
			                </div>
			
			                <div class='cc-legend-item'>
			                    <span class='cc-line-key'></span>
			                    <span>Cumulative Revenue Share</span>
			                </div>
			            </div>
			
			            <svg class='cc-svg'
			                 viewBox='0 0 840 270'
			                 preserveAspectRatio='xMidYMid meet'>
			
			                " & _GridLines & "
			                " & _RightAxis & "
			                " & _Bars & "
			
			                <polyline points='" & _LinePoints & "'
			                          fill='none'
			                          stroke='#331045'
			                          stroke-width='2.5'
			                          stroke-linejoin='round'
			                          stroke-linecap='round'/>
			
			                " & _Markers & "
			                " & _XAxis & "
			
			                <line x1='" & FORMAT ( _DividerX, "0" ) & "'
			                      y1='" & FORMAT ( _Top, "0" ) & "'
			                      x2='" & FORMAT ( _DividerX, "0" ) & "'
			                      y2='" & FORMAT ( _Top + _PlotHeight, "0" ) & "'
			                      stroke='#777177'
			                      stroke-width='2'
			                      stroke-dasharray='7 6'/>
			
			                <rect x='520'
			                      y='84'
			                      width='185'
			                      height='62'
			                      rx='6'
			                      fill='#FFFFFF'
			                      stroke='#6F4A7C'
			                      stroke-width='1.5'/>
			
			                <text x='612'
			                      y='108'
			                      text-anchor='middle'
			                      class='cc-label'>
			                    Top 20% =
			                </text>
			
			                <text x='612'
			                      y='135'
			                      text-anchor='middle'
			                      class='cc-strong'>
			                    " & FORMAT ( _Top20RevenuePct, "0%" ) & " of revenue
			                </text>
			
			                <text x='430'
			                      y='255'
			                      text-anchor='middle'
			                      class='cc-label'>
			                    Customers Ranked by Revenue
			                </text>
			
			                <text x='16'
			                      y='116'
			                      text-anchor='middle'
			                      transform='rotate(-90 16 116)'
			                      class='cc-label'>
			                    Revenue (€m)
			                </text>
			
			            </svg>
			        </div>
			        "
			    )
		displayFolder: 04 Customers
		lineageTag: f791066e-aaed-4a2c-8c5a-dd6f9b2873ab

	measure 'ASP vs List' =
			
			VAR List = AVERAGE(dimProduct[base_list_price_eur])
			RETURN
			DIVIDE([ASP], List)-1
		formatString: #,0.00\ %;-#,0.00\ %;#,0.00\ %
		displayFolder: 02 Margin
		lineageTag: 8ce4ece4-67f4-4847-a374-e062782fc4c9

	measure 'Revenue FC Bias Variance %' = DIVIDE([Revenue FC], [Revenue])-1
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 03 Forecasting
		lineageTag: 94acd190-9784-4360-87cb-777efc97f86d

	measure 'Forecast Version Comparison HTML' = ```
			
			VAR _Versions =
			    DATATABLE (
			        "VersionKey", STRING,
			        "VersionLabel", STRING,
			        "Color", STRING,
			        "Sort", INTEGER,
			        {
			            { "Budget", "Budget", "#B7B7B7", 1 },
			            { "Rolling Forecast", "Rolling Forecast", "#5B9FB4", 2 },
			            { "Latest Estimate", "Latest Forecast", "#D99A2B", 3 }
			        }
			    )
			
			VAR _LastActualForecastMonth =
			    MAXX (
			        FILTER (
			            ALLSELECTED ( dimDate[MonthStartDate] ),
			            CALCULATE (
			                COUNTROWS ( factForecast ),
			                REMOVEFILTERS ( factForecast[forecast_version] ),
			                factForecast[actual_revenue_eur] <> BLANK ()
			            ) > 0
			        ),
			        dimDate[MonthStartDate]
			    )
			
			VAR _StartMonth =
			    EDATE ( _LastActualForecastMonth, -11 )
			
			VAR _EndMonth =
			    EDATE ( _LastActualForecastMonth, 1 )
			
			VAR _BaseData =
			    ADDCOLUMNS (
			        _Versions,
			
			        "@Forecast",
			            VAR _Version =
			                [VersionKey]
			
			            RETURN
			                CALCULATE (
			                    SUM ( factForecast[forecast_revenue_eur] ),
			
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			
			                    TREATAS (
			                        { _Version },
			                        factForecast[forecast_version]
			                    ),
			
			                    KEEPFILTERS (
			                        DATESBETWEEN (
			                            dimDate[Date],
			                            _StartMonth,
			                            EOMONTH ( _EndMonth, -1 )))),
			
			        "@Actual",
			            VAR _Version =
			                [VersionKey]
			
			            RETURN
			                CALCULATE (
			                    SUM ( factForecast[actual_revenue_eur] ),
			
			                    REMOVEFILTERS (
			                        factForecast[forecast_version]
			                    ),
			
			                    TREATAS (
			                        { _Version },
			                        factForecast[forecast_version]
			                    ),
			
			                    KEEPFILTERS (
			                        DATESBETWEEN (
			                            dimDate[Date],
			                            _StartMonth,
			                            EOMONTH ( _EndMonth, -1 )
			                        )
			                    )
			                ))
			
			VAR _ErrorData =
			    ADDCOLUMNS (
			        _BaseData,
			
			        "@Error",
			            IF (
			                NOT ISBLANK ( [@Forecast] )
			                    && NOT ISBLANK ( [@Actual] ),
			                ABS ( [@Actual] - [@Forecast] )
			            )
			    )
			
			VAR _Data =
			    ADDCOLUMNS (
			        _ErrorData,
			
			        "@Accuracy",
			            IF (
			                NOT ISBLANK ( [@Error] )
			                    && [@Forecast] <> 0,
			                MAX (
			                    0,
			                    1
			                        - DIVIDE (
			                            [@Error],
			                            ABS ( [@Forecast] )
			                        )
			                )
			            )
			    )
			
			VAR _ValidData =
			    FILTER (
			        _Data,
			        NOT ISBLANK ( [@Accuracy] )
			    )
			
			VAR _HasData =
			    COUNTROWS ( _ValidData ) > 0
			
			VAR _MinimumAccuracyRaw =
			    MINX (
			        _ValidData,
			        [@Accuracy]
			    )
			
			VAR _AccuracyMinimum =
			    MAX (
			        0,
			        MIN (
			            0.98,
			            _MinimumAccuracyRaw - 0.01
			        )
			    )
			
			VAR _AccuracyRange =
			    MAX (
			        0.0001,
			        1 - _AccuracyMinimum
			    )
			
			VAR _MaximumError =
			    MAX (
			        1,
			        MAXX (
			            _ValidData,
			            [@Error]
			        ) * 1.15
			    )
			
			/* =========================================================
			   RESPONSIVE SVG GEOMETRY
			   ========================================================= */
			
			VAR _SvgWidth = 500
			VAR _SvgHeight = 270
			
			/* Left panel: Forecast Accuracy */
			VAR _AccuracyLeft = 20
			VAR _AccuracyRight = 205
			VAR _AccuracyPanelWidth =
			    _AccuracyRight - _AccuracyLeft
			
			VAR _AccuracyCenter =
			    DIVIDE (
			        _AccuracyLeft + _AccuracyRight,
			        2
			    )
			
			/* Right panel: Absolute Error */
			VAR _ErrorLeft = 278
			VAR _ErrorRight = 463
			VAR _ErrorPanelWidth =
			    _ErrorRight - _ErrorLeft
			
			VAR _ErrorCenter =
			    DIVIDE (
			        _ErrorLeft + _ErrorRight,
			        2
			    )
			
			/* Vertical geometry */
			VAR _HeaderY = 25
			VAR _RowTop = 50
			VAR _RowStep = 57
			VAR _BarHeight = 31
			
			VAR _AxisY = 225
			VAR _AxisLabelY = 247
			
			/* =========================================================
			   ACCURACY BARS
			   ========================================================= */
			
			VAR _AccuracyBars =
			    CONCATENATEX (
			        _ValidData,
			
			        VAR _Y =
			            _RowTop
			                + ( [Sort] - 1 ) * _RowStep
			
			        VAR _Width =
			            _AccuracyPanelWidth
			                * DIVIDE (
			                    [@Accuracy] - _AccuracyMinimum,
			                    _AccuracyRange,
			                    0
			                )
			
			        VAR _SafeWidth =
			            MAX (
			                2,
			                _Width
			            )
			
			        RETURN
			
			            "<g>
			                <title>"
			                    & [VersionLabel]
			                    & ": "
			                    & FORMAT (
			                        [@Accuracy],
			                        "0.0%"
			                    )
			                    & " accuracy
			                </title>
			
			                <rect
			                    x='"
			                        & FORMAT (
			                            _AccuracyLeft,
			                            "0",
			                            "en-US"
			                        )
			                        & "'
			                    y='"
			                        & FORMAT (
			                            _Y,
			                            "0",
			                            "en-US"
			                        )
			                        & "'
			                    width='"
			                        & FORMAT (
			                            _SafeWidth,
			                            "0.0",
			                            "en-US"
			                        )
			                        & "'
			                    height='"
			                        & FORMAT (
			                            _BarHeight,
			                            "0",
			                            "en-US"
			                        )
			                        & "'
			                    rx='2'
			                    fill='"
			                        & [Color]
			                        & "'
			                />
			
			                <text
			                    x='"
			                        & FORMAT (
			                            _AccuracyLeft
			                                + _SafeWidth
			                                + 7,
			                            "0.0",
			                            "en-US"
			                        )
			                        & "'
			                    y='"
			                        & FORMAT (
			                            _Y + 21,
			                            "0",
			                            "en-US"
			                        )
			                        & "'
			                    class='fvc-value'>"
			                        & FORMAT (
			                            [@Accuracy],
			                            "0.0%"
			                        )
			                        & "
			                </text>
			            </g>",
			
			        "",
			        [Sort], ASC
			    )
			
			/* =========================================================
			   ERROR BARS
			   ========================================================= */
			
			VAR _ErrorBars =
			    CONCATENATEX (
			        _ValidData,
			
			        VAR _Y =
			            _RowTop
			                + ( [Sort] - 1 ) * _RowStep
			
			        VAR _Width =
			            _ErrorPanelWidth
			                * DIVIDE (
			                    [@Error],
			                    _MaximumError,
			                    0
			                )
			
			        VAR _SafeWidth =
			            MAX (
			                2,
			                _Width
			            )
			
			        RETURN
			
			            "<g>
			                <title>"
			                    & [VersionLabel]
			                    & ": "
			                    & FORMAT (
			                        [@Error] / 1000000,
			                        "€0.0m",
			                        "de-DE"
			                    )
			                    & " absolute error
			                </title>
			
			                <rect
			                    x='"
			                        & FORMAT (
			                            _ErrorLeft,
			                            "0",
			                            "en-US"
			                        )
			                        & "'
			                    y='"
			                        & FORMAT (
			                            _Y,
			                            "0",
			                            "en-US"
			                        )
			                        & "'
			                    width='"
			                        & FORMAT (
			                            _SafeWidth,
			                            "0.0",
			                            "en-US"
			                        )
			                        & "'
			                    height='"
			                        & FORMAT (
			                            _BarHeight,
			                            "0",
			                            "en-US"
			                        )
			                        & "'
			                    rx='2'
			                    fill='"
			                        & [Color]
			                        & "'
			                />
			
			                <text
			                    x='"
			                        & FORMAT (
			                            _ErrorLeft
			                                + _SafeWidth
			                                + 7,
			                            "0.0",
			                            "en-US"
			                        )
			                        & "'
			                    y='"
			                        & FORMAT (
			                            _Y + 21,
			                            "0",
			                            "en-US"
			                        )
			                        & "'
			                    class='fvc-value'>"
			                        & FORMAT (
			                            [@Error] / 1000000,
			                            "0.0",
			                            "de-DE"
			                        )
			                        & "
			                </text>
			            </g>",
			
			        "",
			        [Sort], ASC
			    )
			
			VAR _AccuracyMid =
			    DIVIDE (
			        _AccuracyMinimum + 1,
			        2
			    )
			
			VAR _ErrorMid =
			    DIVIDE (
			        _MaximumError,
			        2
			    )
			
			RETURN
			    IF (
			        ISBLANK ( _LastActualForecastMonth )
			            || NOT _HasData,
			
			        "
			        <div style='
			            font:14px Segoe UI,Arial,sans-serif;
			            color:#6F6872;
			            padding:16px;
			        '>
			            No comparable actual and forecast values were found for
			            Budget, Rolling Forecast, or Latest Estimate.
			        </div>
			        ",
			
			        "
			        <style>
			
			            * {
			                box-sizing:border-box;
			            }
			
			            html,
			            body {
			                margin:0;
			                padding:0;
			                width:100%;
			                height:auto;
			            }
			
			            .fvc-card {
			                width:100%;
			                padding:10px 12px 8px;
			                background:#FFFFFF;
			                border:1px solid #E3DEE6;
			                border-radius:8px;
			                font-family:'Segoe UI',Arial,sans-serif;
			                overflow:hidden;
			            }
			
			            .fvc-header {
			                display:flex;
			                align-items:baseline;
			                flex-wrap:wrap;
			                column-gap:8px;
			                row-gap:2px;
			            }
			
			            .fvc-title {
			                color:#211D22;
			                font-size:16px;
			                line-height:20px;
			                font-weight:700;
			            }
			
			            .fvc-period {
			                color:#777079;
			                font-size:11px;
			                line-height:15px;
			                font-weight:500;
			                white-space:nowrap;
			            }
			
			            .fvc-legend {
			                display:flex;
			                align-items:center;
			                flex-wrap:wrap;
			                column-gap:18px;
			                row-gap:6px;
			                margin-top:9px;
			                margin-bottom:4px;
			
			                color:#514B53;
			                font-size:11px;
			                line-height:14px;
			            }
			
			            .fvc-item {
			                display:flex;
			                align-items:center;
			                gap:6px;
			                white-space:nowrap;
			            }
			
			            .fvc-swatch {
			                flex:0 0 auto;
			                width:11px;
			                height:11px;
			                border-radius:50%;
			            }
			
			            .fvc-svg {
			                display:block;
			
			                width:100%;
			                height:auto;
			
			                margin:7px 0 0 0;
			                padding:0;
			
			                overflow:visible;
			            }
			
			            .fvc-head {
			                fill:#302A31;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:15px;
			                font-weight:400;
			            }
			
			            .fvc-axis {
			                fill:#6A646C;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:13px;
			                font-weight:500;
			            }
			
			            .fvc-value {
			                fill:#3F3940;
			                font-family:'Segoe UI',Arial,sans-serif;
			                font-size:15px;
			                font-weight:400;
			            }
			
			            @media (max-width:420px) {
			
			                .fvc-card {
			                    padding:9px 9px 7px;
			                }
			
			                .fvc-title {
			                    font-size:15px;
			                }
			
			                .fvc-period {
			                    font-size:10px;
			                }
			
			                .fvc-legend {
			                    column-gap:11px;
			                    font-size:10px;
			                }
			            }
			
			        </style>
			
			        <div class='fvc-card'>
			
			            <div class='fvc-header'>
			
			                <div class='fvc-title'>
			                    VERSION COMPARISON
			                </div>
			
			            </div>
			
			            <div class='fvc-legend'>
			
			                <div class='fvc-item'>
			                    <span
			                        class='fvc-swatch'
			                        style='background:#B7B7B7'>
			                    </span>
			                    <span>Budget</span>
			                </div>
			
			                <div class='fvc-item'>
			                    <span
			                        class='fvc-swatch'
			                        style='background:#5B9FB4'>
			                    </span>
			                    <span>Rolling Forecast</span>
			                </div>
			
			                <div class='fvc-item'>
			                    <span
			                        class='fvc-swatch'
			                        style='background:#D99A2B'>
			                    </span>
			                    <span>Latest Forecast</span>
			                </div>
			
			            </div>
			
			            <svg
			                class='fvc-svg'
			                viewBox='0 0 "
			                    & FORMAT (
			                        _SvgWidth,
			                        "0",
			                        "en-US"
			                    )
			                    & " "
			                    & FORMAT (
			                        _SvgHeight,
			                        "0",
			                        "en-US"
			                    )
			                    & "'
			                preserveAspectRatio='xMidYMin meet'>
			
			                <text
			                    x='"
			                        & FORMAT (
			                            _AccuracyCenter,
			                            "0",
			                            "en-US"
			                        )
			                        & "'
			                    y='"
			                        & FORMAT (
			                            _HeaderY,
			                            "0",
			                            "en-US"
			                        )
			                        & "'
			                    text-anchor='middle'
			                    class='fvc-head'>
			                    Forecast Accuracy (%)
			                </text>
			
			                <text
			                    x='"
			                        & FORMAT (
			                            _ErrorCenter,
			                            "0",
			                            "en-US"
