	measure 'FC Variance Drivers Waterfall Value' = ```
			
			VAR cat   = SELECTEDVALUE('dimPvmWaterfallCategories'[Category])
			VAR price = [FC Price Variance]
			VAR volume   = [FC Volume Variance]
			VAR other = [FC Other Variance]
			RETURN
			SWITCH (
			    TRUE(),
			    cat = "Price",      price,
			    cat = "Volume",     volume,
			    cat = "Other",        other,
			    BLANK()
			)
			
			```
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
