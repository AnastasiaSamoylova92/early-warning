	measure 'Cohort Retention HTML' =
			
			VAR _LastAvailableMonth =
			    CALCULATE (
			        MAX ( dimDate[MonthStartDate] ),
			        REMOVEFILTERS ( dimDate )
			    )
			
			
			-- Customer acquisition and quarterly cohort assignment
			VAR _CustomerBase =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ( dimCustomer ),
			
			            "@CustomerID",
			                dimCustomer[customer_id],
			
			            "@AcquisitionMonth",
			                DATE (
			                    YEAR ( dimCustomer[customer_since] ),
			                    MONTH ( dimCustomer[customer_since] ),
			                    1
			                ),
			
			            "@CohortMonth",
			                DATE (
			                    YEAR ( dimCustomer[customer_since] ),
			                    1
			                        + 3
			                            * INT (
			                                DIVIDE (
			                                    MONTH ( dimCustomer[customer_since] ) - 1,
			                                    3
			                                )
			                            ),
			                    1
			                ),
			
			            "@AllPeriodRevenue",
			                CALCULATE (
			                    [Revenue],
			                    REMOVEFILTERS ( dimDate )
			                )
			        ),
			
			        NOT ISBLANK ( [@CustomerID] )
			            && NOT ISBLANK ( [@AcquisitionMonth] )
			            && [@AllPeriodRevenue] > 0
			    )
			
			
			-- All quarterly cohorts from 2024 onwards
			VAR _CohortList =
			    FILTER (
			        DISTINCT (
			            SELECTCOLUMNS (
			                _CustomerBase,
			                "@CohortMonth",
			                    [@CohortMonth]
			            )
			        ), [@CohortMonth] >= DATE ( 2022, 1, 1 )
			    )
			
			
			-- Retention month offsets
			VAR _Offsets =
			    DATATABLE (
			        "OffsetMonths",
			        INTEGER,
			        {
			            { 0 },
			            { 1 },
			            { 2 },
			            { 3 },
			            { 6 },
			            { 9 },
			            { 12 },
			            { 18 },
			            { 24 }
			        }
			    )
			
			
			-- Header cells
			VAR _HeaderCells =
			    CONCATENATEX (
			        _Offsets,
			        "<th>"
			            & FORMAT ( [OffsetMonths], "0" )
			            & "</th>",
			        "",
			        [OffsetMonths],
			        ASC
			    )
			
			
			-- Cohort table rows
			VAR _CohortRows =
			    CONCATENATEX (
			        _CohortList,
			
			        VAR _CurrentCohort =
			            [@CohortMonth]
			
			        VAR _CurrentQuarter =
			            "Q"
			                & FORMAT (
			                    QUARTER ( _CurrentCohort ),
			                    "0"
			                )
			                & " "
			                & FORMAT (
			                    YEAR ( _CurrentCohort ),
			                    "0"
			                )
			
			        VAR _CohortCustomers =
			            FILTER (
			                _CustomerBase,
			                [@CohortMonth] = _CurrentCohort
			            )
			
			        VAR _OriginalCustomerCount =
			            COUNTROWS ( _CohortCustomers )
			
			        VAR _Cells =
			            CONCATENATEX (
			                _Offsets,
			
			                VAR _Offset =
			                    [OffsetMonths]
			
			                -- Entire quarterly cohort must have had enough time
			                -- to reach the respective month offset
			                VAR _PeriodIsMature =
			                    EDATE (
			                        _CurrentCohort,
			                        _Offset + 2
			                    ) <= _LastAvailableMonth
			
			                VAR _RetainedCustomers =
			                    IF (
			                        _Offset = 0,
			
			                        _OriginalCustomerCount,
			
			                        COUNTROWS (
			                            FILTER (
			                                _CohortCustomers,
			
			                                VAR _CustomerID =
			                                    [@CustomerID]
			
			                                VAR _AcquisitionMonth =
			                                    [@AcquisitionMonth]
			
			                                VAR _MissingCheckpoints =
			                                    COUNTROWS (
			                                        FILTER (
			                                            _Offsets,
			
			                                            VAR _CheckpointOffset =
			                                                [OffsetMonths]
			
			                                            VAR _TargetMonth =
			                                                EDATE (
			                                                    _AcquisitionMonth,
			                                                    _CheckpointOffset
			                                                )
			
			                                            VAR _NextTargetMonth =
			                                                EDATE (
			                                                    _TargetMonth,
			                                                    1
			                                                )
			
			                                            VAR _SalesRows =
			                                                CALCULATE (
			                                                    COUNTROWS ( factSales ),
			
			                                                    REMOVEFILTERS ( dimDate ),
			
			                                                    TREATAS (
			                                                        { _CustomerID },
			                                                        factSales[customer_id]
			                                                    ),
			
			                                                    FILTER (
			                                                        ALL ( dimDate[MonthStartDate] ),
			                                                        dimDate[MonthStartDate] >= _TargetMonth
			                                                            && dimDate[MonthStartDate] < _NextTargetMonth
			                                                    )
			                                                )
			
			                                            RETURN
			                                                _CheckpointOffset > 0
			                                                    && _CheckpointOffset <= _Offset
			                                                    && _SalesRows = 0
			                                        )
			                                    )
			
			                                RETURN
			                                    _MissingCheckpoints = 0
			                            )
			                        )
			                    )
			
			                VAR _Retention =
			                    DIVIDE (
			                        _RetainedCustomers,
			                        _OriginalCustomerCount
			                    )
			
			                VAR _BackgroundColor =
			                    SWITCH (
			                        TRUE (),
			                        _Retention >= 0.98, "#58A968",
			                        _Retention >= 0.95, "#78B982",
			                        _Retention >= 0.90, "#9ACA9F",
			                        _Retention >= 0.80, "#B8D9BA",
			                        _Retention >= 0.70, "#D0E6D1",
			                        "#E6F1E6"
			                    )
			
			                RETURN
			                    IF (
			                        NOT _PeriodIsMature,
			
			                        "<td class='cr-empty'>–</td>",
			
			                        "<td class='cr-value'
			                             style='background:"
			                            & _BackgroundColor
			                            & "'>"
			                            & FORMAT (
			                                _Retention,
			                                "0%"
			                            )
			                            & "</td>"
			                    ),
			
			                "",
			                [OffsetMonths],
			                ASC
			            )
			
			        RETURN
			            "<tr>"
			                & "<td class='cr-cohort'>"
			                & _CurrentQuarter
			                & "</td>"
			                & _Cells
			                & "</tr>",
			
			        "",
			        [@CohortMonth],
			        DESC
			    )
			
			RETURN
			    IF (
			        COUNTROWS ( _CohortList ) = 0,
			        BLANK (),
			
			        "
			        <style>
			
			            * {
			                box-sizing:border-box;
			            }
			
			html,
			body {
			    width:100%;
			    height:100%;
			    margin:0;
			    padding:0;
			    overflow:hidden;
			}
			
			.cr-card {
			    width:100%;
			    height:100%;
			    min-width:0;
			    min-height:0;
			
			    display:flex;
			    flex-direction:column;
			
			    overflow:hidden;
			
			    background:#FFFFFF;
			
			    border:1px solid #E3DEE6;
			    font-family:
			        'Segoe UI';
			}
			
			.cr-title {
			    color:#211D22;
			    font-size: 15px;
			    font-weight:700;
			
			    text-transform:uppercase;
			    white-space:nowrap;
			    overflow:hidden;
			    text-overflow:ellipsis;
			}
			
			.cr-table {
			    flex:1 1 auto;
			
			    width:100%;
			    min-width:46px;
			    height:100%;
			    min-height:0;
			
			    border-collapse:separate;
			    clamp(1px, .18vw, 2px);
			
			    table-layout:fixed;
			
			    color:#302B31;
			
			    font-size: 11px;
			}
			
			.cr-table thead {
			    height:15%;
			}
			
			.cr-table tbody {
			    height:85%;
			}
			
			
			/* HEADER */
			
			.cr-table th {
			    background:#FFFFFF;
			    font-size: 10px;
			    font-weight:700;
			    text-align:center;
			    white-space:nowrap;
			    overflow:hidden;
			    text-overflow:ellipsis;
			}
			
			.cr-table th:first-child {
			    width:
			        clamp(58px, 15vw, 135px);
			
			    text-align:left;
			}
			
			
			.cr-super-header {
			    height:40%;
			}
			
			.cr-month-header {
			    height:60%;
			}
			
			
			.cr-super-header th {
			    color:#5A545B;
			    font-size: 10px;
			    font-weight:600;
			}
			.cr-month-header th {
			    border-bottom:1px solid #D8D3DA;
			}
			
			.cr-table tbody tr {
			    height:21px;
			}
			
			
			/* COHORT */
			
			.cr-cohort {
			    padding:
			        clamp(1px, .45vh, 7px)
			        clamp(2px, .5vw, 7px);
			
			    overflow:hidden;
			
			    background:#FFFFFF;
			    color:#302B31;
			
			    font-size:10px;
			
			    font-weight:700;
			    text-align:left;
			
			    text-overflow:ellipsis;
			    white-space:nowrap;
			
			    vertical-align:middle;
			}
			
			
			/* RETENTION VALUE */
			
			.cr-value {
			    padding:
			        clamp(1px, .45vh, 7px)
			        clamp(1px, .35vw, 5px);
			
			    border-radius:
			        clamp(2px, .25vw, 4px);
			
			    color:#17381E;
			
			    font-size:10px;
			
			    font-weight:650;
			    text-align:center;
			    vertical-align:middle;
			
			    white-space:nowrap;
			    overflow:hidden;
			}
			
			
			/* EMPTY */
			
			.cr-empty {
			    padding:
			        clamp(1px, .45vh, 7px)
			        clamp(1px, .35vw, 5px);
			    min-width:46px;
			
			    background:#FAF9FA;
			    color:#9A959B;
			
			    font-size:9px;
			
			    line-height:1.05;
			
			    text-align:center;
			    vertical-align:middle;
			}
			
			
			        </style>
			
			
			        <div class='cr-card'>
			
			            <div class='cr-title'>
			                Cohort Retention
			            </div>
			
			            <table class='cr-table'>
			
			                <thead>
			
			                    <tr class='cr-super-header'>
			
			                        <th></th>
			
			                        <th colspan='9'>
			                            Months since Acquisition
			                        </th>
			
			                    </tr>
			
			
			                    <tr class='cr-month-header'>
			
			                        <th>Cohort</th>
			
			                        "
			                            & _HeaderCells &
			                        "
			
			                    </tr>
			
			                </thead>
			
			
			                <tbody>
			
			                    "
			                        & _CohortRows &
			                    "
			
			                </tbody>
			
			            </table>
			
			        </div>
			        "
			    )
		displayFolder: 04 Customers
