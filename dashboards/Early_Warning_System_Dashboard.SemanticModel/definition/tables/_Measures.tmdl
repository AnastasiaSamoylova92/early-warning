		lineageTag: 6b4d9e21-8f73-4c5a-a102-7d6e3b9f4c28

	measure 'Selected Forecast Version' = ```
			
			  SELECTEDVALUE(
			      factForecast[forecast_version],
			      "Latest Estimate"
			  )
			```
		displayFolder: 03 Forecasting
		lineageTag: 9aff2cf7-66fe-4a41-a3b0-77b33582a5e9

	measure 'Previous Customers' = ```
			
			  CALCULATETABLE(
			      VALUES(factSales[customer_id]),
			      DATEADD(dimDate[Date], -1, YEAR)
			  )
			```
		formatString: 0
		displayFolder: 04 Customers
		lineageTag: 8c85b207-ad72-4876-a1f0-646908941bf0

	measure 'NRR Starting Revenue' = ```
			
			  VAR PriorYearCustomerCohort =
			      CALCULATETABLE (
			          FILTER (
			              VALUES ( dimCustomer[customer_id] ),
			              CALCULATE ( [Revenue] ) > 0
			          ),
			          SAMEPERIODLASTYEAR ( dimDate[Date] )
			      )
			  RETURN
			      CALCULATE (
			          [Revenue],
			          SAMEPERIODLASTYEAR ( dimDate[Date] ),
			          KEEPFILTERS ( PriorYearCustomerCohort )
			      )
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 00 Core Measures
		lineageTag: a8856376-3cd5-4ad3-8dfd-e8dc5e7779fd

		annotation PBI_FormatHint = {"currencyCulture":"en-DE"}

	measure 'NRR Ending Revenue' = ```
			
			  VAR PriorYearCustomerCohort =
			      CALCULATETABLE (
			          FILTER (
			              VALUES ( dimCustomer[customer_id] ),
			              CALCULATE ( [Revenue] ) > 0
			          ),
			          SAMEPERIODLASTYEAR ( dimDate[Date] )
			      )
			  RETURN
			      CALCULATE (
			          [Revenue],
			          KEEPFILTERS ( PriorYearCustomerCohort )
			      )
			```
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 00 Core Measures
		lineageTag: 4dd32413-f261-4f41-b36f-63d5fa744144

		annotation PBI_FormatHint = {"currencyCulture":"en-DE"}

	measure 'Evaluation Records' = ```
			
			  VAR LabeledRows =
			      CALCULATE (
			          COUNTROWS ( factMlPredictions ),
			          KEEPFILTERS (
			              FILTER (
			                  factMlPredictions,
			                  NOT ISBLANK ( factMlPredictions[actual_risk_label_num] )
			              )
			          )
			      )
			  RETURN
			      IF ( LabeledRows = 0, BLANK (), LabeledRows )
			```
		formatString: 0
		displayFolder: 01 Risk
		lineageTag: 19976484-c4e0-407e-bb72-899373762875

	measure 'Risk Product-Region Records' = ```
			
			  COUNTROWS ( factMlPredictions )
			```
		formatString: 0
		displayFolder: 01 Risk
		lineageTag: 7ac1246a-fd2f-4ddc-bbbf-afc6b12f7672

	measure 'High Risk F1' = ```
			
			  VAR PrecisionValue = [High Risk Precision]
			  VAR RecallValue = [High Risk Recall]
			  RETURN
			      IF (
			          ISBLANK ( [Evaluation Records] ),
			          BLANK (),
			          DIVIDE (
			              2 * PrecisionValue * RecallValue,
			              PrecisionValue + RecallValue
			          )
			      )
			```
		displayFolder: 06 Model Performance
		lineageTag: 6bb90aea-91b1-450c-959d-95a7743e126d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Value
		formatString: 0
		lineageTag: 6576a37b-0815-4be0-8f16-1f5f3915f318
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = { BLANK() }

	annotation PBI_Id = e0833ed3d981439d985b4fc300b8c118

