		lineageTag: 08f9938a-2232-403e-8ea3-439610fcfa6e

	measure 'Customers New' = COUNTROWS(FILTER(VALUES(dimCustomer[customer_id]), [Revenue] > 0 && COALESCE([Revenue PY], 0 ) = 0))
		formatString: 0
		displayFolder: 04 Customers
		lineageTag: 4168113e-90b6-4178-b458-b155b6436e96

	measure 'Customers Churn' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dimCustomer[customer_id]),
			        COALESCE([Revenue PY], 0) > 0
			            && COALESCE([Revenue], 0) = 0))
		formatString: 0
		displayFolder: 04 Customers
		lineageTag: ed874982-d0f3-4ef7-8d76-450a0b5e5300

	measure 'Customer Churn Rate %' =
			DIVIDE([Customers Churn], CALCULATE([Customers Active],
			DATEADD(dimDate[Date], -1, YEAR)))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 04 Customers
		lineageTag: f72b67e0-a29d-431b-87b2-2d9436bd47cd

	measure 'Last Refresh' =
			"↻ Last updated: "
			& FORMAT(NOW(), "dd MMM yyyy • HH:mm")
		displayFolder: 00 Core Measures
		lineageTag: b667f558-b6a2-4c9d-9cb2-c647858602b0

	measure 'Revenue YoY % with Arrow' =
			
			VAR uparrow = UNICHAR(129129)
			VAR downarrow = UNICHAR(129131)
			VAR revenuegap = [Revenue YoY %]*100
			RETURN
			IF(revenuegap < 0,
			downarrow &" "&FORMAT(ROUND(revenuegap,1), "#.###")&"% vs PY",
			uparrow &" "&FORMAT(ROUND(revenuegap,1), "#.###")&"% vs PY")
		displayFolder: 00 Core Measures
		lineageTag: ebf8cb57-75ed-4730-ad8b-fbcb8409f5a3

	measure 'Revenue Sparkline' = ```
			
			
			VAR LineColour = "%23118DFF"
			VAR PointColour = "white"
			VAR Defs = "<defs>
			    <linearGradient id='grad' x1='0' y1='25' x2='0' y2='50' gradientUnits='userSpaceOnUse'>
			        <stop stop-color='#118DFF' offset='0' />
			        <stop stop-color='#118DFF' offset='0.3' />
			        <stop stop-color='white' offset='1' />
			    </linearGradient>
			</defs>"
			// "Date" field used in this example along the X axis
			VAR XMinDate = MIN(dimDate[MonthStartDate])
			VAR XMaxDate = MAX(dimDate[MonthStartDate])
			
			// Obtain overall min and overall max measure values when evaluated for each date
			VAR YMinValue = MINX(Values(dimDate[MonthStartDate]),CALCULATE([Revenue]))
			VAR YMaxValue = MAXX(Values(dimDate[MonthStartDate]),CALCULATE([Revenue]))
			
			// Build table of X & Y coordinates and fit to 50 x 150 viewbox
			VAR SparklineTable = ADDCOLUMNS(
			    SUMMARIZE('dimDate',dimDate[MonthStartDate]),
			        "X",INT(150 * DIVIDE(dimDate[MonthStartDate] - XMinDate, XMaxDate - XMinDate)),
			        "Y",INT(50 * DIVIDE([Revenue] - YMinValue,YMaxValue - YMinValue)))
			
			// Concatenate X & Y coordinates to build the sparkline
			VAR Lines = CONCATENATEX(SparklineTable,[X] & "," & 50-[Y]," ", dimDate[MonthStartDate])
			
			// Last data points on the line
			VAR LastSparkYValue = MAXX( FILTER(SparklineTable, dimDate[MonthStartDate] = XMaxDate), [Y])
			VAR LastSparkXValue = MAXX( FILTER(SparklineTable, dimDate[MonthStartDate] = XMaxDate), [X])
			
			// Add to SVG, and verify Data Category is set to Image URL for this measure
			VAR SVGImageURL = 
			    "data:image/svg+xml;utf8," & 
			    --- gradient---
			    "<svg xmlns='http://www.w3.org/2000/svg' x='0px' y='0px' viewBox='-7 -7 164 64'>" & Defs & 
			     "<polyline fill='url(#grad)' fill-opacity='0.3' stroke='transparent' 
			      stroke-width='0' points=' 0 50 " & Lines & 
			      " 150 150 Z '/>" &
			    --- Lines---
			    "<polyline 
			        fill='transparent' stroke='" & LineColour & "' 
			        stroke-linecap='round' stroke-linejoin='round' 
			        stroke-width='3' points=' " & Lines & 
			      " '/>" &
			    --- Last Point---
			        "<circle cx='"& LastSparkXValue & "' cy='" & 50 - LastSparkYValue & "' r='4' stroke='" & LineColour & "' stroke-width='3' fill='" & PointColour & "' />" &
			        "</svg>"
			RETURN SVGImageURL
			```
		displayFolder: 00 Core Measures
		lineageTag: 8261ccaa-5fbd-41d0-8a65-8c74f0f9b73c

