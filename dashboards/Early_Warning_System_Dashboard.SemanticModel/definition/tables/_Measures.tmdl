	measure 'KT Revenue Driver' =
			
			VAR Growth = [Revenue YoY %]
			VAR Price = [PVM Price Effect]
			VAR Volume = [PVM Volume Effect]
			VAR Mix = [PVM Revenue Mix Effect]
			VAR MainDriver =
			    SWITCH(
			        TRUE(),
			        Price >= Volume && Price >= Mix, "price",
			        Volume >= Price && Volume >= Mix, "volume",
			        "mix"
			    )
			RETURN
			IF(Growth >0, "Revenue increased by " & FORMAT(Growth, "0.0%") & " vs PY, driven by " & MainDriver & " growth.","Revenue decreased by " & FORMAT(Growth, "0.0%") & " vs PY, driven by " & MainDriver)
		displayFolder: 02 Margin
		lineageTag: a4a49731-3752-478a-96a6-8bcaf77abc20

	measure 'KT Revenue at Risk' =
			
			VAR RiskGrowth = [Revenue at Risk % of Total YoY pp]
			VAR TopRiskProduct =
			    TOPN(
			        1,
			        VALUES(dimProduct[product_family]),
			        [Revenue at Risk %],
			        DESC
			    )
			RETURN
			IF(RiskGrowth > 0, "Revenue at risk increased by " & FORMAT(RiskGrowth, "0.0pp") & " vs PY Focus on retention in " & CONCATENATEX(TopRiskProduct, dimProduct[product_family], ", ") & ".", "Revenue at risk decreased by " & FORMAT(RiskGrowth, "0.0pp") & " vs PY Focus on retention in " & CONCATENATEX(TopRiskProduct, dimProduct[product_family], ", ") & ".")
		displayFolder: 01 Risk
		lineageTag: 28d8480c-21b2-49d1-bd41-cd3048dcfe31

	measure 'KT Insight NRR' =
			
			VAR NRRChange = [NRR YoY % pp]
			RETURN
			"NRR " &
