	measure 'Commercial Growth Pipeline KPI Cards HTML' =
			
			VAR _WeightedPipeline =
			    CALCULATE (
			        SUM ( factPipeline[weighted_pipeline_eur] ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 0 ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 0 )
			    )
			
			VAR _OpenPipelineValue =
			    CALCULATE (
			        SUM ( factPipeline[expected_value_eur] ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 0 ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 0 )
			    )
			
			VAR _RevenueTarget =
			    CALCULATE (
			        [Revenue FC],
			        REMOVEFILTERS ( factForecast[forecast_version] ),
			        factForecast[forecast_version] = "Budget"
			    )
			
			VAR _PipelineCoverage =
			    DIVIDE ( _OpenPipelineValue, _RevenueTarget )
			
			VAR _WonOpportunities =
			    CALCULATE (
			        DISTINCTCOUNT ( factPipeline[opportunity_id] ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 1 )
			    )
			
			VAR _LostOpportunities =
			    CALCULATE (
			        DISTINCTCOUNT ( factPipeline[opportunity_id] ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 1 )
			    )
			
			VAR _WinRate =
			    DIVIDE (
			        _WonOpportunities,
			        _WonOpportunities + _LostOpportunities
			    )
			
			VAR _OpenOpportunities =
			    CALCULATE (
			        DISTINCTCOUNT ( factPipeline[opportunity_id] ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 0 ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 0 )
			    )
			
			VAR _AverageDaysToClose =
			    CALCULATE (
			        AVERAGE ( factPipeline[days_to_close] ),
			        FILTER (
			            factPipeline,
			            factPipeline[is_closed_won] = 1
			                || factPipeline[is_closed_lost] = 1
			        )
			    )
			
			VAR _Activities =
			    DISTINCTCOUNT ( factCRMActivities[activity_id] )
			
			VAR _AccountsWithActivity =
			    DISTINCTCOUNT ( factCRMActivities[customer_id] )
			
			VAR _ActivityPerAccount =
			    DIVIDE ( _Activities, _AccountsWithActivity )
			
			VAR _WeightedPipelineFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _WeightedPipeline ), "—",
			        ABS ( _WeightedPipeline ) >= 1000000000,
			            "€" & FORMAT ( _WeightedPipeline / 1000000000, "0.0" ) & "bn",
			        ABS ( _WeightedPipeline ) >= 1000000,
			            "€" & FORMAT ( _WeightedPipeline / 1000000, "0.0" ) & "m",
			        ABS ( _WeightedPipeline ) >= 1000,
			            "€" & FORMAT ( _WeightedPipeline / 1000, "0.0" ) & "k",
			        "€" & FORMAT ( _WeightedPipeline, "#,0" )
			    )
			
			VAR _CoverageFormatted =
			    IF (
			        ISBLANK ( _PipelineCoverage ),
			        "—",
			        FORMAT ( _PipelineCoverage, "0.0" ) & "x"
			    )
			
			VAR _WinRateFormatted =
			    IF (
			        ISBLANK ( _WinRate ),
			        "—",
			        FORMAT ( _WinRate, "0.0%" )
			    )
			
			VAR _OpenOpportunitiesFormatted =
			    IF (
			        ISBLANK ( _OpenOpportunities ),
			        "—",
			        FORMAT ( _OpenOpportunities, "#,0" )
			    )
			
			VAR _DaysToCloseFormatted =
			    IF (
			        ISBLANK ( _AverageDaysToClose ),
			        "—",
			        FORMAT ( _AverageDaysToClose, "0" )
			    )
			
			VAR _ActivityPerAccountFormatted =
			    IF (
			        ISBLANK ( _ActivityPerAccount ),
			        "—",
			        FORMAT ( _ActivityPerAccount, "0.0" )
			    )
			
			VAR _PipelineIcon =
			    "<svg viewBox='0 0 48 48' aria-hidden='true'>
			        <path d='M7 9h34L29 23v12l-10 5V23L7 9z'
			              fill='currentColor'/>
			     </svg>"
			
			VAR _CoverageIcon =
			    "<svg viewBox='0 0 48 48' aria-hidden='true'>
			        <path d='M24 5c5 4 10 5 16 6v11c0 10-6 17-16 22C14 39 8 32 8 22V11c6-1 11-2 16-6z'
			              fill='currentColor'/>
			        <path d='m17 24 5 5 10-12'
			              fill='none' stroke='white' stroke-width='3.4'
			              stroke-linecap='round' stroke-linejoin='round'/>
			     </svg>"
			
			VAR _WinRateIcon =
			    "<svg viewBox='0 0 48 48' aria-hidden='true'>
			        <circle cx='22' cy='25' r='16' fill='none'
			                stroke='currentColor' stroke-width='4'/>
			        <circle cx='22' cy='25' r='9' fill='none'
			                stroke='currentColor' stroke-width='4'/>
			        <circle cx='22' cy='25' r='3.5' fill='currentColor'/>
			        <path d='M26 21 40 7m-7 1h7v7'
			              fill='none' stroke='currentColor' stroke-width='4'
			              stroke-linecap='round' stroke-linejoin='round'/>
			     </svg>"
			
			VAR _OpportunityIcon =
			    "<svg viewBox='0 0 48 48' aria-hidden='true'>
			        <rect x='6' y='14' width='36' height='25' rx='3'
			              fill='currentColor'/>
			        <path d='M18 14v-4c0-2 1-3 3-3h6c2 0 3 1 3 3v4M6 24h36M22 21h4v6h-4z'
			              fill='none' stroke='white' stroke-width='2.8'
			              stroke-linejoin='round'/>
			     </svg>"
			
			VAR _DaysIcon =
			    "<svg viewBox='0 0 48 48' aria-hidden='true'>
			        <rect x='6' y='9' width='36' height='34' rx='4'
			              fill='currentColor'/>
			        <path d='M14 5v9M34 5v9M6 17h36'
			              fill='none' stroke='currentColor' stroke-width='4'
			              stroke-linecap='round'/>
			        <g fill='white'>
			          <circle cx='15' cy='25' r='2.5'/>
			          <circle cx='24' cy='25' r='2.5'/>
			          <circle cx='33' cy='25' r='2.5'/>
			          <circle cx='15' cy='34' r='2.5'/>
			          <circle cx='24' cy='34' r='2.5'/>
			          <circle cx='33' cy='34' r='2.5'/>
			        </g>
			     </svg>"
			
			VAR _ActivityIcon =
			    "<svg viewBox='0 0 48 48' aria-hidden='true'>
			        <circle cx='19' cy='16' r='8' fill='currentColor'/>
			        <circle cx='35' cy='18' r='6'
			                fill='currentColor' opacity='.82'/>
			        <path d='M5 41v-5c0-7 6-12 14-12s14 5 14 12v5H5z'
			              fill='currentColor'/>
			        <path d='M31 28c7 0 12 4 12 10v3H34v-5c0-3-1-6-3-8z'
			              fill='currentColor' opacity='.82'/>
			     </svg>"
			
			RETURN
			    "<style>
			        * { box-sizing: border-box; }
			
			        .cgp-grid {
			            width: 100%;
			            height: 100%;
			            min-height: 108px;
			            display: grid;
			            grid-template-columns: repeat(6, minmax(0, 1fr));
			            gap: 10px;
			            padding: 4px;
			            font-family: 'Segoe UI', Arial, sans-serif;
			        }
			
			        .cgp-card {
			            position: relative;
			            min-width: 0;
			            min-height: 98px;
			            display: grid;
			            grid-template-columns: minmax(0, 1fr) 46px;
			            align-items: center;
			            padding: 13px 12px 11px 15px;
			            overflow: hidden;
			            background: #FFFFFF;
			            border: 1px solid #DDD7E0;
			            border-top: 3px solid #6F4A7C;
			            border-radius: 9px;
			            box-shadow: 0 2px 6px rgba(51,16,69,.07);
			        }
			
			        .cgp-card::after {
			            content: '';
			            position: absolute;
			            right: -20px;
			            bottom: -30px;
			            width: 82px;
			            height: 82px;
			            border-radius: 50%;
			            background: rgba(111,74,124,.045);
			        }
			
			        .cgp-copy {
			            position: relative;
			            z-index: 1;
			            min-width: 0;
			        }
			
			        .cgp-label {
			            margin-bottom: 5px;
			            overflow: hidden;
			            color: #5D5660;
			            font-size: 11px;
			            font-weight: 600;
			            line-height: 1.15;
			            text-overflow: ellipsis;
			            white-space: nowrap;
			        }
			
			        .cgp-value {
			            color: #4B285E;
			            font-size: 27px;
			            font-weight: 750;
			            line-height: 1;
			            letter-spacing: -.4px;
			            white-space: nowrap;
			        }
			
			        .cgp-icon {
			            position: relative;
			            z-index: 1;
			            width: 40px;
			            height: 40px;
			            justify-self: end;
			            color: #7D4E91;
			        }
			
			        .cgp-icon svg {
			            display: block;
			            width: 100%;
			            height: 100%;
			        }
			
			        @media (max-width: 900px) {
			            .cgp-grid {
			                grid-template-columns: repeat(3, minmax(0, 1fr));
			            }
			        }
			    </style>
			
			    <div class='cgp-grid'>
			
			        <div class='cgp-card'
			             title='Probability-weighted value of currently open opportunities'>
			            <div class='cgp-copy'>
			                <div class='cgp-label'>Weighted Pipeline</div>
			                <div class='cgp-value'>"
			                    & _WeightedPipelineFormatted &
			                "</div>
			            </div>
			            <div class='cgp-icon'>" & _PipelineIcon & "</div>
			        </div>
			
			        <div class='cgp-card'
			             title='Open pipeline value divided by Budget revenue target'>
			            <div class='cgp-copy'>
			                <div class='cgp-label'>Pipeline Coverage</div>
			                <div class='cgp-value'>"
			                    & _CoverageFormatted &
			                "</div>
			            </div>
			            <div class='cgp-icon'>" & _CoverageIcon & "</div>
			        </div>
			
			        <div class='cgp-card'
			             title='Won opportunities divided by won plus lost opportunities'>
			            <div class='cgp-copy'>
			                <div class='cgp-label'>Win Rate</div>
			                <div class='cgp-value'>"
			                    & _WinRateFormatted &
			                "</div>
			            </div>
			            <div class='cgp-icon'>" & _WinRateIcon & "</div>
			        </div>
			
			        <div class='cgp-card'
			             title='Distinct opportunities that are neither won nor lost'>
			            <div class='cgp-copy'>
			                <div class='cgp-label'>Open Opportunities</div>
			                <div class='cgp-value'>"
			                    & _OpenOpportunitiesFormatted &
			                "</div>
			            </div>
			            <div class='cgp-icon'>" & _OpportunityIcon & "</div>
			        </div>
			
			        <div class='cgp-card'
			             title='Average closing duration for won and lost opportunities'>
			            <div class='cgp-copy'>
			                <div class='cgp-label'>Average Days to Close</div>
			                <div class='cgp-value'>"
			                    & _DaysToCloseFormatted &
			                "</div>
			            </div>
			            <div class='cgp-icon'>" & _DaysIcon & "</div>
			        </div>
			
			        <div class='cgp-card'
			             title='CRM activities divided by accounts with at least one activity'>
			            <div class='cgp-copy'>
			                <div class='cgp-label'>Activity / Account</div>
			                <div class='cgp-value'>"
			                    & _ActivityPerAccountFormatted &
			                "</div>
			            </div>
			            <div class='cgp-icon'>" & _ActivityIcon & "</div>
			        </div>
			
			    </div>"
		displayFolder: 08 Executive
		lineageTag: 0240c255-3e11-40af-981e-66d40f3cac19

	measure 'Commercial Growth Pipeline KPI Cards HTML 2' =
			
			VAR _UpArrow =
			    UNICHAR ( 9650 )
			
			VAR _DownArrow =
			    UNICHAR ( 9660 )
			
			VAR _NeutralArrow =
			    UNICHAR ( 8212 )
			
			
			-- =====================================================
			-- CURRENT VALUES
			-- =====================================================
			
			VAR _WeightedPipeline =
			    CALCULATE (
			        SUM ( factPipeline[weighted_pipeline_eur] ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 0 ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 0 )
			    )
			
			VAR _OpenPipelineValue =
			    CALCULATE (
			        SUM ( factPipeline[expected_value_eur] ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 0 ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 0 )
			    )
			
			VAR _BudgetRevenue =
			    CALCULATE (
			        [Revenue FC],
			        REMOVEFILTERS ( factForecast[forecast_version] ),
			        factForecast[forecast_version] = "Budget"
			    )
			
			VAR _PipelineCoverage =
			    DIVIDE (
			        _OpenPipelineValue,
			        _BudgetRevenue
			    )
			
			VAR _WonOpportunities =
			    CALCULATE (
			        DISTINCTCOUNT ( factPipeline[opportunity_id] ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 1 )
			    )
			
			VAR _LostOpportunities =
			    CALCULATE (
			        DISTINCTCOUNT ( factPipeline[opportunity_id] ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 1 )
			    )
			
			VAR _WinRate =
			    DIVIDE (
			        _WonOpportunities,
			        _WonOpportunities + _LostOpportunities
			    )
			
			VAR _OpenOpportunities =
			    CALCULATE (
			        DISTINCTCOUNT ( factPipeline[opportunity_id] ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 0 ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 0 )
			    )
			
			VAR _ClosedOpportunityFilter =
			    FILTER (
			        ALL (
			            factPipeline[is_closed_won],
			            factPipeline[is_closed_lost]
			        ),
			        factPipeline[is_closed_won] = 1
			            || factPipeline[is_closed_lost] = 1
			    )
			
			VAR _AverageDaysToClose =
			    CALCULATE (
			        AVERAGE ( factPipeline[days_to_close] ),
			        _ClosedOpportunityFilter
			    )
			
			VAR _Activities =
			    DISTINCTCOUNT ( factCRMActivities[activity_id] )
			
			VAR _AccountsWithActivity =
			    DISTINCTCOUNT ( factCRMActivities[customer_id] )
			
			VAR _ActivityPerAccount =
			    DIVIDE (
			        _Activities,
			        _AccountsWithActivity
			    )
			
			
			-- =====================================================
			-- PREVIOUS-MONTH VALUES
			-- =====================================================
			
			VAR _WeightedPipelinePM =
			    CALCULATE (
			        SUM ( factPipeline[weighted_pipeline_eur] ),
			        DATEADD ( dimDate[Date], -1, MONTH ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 0 ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 0 )
			    )
			
			VAR _OpenPipelineValuePM =
			    CALCULATE (
			        SUM ( factPipeline[expected_value_eur] ),
			        DATEADD ( dimDate[Date], -1, MONTH ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 0 ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 0 )
			    )
			
			VAR _BudgetRevenuePM =
			    CALCULATE (
			        [Revenue FC],
			        DATEADD ( dimDate[Date], -1, MONTH ),
			        REMOVEFILTERS ( factForecast[forecast_version] ),
			        factForecast[forecast_version] = "Budget"
			    )
			
			VAR _PipelineCoveragePM =
			    DIVIDE (
			        _OpenPipelineValuePM,
			        _BudgetRevenuePM
			    )
			
			VAR _WonOpportunitiesPM =
			    CALCULATE (
			        DISTINCTCOUNT ( factPipeline[opportunity_id] ),
			        DATEADD ( dimDate[Date], -1, MONTH ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 1 )
			    )
			
			VAR _LostOpportunitiesPM =
			    CALCULATE (
			        DISTINCTCOUNT ( factPipeline[opportunity_id] ),
			        DATEADD ( dimDate[Date], -1, MONTH ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 1 )
			    )
			
			VAR _WinRatePM =
			    DIVIDE (
			        _WonOpportunitiesPM,
			        _WonOpportunitiesPM + _LostOpportunitiesPM
			    )
			
			VAR _OpenOpportunitiesPM =
			    CALCULATE (
			        DISTINCTCOUNT ( factPipeline[opportunity_id] ),
			        DATEADD ( dimDate[Date], -1, MONTH ),
			        KEEPFILTERS ( factPipeline[is_closed_won] = 0 ),
			        KEEPFILTERS ( factPipeline[is_closed_lost] = 0 )
			    )
			
			VAR _AverageDaysToClosePM =
			    CALCULATE (
			        AVERAGE ( factPipeline[days_to_close] ),
			        DATEADD ( dimDate[Date], -1, MONTH ),
			        _ClosedOpportunityFilter
			    )
			
			VAR _ActivitiesPM =
			    CALCULATE (
			        DISTINCTCOUNT ( factCRMActivities[activity_id] ),
			        DATEADD ( dimDate[Date], -1, MONTH )
			    )
			
			VAR _AccountsWithActivityPM =
			    CALCULATE (
			        DISTINCTCOUNT ( factCRMActivities[customer_id] ),
			        DATEADD ( dimDate[Date], -1, MONTH )
			    )
			
			VAR _ActivityPerAccountPM =
			    DIVIDE (
			        _ActivitiesPM,
			        _AccountsWithActivityPM
			    )
			
			
			-- =====================================================
			-- VARIANCES
			-- =====================================================
			
			VAR _WeightedPipelineChange =
			    DIVIDE (
			        _WeightedPipeline - _WeightedPipelinePM,
			        ABS ( _WeightedPipelinePM )
			    )
			
			VAR _CoverageChange =
			    _PipelineCoverage - _PipelineCoveragePM
			
			VAR _WinRateChangePP =
			    (
			        _WinRate - _WinRatePM
			    ) * 100
			
			VAR _OpenOpportunitiesChange =
			    DIVIDE (
			        _OpenOpportunities - _OpenOpportunitiesPM,
			        ABS ( _OpenOpportunitiesPM )
			    )
			
			VAR _DaysToCloseChange =
			    _AverageDaysToClose - _AverageDaysToClosePM
			
			VAR _ActivityChange =
			    _ActivityPerAccount - _ActivityPerAccountPM
			
			
			-- =====================================================
			-- MAIN VALUE FORMATTING
			-- =====================================================
			
			VAR _WeightedPipelineFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _WeightedPipeline ), "—",
			        ABS ( _WeightedPipeline ) >= 1000000000,
			            "€"
			                & FORMAT (
			                    _WeightedPipeline / 1000000000,
			                    "0.00"
			                )
			                & "bn",
			        ABS ( _WeightedPipeline ) >= 1000000,
			            "€"
			                & FORMAT (
			                    _WeightedPipeline / 1000000,
			                    "0.0"
			                )
			                & "m",
			        ABS ( _WeightedPipeline ) >= 1000,
			            "€"
			                & FORMAT (
			                    _WeightedPipeline / 1000,
			                    "0.0"
			                )
			                & "k",
			        "€" & FORMAT ( _WeightedPipeline, "#,0" )
			    )
			
			VAR _CoverageFormatted =
			    IF (
			        ISBLANK ( _PipelineCoverage ),
			        "—",
			        FORMAT ( _PipelineCoverage, "0.0" ) & "x"
			    )
			
			VAR _WinRateFormatted =
			    IF (
			        ISBLANK ( _WinRate ),
			        "—",
			        FORMAT ( _WinRate, "0.0%" )
			    )
			
			VAR _OpenOpportunitiesFormatted =
			    IF (
			        ISBLANK ( _OpenOpportunities ),
			        "—",
			        FORMAT ( _OpenOpportunities, "#,0" )
			    )
			
			VAR _DaysToCloseFormatted =
			    IF (
			        ISBLANK ( _AverageDaysToClose ),
			        "—",
			        FORMAT ( _AverageDaysToClose, "0" )
			    )
			
			VAR _ActivityPerAccountFormatted =
			    IF (
			        ISBLANK ( _ActivityPerAccount ),
			        "—",
			        FORMAT ( _ActivityPerAccount, "0.0" )
			    )
			
			
			-- =====================================================
			-- COMPARISON TEXT
			-- =====================================================
			
			VAR _WeightedPipelineComparison =
			    IF (
			        ISBLANK ( _WeightedPipelineChange ),
			        "No PM comparison",
			        SWITCH (
			            TRUE (),
			            _WeightedPipelineChange > 0,
			                _UpArrow & " "
			                    & FORMAT (
			                        ABS ( _WeightedPipelineChange ),
			                        "0.0%"
			                    )
			                    & " vs PM",
			            _WeightedPipelineChange < 0,
			                _DownArrow & " "
			                    & FORMAT (
			                        ABS ( _WeightedPipelineChange ),
			                        "0.0%"
			                    )
			                    & " vs PM",
			            _NeutralArrow & " 0.0% vs PM"
			        )
			    )
			
			VAR _CoverageComparison =
			    IF (
			        ISBLANK ( _CoverageChange ),
			        "No PM comparison",
			        SWITCH (
			            TRUE (),
			            _CoverageChange > 0,
			                _UpArrow & " "
			                    & FORMAT (
			                        ABS ( _CoverageChange ),
			                        "0.0"
			                    )
			                    & "x vs PM",
			            _CoverageChange < 0,
			                _DownArrow & " "
			                    & FORMAT (
			                        ABS ( _CoverageChange ),
			                        "0.0"
			                    )
			                    & "x vs PM",
			            _NeutralArrow & " 0.0x vs PM"
			        )
			    )
			
			VAR _WinRateComparison =
			    IF (
			        ISBLANK ( _WinRateChangePP ),
			        "No PM comparison",
			        SWITCH (
			            TRUE (),
			            _WinRateChangePP > 0,
			                _UpArrow & " "
			                    & FORMAT (
			                        ABS ( _WinRateChangePP ),
			                        "0.0"
			                    )
			                    & " pp vs PM",
			            _WinRateChangePP < 0,
			                _DownArrow & " "
			                    & FORMAT (
			                        ABS ( _WinRateChangePP ),
			                        "0.0"
			                    )
			                    & " pp vs PM",
			            _NeutralArrow & " 0.0 pp vs PM"
			        )
			    )
			
			VAR _OpenOpportunitiesComparison =
			    IF (
			        ISBLANK ( _OpenOpportunitiesChange ),
			        "No PM comparison",
			        SWITCH (
			            TRUE (),
			            _OpenOpportunitiesChange > 0,
			                _UpArrow & " "
			                    & FORMAT (
			                        ABS ( _OpenOpportunitiesChange ),
			                        "0.0%"
			                    )
			                    & " vs PM",
			            _OpenOpportunitiesChange < 0,
			                _DownArrow & " "
			                    & FORMAT (
			                        ABS ( _OpenOpportunitiesChange ),
			                        "0.0%"
			                    )
			                    & " vs PM",
			            _NeutralArrow & " 0.0% vs PM"
			        )
			    )
			
			VAR _DaysToCloseComparison =
			    IF (
			        ISBLANK ( _DaysToCloseChange ),
			        "No PM comparison",
			        SWITCH (
			            TRUE (),
			            _DaysToCloseChange < 0,
			                _DownArrow & " "
			                    & FORMAT (
			                        ABS ( _DaysToCloseChange ),
			                        "0"
			                    )
			                    & " days vs PM",
			            _DaysToCloseChange > 0,
			                _UpArrow & " "
			                    & FORMAT (
			                        ABS ( _DaysToCloseChange ),
			                        "0"
			                    )
			                    & " days vs PM",
			            _NeutralArrow & " 0 days vs PM"
			        )
			    )
			
			VAR _ActivityComparison =
			    IF (
			        ISBLANK ( _ActivityChange ),
			        "No PM comparison",
			        SWITCH (
			            TRUE (),
			            _ActivityChange > 0,
			                _UpArrow & " "
			                    & FORMAT (
			                        ABS ( _ActivityChange ),
			                        "0.0"
			                    )
			                    & " vs PM",
			            _ActivityChange < 0,
			                _DownArrow & " "
			                    & FORMAT (
			                        ABS ( _ActivityChange ),
			                        "0.0"
			                    )
			                    & " vs PM",
			            _NeutralArrow & " 0.0 vs PM"
			        )
			    )
			
			
			-- =====================================================
			-- COMPARISON COLORS
			-- =====================================================
			
			VAR _WeightedPipelineColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _WeightedPipelineChange ), "#7A7480",
			        _WeightedPipelineChange > 0, "#2F855A",
			        _WeightedPipelineChange < 0, "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _CoverageColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _CoverageChange ), "#7A7480",
			        _CoverageChange > 0, "#2F855A",
			        _CoverageChange < 0, "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _WinRateColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _WinRateChangePP ), "#7A7480",
			        _WinRateChangePP > 0, "#2F855A",
			        _WinRateChangePP < 0, "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _OpenOpportunitiesColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _OpenOpportunitiesChange ), "#7A7480",
			        _OpenOpportunitiesChange > 0, "#2F855A",
			        _OpenOpportunitiesChange < 0, "#C53D3D",
			        "#7A7480"
			    )
			
			-- Lower closing duration is positive
			VAR _DaysToCloseColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _DaysToCloseChange ), "#7A7480",
			        _DaysToCloseChange < 0, "#2F855A",
			        _DaysToCloseChange > 0, "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _ActivityColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _ActivityChange ), "#7A7480",
			        _ActivityChange > 0, "#2F855A",
			        _ActivityChange < 0, "#C53D3D",
			        "#7A7480"
			    )
			
			
			-- =====================================================
			-- SVG ICONS
			-- =====================================================
			
			VAR _PipelineIcon =
			    "<svg viewBox='0 0 48 48'>
			        <path d='M7 9h34L29 23v12l-10 5V23L7 9z'
			              fill='white'/>
			     </svg>"
			
			VAR _CoverageIcon =
			    "<svg viewBox='0 0 48 48'>
			        <path d='M24 5c5 4 10 5 16 6v11c0 10-6 17-16 22C14 39 8 32 8 22V11c6-1 11-2 16-6z'
			              fill='white'/>
			        <path d='m17 24 5 5 10-12'
			              fill='none'
			              stroke='#6F4A7C'
			              stroke-width='3.4'
			              stroke-linecap='round'
			              stroke-linejoin='round'/>
			     </svg>"
			
			VAR _WinRateIcon =
			    "<svg viewBox='0 0 48 48'>
			        <circle cx='22' cy='25' r='15'
			                fill='none'
			                stroke='white'
			                stroke-width='4'/>
			        <circle cx='22' cy='25' r='8'
			                fill='none'
			                stroke='white'
			                stroke-width='4'/>
			        <circle cx='22' cy='25' r='3'
			                fill='white'/>
			        <path d='M26 21 40 7m-7 1h7v7'
			              fill='none'
			              stroke='white'
			              stroke-width='4'
			              stroke-linecap='round'
			              stroke-linejoin='round'/>
			     </svg>"
			
			VAR _OpportunityIcon =
			    "<svg viewBox='0 0 48 48'>
			        <rect x='6' y='14'
			              width='36'
			              height='25'
			              rx='3'
			              fill='white'/>
			        <path d='M18 14v-4c0-2 1-3 3-3h6c2 0 3 1 3 3v4M6 24h36'
			              fill='none'
			              stroke='#6F4A7C'
			              stroke-width='2.8'/>
			     </svg>"
			
			VAR _DaysIcon =
			    "<svg viewBox='0 0 48 48'>
			        <rect x='6' y='9'
			              width='36'
			              height='34'
			              rx='4'
			              fill='white'/>
			        <path d='M14 5v9M34 5v9M6 17h36'
			              fill='none'
			              stroke='#D99A2B'
			              stroke-width='4'
			              stroke-linecap='round'/>
			        <g fill='#D99A2B'>
			            <circle cx='15' cy='25' r='2.5'/>
			            <circle cx='24' cy='25' r='2.5'/>
			            <circle cx='33' cy='25' r='2.5'/>
			            <circle cx='15' cy='34' r='2.5'/>
			            <circle cx='24' cy='34' r='2.5'/>
			            <circle cx='33' cy='34' r='2.5'/>
			        </g>
			     </svg>"
			
			VAR _ActivityIcon =
			    "<svg viewBox='0 0 48 48'>
			        <circle cx='19' cy='16' r='8'
			                fill='white'/>
			        <circle cx='35' cy='18' r='6'
			                fill='white'
			                opacity='.85'/>
			        <path d='M5 41v-5c0-7 6-12 14-12s14 5 14 12v5H5z'
			              fill='white'/>
			        <path d='M31 28c7 0 12 4 12 10v3H34v-5c0-3-1-6-3-8z'
			              fill='white'
			              opacity='.85'/>
			     </svg>"
			
			
			RETURN
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			        }
			
			        .cg-row {
			            width:100%;
			            height:100%;
			            min-height:112px;
			            display:grid;
			            grid-template-columns:repeat(6,minmax(0,1fr));
			            gap:12px;
			            padding:5px;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .cg-card {
			            min-width:0;
			            min-height:102px;
			            display:grid;
			            grid-template-columns:58px minmax(0,1fr);
			            align-items:center;
			            gap:12px;
			            padding:12px 13px;
			            overflow:hidden;
			            background:#FFFFFF;
			            border:1px solid #DCD6DF;
			            border-radius:8px;
			            box-shadow:0 2px 6px rgba(51,16,69,.08);
			        }
			
			        .cg-icon {
			            width:52px;
			            height:52px;
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            padding:8px;
			            border-radius:50%;
			        }
			
			        .cg-icon svg {
			            width:100%;
			            height:100%;
			            display:block;
			        }
			
			        .cg-content {
			            min-width:0;
			        }
			
			        .cg-label {
			            margin-bottom:5px;
			            overflow:hidden;
			            color:#4E4851;
			            font-size:11px;
			            font-weight:500;
			            line-height:1.1;
			            text-overflow:ellipsis;
			            white-space:nowrap;
			        }
			
			        .cg-value {
			            overflow:hidden;
			            color:#171419;
			            font-size:25px;
			            font-weight:750;
			            line-height:1;
			            letter-spacing:-.4px;
			            text-overflow:ellipsis;
			            white-space:nowrap;
			        }
			
			        .cg-change {
			            margin-top:8px;
			            font-size:11px;
			            font-weight:650;
			            line-height:1;
			            white-space:nowrap;
			        }
			
			        @media(max-width:1000px) {
			            .cg-row {
			                grid-template-columns:repeat(3,minmax(0,1fr));
			            }
			        }
			    </style>
			
			    <div class='cg-row'>
			
			        <div class='cg-card'
			             title='Probability-weighted value of open opportunities'>
			            <div class='cg-icon'
			                 style='background:#331045'>"
			                & _PipelineIcon &
			            "</div>
			
			            <div class='cg-content'>
			                <div class='cg-label'>Weighted Pipeline</div>
			                <div class='cg-value'>"
			                    & _WeightedPipelineFormatted &
			                "</div>
			                <div class='cg-change'
			                     style='color:" & _WeightedPipelineColor & "'>"
			                    & _WeightedPipelineComparison &
			                "</div>
			            </div>
			        </div>
			
			        <div class='cg-card'
			             title='Open pipeline divided by Budget revenue'>
			            <div class='cg-icon'
			                 style='background:#6F4A7C'>"
			                & _CoverageIcon &
			            "</div>
			
			            <div class='cg-content'>
			                <div class='cg-label'>Pipeline Coverage</div>
			                <div class='cg-value'>"
			                    & _CoverageFormatted &
			                "</div>
			                <div class='cg-change'
			                     style='color:" & _CoverageColor & "'>"
			                    & _CoverageComparison &
			                "</div>
			            </div>
			        </div>
			
			        <div class='cg-card'
			             title='Won opportunities divided by won plus lost'>
			            <div class='cg-icon'
			                 style='background:#4F91A8'>"
			                & _WinRateIcon &
			            "</div>
			
			            <div class='cg-content'>
			                <div class='cg-label'>Win Rate</div>
			                <div class='cg-value'>"
			                    & _WinRateFormatted &
			                "</div>
			                <div class='cg-change'
			                     style='color:" & _WinRateColor & "'>"
			                    & _WinRateComparison &
			                "</div>
			            </div>
			        </div>
			
			        <div class='cg-card'
			             title='Opportunities that are neither won nor lost'>
			            <div class='cg-icon'
			                 style='background:#6F4A7C'>"
			                & _OpportunityIcon &
			            "</div>
			
			            <div class='cg-content'>
			                <div class='cg-label'>Open Opportunities</div>
			                <div class='cg-value'>"
			                    & _OpenOpportunitiesFormatted &
			                "</div>
			                <div class='cg-change'
			                     style='color:" & _OpenOpportunitiesColor & "'>"
			                    & _OpenOpportunitiesComparison &
			                "</div>
			            </div>
			        </div>
			
			        <div class='cg-card'
			             title='Average closing duration for closed opportunities'>
			            <div class='cg-icon'
			                 style='background:#D99A2B'>"
			                & _DaysIcon &
			            "</div>
			
			            <div class='cg-content'>
			                <div class='cg-label'>Average Days to Close</div>
			                <div class='cg-value'>"
			                    & _DaysToCloseFormatted &
			                "</div>
			                <div class='cg-change'
			                     style='color:" & _DaysToCloseColor & "'>"
			                    & _DaysToCloseComparison &
			                "</div>
			            </div>
			        </div>
			
			        <div class='cg-card'
			             title='CRM activities per account with recorded activity'>
			            <div class='cg-icon'
			                 style='background:#2F855A'>"
			                & _ActivityIcon &
			            "</div>
			
			            <div class='cg-content'>
			                <div class='cg-label'>Activity / Account</div>
			                <div class='cg-value'>"
			                    & _ActivityPerAccountFormatted &
			                "</div>
			                <div class='cg-change'
			                     style='color:" & _ActivityColor & "'>"
			                    & _ActivityComparison &
			                "</div>
			            </div>
			        </div>
			
			    </div>
			    "
		displayFolder: 08 Executive
		lineageTag: 0db9f052-95af-4aaa-8acf-d453ba611161

	measure 'Title Product Risk Detail HTML' =
			
			VAR _ProductID =
			    SELECTEDVALUE ( dimProduct[product_id] )
			
			VAR _ProductName =
			    SELECTEDVALUE ( dimProduct[product_name] )
			
			VAR _Region =
			    SELECTEDVALUE ( dimRegion[region] )
			
			VAR _SelectedDate =
			    SELECTEDVALUE ( dimDate[Date] )
			
			VAR _RiskScore =
			    SELECTEDVALUE ( factMlPredictions[risk_score] )
			
			RETURN
			    "
			    <div style='
			        width:100%;
			        overflow:hidden;
			        color:#26232A;
			        background:transparent;
			        font-family:Segoe UI,Arial,sans-serif;
			        font-size:26px;
			        font-weight:700;
			        white-space:nowrap;
			        text-overflow:ellipsis;'>
			
			        PRODUCT RISK DETAIL · "
			            & COALESCE ( FORMAT ( _ProductID, "0" ), "—" )
			            & " · "
			            & COALESCE ( _ProductName, "—" )
			            & " · "
			            & COALESCE ( _Region, "—" )
			            & "
			
			    </div>
			    "
		displayFolder: 01 Risk
		lineageTag: eae56f6d-e814-451e-9d30-872b7959a24f

	measure 'Priority Actions HTML' = ```
			
			VAR _LatestMonth =
			    CALCULATE (
			        MAX ( factMlPredictions[year_month] ),
			        REMOVEFILTERS ( dimDate ),
			        REMOVEFILTERS ( factMlPredictions[year_month] )
			    )
			
			VAR _MonthStart =
			    DATE (
			        YEAR ( _LatestMonth ),
			        MONTH ( _LatestMonth ),
			        1
			    )
			
			VAR _MonthEnd =
			    EOMONTH ( _MonthStart, 0 )
			
			VAR _PreviousMonthStart =
			    EDATE ( _MonthStart, -1 )
			
			VAR _PreviousMonthEnd =
			    EOMONTH ( _MonthStart, -1 )
			
			VAR _LatestMonthLabel =
			    FORMAT (
			        _MonthStart,
			        "MMM yyyy",
			        "en-US"
			    )
			
			-- ============================================================
			-- EXISTING PRODUCT-REGION COMBINATIONS IN LATEST ML MONTH
			-- ============================================================
			
			VAR _LatestPredictionRows =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS ( dimDate ),
			        FILTER (
			            ALL ( factMlPredictions[year_month] ),
			            factMlPredictions[year_month] >= _MonthStart
			                && factMlPredictions[year_month] <= _MonthEnd
			        )
			    )
			
			VAR _ProductRegionKeys =
			    SUMMARIZE (
			        _LatestPredictionRows,
			        factMlPredictions[product_id],
			        factMlPredictions[region_id]
			    )
			
			-- ============================================================
			-- ADD PRODUCT, RISK AND COMMERCIAL INFORMATION
			-- ============================================================
			
			VAR _ProductRegionData =
			    ADDCOLUMNS (
			        _ProductRegionKeys,
			
			        "@SKU",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            RETURN
			                LOOKUPVALUE (
			                    dimProduct[sku],
			                    dimProduct[product_id], _ProductID
			                ),
			
			        "@ProductName",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            RETURN
			                LOOKUPVALUE (
			                    dimProduct[product_name],
			                    dimProduct[product_id], _ProductID
			                ),
			
			        "@Lifecycle",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            RETURN
			                LOOKUPVALUE (
			                    dimProduct[lifecycle_stage],
			                    dimProduct[product_id], _ProductID
			                ),
			
			        "@TargetMargin",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			            RETURN
			                LOOKUPVALUE (
			                    dimProduct[target_margin_pct],
			                    dimProduct[product_id], _ProductID
			                ),
			
			        "@Region",
			            VAR _RegionID =
			                factMlPredictions[region_id]
			            RETURN
			                LOOKUPVALUE (
			                    dimRegion[region],
			                    dimRegion[region_id], _RegionID
			                ),
			
			        "@PredictedClass",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			
			            VAR _RegionID =
			                factMlPredictions[region_id]
			
			            RETURN
			                CALCULATE (
			                    MAX (
			                        factMlPredictions[predicted_risk_label_num]
			                    ),
			                    REMOVEFILTERS ( dimDate ),
			                    FILTER (
			                        ALL ( factMlPredictions[year_month] ),
			                        factMlPredictions[year_month] >= _MonthStart
			                            && factMlPredictions[year_month] <= _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        factMlPredictions[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        factMlPredictions[region_id]
			                    )
			                ),
			
			        "@RiskScore",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			
			            VAR _RegionID =
			                factMlPredictions[region_id]
			
			            RETURN
			                CALCULATE (
			                    [Risk Score normalized AVG],
			                    REMOVEFILTERS ( dimDate ),
			                    FILTER (
			                        ALL ( factMlPredictions[year_month] ),
			                        factMlPredictions[year_month] >= _MonthStart
			                            && factMlPredictions[year_month] <= _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        factMlPredictions[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        factMlPredictions[region_id]
			                    )
			                ),
			
			        "@Revenue",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			
			            VAR _RegionID =
			                factMlPredictions[region_id]
			
			            RETURN
			                CALCULATE (
			                    SUM ( factMlPredictions[revenue] ),
			                    REMOVEFILTERS ( dimDate ),
			                    FILTER (
			                        ALL ( factMlPredictions[year_month] ),
			                        factMlPredictions[year_month] >= _MonthStart
			                            && factMlPredictions[year_month] <= _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        factMlPredictions[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        factMlPredictions[region_id]
			                    )
			                ),
			
			        "@RevenuePM",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			
			            VAR _RegionID =
			                factMlPredictions[region_id]
			
			            RETURN
			                CALCULATE (
			                    SUM ( factMlPredictions[revenue] ),
			                    REMOVEFILTERS ( dimDate ),
			                    FILTER (
			                        ALL ( factMlPredictions[year_month] ),
			                        factMlPredictions[year_month] >= _PreviousMonthStart
			                            && factMlPredictions[year_month] <= _PreviousMonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        factMlPredictions[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        factMlPredictions[region_id]
			                    )
			                ),
			
			        "@GrossMargin",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			
			            VAR _RegionID =
			                factMlPredictions[region_id]
			
			            RETURN
			                CALCULATE (
			                    [Gross Margin %],
			                    REMOVEFILTERS ( dimDate ),
			                    DATESBETWEEN (
			                        dimDate[Date],
			                        _MonthStart,
			                        _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        dimProduct[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        dimRegion[region_id]
			                    )
			                ),
			
			        "@Volatility",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			
			            VAR _RegionID =
			                factMlPredictions[region_id]
			
			            RETURN
			                CALCULATE (
			                    [Sales Volatility %],
			                    REMOVEFILTERS ( dimDate ),
			                    DATESBETWEEN (
			                        dimDate[Date],
			                        _MonthStart,
			                        _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        dimProduct[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        dimRegion[region_id]
			                    )
			                ),
			
			        "@Competition",
			            VAR _ProductID =
			                factMlPredictions[product_id]
			
			            VAR _RegionID =
			                factMlPredictions[region_id]
			
			            RETURN
			                CALCULATE (
			                    [Competitor Pressure Score AVG],
			                    REMOVEFILTERS ( dimDate ),
			                    FILTER (
			                        ALL ( factMlPredictions[year_month] ),
			                        factMlPredictions[year_month] >= _MonthStart
			                            && factMlPredictions[year_month] <= _MonthEnd
			                    ),
			                    TREATAS (
			                        { _ProductID },
			                        factMlPredictions[product_id]
			                    ),
			                    TREATAS (
			                        { _RegionID },
			                        factMlPredictions[region_id]
			                    )
			                )
			    )
			
			-- ============================================================
			-- CALCULATE CHANGES
			-- ============================================================
			
			VAR _EnrichedData =
			    ADDCOLUMNS (
			        _ProductRegionData,
			
			        "@RevenueMoM",
			            [Revenue MoM %],
			
			        "@MarginGap",
			            IF (
			                NOT ISBLANK ( [@GrossMargin] )
			                    && NOT ISBLANK ( [@TargetMargin] ),
			                [@GrossMargin] - [@TargetMargin]
			            )
			    )
			
			-- ============================================================
			-- CRITICAL PRODUCTS
			-- Predicted high-risk OR normalized score >= 7.5
			-- ============================================================
			
			VAR _CriticalProducts =
			    FILTER (
			        _EnrichedData,
			        [@PredictedClass] = 2
			            || [@RiskScore] >= 7.5
			    )
			
			VAR _CriticalCount =
			    COUNTROWS ( _CriticalProducts )
			
			VAR _TopProducts =
			    TOPN (
			        5,
			        _CriticalProducts,
			        [@RiskScore], DESC,
			        [@Revenue], DESC
			    )
			
			VAR _BadgeText =
			    IF (
			        _CriticalCount > 5,
			
			        "Top 5 of "
			            & FORMAT (
			                _CriticalCount,
			                "#,0",
			                "de-DE"
			            )
			            & " critical",
			
			        FORMAT (
			            _CriticalCount,
			            "#,0",
			            "de-DE"
			        )
			            & " critical product"
			            & IF (
			                _CriticalCount = 1,
			                "",
			                "s"
			            )
			    )
			
			-- ============================================================
			-- CREATE HTML TABLE ROWS
			-- ============================================================
			
			VAR _RowsHTML =
			    CONCATENATEX (
			        _TopProducts,
			
			        VAR _SKU =
			            COALESCE (
			                [@SKU],
			                "—"
			            )
			
			        VAR _ProductName =
			            COALESCE (
			                [@ProductName],
			                "Unknown product"
			            )
			
			        VAR _Region =
			            COALESCE (
			                [@Region],
			                "—"
			            )
			
			        VAR _Lifecycle =
			            COALESCE (
			                [@Lifecycle],
			                "—"
			            )
			
			        VAR _RiskScore =
			            [@RiskScore]
			
			        VAR _Revenue =
			            [@Revenue]
			
			        VAR _RevenueMoM =
			            [@RevenueMoM]
			
			        VAR _Volatility =
			            [@Volatility]
			
			        VAR _Competition =
			            [@Competition]
			
			        VAR _MarginGap =
			            [@MarginGap]
			
			        -- ====================================================
			        -- DRIVER TAGS
			        -- ====================================================
			
			        VAR _DriverTable =
			            FILTER (
			                UNION (
			                    ROW (
			                        "Priority", 1,
			                        "Driver", "High sales volatility",
			                        "Show",
			                            NOT ISBLANK ( _Volatility )
			                                && _Volatility >= 0.20
			                    ),
			                    ROW (
			                        "Priority", 2,
			                        "Driver", "Recent sales drop",
			                        "Show",
			                            NOT ISBLANK ( _RevenueMoM )
			                                && _RevenueMoM < 0
			                    ),
			                    ROW (
			                        "Priority", 3,
			                        "Driver", "Margin below target",
			                        "Show",
			                            NOT ISBLANK ( _MarginGap )
			                                && _MarginGap < 0
			                    ),
			                    ROW (
			                        "Priority", 4,
			                        "Driver", "High competition",
			                        "Show",
			                            NOT ISBLANK ( _Competition )
			                                && _Competition >= 70
			                    )
			                ),
			                [Show]
			            )
			
			        VAR _TopDrivers =
			            TOPN (
			                2,
			                _DriverTable,
			                [Priority], ASC
			            )
			
			        VAR _DriverHTML =
			            IF (
			                COUNTROWS ( _TopDrivers ) = 0,
			
			                "Elevated model risk",
			
			                CONCATENATEX (
			                    _TopDrivers,
			                    [Driver],
			                    " · ",
			                    [Priority], ASC
			                )
			            )
			
			        -- ====================================================
			        -- FORMATTING
			        -- ====================================================
			
			        VAR _RiskWidth =
			            MIN (
			                100,
			                MAX (
			                    0,
			                    _RiskScore * 10
			                )
			            )
			
			        VAR _RiskFormatted =
			            IF (
			                ISBLANK ( _RiskScore ),
			                "—",
			                FORMAT (
			                    _RiskScore,
			                    "0.0",
			                    "de-DE"
			                )
			            )
			
			        VAR _RevenueFormatted =
			            SWITCH (
			                TRUE (),
			
			                ISBLANK ( _Revenue ),
			                    "—",
			
			                ABS ( _Revenue ) >= 1000000000,
			                    FORMAT (
			                        _Revenue / 1000000000,
			                        "€0.00",
			                        "de-DE"
			                    )
			                        & "B",
			
			                ABS ( _Revenue ) >= 1000000,
			                    FORMAT (
			                        _Revenue / 1000000,
			                        "€0.00",
			                        "de-DE"
			                    )
			                        & "M",
			
			                ABS ( _Revenue ) >= 1000,
			                    FORMAT (
			                        _Revenue / 1000,
			                        "€0.0",
			                        "de-DE"
			                    )
			                        & "K",
			
			                FORMAT (
			                    _Revenue,
			                    "€#,0",
			                    "de-DE"
			                )
			            )
			
			        VAR _ChangeText =
			            SWITCH (
			                TRUE (),
			
			                ISBLANK ( _RevenueMoM ),
			                    "No prior-month data",
			
			                _RevenueMoM > 0,
			                    "▲ "
			                        & FORMAT (
			                            _RevenueMoM,
			                            "0.0%",
			                            "de-DE"
			                        )
			                        & " vs PM",
			
			                _RevenueMoM < 0,
			                    "▼ "
			                        & FORMAT (
			                            ABS ( _RevenueMoM ),
			                            "0.0%",
			                            "de-DE"
			                        )
			                        & " vs PM",
			
			                "— 0.0% vs PM"
			            )
			
			        VAR _ChangeColor =
			            SWITCH (
			                TRUE (),
			                ISBLANK ( _RevenueMoM ), "#7A7480",
			                _RevenueMoM < 0, "#C53D3D",
			                _RevenueMoM > 0, "#2F855A",
			                "#7A7480"
			            )
			
			        RETURN
			            "
			            <div class='pa-row'>
			
			                <!-- PRODUCT -->
			
			                <div class='pa-product'>
			
			                    <span class='pa-sku'>"
			                        & _SKU &
			                    "</span>
			
			                    <span class='pa-name'>"
			                        & _ProductName &
			                    "</span>
			
			                </div>
			
			                <!-- REGION -->
			
			                <div class='pa-cell'>
			                    " & _Region & "
			                </div>
			
			                <!-- RISK -->
			
			                <div class='pa-risk'>
			
			                    <span class='pa-risk-number'>
			                        " & _RiskFormatted & "
			                    </span>
			
			                    <div class='pa-risk-track'>
			
			                        <div
			                            class='pa-risk-fill'
			                            style='width:"
			                                & FORMAT (
			                                    _RiskWidth,
			                                    "0"
			                                )
			                                & "%'>
			                        </div>
			
			                    </div>
			
			                    <span class='pa-risk-badge'>
			                        HIGH RISK
			                    </span>
			
			                </div>
			
			                <!-- REVENUE -->
			
			                <div class='pa-cell pa-number pa-revenue'>
			                    " & _RevenueFormatted & "
			                </div>
			
			                <!-- DRIVERS -->
			
			                <div class='pa-drivers'>
			                    " & _DriverHTML & "
			                </div>
			
			                <!-- LIFECYCLE -->
			
			                <div class='pa-cell pa-center'>
			                    " & _Lifecycle & "
			                </div>
			
			                <!-- LATEST CHANGE -->
			
			                <div
			                    class='pa-cell pa-change'
			                    style='color:"
			                        & _ChangeColor &
			                    "'>
			
			                    " & _ChangeText & "
			
			                </div>
			
			            </div>
			            ",
			
			        "",
			        [@RiskScore], DESC,
			        [@Revenue], DESC
			    )
			
			-- ============================================================
			-- FINAL HTML
			-- ============================================================
			
			RETURN
			
			IF (
			    ISBLANK ( _LatestMonth ),
			
			    "
			    <div style='
			        padding:12px;
			        color:#7A7480;
			        background:#FFFFFF;
			        border:1px solid #E2DEE4;
			        border-radius:8px;
			        font:11px Segoe UI,Arial,sans-serif;'>
			
			        No ML prediction month found
			
			    </div>
			    ",
			
			    IF (
			        _CriticalCount = 0,
			
			        "
			        <div style='
			            padding:12px;
			            color:#000000;
			            background:#FFFFFF;
			            border:1px solid #E2DEE4;
			            border-radius:8px;
			            font:11px Segoe UI,Arial,sans-serif;'>
			
			            Latest month: "
			                & _LatestMonthLabel
			                & "<br>
			
			            No products meet the high-risk criteria.
			
			        </div>
			        ",
			
			        "
			        <style>
			
			            /* =================================================
			               GLOBAL
			               ================================================= */
			
			            * {
			                box-sizing:border-box;
			                margin:0;
			                padding:0;
			                font-family:'Segoe UI',Arial,sans-serif;
			            }
			
			            /* =================================================
			               MAIN CONTAINER
			               ================================================= */
			
			            .pa-container {
			                width:100%;
			                overflow-x:auto;
			
			                background:#FFFFFF;
			
			                border:1px solid rgba(51,16,69,.14);
			                border-radius:5px;
			            }
			
			            /* =================================================
			               TITLE
			               ================================================= */
			
			            .pa-titlebar {
			                display:flex;
			                align-items:center;
			                gap:8px;
			
			                min-width:780px;
			
			                padding:5px;
			
			                border-bottom:1px solid #DDD8DF;
			            }
			
			            .pa-title {
			                color:#000000;
			
			                font-size:15px;
			                font-weight:700;
			
			                text-transform:uppercase;
			                white-space:nowrap;
			            }
			
			            .pa-count {
			                padding:2px 5px;
			
			                color:#C53D3D;
			                background:#FFF2F2;
			
			                border:1px solid #F1BABA;
			                border-radius:3px;
			
			                font-size:12px;
			                font-weight:600;
			
			                white-space:nowrap;
			            }
			
			            /* =================================================
			               TABLE GRID
			               ================================================= */
			
			            .pa-header,
			            .pa-row {
			                display:grid;
			
			                grid-template-columns:
			                    minmax(145px,1.30fr)
			                    minmax(70px,.65fr)
			                    minmax(145px,1.15fr)
			                    minmax(80px,.72fr)
			                    minmax(145px,1.30fr)
			                    minmax(75px,.65fr)
			                    minmax(120px,.95fr);
			
			                align-items:center;
			
			                min-width:780px;
			            }
			
			            /* =================================================
			               HEADER
			               ================================================= */
			
			            .pa-header {
			                min-height:24px;
			
			                color:#000000;
			                background:#F7F5F7;
			
			                border-bottom:1px solid #DDD8DF;
			
			                font-size:12px;
			                font-weight:700;
			            }
			
			            /*
			               ALL COLUMN HEADERS CENTERED
			            */
			
			            .pa-header > div {
			                text-align:center;
			            }
			
			            /* =================================================
			               COMMON CELL FORMATTING
			               ================================================= */
			
			            .pa-header > div,
			            .pa-row > div {
			                min-width:0;
			
			                padding:5px 7px;
			
			                border-right:1px solid #ECE8ED;
			            }
			
			            .pa-header > div:last-child,
			            .pa-row > div:last-child {
			                border-right:none;
			            }
			
			            /* =================================================
			               DATA ROWS
			               ================================================= */
			
			            .pa-row {
			                min-height:31px;
			
			                color:#26232A;
			
			                border-bottom:1px solid #EEEAEF;
			
			                font-size:11px;
			            }
			
			            .pa-row:last-child {
			                border-bottom:none;
			            }
			
			            .pa-row:nth-child(even) {
			                background:#FBFAFB;
			            }
			
			            .pa-row:hover {
			                background:#F4F0F6;
			            }
			
			            /* =================================================
			               PRODUCT
			               ================================================= */
			
			            .pa-product {
			                display:flex;
			                align-items:center;
			                gap:5px;
			
			                overflow:hidden;
			
			                white-space:nowrap;
			            }
			
			            .pa-sku {
			                flex-shrink:0;
			
			                color:#26232A;
			
			                font-weight:400;
			            }
			
			            .pa-name {
			                overflow:hidden;
			
			                color:#5F5962;
			
			                text-overflow:ellipsis;
			            }
			
			            /* =================================================
			               STANDARD CELLS
			               ================================================= */
			
			            .pa-cell {
			                overflow:hidden;
			
			                white-space:nowrap;
			                text-overflow:ellipsis;
			            }
			
			            .pa-number {
			                text-align:center;
			
			                font-variant-numeric:tabular-nums;
			            }
			
			            .pa-center {
			                text-align:center;
			            }
			
			            /* =================================================
			               RISK SCORE
			               ================================================= */
			
			            .pa-risk {
			                display:flex;
			                align-items:center;
			                gap:5px;
			
			                min-width:0;
			            }
			
			            .pa-risk-number {
			                width:24px;
			                flex-shrink:0;
			
			                color:#331045;
			
			                font-size:11px;
			                font-weight:400;
			
			                font-variant-numeric:tabular-nums;
			            }
			
			            .pa-risk-track {
			                position:relative;
			
			                height:11px;
			                min-width:35px;
			                flex:1;
			
			                overflow:hidden;
			
			                background:#E8E4E9;
			
			                border-radius:2px;
			            }
			
			            .pa-risk-fill {
			                height:100%;
			                min-width:3px;
			
			                background:linear-gradient(
			                    90deg,
			                    #C53D3D,
			                    #EB1717
			                );
			
			                border-radius:2px;
			            }
			
			            .pa-risk-badge {
			                flex-shrink:0;
			
			                padding:2px 4px;
			
			                color:#FFFFFF;
			                background:#D50000;
			
			                border-radius:3px;
			
			                font-size:11px;
			                font-weight:400;
			
			                white-space:nowrap;
			            }
			
			            /* =================================================
			               REVENUE
			               ================================================= */
			
			            .pa-revenue {
			                color:#26232A;
			
			                font-weight:400;
			
			                text-align:center;
			
			                font-variant-numeric:tabular-nums;
			            }
			
			            /* =================================================
			               DRIVERS
			               ================================================= */
			
			            .pa-drivers {
			                overflow:hidden;
			
			                color:#4F4952;
			
			                font-size:11px;
			
			                white-space:normal;
			            }
			
			            /* =================================================
			               LATEST CHANGE
			               ================================================= */
			
			            .pa-change {
			                overflow:hidden;
			
			                font-weight:400;
			
			                white-space:nowrap;
			                text-overflow:ellipsis;
			
			                font-variant-numeric:tabular-nums;
			            }
			
			        </style>
			
			        <div class='pa-container'>
			
			            <!-- =============================================
			                 TITLE
			                 ============================================= -->
			
			            <div class='pa-titlebar'>
			
			                <div class='pa-title'>
			                    Priority Actions
			                </div>
			
			                <div class='pa-count'>
			                    " & _BadgeText & "
			                </div>
			
			            </div>
			
			            <!-- =============================================
			                 COLUMN HEADERS
			                 ============================================= -->
			
			            <div class='pa-header'>
			
			                <div>
			                    Product
			                </div>
			
			                <div>
			                    Region
			                </div>
			
			                <div>
			                    Risk
			                </div>
			
			                <div>
			                    Revenue
			                </div>
			
			                <div>
			                    Primary Drivers
			                </div>
			
			                <div>
			                    Lifecycle
			                </div>
			
			                <div>
			                    Latest Change
			                </div>
			
			            </div>
			
			            <!-- =============================================
			                 DATA ROWS
			                 ============================================= -->
			
			            " & _RowsHTML & "
			
			        </div>
			        "
			    )
			)
			
			
			```
		displayFolder: 01 Risk
		lineageTag: fca3d0c2-7078-453f-98df-fb5154716b8f

	measure 'Europe Revenue Map HTML' = ```
			
			VAR _CountryRevenue =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER (
			                ALLSELECTED ( dimRegion[country] ),
			                NOT ISBLANK ( dimRegion[country] )
			            ),
			            "@CountryKey",
			                LOWER ( TRIM ( dimRegion[country] ) ),
			            "@RevenueValue",
			                CALCULATE ( [Revenue] )
			        ),
			        NOT ISBLANK ( [@RevenueValue] )
			    )
			
			-- Embedded Europe-only geometry. No external map service is required.
