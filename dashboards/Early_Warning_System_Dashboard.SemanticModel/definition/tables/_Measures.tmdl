		displayFolder: 01 Risk
		lineageTag: bd536f73-bedc-404c-ad3e-857a6389c9c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'HR KPI Card HTML' =
			
			
			-- ── REFERENCE DATES ────────────────────────────────────────────
			VAR _cur = MAX ( factMlPredictions[year_month] )
			VAR _pm  = EDATE ( _cur, -1 )
			VAR _lbl = FORMAT ( _cur, "MMMM YYYY" )
			
			-- ── CURRENT PERIOD ─────────────────────────────────────────────
			VAR _alerts =
			    CALCULATE (
			        COUNTROWS ( factMlPredictions ),
			        factMlPredictions[is_high_risk_alert] = 1,
			        factMlPredictions[year_month] = _cur
			    )
			VAR _total =
			    CALCULATE (
			        COUNTROWS ( factMlPredictions ),
			        factMlPredictions[year_month] = _cur
			    )
			VAR _rate  = DIVIDE ( _alerts, _total )
			VAR _score =
			    CALCULATE (
			        AVERAGE ( factMlPredictions[risk_score] ),
			        factMlPredictions[is_high_risk_alert] = 1,
			        factMlPredictions[year_month] = _cur
			    )
			VAR _rev =
			    CALCULATE (
			        SUM ( factMlPredictions[revenue] ),
			        factMlPredictions[is_high_risk_alert] = 1,
			        factMlPredictions[year_month] = _cur
			    )
			
			-- ── PREVIOUS MONTH ─────────────────────────────────────────────
			VAR _alerts_pm =
			    CALCULATE (
			        COUNTROWS ( factMlPredictions ),
			        factMlPredictions[is_high_risk_alert] = 1,
			        factMlPredictions[year_month] = _pm,
			        REMOVEFILTERS ( factMlPredictions[year_month] ),
			        REMOVEFILTERS ( dimDate )
			    )
			VAR _total_pm =
			    CALCULATE (
			        COUNTROWS ( factMlPredictions ),
			        factMlPredictions[year_month] = _pm,
			        REMOVEFILTERS ( factMlPredictions[year_month] ),
			        REMOVEFILTERS ( dimDate )
			    )
			VAR _rate_pm  = DIVIDE ( _alerts_pm, _total_pm )
			VAR _score_pm =
			    CALCULATE (
			        AVERAGE ( factMlPredictions[risk_score] ),
			        factMlPredictions[is_high_risk_alert] = 1,
			        factMlPredictions[year_month] = _pm,
			        REMOVEFILTERS ( factMlPredictions[year_month] ),
			        REMOVEFILTERS ( dimDate )
			    )
			VAR _rev_pm =
			    CALCULATE (
			        SUM ( factMlPredictions[revenue] ),
			        factMlPredictions[is_high_risk_alert] = 1,
			        factMlPredictions[year_month] = _pm,
			        REMOVEFILTERS ( factMlPredictions[year_month] ),
			        REMOVEFILTERS ( dimDate )
			    )
			
			-- ── DELTAS ─────────────────────────────────────────────────────
			VAR _da = _alerts - _alerts_pm
			VAR _dr = _rate   - _rate_pm
			VAR _ds = _score  - _score_pm
			VAR _dv = DIVIDE ( _rev - _rev_pm, _rev_pm )
			
			VAR _ca = IF ( _da > 0, "#E8433A", IF ( _da < 0, "#22C55E", "#666666" ) )
			VAR _cr = IF ( _dr > 0, "#E8433A", IF ( _dr < 0, "#22C55E", "#666666" ) )
			VAR _cs = IF ( _ds > 0, "#E8433A", IF ( _ds < 0, "#22C55E", "#666666" ) )
			VAR _cv = IF ( _dv > 0, "#E8433A", IF ( _dv < 0, "#22C55E", "#666666" ) )
			
			VAR _aa = IF ( _da > 0, "▲ ", IF ( _da < 0, "▼ ", "— " ) )
			VAR _ar = IF ( _dr > 0, "▲ ", IF ( _dr < 0, "▼ ", "— " ) )
			VAR _as = IF ( _ds > 0, "▲ ", IF ( _ds < 0, "▼ ", "— " ) )
			VAR _av = IF ( _dv > 0, "▲ ", IF ( _dv < 0, "▼ ", "— " ) )
			
			-- ── FORMATTED VALUES ───────────────────────────────────────────
			VAR _alerts_f = FORMAT ( _alerts, "#,0" )
			VAR _da_f     = _aa & FORMAT ( ABS ( _da ), "#,0" ) & " vs PM"
			
			VAR _rate_f   = FORMAT ( _rate, "0.0%" )
			VAR _dr_f     = _ar & FORMAT ( ABS ( _dr ) * 100, "0.1" ) & " pp vs PM"
			
			VAR _score_f  = FORMAT ( _score, "0.000" )
			VAR _ds_f     = _as & FORMAT ( ABS ( _ds ), "0.000" ) & " vs PM"
			
			VAR _rev_f    =
			    "€ " &
			    IF ( _rev >= 1000000, FORMAT ( _rev / 1000000, "0.0" ) & "M",
			    IF ( _rev >= 1000,    FORMAT ( _rev / 1000,    "0.0" ) & "K",
			                          FORMAT ( _rev, "#,0" ) ) )
			VAR _dv_f     = _av & FORMAT ( ABS ( _dv ), "0.0%" ) & " vs PM"
			
			-- ── HTML ───────────────────────────────────────────────────────
			RETURN
			"<style>
			*{box-sizing:border-box;margin:0;padding:0;font-family:'Segoe UI',Arial,sans-serif}
			body{background:transparent;padding:8px 0;color:#F0F0F5}
			.ttl{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#555;margin-bottom:8px;font-weight:600}
			.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
			.c{background:transparent;padding:6px 14px;border-left:3px solid}
			.ico{font-size:8px;margin-bottom:3px}
			.lbl{font-size:8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:2px}
			.val{font-size:20px;font-weight:700;letter-spacing:-.5px;line-height:1;margin-bottom:4px}
			.dlt{display:inline-block;font-size:9px;font-weight:600;padding:1px 6px;border-radius:3px;margin-bottom:3px}
			.sub{font-size:6px;color:#444;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			</style>
			<body>
			<div class='ttl'>High-Risk Products &middot; " & _lbl & "</div>
			<div class='grid'>
			<div class='c' style='border-color:#E8433A'>
			<div class='ico'>&#9888;</div>
			<div class='lbl' style='color:#E8433A'>High-Risk Alerts</div>
			<div class='val' style='color:#FFD0CC'>" & _alerts_f & "</div>
			<div class='dlt' style='background:" & _ca & "26;color:" & _ca & "'>" & _da_f & "</div>
			<div class='sub'>prod &times; region flagged</div>
			</div>
			<div class='c' style='border-color:#EF9F27'>
			<div class='ico'>&#9684;</div>
			<div class='lbl' style='color:#EF9F27'>Alert Rate</div>
			<div class='val' style='color:#FFE5B5'>" & _rate_f & "</div>
			<div class='dlt' style='background:" & _cr & "26;color:" & _cr & "'>" & _dr_f & "</div>
			<div class='sub'>of all combinations</div>
			</div>
			<div class='c' style='border-color:#8B5CF6'>
			<div class='ico'>&#9670;</div>
			<div class='lbl' style='color:#8B5CF6'>Avg Risk Score</div>
			<div class='val' style='color:#DDD4FF'>" & _score_f & "</div>
			<div class='dlt' style='background:" & _cs & "26;color:" & _cs & "'>" & _ds_f & "</div>
			<div class='sub'>high-risk rows only</div>
			</div>
			<div class='c' style='border-color:#F5A034'>
			<div class='ico'>&#8364;</div>
			<div class='lbl' style='color:#F5A034'>Revenue Under Watch</div>
			<div class='val' style='color:#FFE0B5'>" & _rev_f & "</div>
			<div class='dlt' style='background:" & _cv & "26;color:" & _cv & "'>" & _dv_f & "</div>
			<div class='sub'>at-risk revenue</div>
			</div>
			</div>
			</body>"
		displayFolder: 01 Risk
		lineageTag: db3cf39c-02ab-441e-813b-947f4f9dfdf1

	measure 'ML Model Performance HTML' =
			
			
			-- ── REFERENCE DATES ────────────────────────────────────────────
			VAR _cur = MAX ( factMlPredictions[year_month] )
			VAR _pm  = EDATE ( _cur, -1 )
			VAR _lbl = FORMAT ( _cur, "MMMM YYYY" )
			
			-- ── DATA SNAPSHOTS ─────────────────────────────────────────────
			-- Add split = "test" filter here if training rows are included in the table
			VAR _data_cur = CALCULATETABLE (
			    factMlPredictions,
			    factMlPredictions[year_month] = _cur,
			    REMOVEFILTERS ( factMlPredictions[year_month] ),
			    REMOVEFILTERS ( dimDate )
			)
			VAR _data_pm = CALCULATETABLE (
			    factMlPredictions,
			    factMlPredictions[year_month] = _pm,
			    REMOVEFILTERS ( factMlPredictions[year_month] ),
			    REMOVEFILTERS ( dimDate )
			)
			
			-- ── CONFUSION MATRIX BLOCKS (Current) ──────────────────────────
			-- TP: predicted high-risk AND actual was high-risk (alert fired, not a false alarm)
			-- FP: is_false_alarm  → predicted high-risk but actual was NOT high-risk
			-- FN: is_missed_high_risk → actual was high-risk but model did NOT flag it
			-- TN: all other rows (correctly predicted as non-high-risk)
			VAR _n_cur   = COUNTROWS ( _data_cur )
			VAR _tp_cur  = COUNTROWS ( FILTER ( _data_cur,
			                   factMlPredictions[is_high_risk_alert]  = 1 &&
			                   factMlPredictions[is_false_alarm]      = 0 ) )
			VAR _fp_cur  = COUNTROWS ( FILTER ( _data_cur, factMlPredictions[is_false_alarm]      = 1 ) )
			VAR _fn_cur  = COUNTROWS ( FILTER ( _data_cur, factMlPredictions[is_missed_high_risk] = 1 ) )
			VAR _tn_cur  = _n_cur - _tp_cur - _fp_cur - _fn_cur
			
			-- ── ACCURACY (Current) ─────────────────────────────────────────
			VAR _acc_cur = DIVIDE (
			    COUNTROWS ( FILTER ( _data_cur,
			        factMlPredictions[predicted_risk_label_num] = factMlPredictions[actual_risk_label_num] ) ),
			    _n_cur
			)
			
			-- ── MACRO F1 (Current) ─────────────────────────────────────────
			-- SUMX iterates over each distinct class label;
			-- VAR _c captures the current row value before entering the nested FILTER context
			VAR _classes_cur = DISTINCT (
			    SELECTCOLUMNS ( _data_cur, "cls", factMlPredictions[actual_risk_label_num] )
			)
			VAR _f1_cur = DIVIDE (
			    SUMX (
			        _classes_cur,
			        VAR _c  = [cls]
			        VAR _tp = COUNTROWS ( FILTER ( _data_cur,
			                      factMlPredictions[predicted_risk_label_num] = _c &&
			                      factMlPredictions[actual_risk_label_num]    = _c ) )
			        VAR _fp = COUNTROWS ( FILTER ( _data_cur,
			                      factMlPredictions[predicted_risk_label_num] = _c &&
			                      factMlPredictions[actual_risk_label_num]   <> _c ) )
			        VAR _fn = COUNTROWS ( FILTER ( _data_cur,
			                      factMlPredictions[actual_risk_label_num]    = _c &&
			                      factMlPredictions[predicted_risk_label_num] <> _c ) )
			        VAR _p  = DIVIDE ( _tp, _tp + _fp )
			        VAR _r  = DIVIDE ( _tp, _tp + _fn )
			        RETURN DIVIDE ( 2 * _p * _r, _p + _r, 0 )
			    ),
			    COUNTROWS ( _classes_cur )
			)
			
			-- ── HIGH-RISK RECALL / PRECISION / FAR / ALERT RATE (Current) ──
			VAR _recall_cur    = DIVIDE ( _tp_cur, _tp_cur + _fn_cur )
			VAR _prec_cur      = DIVIDE ( _tp_cur, _tp_cur + _fp_cur )
			VAR _far_cur       = DIVIDE ( _fp_cur, _fp_cur + _tn_cur )
			VAR _alert_cur     = DIVIDE ( _tp_cur + _fp_cur, _n_cur )
			
			-- ── SAME BLOCK FOR PREVIOUS MONTH ──────────────────────────────
			VAR _n_pm   = COUNTROWS ( _data_pm )
			VAR _tp_pm  = COUNTROWS ( FILTER ( _data_pm,
			                   factMlPredictions[is_high_risk_alert]  = 1 &&
			                   factMlPredictions[is_false_alarm]      = 0 ) )
			VAR _fp_pm  = COUNTROWS ( FILTER ( _data_pm, factMlPredictions[is_false_alarm]      = 1 ) )
			VAR _fn_pm  = COUNTROWS ( FILTER ( _data_pm, factMlPredictions[is_missed_high_risk] = 1 ) )
			VAR _tn_pm  = _n_pm - _tp_pm - _fp_pm - _fn_pm
			
			VAR _acc_pm = DIVIDE (
			    COUNTROWS ( FILTER ( _data_pm,
			        factMlPredictions[predicted_risk_label_num] = factMlPredictions[actual_risk_label_num] ) ),
			    _n_pm
			)
			VAR _classes_pm = DISTINCT (
			    SELECTCOLUMNS ( _data_pm, "cls", factMlPredictions[actual_risk_label_num] )
			)
			VAR _f1_pm = DIVIDE (
			    SUMX (
			        _classes_pm,
			        VAR _c  = [cls]
			        VAR _tp = COUNTROWS ( FILTER ( _data_pm,
			                      factMlPredictions[predicted_risk_label_num] = _c &&
			                      factMlPredictions[actual_risk_label_num]    = _c ) )
			        VAR _fp = COUNTROWS ( FILTER ( _data_pm,
			                      factMlPredictions[predicted_risk_label_num] = _c &&
			                      factMlPredictions[actual_risk_label_num]   <> _c ) )
			        VAR _fn = COUNTROWS ( FILTER ( _data_pm,
			                      factMlPredictions[actual_risk_label_num]    = _c &&
			                      factMlPredictions[predicted_risk_label_num] <> _c ) )
			        VAR _p  = DIVIDE ( _tp, _tp + _fp )
			        VAR _r  = DIVIDE ( _tp, _tp + _fn )
			        RETURN DIVIDE ( 2 * _p * _r, _p + _r, 0 )
			    ),
			    COUNTROWS ( _classes_pm )
			)
			VAR _recall_pm = DIVIDE ( _tp_pm, _tp_pm + _fn_pm )
			VAR _prec_pm   = DIVIDE ( _tp_pm, _tp_pm + _fp_pm )
			VAR _far_pm    = DIVIDE ( _fp_pm, _fp_pm + _tn_pm )
			VAR _alert_pm  = DIVIDE ( _tp_pm + _fp_pm, _n_pm )
			
			-- ── DELTAS ─────────────────────────────────────────────────────
			VAR _d_acc    = _acc_cur    - _acc_pm
			VAR _d_f1     = _f1_cur     - _f1_pm
			VAR _d_recall = _recall_cur - _recall_pm
			VAR _d_prec   = _prec_cur   - _prec_pm
			VAR _d_far    = _far_cur    - _far_pm
			VAR _d_alert  = _alert_cur  - _alert_pm
			
			-- ↑ good → green for performance metrics; ↑ bad → red for FAR + Alert Rate
			VAR _c_acc    = IF ( _d_acc    > 0, "#22C55E", IF ( _d_acc    < 0, "#EF4444", "#666" ) )
			VAR _c_f1     = IF ( _d_f1     > 0, "#22C55E", IF ( _d_f1     < 0, "#EF4444", "#666" ) )
			VAR _c_recall = IF ( _d_recall > 0, "#22C55E", IF ( _d_recall < 0, "#EF4444", "#666" ) )
			VAR _c_prec   = IF ( _d_prec   > 0, "#22C55E", IF ( _d_prec   < 0, "#EF4444", "#666" ) )
			VAR _c_far    = IF ( _d_far    > 0, "#EF4444", IF ( _d_far    < 0, "#22C55E", "#666" ) )
			VAR _c_alert  = IF ( _d_alert  > 0, "#EF4444", IF ( _d_alert  < 0, "#22C55E", "#666" ) )
			
			VAR _a_acc    = IF ( _d_acc    > 0, "▲ ", IF ( _d_acc    < 0, "▼ ", "— " ) )
			VAR _a_f1     = IF ( _d_f1     > 0, "▲ ", IF ( _d_f1     < 0, "▼ ", "— " ) )
			VAR _a_recall = IF ( _d_recall > 0, "▲ ", IF ( _d_recall < 0, "▼ ", "— " ) )
			VAR _a_prec   = IF ( _d_prec   > 0, "▲ ", IF ( _d_prec   < 0, "▼ ", "— " ) )
			VAR _a_far    = IF ( _d_far    > 0, "▲ ", IF ( _d_far    < 0, "▼ ", "— " ) )
			VAR _a_alert  = IF ( _d_alert  > 0, "▲ ", IF ( _d_alert  < 0, "▼ ", "— " ) )
			
			-- ── FORMATTED VALUES ───────────────────────────────────────────
			VAR _acc_f   = FORMAT ( _acc_cur,    "0.0%"  )
			VAR _f1_f    = FORMAT ( _f1_cur,     "0.000" )
			VAR _rec_f   = FORMAT ( _recall_cur, "0.0%"  )
			VAR _pre_f   = FORMAT ( _prec_cur,   "0.0%"  )
			VAR _far_f   = FORMAT ( _far_cur,    "0.0%"  )
			VAR _ar_f    = FORMAT ( _alert_cur,  "0.0%"  )
			
			VAR _dacc_f  = _a_acc    & FORMAT ( ABS ( _d_acc    ) * 100, "0.1" ) & " pp vs PM"
			VAR _df1_f   = _a_f1     & FORMAT ( ABS ( _d_f1     ),       "0.000") & " vs PM"
			VAR _drec_f  = _a_recall & FORMAT ( ABS ( _d_recall ) * 100, "0.1" ) & " pp vs PM"
			VAR _dpre_f  = _a_prec   & FORMAT ( ABS ( _d_prec   ) * 100, "0.1" ) & " pp vs PM"
			VAR _dfar_f  = _a_far    & FORMAT ( ABS ( _d_far    ) * 100, "0.1" ) & " pp vs PM"
			VAR _dar_f   = _a_alert  & FORMAT ( ABS ( _d_alert  ) * 100, "0.1" ) & " pp vs PM"
			
			-- ── HTML ───────────────────────────────────────────────────────
			RETURN
			"<style>
			*{box-sizing:border-box;margin:0;padding:0;font-family:'Segoe UI',Arial,sans-serif}
			body{background:transparent;padding:8px 0;color:#F0F0F5}
			.ttl{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#555;margin-bottom:8px;font-weight:600}
			.grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
			.c{background:transparent;padding:6px 10px;border-left:3px solid}
			.lbl{font-size:8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:2px}
			.val{font-size:18px;font-weight:700;letter-spacing:-.5px;line-height:1;margin-bottom:4px}
			.bot{display:flex;align-items:center;gap:4px;overflow:hidden}
			.dlt{font-size:8px;font-weight:600;padding:1px 5px;border-radius:3px;white-space:nowrap;flex-shrink:0}
			.sub{font-size:8px;color:#444;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			</style>
			<body>
			<div class='ttl'>Model Performance &middot; " & _lbl & "</div>
			<div class='grid'>
			<div class='c' style='border-color:#4ADE80'>
			<div class='lbl' style='color:#4ADE80'>Accuracy</div>
			<div class='val' style='color:#BBF7D0'>" & _acc_f & "</div>
			<div class='bot'><span class='dlt' style='background:" & _c_acc & "26;color:" & _c_acc & "'>" & _dacc_f & "</span><span class='sub'>all classes</span></div>
			</div>
			<div class='c' style='border-color:#34D399'>
			<div class='lbl' style='color:#34D399'>Macro F1</div>
			<div class='val' style='color:#A7F3D0'>" & _f1_f & "</div>
			<div class='bot'><span class='dlt' style='background:" & _c_f1 & "26;color:" & _c_f1 & "'>" & _df1_f & "</span><span class='sub'>avg 3 classes</span></div>
			</div>
			<div class='c' style='border-color:#38BDF8'>
			<div class='lbl' style='color:#38BDF8'>HR Recall</div>
			<div class='val' style='color:#BAE6FD'>" & _rec_f & "</div>
			<div class='bot'><span class='dlt' style='background:" & _c_recall & "26;color:" & _c_recall & "'>" & _drec_f & "</span><span class='sub'>TP / (TP+FN)</span></div>
			</div>
			<div class='c' style='border-color:#818CF8'>
			<div class='lbl' style='color:#818CF8'>HR Precision</div>
			<div class='val' style='color:#C7D2FE'>" & _pre_f & "</div>
			<div class='bot'><span class='dlt' style='background:" & _c_prec & "26;color:" & _c_prec & "'>" & _dpre_f & "</span><span class='sub'>TP / (TP+FP)</span></div>
			</div>
			<div class='c' style='border-color:#FB923C'>
			<div class='lbl' style='color:#FB923C'>False Alarm</div>
			<div class='val' style='color:#FED7AA'>" & _far_f & "</div>
			<div class='bot'><span class='dlt' style='background:" & _c_far & "26;color:" & _c_far & "'>" & _dfar_f & "</span><span class='sub'>FP / (FP+TN)</span></div>
			</div>
			<div class='c' style='border-color:#94A3B8'>
			<div class='lbl' style='color:#94A3B8'>Alert Rate</div>
			<div class='val' style='color:#CBD5E1'>" & _ar_f & "</div>
			<div class='bot'><span class='dlt' style='background:" & _c_alert & "26;color:" & _c_alert & "'>" & _dar_f & "</span><span class='sub'>flagged / total</span></div>
			</div>
			</div>
			</body>"
		displayFolder: 06 Model Performance
		lineageTag: 5e941e49-5559-4c09-9d4b-748a6bffba83

	measure 'DQ Feature Card HTML' =
			
			
			-- ── REFERENCE DATES ────────────────────────────────────────────
			VAR _cur = MAX ( factMlPredictions[year_month] )
			VAR _pm  = EDATE ( _cur, -1 )
			VAR _lbl = FORMAT ( _cur, "MMMM YYYY" )
			
			-- ── DATA SNAPSHOTS ─────────────────────────────────────────────
			VAR _data_cur = CALCULATETABLE (
			    factMlPredictions,
			    factMlPredictions[year_month] = _cur,
			    REMOVEFILTERS ( factMlPredictions[year_month] ),
			    REMOVEFILTERS ( dimDate )
			)
			VAR _data_pm = CALCULATETABLE (
			    factMlPredictions,
			    factMlPredictions[year_month] = _pm,
			    REMOVEFILTERS ( factMlPredictions[year_month] ),
			    REMOVEFILTERS ( dimDate )
			)
			
			-- ── M1 · FEATURE DATASET ROWS ──────────────────────────────────
			VAR _rows_cur = COUNTROWS ( _data_cur )
			VAR _rows_pm  = COUNTROWS ( _data_pm )
			VAR _d_rows   = _rows_cur - _rows_pm
			
			-- ── M2 · ML FEATURE COUNT (static) ────────────────────────────
			-- Adjust this constant if your feature set changes after retraining
			VAR _feat_n   = 27
			
			-- ── M3 · ENRICHMENT JOIN COVERAGE ─────────────────────────────
			-- A row is "covered" when its product_id exists in dimProduct
			-- AND its region_id exists in dimRegion
			VAR _joined_cur = COUNTROWS ( FILTER (
			    _data_cur,
			    NOT ISBLANK ( LOOKUPVALUE (
			        dimProduct[product_id], dimProduct[product_id],
			        factMlPredictions[product_id] ) ) &&
			    NOT ISBLANK ( LOOKUPVALUE (
			        dimRegion[region_id], dimRegion[region_id],
			        factMlPredictions[region_id] ) )
			) )
			VAR _cov_cur    = DIVIDE ( _joined_cur, _rows_cur )
			
			VAR _joined_pm  = COUNTROWS ( FILTER (
			    _data_pm,
			    NOT ISBLANK ( LOOKUPVALUE (
			        dimProduct[product_id], dimProduct[product_id],
			        factMlPredictions[product_id] ) ) &&
			    NOT ISBLANK ( LOOKUPVALUE (
			        dimRegion[region_id], dimRegion[region_id],
			        factMlPredictions[region_id] ) )
			) )
			VAR _cov_pm     = DIVIDE ( _joined_pm, _rows_pm )
			VAR _d_cov      = _cov_cur - _cov_pm
			
			-- ── M4 · DUPLICATE COMPOSITE KEYS ─────────────────────────────
			-- Grain per month = (product_id × region_id)
			-- Extra rows = total rows − count of distinct key pairs
			VAR _distinct_cur = COUNTROWS ( SUMMARIZE (
			    _data_cur,
			    factMlPredictions[product_id],
			    factMlPredictions[region_id]
			) )
			VAR _dupes_cur    = _rows_cur - _distinct_cur
			
			VAR _distinct_pm  = COUNTROWS ( SUMMARIZE (
			    _data_pm,
			    factMlPredictions[product_id],
			    factMlPredictions[region_id]
			) )
			VAR _dupes_pm     = _rows_pm - _distinct_pm
			VAR _d_dupes      = _dupes_cur - _dupes_pm
			
			-- ── M5 · MISSING ENRICHMENT VALUES ─────────────────────────────
			-- Rows with at least one blank across the key enrichment columns.
			-- Extend this list if you add new enrichment sources.
			VAR _miss_cur = COUNTROWS ( FILTER (
			    _data_cur,
			    ISBLANK ( factMlPredictions[product_line]           ) || factMlPredictions[product_line]       = "" ||
			    ISBLANK ( factMlPredictions[product_category]       ) || factMlPredictions[product_category]   = "" ||
			    ISBLANK ( factMlPredictions[lifecycle_stage]        ) || factMlPredictions[lifecycle_stage]    = "" ||
			    ISBLANK ( factMlPredictions[market_demand_index]    ) ||
			    ISBLANK ( factMlPredictions[market_tailwind_score]  )
			) )
			VAR _miss_pm  = COUNTROWS ( FILTER (
			    _data_pm,
			    ISBLANK ( factMlPredictions[product_line]           ) || factMlPredictions[product_line]       = "" ||
			    ISBLANK ( factMlPredictions[product_category]       ) || factMlPredictions[product_category]   = "" ||
			    ISBLANK ( factMlPredictions[lifecycle_stage]        ) || factMlPredictions[lifecycle_stage]    = "" ||
			    ISBLANK ( factMlPredictions[market_demand_index]    ) ||
			    ISBLANK ( factMlPredictions[market_tailwind_score]  )
			) )
			VAR _d_miss   = _miss_cur - _miss_pm
			
			-- ── DELTA COLORS ───────────────────────────────────────────────
			-- Rows:     ↑ = more data = green  |  ↓ = data loss = red
			VAR _c_rows  = IF ( _d_rows  > 0, "#22C55E", IF ( _d_rows  < 0, "#EF4444", "#666" ) )
			VAR _a_rows  = IF ( _d_rows  > 0, "▲ ",      IF ( _d_rows  < 0, "▼ ",      "— "   ) )
			
			-- Coverage:  ↑ = green  |  ↓ = red
			VAR _c_cov   = IF ( _d_cov   > 0, "#22C55E", IF ( _d_cov   < 0, "#EF4444", "#666" ) )
			VAR _a_cov   = IF ( _d_cov   > 0, "▲ ",      IF ( _d_cov   < 0, "▼ ",      "— "   ) )
			
			-- Dupes:   0 = clean (green badge);  ↑ = worse (red);  ↓ = improving (green)
			VAR _c_dupes = IF ( _dupes_cur = 0, "#22C55E",
			               IF ( _d_dupes > 0,   "#EF4444",
			               IF ( _d_dupes < 0,   "#22C55E", "#666" ) ) )
			
			-- Missing: 0 = clean (green badge);  ↑ = worse (red);  ↓ = improving (green)
			VAR _c_miss  = IF ( _miss_cur  = 0, "#22C55E",
			               IF ( _d_miss  > 0,   "#EF4444",
			               IF ( _d_miss  < 0,   "#22C55E", "#666" ) ) )
			
			-- ── FORMATTED VALUES ───────────────────────────────────────────
			VAR _rows_f  = FORMAT ( _rows_cur,  "#,0" )
			VAR _drows_f = _a_rows & FORMAT ( ABS ( _d_rows ), "#,0" ) & " vs PM"
			
			VAR _feat_f  = FORMAT ( _feat_n, "#,0" )
			
			VAR _cov_f   = FORMAT ( _cov_cur, "0.0%" )
			VAR _dcov_f  = _a_cov & FORMAT ( ABS ( _d_cov ) * 100, "0.1" ) & " pp vs PM"
			
			VAR _dup_f   = FORMAT ( _dupes_cur, "#,0" )
			VAR _ddup_f  = IF ( _dupes_cur = 0,
			    "&#10003; clean",
			    IF ( _d_dupes > 0, "▲ ", IF ( _d_dupes < 0, "▼ ", "— " ) )
			        & FORMAT ( ABS ( _d_dupes ), "#,0" ) & " vs PM"
			)
			
			VAR _mis_f   = FORMAT ( _miss_cur, "#,0" )
			VAR _dmis_f  = IF ( _miss_cur = 0,
			    "&#10003; clean",
			    IF ( _d_miss > 0, "▲ ", IF ( _d_miss < 0, "▼ ", "— " ) )
			        & FORMAT ( ABS ( _d_miss ), "#,0" ) & " vs PM"
			)
			
			-- ── HTML ───────────────────────────────────────────────────────
			RETURN
			"<style>
			*{box-sizing:border-box;margin:0;padding:0;font-family:'Segoe UI',Arial,sans-serif}
			body{background:transparent;padding:8px 0;color:#F0F0F5}
			.ttl{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#555;margin-bottom:8px;font-weight:600}
			.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
			.c{background:transparent;padding:6px 10px;border-left:3px solid}
			.lbl{font-size:8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:2px}
			.val{font-size:20px;font-weight:700;letter-spacing:-.5px;line-height:1;margin-bottom:4px}
			.bot{display:flex;align-items:center;gap:4px;overflow:hidden}
			.dlt{font-size:8px;font-weight:600;padding:1px 5px;border-radius:3px;white-space:nowrap;flex-shrink:0}
			.sub{font-size:8px;color:#444;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			</style>
			<body>
			<div class='ttl'>ML Feature Quality &middot; " & _lbl & "</div>
			<div class='grid'>
			
			<div class='c' style='border-color:#60A5FA'>
			<div class='lbl' style='color:#60A5FA'>Dataset Rows</div>
			<div class='val' style='color:#BFDBFE'>" & _rows_f & "</div>
			<div class='bot'>
			<span class='dlt' style='background:" & _c_rows & "26;color:" & _c_rows & "'>" & _drows_f & "</span>
			<span class='sub'>current month</span>
			</div></div>
			
			<div class='c' style='border-color:#A78BFA'>
			<div class='lbl' style='color:#A78BFA'>ML Features</div>
			<div class='val' style='color:#EDE9FE'>" & _feat_f & "</div>
			<div class='bot'>
			<span class='dlt' style='background:#66666626;color:#666'>&#8212; stable</span>
			<span class='sub'>input columns</span>
			</div></div>
			
			<div class='c' style='border-color:#34D399'>
			<div class='lbl' style='color:#34D399'>Join Coverage</div>
			<div class='val' style='color:#D1FAE5'>" & _cov_f & "</div>
			<div class='bot'>
			<span class='dlt' style='background:" & _c_cov & "26;color:" & _c_cov & "'>" & _dcov_f & "</span>
			<span class='sub'>dim match rate</span>
			</div></div>
			
			<div class='c' style='border-color:#F87171'>
			<div class='lbl' style='color:#F87171'>Duplicate Keys</div>
			<div class='val' style='color:#FEE2E2'>" & _dup_f & "</div>
			<div class='bot'>
			<span class='dlt' style='background:" & _c_dupes & "26;color:" & _c_dupes & "'>" & _ddup_f & "</span>
			<span class='sub'>extra rows</span>
			</div></div>
			
			<div class='c' style='border-color:#FBBF24'>
			<div class='lbl' style='color:#FBBF24'>Missing Values</div>
			<div class='val' style='color:#FEF3C7'>" & _mis_f & "</div>
			<div class='bot'>
			<span class='dlt' style='background:" & _c_miss & "26;color:" & _c_miss & "'>" & _dmis_f & "</span>
			<span class='sub'>enrichment fields</span>
			</div></div>
			
			</div>
			</body>"
		displayFolder: 07 Data Quality
		lineageTag: feaf9dbd-d596-4f4c-a1b5-7b836d18ae89

	measure 'Risk KPI Card HTML 2' =
			
			VAR _CurrentMonth =
			    MAX ( factMlPredictions[year_month] )
			
			VAR _HighRiskProducts =
			    COALESCE (
			        CALCULATE (
			            [High Risk Products],
			            KEEPFILTERS (
			                factMlPredictions[year_month] = _CurrentMonth
			            )
			        ),
			        0
			    )
			
			VAR _HighRiskAlerts =
			    COALESCE (
			        CALCULATE (
			            [High Risk Alerts],
			            KEEPFILTERS (
			                factMlPredictions[year_month] = _CurrentMonth
			            )
			        ),
			        0
			    )
			
			VAR _AlertRate =
			    COALESCE (
			        CALCULATE (
			            [High Risk Alert Rate],
			            KEEPFILTERS (
			                factMlPredictions[year_month] = _CurrentMonth
			            )
			        ),
			        0
			    )
			
			VAR _AverageRiskScore =
			    COALESCE (
			        CALCULATE (
			            [Average Risk Score],
			            KEEPFILTERS (
			                factMlPredictions[year_month] = _CurrentMonth
			            )
			        ),
			        0
			    )
			
			VAR _RevenueUnderWatch =
			    COALESCE (
			        CALCULATE (
			            [Current Revenue Under Watch],
			            KEEPFILTERS (
			                factMlPredictions[year_month] = _CurrentMonth
			            )
			        ),
			        0
			    )
			
			VAR _PeriodLabel =
			    FORMAT ( _CurrentMonth, "MMMM yyyy" )
			
			VAR _ProductsFormatted =
			    FORMAT ( _HighRiskProducts, "#,0" )
			
			VAR _AlertsFormatted =
			    FORMAT ( _HighRiskAlerts, "#,0" )
			
			VAR _RateFormatted =
			    FORMAT ( _AlertRate, "0.0%" )
			
			VAR _ScoreFormatted =
			    FORMAT ( _AverageRiskScore, "0.0" )
			
			VAR _RevenueFormatted =
			    SWITCH (
			        TRUE (),
			        ABS ( _RevenueUnderWatch ) >= 1000000000,
			            "€ " & FORMAT ( DIVIDE ( _RevenueUnderWatch, 1000000000 ), "0.0" ) & "B",
			        ABS ( _RevenueUnderWatch ) >= 1000000,
			            "€ " & FORMAT ( DIVIDE ( _RevenueUnderWatch, 1000000 ), "0.0" ) & "M",
			        ABS ( _RevenueUnderWatch ) >= 1000,
			            "€ " & FORMAT ( DIVIDE ( _RevenueUnderWatch, 1000 ), "0.0" ) & "K",
			        "€ " & FORMAT ( _RevenueUnderWatch, "#,0" )
			    )
			
			RETURN
			IF (
			    ISBLANK ( _CurrentMonth ),
			    "
			    <div style='
			        font-family:Segoe UI,Arial,sans-serif;
			        padding:20px;
			        color:#94A3B8;
			        text-align:center;'>
			        No risk data available
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			        }
			
			        .risk-wrapper {
			            width:100%;
			            padding:0
			            font-family:'Segoe UI',Arial,sans-serif;
			            color:#F8FAFC;
			            background:transparent;
			            border:none;
			            border-radius:0;
			        }
			
			        .risk-title {
			            font-size:12px;
			            font-weight:700;
			            letter-spacing:.08em;
			            text-transform:uppercase;
			            color:#CBD5E1;
			        }
			
			        .risk-period {
			            padding:4px 9px;
			            font-size:10px;
			            font-weight:600;
			            color:#C4B5FD;
			            background:#8B5CF622;
			            border:1px solid #8B5CF655;
			            border-radius:20px;
			        }
			
			        .risk-grid {
			            display:grid;
			            grid-template-columns:repeat(5,minmax(0,1fr));
			            gap:6px;
			        }
			
			        .risk-card {
			            position:relative;
			            min-width:0;
			            padding:9px 12px 8px;
			            overflow:hidden;
			            background: transparent;
			            border:1px solid rgba(148,163,184,.18);
			            border-radius:8px;
			        }
			
			        .risk-accent {
			            position:absolute;
			            top:0;
			            left:0;
			            width:100%;
			            height:3px;
			        }
			
			        .risk-label {
			            min-height:20px;
			            margin-bottom:4px;
			            font-size:8px;
			            line-height:1.2;
			            font-weight:700;
			            letter-spacing:.05em;
			            text-transform:uppercase;
			            color:#94A3B8;
			        }
			
			        .risk-value {
			            margin-bottom:4px;
			            overflow:hidden;
			            font-size:clamp(18px,1.8vw,26px);
			            line-height:1;
			            font-weight:750;
			            letter-spacing:-.03em;
			            color:#F8FAFC;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .risk-meta {
			            overflow:hidden;
			            font-size:7px;
			            line-height:1.15;
			            color:#64748B;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        @media(max-width:850px) {
			            .risk-grid {
			                grid-template-columns:repeat(2,minmax(0,1fr));
			            }
			        }
			    </style>
			
			    <div class='risk-wrapper'>
			        <div class='risk-grid'>
			
			            <div class='risk-card'>
			                <div class='risk-accent'
			                     style='background:#EF4444'></div>
			                <div class='risk-label'>
			                    High-Risk Products
			                </div>
			                <div class='risk-value'
			                     style='color:#FCA5A5'>
			                    " & _ProductsFormatted & "
			                </div>
			                <div class='risk-meta'>
			                    Distinct flagged products
			                </div>
			            </div>
			
			            <div class='risk-card'>
			                <div class='risk-accent'
			                     style='background:#F97316'></div>
			                <div class='risk-label'>
			                    High-Risk Alerts
			                </div>
			                <div class='risk-value'
			                     style='color:#FDBA74'>
			                    " & _AlertsFormatted & "
			                </div>
			                <div class='risk-meta'>
			                    Product × region alerts
			                </div>
			            </div>
			
			            <div class='risk-card'>
			                <div class='risk-accent'
			                     style='background:#F59E0B'></div>
			                <div class='risk-label'>
			                    High-Risk Alert Rate
			                </div>
			                <div class='risk-value'
			                     style='color:#FCD34D'>
			                    " & _RateFormatted & "
			                </div>
			                <div class='risk-meta'>
			                    Alerts / assessed records
			                </div>
			            </div>
			
			            <div class='risk-card'>
			                <div class='risk-accent'
			                     style='background:#8B5CF6'></div>
			                <div class='risk-label'>
			                    Average Risk Score
			                </div>
			                <div class='risk-value'
			                     style='color:#C4B5FD'>
			                    " & _ScoreFormatted & "
			                </div>
			                <div class='risk-meta'>
			                    Portfolio average · 0–10
			                </div>
			            </div>
			
			            <div class='risk-card'>
			                <div class='risk-accent'
			                     style='background:#38BDF8'></div>
			                <div class='risk-label'>
			                    Current Revenue Under Watch
			                </div>
			                <div class='risk-value'
			                     style='color:#7DD3FC'>
			                    " & _RevenueFormatted & "
			                </div>
			                <div class='risk-meta'>
			                    Revenue linked to alerts
			                </div>
			            </div>
			
			        </div>
			    </div>
			    "
			)
		displayFolder: 01 Risk
		lineageTag: 3fbd944e-cec9-414d-803d-f3919ed41bcc

	measure 'DQ Card HTML' =
			
			VAR _CurrentMonth =
			    MAX ( factMlPredictions[year_month] )
			
			VAR _CurrentData =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS ( dimDate ),
			        REMOVEFILTERS ( factMlPredictions[year_month] ),
			        factMlPredictions[year_month] = _CurrentMonth
			    )
			
			-- KPI 1: Feature Dataset Rows
			VAR _DatasetRows =
			    COUNTROWS ( _CurrentData )
			
			-- KPI 2: ML Feature Count
			-- Update this value when the model feature set changes
			VAR _FeatureCount =
			    27
			
			-- The five fields monitored as enrichment fields
			VAR _CoveredRows =
			    COUNTROWS (
			        FILTER (
			            _CurrentData,
			            NOT ISBLANK ( factMlPredictions[product_line] )
			                && factMlPredictions[product_line] <> ""
			                && NOT ISBLANK ( factMlPredictions[product_category] )
			                && factMlPredictions[product_category] <> ""
			                && NOT ISBLANK ( factMlPredictions[lifecycle_stage] )
			                && factMlPredictions[lifecycle_stage] <> ""
			                && NOT ISBLANK ( factMlPredictions[market_demand_index] )
			                && NOT ISBLANK ( factMlPredictions[market_tailwind_score] )
			        )
			    )
			
			-- KPI 3: Enrichment Join Coverage
			VAR _JoinCoverage =
			    DIVIDE ( _CoveredRows, _DatasetRows, 0 )
			
			-- KPI 4: Duplicate Composite Keys
			-- Expected grain: month × product × region
			VAR _DistinctCompositeKeys =
			    COUNTROWS (
			        SUMMARIZE (
			            _CurrentData,
			            factMlPredictions[product_id],
			            factMlPredictions[region_id]
			        )
			    )
			
			VAR _DuplicateCompositeKeys =
			    MAX ( 0, _DatasetRows - _DistinctCompositeKeys )
			
			-- KPI 5: Individual missing values across enrichment fields
			VAR _MissingEnrichmentValues =
			    SUMX (
			        _CurrentData,
			        IF (
			            ISBLANK ( factMlPredictions[product_line] )
			                || factMlPredictions[product_line] = "",
			            1,
			            0
			        )
			        +
			        IF (
			            ISBLANK ( factMlPredictions[product_category] )
			                || factMlPredictions[product_category] = "",
			            1,
			            0
			        )
			        +
			        IF (
			            ISBLANK ( factMlPredictions[lifecycle_stage] )
			                || factMlPredictions[lifecycle_stage] = "",
			            1,
			            0
			        )
			        +
			        IF (
			            ISBLANK ( factMlPredictions[market_demand_index] ),
			            1,
			            0
			        )
			        +
			        IF (
			            ISBLANK ( factMlPredictions[market_tailwind_score] ),
			            1,
			            0
			        )
			    )
			
			VAR _MonitoredValueCount =
			    _DatasetRows * 5
			
			VAR _MissingValueRate =
			    DIVIDE (
			        _MissingEnrichmentValues,
			        _MonitoredValueCount,
			        0
			    )
			
			-- Dynamic status colors
			VAR _CoverageColor =
			    SWITCH (
			        TRUE (),
			        _JoinCoverage >= 1,    "#2F855A",
			        _JoinCoverage >= 0.99, "#D99A2B",
			        "#C53D3D"
			    )
			
			VAR _DuplicateColor =
			    IF (
			        _DuplicateCompositeKeys = 0,
			        "#2F855A",
			        "#C53D3D"
			    )
			
			VAR _MissingColor =
			    SWITCH (
			        TRUE (),
			        _MissingEnrichmentValues = 0, "#2F855A",
			        _MissingValueRate < 0.01,      "#D99A2B",
			        "#C53D3D"
			    )
			
			-- Formatted values
			VAR _RowsFormatted =
			    FORMAT ( _DatasetRows, "#,0","de-DE" )
			
			VAR _FeaturesFormatted =
			    FORMAT ( _FeatureCount, "#,0","de-DE" )
			
			VAR _CoverageFormatted =
			    FORMAT ( _JoinCoverage, "0.0%","de-DE" )
			
			VAR _DuplicatesFormatted =
			    FORMAT ( _DuplicateCompositeKeys, "#,0","de-DE" )
			
			VAR _MissingFormatted =
			    FORMAT ( _MissingEnrichmentValues, "#,0","de-DE" )
			
			VAR _PeriodFormatted =
			    FORMAT ( _CurrentMonth, "MMM yyyy" )
			
			VAR _CoverageMeta =
			    FORMAT ( _CoveredRows, "#,0","de-DE" )
			        & " of "
			        & FORMAT ( _DatasetRows, "#,0","de-DE" )
			        & " rows complete"
			
			VAR _DuplicateMeta =
			    IF (
			        _DuplicateCompositeKeys = 0,
			        "Composite keys are unique",
			        "Rows above expected grain"
			    )
			
			VAR _MissingMeta =
			    IF (
			        _MissingEnrichmentValues = 0,
			        "No missing enrichment values",
			        FORMAT ( _MissingValueRate, "0.0%","de-DE" )
			            & " of monitored values"
			    )
			
			RETURN
			IF (
			    ISBLANK ( _CurrentMonth ),
			    "
			    <div style='
			        font-family:Segoe UI,Arial,sans-serif;
			        color:#7A7480;
			        padding:8px;
			        background:#FFFFFF;'>
			        No data available
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .dq-grid {
			            display:grid;
			            grid-template-columns:repeat(5,minmax(0,1fr));
			            gap:6px;
			            width:100%;
			            background:transparent;
			        }
			
			        .dq-card {
			            position:relative;
			            min-width:0;
			            padding:9px 12px 8px;
			            overflow:hidden;
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.14);
			            border-radius:5px;
			        }
			
			        .dq-accent {
			            position:absolute;
			            top:0;
			            left:0;
			            width:100%;
			            height:3px;
			        }
			
			        .dq-label {
			            min-height:20px;
			            margin-bottom:4px;
			            font-size:10px;
			            font-weight:700;
			            letter-spacing:.05em;
			            text-transform:uppercase;
			            color:#000000;
			        }
			
			        .dq-value {
			            margin-bottom:4px;
			            overflow:hidden;
			            font-size:clamp(18px,1.8vw,26px);
			            line-height:1;
			            font-weight:700;
			            letter-spacing:-.03em;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .dq-meta {
			            overflow:hidden;
			            font-size:10px;
			            color:#7A7480;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        @media(max-width:850px) {
			            .dq-grid {
			                grid-template-columns:repeat(2,minmax(0,1fr));
			            }
			        }
			    </style>
			
			    <div class='dq-grid'>
			
			        <div class='dq-card'>
			            <div class='dq-accent'
			                 style='background:#331045'></div>
			            <div class='dq-label'>
			                Feature Dataset
			            </div>
			            <div class='dq-value'
			                 style='color:#331045'>
			                " & _RowsFormatted & "
			            </div>
			            <div class='dq-meta'>
			                model-ready rows
			            </div>
			        </div>
			
			        <div class='dq-card'>
			            <div class='dq-accent'
			                 style='background:#6F4A7C'></div>
			            <div class='dq-label'>
			                ML features
			            </div>
			            <div class='dq-value'
			                 style='color:#6F4A7C'>
			                " & _FeaturesFormatted & "
			            </div>
			            <div class='dq-meta'>
			                Configured inputs
			            </div>
			        </div>
			
			        <div class='dq-card'>
			            <div class='dq-accent'
			                 style='background:" & _CoverageColor & "'></div>
			            <div class='dq-label'>
			                Enrichment Join Coverage
			            </div>
			            <div class='dq-value'
			                 style='color:" & _CoverageColor & "'>
			                " & _CoverageFormatted & "
			            </div>
			            <div class='dq-meta'>
			                " & _CoverageMeta & "
			            </div>
			        </div>
			
			        <div class='dq-card'>
			            <div class='dq-accent'
			                 style='background:" & _DuplicateColor & "'></div>
			            <div class='dq-label'>
			                Duplicate Composite Keys
			            </div>
			            <div class='dq-value'
			                 style='color:" & _DuplicateColor & "'>
			                " & _DuplicatesFormatted & "
			            </div>
			            <div class='dq-meta'>
			                " & _DuplicateMeta & "
			            </div>
			        </div>
			
			        <div class='dq-card'>
			            <div class='dq-accent'
			                 style='background:" & _MissingColor & "'></div>
			            <div class='dq-label'>
			                Missing Enrichment Values
			            </div>
			            <div class='dq-value'
			                 style='color:" & _MissingColor & "'>
			                " & _MissingFormatted & "
			            </div>
			            <div class='dq-meta'>
			                " & _MissingMeta & "
			            </div>
			        </div>
			
			    </div>
			    "
			)
		displayFolder: 07 Data Quality
		lineageTag: 0f4869b5-75cd-4b76-847b-76f50eb83500

	measure 'ML Performance HTML' =
			
			VAR _CurrentMonth =
			    MAX ( factMlPredictions[year_month] )
			
			VAR _PreviousMonth =
			    EDATE ( _CurrentMonth, -1 )
			
			VAR _HighRiskClass =
			    2
			
			VAR _Classes =
			    DATATABLE (
			        "ClassID", INTEGER,
			        {
			            { 0 },
			            { 1 },
			            { 2 }
			        }
			    )
			
			-- Current-month snapshot
			VAR _CurrentData =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS ( dimDate ),
			        FILTER (
			            ALL ( factMlPredictions[year_month] ),
			            factMlPredictions[year_month] = _CurrentMonth
			        )
			    )
			
			-- Previous-month snapshot
			VAR _PreviousData =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS ( dimDate ),
			        FILTER (
			            ALL ( factMlPredictions[year_month] ),
			            factMlPredictions[year_month] = _PreviousMonth
			        )
			    )
			
			VAR _CurrentRows =
			    COUNTROWS ( _CurrentData )
			
			VAR _PreviousRows =
			    COUNTROWS ( _PreviousData )
			
			VAR _HasPreviousMonth =
			    _PreviousRows > 0
			
			-- Current confusion matrix: high risk vs. all other classes
			VAR _TPCurrent =
			    COUNTROWS (
			        FILTER (
			            _CurrentData,
			            factMlPredictions[actual_risk_label_num] = _HighRiskClass
			                && factMlPredictions[predicted_risk_label_num] = _HighRiskClass
			        )
			    )
			
			VAR _FPCurrent =
			    COUNTROWS (
			        FILTER (
			            _CurrentData,
			            factMlPredictions[actual_risk_label_num] <> _HighRiskClass
			                && factMlPredictions[predicted_risk_label_num] = _HighRiskClass
			        )
			    )
			
			VAR _FNCurrent =
			    COUNTROWS (
			        FILTER (
			            _CurrentData,
			            factMlPredictions[actual_risk_label_num] = _HighRiskClass
			                && factMlPredictions[predicted_risk_label_num] <> _HighRiskClass
			        )
			    )
			
			VAR _TNCurrent =
			    COUNTROWS (
			        FILTER (
			            _CurrentData,
			            factMlPredictions[actual_risk_label_num] <> _HighRiskClass
			                && factMlPredictions[predicted_risk_label_num] <> _HighRiskClass
			        )
			    )
			
			-- Previous-month confusion matrix
			VAR _TPPrevious =
			    COUNTROWS (
			        FILTER (
			            _PreviousData,
			            factMlPredictions[actual_risk_label_num] = _HighRiskClass
			                && factMlPredictions[predicted_risk_label_num] = _HighRiskClass
			        )
			    )
			
			VAR _FPPrevious =
			    COUNTROWS (
			        FILTER (
			            _PreviousData,
			            factMlPredictions[actual_risk_label_num] <> _HighRiskClass
			                && factMlPredictions[predicted_risk_label_num] = _HighRiskClass
			        )
			    )
			
			VAR _FNPrevious =
			    COUNTROWS (
			        FILTER (
			            _PreviousData,
			            factMlPredictions[actual_risk_label_num] = _HighRiskClass
			                && factMlPredictions[predicted_risk_label_num] <> _HighRiskClass
			        )
			    )
			
			VAR _TNPrevious =
			    COUNTROWS (
			        FILTER (
			            _PreviousData,
			            factMlPredictions[actual_risk_label_num] <> _HighRiskClass
			                && factMlPredictions[predicted_risk_label_num] <> _HighRiskClass
			        )
			    )
			
			-- Accuracy
			VAR _AccuracyCurrent =
			    DIVIDE (
			        COUNTROWS (
			            FILTER (
			                _CurrentData,
			                factMlPredictions[actual_risk_label_num]
			                    = factMlPredictions[predicted_risk_label_num]
			            )
			        ),
			        _CurrentRows
			    )
			
			VAR _AccuracyPrevious =
			    DIVIDE (
			        COUNTROWS (
			            FILTER (
			                _PreviousData,
			                factMlPredictions[actual_risk_label_num]
			                    = factMlPredictions[predicted_risk_label_num]
			            )
			        ),
			        _PreviousRows
			    )
			
			-- Macro F1 across the fixed classes 0, 1 and 2
			VAR _MacroF1Current =
			    AVERAGEX (
			        _Classes,
			        VAR _Class = [ClassID]
			
			        VAR _ClassTP =
			            COUNTROWS (
			                FILTER (
			                    _CurrentData,
			                    factMlPredictions[actual_risk_label_num] = _Class
			                        && factMlPredictions[predicted_risk_label_num] = _Class
			                )
			            )
			
			        VAR _ClassFP =
			            COUNTROWS (
			                FILTER (
			                    _CurrentData,
			                    factMlPredictions[actual_risk_label_num] <> _Class
			                        && factMlPredictions[predicted_risk_label_num] = _Class
			                )
			            )
			
			        VAR _ClassFN =
			            COUNTROWS (
			                FILTER (
			                    _CurrentData,
			                    factMlPredictions[actual_risk_label_num] = _Class
			                        && factMlPredictions[predicted_risk_label_num] <> _Class
			                )
			            )
			
			        RETURN
			            DIVIDE (
			                2 * _ClassTP,
			                2 * _ClassTP + _ClassFP + _ClassFN,
			                0
			            )
			    )
			
			VAR _MacroF1Previous =
			    AVERAGEX (
			        _Classes,
			        VAR _Class = [ClassID]
			
			        VAR _ClassTP =
			            COUNTROWS (
			                FILTER (
			                    _PreviousData,
			                    factMlPredictions[actual_risk_label_num] = _Class
			                        && factMlPredictions[predicted_risk_label_num] = _Class
			                )
			            )
			
			        VAR _ClassFP =
			            COUNTROWS (
			                FILTER (
			                    _PreviousData,
			                    factMlPredictions[actual_risk_label_num] <> _Class
			                        && factMlPredictions[predicted_risk_label_num] = _Class
			                )
			            )
			
			        VAR _ClassFN =
			            COUNTROWS (
			                FILTER (
			                    _PreviousData,
			                    factMlPredictions[actual_risk_label_num] = _Class
			                        && factMlPredictions[predicted_risk_label_num] <> _Class
			                )
			            )
			
			        RETURN
			            DIVIDE (
			                2 * _ClassTP,
			                2 * _ClassTP + _ClassFP + _ClassFN,
			                0
			            )
			    )
			
			-- High-risk metrics
			VAR _RecallCurrent =
			    DIVIDE (
			        _TPCurrent,
			        _TPCurrent + _FNCurrent
			    )
			
			VAR _RecallPrevious =
			    DIVIDE (
			        _TPPrevious,
			        _TPPrevious + _FNPrevious
			    )
			
			VAR _PrecisionCurrent =
			    DIVIDE (
			        _TPCurrent,
			        _TPCurrent + _FPCurrent
			    )
			
			VAR _PrecisionPrevious =
			    DIVIDE (
			        _TPPrevious,
			        _TPPrevious + _FPPrevious
			    )
			
			VAR _FalseAlarmRateCurrent =
			    DIVIDE (
			        _FPCurrent,
			        _FPCurrent + _TNCurrent
			    )
			
			VAR _FalseAlarmRatePrevious =
			    DIVIDE (
			        _FPPrevious,
			        _FPPrevious + _TNPrevious
			    )
			
			VAR _AlertRateCurrent =
			    DIVIDE (
			        _TPCurrent + _FPCurrent,
			        _CurrentRows
			    )
			
			VAR _AlertRatePrevious =
			    DIVIDE (
			        _TPPrevious + _FPPrevious,
			        _PreviousRows
			    )
			
			-- Month-over-month changes
			VAR _AccuracyDelta =
			    _AccuracyCurrent - _AccuracyPrevious
			
			VAR _MacroF1Delta =
			    _MacroF1Current - _MacroF1Previous
			
			VAR _RecallDelta =
			    _RecallCurrent - _RecallPrevious
			
			VAR _PrecisionDelta =
			    _PrecisionCurrent - _PrecisionPrevious
			
			VAR _FalseAlarmDelta =
			    _FalseAlarmRateCurrent - _FalseAlarmRatePrevious
			
			VAR _AlertRateDelta =
			    _AlertRateCurrent - _AlertRatePrevious
			
			-- Trend colors
			VAR _AccuracyDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _HasPreviousMonth ), "#7A7480",
			        _AccuracyDelta > 0,         "#2F855A",
			        _AccuracyDelta < 0,         "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _MacroF1DeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _HasPreviousMonth ), "#7A7480",
			        _MacroF1Delta > 0,          "#2F855A",
			        _MacroF1Delta < 0,          "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _RecallDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _HasPreviousMonth ), "#7A7480",
			        _RecallDelta > 0,           "#2F855A",
			        _RecallDelta < 0,           "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _PrecisionDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _HasPreviousMonth ), "#7A7480",
			        _PrecisionDelta > 0,        "#2F855A",
			        _PrecisionDelta < 0,        "#C53D3D",
			        "#7A7480"
			    )
			
			-- Lower false-alarm rate is better
			VAR _FalseAlarmDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _HasPreviousMonth ), "#7A7480",
			        _FalseAlarmDelta < 0,       "#2F855A",
			        _FalseAlarmDelta > 0,       "#C53D3D",
			        "#7A7480"
			    )
			
			-- Alert rate is context-dependent, so the trend remains neutral
			VAR _AlertRateDeltaColor =
			    IF (
			        _HasPreviousMonth,
			        "#6F4A7C",
			        "#7A7480"
			    )
			
			-- Direction arrows
			VAR _AccuracyArrow =
			    IF (
			        _AccuracyDelta > 0,
			        "▲ ",
			        IF ( _AccuracyDelta < 0, "▼ ", "— " )
			    )
			
			VAR _MacroF1Arrow =
			    IF (
			        _MacroF1Delta > 0,
			        "▲ ",
			        IF ( _MacroF1Delta < 0, "▼ ", "— " )
			    )
			
			VAR _RecallArrow =
			    IF (
			        _RecallDelta > 0,
			        "▲ ",
			        IF ( _RecallDelta < 0, "▼ ", "— " )
			    )
			
			VAR _PrecisionArrow =
			    IF (
			        _PrecisionDelta > 0,
			        "▲ ",
			        IF ( _PrecisionDelta < 0, "▼ ", "— " )
			    )
			
			VAR _FalseAlarmArrow =
			    IF (
			        _FalseAlarmDelta > 0,
			        "▲ ",
			        IF ( _FalseAlarmDelta < 0, "▼ ", "— " )
			    )
			
			VAR _AlertRateArrow =
			    IF (
			        _AlertRateDelta > 0,
			        "▲ ",
			        IF ( _AlertRateDelta < 0, "▼ ", "— " )
			    )
			
			-- KPI values
			VAR _AccuracyFormatted =
			    IF (
			        ISBLANK ( _AccuracyCurrent ),
			        "—",
			        FORMAT ( _AccuracyCurrent, "0.0%","de-DE" )
			    )
			
			VAR _MacroF1Formatted =
			    IF (
			        ISBLANK ( _MacroF1Current ),
			        "—",
			        FORMAT ( _MacroF1Current, "0.0%","de-DE" )
			    )
			
			VAR _RecallFormatted =
			    IF (
			        ISBLANK ( _RecallCurrent ),
			        "—",
			        FORMAT ( _RecallCurrent, "0.0%","de-DE" )
			    )
			
			VAR _PrecisionFormatted =
			    IF (
			        ISBLANK ( _PrecisionCurrent ),
			        "—",
			        FORMAT ( _PrecisionCurrent, "0.0%","de-DE" )
			    )
			
			VAR _FalseAlarmFormatted =
			    IF (
			        ISBLANK ( _FalseAlarmRateCurrent ),
			        "—",
			        FORMAT ( _FalseAlarmRateCurrent, "0.0%","de-DE" )
			    )
			
			VAR _AlertRateFormatted =
			    IF (
			        ISBLANK ( _AlertRateCurrent ),
			        "—",
			        FORMAT ( _AlertRateCurrent, "0.0%","de-DE" )
			    )
			
			-- Comparison labels
			VAR _AccuracyComparison =
			    IF (
			        NOT ( _HasPreviousMonth ),
			        "— No PM data",
			        _AccuracyArrow
			            & FORMAT ( ABS ( _AccuracyDelta ) * 100, "0.0","de-DE" )
			            & " pp vs PM"
			    )
			
			VAR _MacroF1Comparison =
			    IF (
			        NOT ( _HasPreviousMonth ),
			        "— No PM data",
			        _MacroF1Arrow
			            & FORMAT ( ABS ( _MacroF1Delta ), "0.0%","de-DE" )
			            & " vs PM"
			    )
			
			VAR _RecallComparison =
			    IF (
			        NOT ( _HasPreviousMonth ),
			        "— No PM data",
			        _RecallArrow
			            & FORMAT ( ABS ( _RecallDelta ) * 100, "0.0","de-DE" )
			            & " pp vs PM"
			    )
			
			VAR _PrecisionComparison =
			    IF (
			        NOT ( _HasPreviousMonth ),
			        "— No PM data",
			        _PrecisionArrow
			            & FORMAT ( ABS ( _PrecisionDelta ) * 100, "0.0","de-DE" )
			            & " pp vs PM"
			    )
			
			VAR _FalseAlarmComparison =
			    IF (
			        NOT ( _HasPreviousMonth ),
			        "— No PM data",
			        _FalseAlarmArrow
			            & FORMAT ( ABS ( _FalseAlarmDelta ) * 100, "0.0","de-DE" )
			            & " pp vs PM"
			    )
			
			VAR _AlertRateComparison =
			    IF (
			        NOT ( _HasPreviousMonth ),
			        "— No PM data",
			        _AlertRateArrow
			            & FORMAT ( ABS ( _AlertRateDelta ) * 100, "0.0","de-DE" )
			            & " pp vs PM"
			    )
			
			RETURN
			IF (
			    ISBLANK ( _CurrentMonth ),
			    "
			    <div style='
			        padding:8px;
			        background:transparent;
			        color:#7A7480;
			        font:8px Segoe UI,Arial,sans-serif;'>
			        No model-performance data
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .mp-grid {
			            display:grid;
			            grid-template-columns:repeat(6,minmax(0,1fr));
			            gap:6px;
			            width:100%;
			            background:transparent;
			        }
			
			        .mp-card {
			            position:relative;
			            min-width:0;
			            padding:9px 10px 8px;
			            overflow:hidden;
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.14);
			            border-radius:5px;
			        }
			
			        .mp-accent {
			            position:absolute;
			            top:0;
			            left:0;
			            width:100%;
			            height:3px;
			        }
			
			        .mp-label {
			            margin-bottom:4px;
			            overflow:hidden;
			            color:#000000;
			            font-size:10px;
			            font-weight:700;
			            letter-spacing:.035em;
			            text-transform:uppercase;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .mp-value {
			            margin-bottom:5px;
			            overflow:hidden;
			            font-size:clamp(18px,1.7vw,24px);
			            line-height:1;
			            font-weight:700;
			            letter-spacing:-.03em;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .mp-bottom {
			            display:flex;
			            align-items:center;
			            gap:4px;
			            min-width:0;
			            overflow:hidden;
			        }
			
			        .mp-delta {
			            flex-shrink:0;
			            padding:1px 4px;
			            border:1px solid;
			            border-radius:3px;
			            font-size:10px;
			            font-weight:600;
			            white-space:nowrap;
			        }
			
			        .mp-meta {
			            min-width:0;
			            overflow:hidden;
			            color:#7A7480;
			            font-size:10px;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			    </style>
			
			    <div class='mp-grid'>
			
			        <div class='mp-card'>
			            <div class='mp-accent'
			                 style='background:#331045'></div>
			            <div class='mp-label'>Accuracy</div>
			            <div class='mp-value'
			                 style='color:#331045'>
			                " & _AccuracyFormatted & "
			            </div>
			            <div class='mp-bottom'>
			                <span class='mp-delta'
			                      style='color:" & _AccuracyDeltaColor & ";
			                             border-color:" & _AccuracyDeltaColor & "55;
			                             background:" & _AccuracyDeltaColor & "10'>
			                    " & _AccuracyComparison & "
			                </span>
			                <span class='mp-meta'>correct / all</span>
			            </div>
			        </div>
			
			        <div class='mp-card'>
			            <div class='mp-accent'
			                 style='background:#6F4A7C'></div>
			            <div class='mp-label'>Macro F1</div>
			            <div class='mp-value'
			                 style='color:#6F4A7C'>
			                " & _MacroF1Formatted & "
			            </div>
			            <div class='mp-bottom'>
			                <span class='mp-delta'
			                      style='color:" & _MacroF1DeltaColor & ";
			                             border-color:" & _MacroF1DeltaColor & "55;
			                             background:" & _MacroF1DeltaColor & "10'>
			                    " & _MacroF1Comparison & "
			                </span>
			                <span class='mp-meta'>equal class weight</span>
			            </div>
			        </div>
			
			        <div class='mp-card'>
			            <div class='mp-accent'
			                 style='background:#2F855A'></div>
			            <div class='mp-label'>High-Risk Recall</div>
			            <div class='mp-value'
			                 style='color:#2F855A'>
			                " & _RecallFormatted & "
			            </div>
			            <div class='mp-bottom'>
			                <span class='mp-delta'
			                      style='color:" & _RecallDeltaColor & ";
			                             border-color:" & _RecallDeltaColor & "55;
			                             background:" & _RecallDeltaColor & "10'>
			                    " & _RecallComparison & "
			                </span>
			                <span class='mp-meta'>high risks found</span>
			            </div>
			        </div>
			
			        <div class='mp-card'>
			            <div class='mp-accent'
			                 style='background:#4F7664'></div>
			            <div class='mp-label'>High-Risk Precision</div>
			            <div class='mp-value'
			                 style='color:#4F7664'>
			                " & _PrecisionFormatted & "
			            </div>
			            <div class='mp-bottom'>
			                <span class='mp-delta'
			                      style='color:" & _PrecisionDeltaColor & ";
			                             border-color:" & _PrecisionDeltaColor & "55;
			                             background:" & _PrecisionDeltaColor & "10'>
			                    " & _PrecisionComparison & "
			                </span>
			                <span class='mp-meta'>valid high alerts</span>
			            </div>
			        </div>
			
			        <div class='mp-card'>
			            <div class='mp-accent'
			                 style='background:#C53D3D'></div>
			            <div class='mp-label'>False-Alarm Rate</div>
			            <div class='mp-value'
			                 style='color:#C53D3D'>
			                " & _FalseAlarmFormatted & "
			            </div>
			            <div class='mp-bottom'>
			                <span class='mp-delta'
			                      style='color:" & _FalseAlarmDeltaColor & ";
			                             border-color:" & _FalseAlarmDeltaColor & "55;
			                             background:" & _FalseAlarmDeltaColor & "10'>
			                    " & _FalseAlarmComparison & "
			                </span>
			                <span class='mp-meta'>false alerts</span>
			            </div>
			        </div>
			
			        <div class='mp-card'>
			            <div class='mp-accent'
			                 style='background:#D99A2B'></div>
			            <div class='mp-label'>Alert Rate</div>
			            <div class='mp-value'
			                 style='color:#D99A2B'>
			                " & _AlertRateFormatted & "
			            </div>
			            <div class='mp-bottom'>
			                <span class='mp-delta'
			                      style='color:" & _AlertRateDeltaColor & ";
			                             border-color:" & _AlertRateDeltaColor & "55;
			                             background:" & _AlertRateDeltaColor & "10'>
			                    " & _AlertRateComparison & "
			                </span>
			                <span class='mp-meta'>records flagged</span>
			            </div>
			        </div>
			
			    </div>
			    "
			)
		displayFolder: 06 Model Performance
		lineageTag: 13b24d9c-8686-4def-afec-373567737ba7

	measure 'Risk Operations Card HTML' =
			
			VAR _CurrentMonth =
			    SELECTEDVALUE ( factMlPredictions[year_month] )
			
			VAR _PreviousMonth =
			    EDATE ( _CurrentMonth, -1 )
			
			VAR _TwoMonthsAgo =
			    EDATE ( _CurrentMonth, -2 )
			
			
			-- ============================================================
			-- MONTHLY DATA SNAPSHOTS
			-- ============================================================
			
			VAR _CurrentData =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS ( dimDate ),
			        FILTER (
			            ALL ( factMlPredictions[year_month] ),
			            factMlPredictions[year_month] = _CurrentMonth
			        )
			    )
			
			VAR _PreviousData =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS ( dimDate ),
			        FILTER (
			            ALL ( factMlPredictions[year_month] ),
			            factMlPredictions[year_month] = _PreviousMonth
			        )
			    )
			
			VAR _TwoMonthsAgoData =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS ( dimDate ),
			        FILTER (
			            ALL ( factMlPredictions[year_month] ),
			            factMlPredictions[year_month] = _TwoMonthsAgo
			        )
			    )
			
			
			VAR _HasPreviousMonth =
			    COUNTROWS ( _PreviousData ) > 0
			
			VAR _HasTwoMonthsAgo =
			    COUNTROWS ( _TwoMonthsAgoData ) > 0
			
			
			-- ============================================================
			-- ALERT SETS
			-- ============================================================
			
			VAR _CurrentAlertSet =
			    DISTINCT (
			        SELECTCOLUMNS (
			            FILTER (
			                _CurrentData,
			                factMlPredictions[is_high_risk_alert] = 1
			            ),
			            "ProductID",
			                factMlPredictions[product_id]
			        )
			    )
			
			
			VAR _PreviousAlertSet =
			    DISTINCT (
			        SELECTCOLUMNS (
			            FILTER (
			                _PreviousData,
			                factMlPredictions[is_high_risk_alert] = 1
			            ),
			            "ProductID",
			                factMlPredictions[product_id]
			        )
			    )
			
			
			VAR _TwoMonthsAgoAlertSet =
			    DISTINCT (
			        SELECTCOLUMNS (
			            FILTER (
			                _TwoMonthsAgoData,
			                factMlPredictions[is_high_risk_alert] = 1
			            ),
			            "ProductID",
			                factMlPredictions[product_id]
			        )
			    )
			
			
			-- ============================================================
			-- KPI 1: CURRENT ALERTS
			-- ============================================================
			
			VAR _AlertsCurrent =
			    COUNTROWS ( _CurrentAlertSet )
			
			VAR _AlertsPrevious =
			    COUNTROWS ( _PreviousAlertSet )
			
			VAR _AlertsDelta =
			    IF (
			        _HasPreviousMonth,
			        _AlertsCurrent - _AlertsPrevious
			    )
			
			
			-- ============================================================
			-- KPI 2: NEW ALERTS
			-- Current alerts not present in previous month
			-- ============================================================
			
			VAR _NewAlertsCurrent =
			    IF (
			        _HasPreviousMonth,
			        COUNTROWS (
			            EXCEPT (
			                _CurrentAlertSet,
			                _PreviousAlertSet
			            )
			        )
			    )
			
			
			VAR _NewAlertsPrevious =
			    IF (
			        _HasTwoMonthsAgo,
			        COUNTROWS (
			            EXCEPT (
			                _PreviousAlertSet,
			                _TwoMonthsAgoAlertSet
			            )
			        )
			    )
			
			
			VAR _NewAlertsDelta =
			    IF (
			        _HasPreviousMonth
			            && _HasTwoMonthsAgo,
			        _NewAlertsCurrent - _NewAlertsPrevious
			    )
			
			
			-- ============================================================
			-- KPI 3: PERSISTENT ALERTS
			-- Alerts present in both current and previous month
			-- ============================================================
			
			VAR _PersistentCurrent =
			    IF (
			        _HasPreviousMonth,
			        COUNTROWS (
			            INTERSECT (
			                _CurrentAlertSet,
			                _PreviousAlertSet
			            )
			        )
			    )
			
			
			VAR _PersistentPrevious =
			    IF (
			        _HasTwoMonthsAgo,
			        COUNTROWS (
			            INTERSECT (
			                _PreviousAlertSet,
			                _TwoMonthsAgoAlertSet
			            )
			        )
			    )
			
			
			VAR _PersistentDelta =
			    IF (
			        _HasPreviousMonth
			            && _HasTwoMonthsAgo,
			        _PersistentCurrent - _PersistentPrevious
			    )
			
			
			VAR _PersistentRate =
			    DIVIDE (
			        _PersistentCurrent,
			        _AlertsCurrent
			    )
			
			
			-- ============================================================
			-- KPI 4 + KPI 5:
			-- CRITICAL QUEUE / REVENUE IN QUEUE
			--
			-- Queue = six highest-priority current high-risk
			-- product × region combinations.
			--
			-- Priority:
			--   1. Highest normalized risk score
			--   2. Highest revenue
			-- ============================================================
			
			VAR _CurrentHighRiskRows =
			    FILTER (
			        _CurrentData,
			        factMlPredictions[is_high_risk_alert] = 1
			    )
			
			
			-- Aggregate explicitly to product × region grain
			VAR _CurrentHighRiskProductRegion =
			    GROUPBY (
			        _CurrentHighRiskRows,
			        factMlPredictions[product_id],
			        factMlPredictions[region_id],
			
			        "@RiskScore",
			            MAXX (
			                CURRENTGROUP (),
			                factMlPredictions[risk_score_normalized]
			            ),
			
			        "@Revenue",
			            SUMX (
			                CURRENTGROUP (),
			                factMlPredictions[revenue]
			            )
			    )
			
			
			-- The operational queue contains a maximum of 6 alerts
			VAR _CriticalQueue =
			    TOPN (
			        6,
			        FILTER (
			            _CurrentHighRiskProductRegion,
			            NOT ISBLANK ( [@RiskScore] )
			        ),
			        [@RiskScore], DESC,
			        [@Revenue], DESC,
			        factMlPredictions[product_id], ASC,
			        factMlPredictions[region_id], ASC
			    )
			
			
			VAR _CriticalQueueCount =
			    COUNTROWS ( _CriticalQueue )
			
			
			VAR _RevenueInQueue =
			    SUMX (
			        _CriticalQueue,
			        [@Revenue]
			    )
			
			
			-- ============================================================
			-- COLORS
			-- ============================================================
			
			VAR _GoodColor =
			    "#2F855A"
			
			VAR _BadColor =
			    "#C53D3D"
			
			VAR _WarningColor =
			    "#D99A2B"
			
			VAR _PurpleColor =
			    "#331045"
			
			VAR _NeutralColor =
			    "#7A7480"
			
			
			VAR _AlertsDeltaColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _AlertsDelta ), _NeutralColor,
			        _AlertsDelta > 0,         _BadColor,
			        _AlertsDelta < 0,         _GoodColor,
			        _NeutralColor
			    )
			
			
			VAR _NewDeltaColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _NewAlertsDelta ), _NeutralColor,
			        _NewAlertsDelta > 0,         _BadColor,
			        _NewAlertsDelta < 0,         _GoodColor,
			        _NeutralColor
			    )
			
			
			VAR _PersistentDeltaColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _PersistentDelta ), _NeutralColor,
			        _PersistentDelta > 0,         _BadColor,
			        _PersistentDelta < 0,         _GoodColor,
			        _NeutralColor
			    )
			
			
			-- ============================================================
			-- FORMATTED VALUES
			-- ============================================================
			
			VAR _AlertsFormatted =
			    FORMAT (
			        _AlertsCurrent,
			        "#,0", "de-DE"
			    )
			
			
			VAR _NewAlertsFormatted =
			    IF (
			        ISBLANK ( _NewAlertsCurrent ),
			        "—",
			        FORMAT (
			            _NewAlertsCurrent,
			            "#,0", "de-DE"
			        )
			    )
			
			
			VAR _PersistentFormatted =
			    IF (
			        ISBLANK ( _PersistentCurrent ),
			        "—",
			        FORMAT (
			            _PersistentCurrent,
			            "#,0", "de-DE"
			        )
			    )
			
			
			VAR _CriticalQueueFormatted =
			    FORMAT (
			        _CriticalQueueCount,
			        "#,0", "de-DE"
			    )
			
			
			VAR _RevenueQueueFormatted =
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( _RevenueInQueue ),
			            "—",
			
			        ABS ( _RevenueInQueue ) >= 1000000,
			            "€"
			                & FORMAT (
			                    DIVIDE (
			                        _RevenueInQueue,
			                        1000000
			                    ),
			                    "0.0", "de-DE"
			                )
			                & "M",
			
			        ABS ( _RevenueInQueue ) >= 1000,
			            "€"
			                & FORMAT (
			                    DIVIDE (
			                        _RevenueInQueue,
			                        1000
			                    ),
			                    "0.0", "de-DE"
			                )
			                & "K",
			
			        "€"
			            & FORMAT (
			                _RevenueInQueue,
			                "#,0", "de-DE"
			            )
			    )
			
			
			-- ============================================================
			-- COMPARISON LABELS
			-- ============================================================
			
			VAR _AlertsComparison =
			    IF (
			        ISBLANK ( _AlertsDelta ),
			        "— No PM data",
			        SWITCH (
			            TRUE (),
			
			            _AlertsDelta > 0,
			                "▲ "
			                    & FORMAT (
			                        ABS ( _AlertsDelta ),
			                        "#,0", "de-DE"
			                    )
			                    & " vs PM",
			
			            _AlertsDelta < 0,
			                "▼ "
			                    & FORMAT (
			                        ABS ( _AlertsDelta ),
			                        "#,0", "de-DE"
			                    )
			                    & " vs PM",
			
			            "— 0 vs PM"
			        )
			    )
			
			
			VAR _NewAlertsComparison =
			    IF (
			        ISBLANK ( _NewAlertsDelta ),
			        "— No baseline",
			        SWITCH (
			            TRUE (),
			
			            _NewAlertsDelta > 0,
			                "▲ "
			                    & FORMAT (
			                        ABS ( _NewAlertsDelta ),
			                        "#,0", "de-DE"
			                    )
			                    & " vs PM",
			
			            _NewAlertsDelta < 0,
			                "▼ "
			                    & FORMAT (
			                        ABS ( _NewAlertsDelta ),
			                        "#,0", "de-DE"
			                    )
			                    & " vs PM",
			
			            "— 0 vs PM"
			        )
			    )
			
			
			VAR _PersistentComparison =
			    IF (
			        ISBLANK ( _PersistentDelta ),
			        "— No baseline",
			        SWITCH (
			            TRUE (),
			
			            _PersistentDelta > 0,
			                "▲ "
			                    & FORMAT (
			                        ABS ( _PersistentDelta ),
			                        "#,0", "de-DE"
			                    )
			                    & " vs PM",
			
			            _PersistentDelta < 0,
			                "▼ "
			                    & FORMAT (
			                        ABS ( _PersistentDelta ),
			                        "#,0", "de-DE"
			                    )
			                    & " vs PM",
			
			            "— 0 vs PM"
			        )
			    )
			
			
			VAR _PersistentMeta =
			    IF (
			        ISBLANK ( _PersistentRate ),
			        "No previous-month baseline",
			        FORMAT (
			            _PersistentRate,
			            "0%"
			        )
			            & " of current alerts"
			    )
			
			
			-- ============================================================
			-- HTML
			-- ============================================================
			
			RETURN
			
			IF (
			    ISBLANK ( _CurrentMonth ),
			
			    "
			    <div style='
			        padding:8px;
			        background:transparent;
			        color:#7A7480;
			        font:8px Segoe UI,Arial,sans-serif;'>
			        No alert data available
			    </div>
			    ",
			
			    "
			    <style>
			
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			
			        .ao-grid {
			            display:grid;
			            grid-template-columns:repeat(5,minmax(0,1fr));
			            gap:6px;
			            width:100%;
			            background:transparent;
			        }
			
			
			        .ao-card {
			            position:relative;
			            min-width:0;
			            padding:9px 10px 8px;
			            overflow:hidden;
			
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.12);
			            border-radius:8px;
			
			            box-shadow:
			                0 1px 3px rgba(51,16,69,.08);
			        }
			
			
			        .ao-accent {
			            position:absolute;
			            top:0;
			            left:0;
			            width:100%;
			            height:3px;
			        }
			
			
			        .ao-label {
			            margin-bottom:4px;
			
			            overflow:hidden;
			
			            color:#000000;
			
			            font-size:10px;
			            font-weight:700;
			            letter-spacing:.03em;
			            text-transform:uppercase;
			
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			
			        .ao-value {
			            margin-bottom:5px;
			
			            overflow:hidden;
			
			            font-size:clamp(18px,1.8vw,24px);
			            line-height:1;
			            font-weight:700;
			            letter-spacing:-.03em;
			
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			
			        .ao-bottom {
			            display:flex;
			            align-items:center;
			            gap:4px;
			
			            min-width:0;
			            overflow:hidden;
			        }
			
			
			        .ao-delta {
			            flex-shrink:0;
			
			            padding:1px 4px;
			
			            border:1px solid;
			            border-radius:3px;
			
			            font-size:10px;
			            font-weight:600;
			
			            white-space:nowrap;
			        }
			
			
			        .ao-meta {
			            min-width:0;
			            overflow:hidden;
			
			            color:#7A7480;
			
			            font-size:10px;
			
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			
			        @media (max-width:700px) {
			
			            .ao-grid {
			                grid-template-columns:
			                    repeat(2,minmax(0,1fr));
			                gap:10px;
			            }
			
			            .ao-card {
			                min-height:98px;
			                padding:13px 12px 10px;
			            }
			
			            .ao-label {
			                font-size:10px;
			            }
			
			            .ao-value {
			                font-size:23px;
			                margin-top:8px;
			            }
			
			            .ao-meta,
			            .ao-delta {
			                font-size:10px;
			            }
			        }
			
			    </style>
			
			
			    <div class='ao-grid'>
			
			
			        <!-- ============================================== -->
			        <!-- CURRENT ALERTS -->
			        <!-- ============================================== -->
			
			        <div class='ao-card'>
			
			            <div
			                class='ao-accent'
			                style='background:#C53D3D'>
			            </div>
			
			            <div class='ao-label'>
			                Current Alerts
			            </div>
			
			            <div
			                class='ao-value'
			                style='color:#C53D3D'>
			                " & _AlertsFormatted & "
			            </div>
			
			            <div class='ao-bottom'>
			
			                <span
			                    class='ao-delta'
			                    style='
			                        color:" & _AlertsDeltaColor & ";
			                        border-color:" & _AlertsDeltaColor & "55;
			                        background:" & _AlertsDeltaColor & "10;
			                    '>
			                    " & _AlertsComparison & "
			                </span>
			
			            </div>
			
			        </div>
			
			
			        <!-- ============================================== -->
			        <!-- NEW ALERTS -->
			        <!-- ============================================== -->
			
			        <div class='ao-card'>
			
			            <div
			                class='ao-accent'
			                style='background:#2F855A'>
			            </div>
			
			            <div class='ao-label'>
			                New Alerts
			            </div>
			
			            <div
			                class='ao-value'
			                style='color:#2F855A'>
			                " & _NewAlertsFormatted & "
			            </div>
			
			            <div class='ao-bottom'>
			
			                <span
			                    class='ao-delta'
			                    style='
			                        color:" & _NewDeltaColor & ";
			                        border-color:" & _NewDeltaColor & "55;
			                        background:" & _NewDeltaColor & "10;
			                    '>
			                    " & _NewAlertsComparison & "
			                </span>
			
			            </div>
			
			        </div>
			
			
			        <!-- ============================================== -->
			        <!-- PERSISTENT ALERTS -->
			        <!-- ============================================== -->
			
			        <div class='ao-card'>
			
			            <div
			                class='ao-accent'
			                style='background:#D99A2B'>
			            </div>
			
			            <div class='ao-label'>
			                Persistent Alerts
			            </div>
			
			            <div
			                class='ao-value'
			                style='color:#D99A2B'>
			                " & _PersistentFormatted & "
			            </div>
			
			            <div class='ao-bottom'>
			
			                <span class='ao-meta'>
			                    " & _PersistentMeta & "
			                </span>
			
			            </div>
			
			        </div>
			
			
			        <!-- ============================================== -->
			        <!-- CRITICAL QUEUE -->
			        <!-- ============================================== -->
			
			        <div class='ao-card'>
			
			            <div
			                class='ao-accent'
			                style='background:#C53D3D'>
			            </div>
			
			            <div class='ao-label'>
			                Critical Queue
			            </div>
			
			            <div
			                class='ao-value'
			                style='color:#C53D3D'>
			                " & _CriticalQueueFormatted & "
			            </div>
			
			            <div class='ao-bottom'>
			
			                <span class='ao-meta'>
			                    Requires immediate review
			                </span>
			
			            </div>
			
			        </div>
			
			
			        <!-- ============================================== -->
			        <!-- REVENUE IN QUEUE -->
			        <!-- ============================================== -->
			
			        <div class='ao-card'>
			
			            <div
			                class='ao-accent'
			                style='background:#331045'>
			            </div>
			
			            <div class='ao-label'>
			                Revenue in Queue
			            </div>
			
			            <div
			                class='ao-value'
			                style='color:#331045'>
			                " & _RevenueQueueFormatted & "
			            </div>
			
			            <div class='ao-bottom'>
			
			                <span class='ao-meta'>
			                    Top prioritized alerts
			                </span>
			
			            </div>
			
			        </div>
			
			
			    </div>
			    "
			)
		displayFolder: 01 Risk
		lineageTag: 47cd4748-ee6a-42ab-9aec-47b69e4498fb

	measure 'Overview Card HTML - Risk Exposure' =
			
			VAR _CurrentMonth =
			    MAX ( factMlPredictions[year_month] )
			
			VAR _PreviousMonth =
			    EDATE ( _CurrentMonth, -1 )
			
			-- Monthly data snapshots
			VAR _CurrentData =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS ( dimDate ),
			        FILTER (
			            ALL ( factMlPredictions[year_month] ),
			            factMlPredictions[year_month] = _CurrentMonth
			        )
			    )
			
			VAR _PreviousData =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS ( dimDate ),
			        FILTER (
			            ALL ( factMlPredictions[year_month] ),
			            factMlPredictions[year_month] = _PreviousMonth
			        )
			    )
			
			VAR _HasPreviousMonth =
			    COUNTROWS ( _PreviousData ) > 0
			
			-- Distinct assessed product × region combinations
			VAR _CurrentRecordSet =
			    DISTINCT (
			        SELECTCOLUMNS (
			            _CurrentData,
			            "ProductID", factMlPredictions[product_id],
			            "RegionID",  factMlPredictions[region_id]
			        )
			    )
			
			VAR _PreviousRecordSet =
			    DISTINCT (
			        SELECTCOLUMNS (
			            _PreviousData,
			            "ProductID", factMlPredictions[product_id],
			            "RegionID",  factMlPredictions[region_id]
			        )
			    )
			
			-- Distinct high-risk alert combinations
			VAR _CurrentAlertSet =
			    DISTINCT (
			        SELECTCOLUMNS (
			            FILTER (
			                _CurrentData,
			                factMlPredictions[is_high_risk_alert] = 1
			            ),
			            "ProductID", factMlPredictions[product_id],
			            "RegionID",  factMlPredictions[region_id]
			        )
			    )
			
			VAR _PreviousAlertSet =
			    DISTINCT (
			        SELECTCOLUMNS (
			            FILTER (
			                _PreviousData,
			                factMlPredictions[is_high_risk_alert] = 1
			            ),
			            "ProductID", factMlPredictions[product_id],
			            "RegionID",  factMlPredictions[region_id]
			        )
			    )
			
			-- KPI 1: High-Risk Products
			VAR _HighRiskProductsCurrent =
			    COUNTROWS (
			        DISTINCT (
			            SELECTCOLUMNS (
			                FILTER (
			                    _CurrentData,
			                    factMlPredictions[is_high_risk_alert] = 1
			                ),
			                "ProductID", factMlPredictions[product_id]
			            )
			        )
			    )
			
			VAR _HighRiskProductsPrevious =
			    COUNTROWS (
			        DISTINCT (
			            SELECTCOLUMNS (
			                FILTER (
			                    _PreviousData,
			                    factMlPredictions[is_high_risk_alert] = 1
			                ),
			                "ProductID", factMlPredictions[product_id]
			            )
			        )
			    )
			
			-- KPI 2: High-Risk Alerts
			VAR _HighRiskAlertsCurrent =
			    COUNTROWS ( _CurrentAlertSet )
			
			VAR _HighRiskAlertsPrevious =
			    COUNTROWS ( _PreviousAlertSet )
			
			-- KPI 3: High-Risk Alert Rate
			VAR _AlertRateCurrent =
			    DIVIDE (
			        _HighRiskAlertsCurrent,
			        COUNTROWS ( _CurrentRecordSet )
			    )
			
			VAR _AlertRatePrevious =
			    DIVIDE (
			        _HighRiskAlertsPrevious,
			        COUNTROWS ( _PreviousRecordSet )
			    )
			
			-- KPI 4: Average Risk Score, normalized to 0–10
			VAR _AverageRiskCurrent =
			    AVERAGEX (
			        _CurrentData,
			        factMlPredictions[risk_score_normalized]
			    )
			
			VAR _AverageRiskPrevious =
			    AVERAGEX (
			        _PreviousData,
			        factMlPredictions[risk_score_normalized]
			    )
			
			-- KPI 5: Revenue Under Watch
			VAR _RevenueCurrent =
			    COALESCE (
			        SUMX (
			            FILTER (
			                _CurrentData,
			                factMlPredictions[is_high_risk_alert] = 1
			            ),
			            factMlPredictions[revenue]
			        ),
			        0
			    )
			
			VAR _RevenuePrevious =
			    COALESCE (
			        SUMX (
			            FILTER (
			                _PreviousData,
			                factMlPredictions[is_high_risk_alert] = 1
			            ),
			            factMlPredictions[revenue]
			        ),
			        0
			    )
			
			-- Month-over-month changes
			VAR _ProductsDelta =
			    IF (
			        _HasPreviousMonth,
			        _HighRiskProductsCurrent - _HighRiskProductsPrevious
			    )
			
			VAR _AlertsDelta =
			    IF (
			        _HasPreviousMonth,
			        _HighRiskAlertsCurrent - _HighRiskAlertsPrevious
			    )
			
			VAR _AlertRateDelta =
			    IF (
			        _HasPreviousMonth,
			        _AlertRateCurrent - _AlertRatePrevious
			    )
			
			VAR _AverageRiskDelta =
			    IF (
			        _HasPreviousMonth
			            && NOT ISBLANK ( _AverageRiskPrevious ),
			        _AverageRiskCurrent - _AverageRiskPrevious
			    )
			
			VAR _RevenueDeltaPct =
			    IF (
			        _HasPreviousMonth
			            && _RevenuePrevious <> 0,
			        DIVIDE (
			            _RevenueCurrent - _RevenuePrevious,
			            ABS ( _RevenuePrevious )
			        )
			    )
			
			-- Status colors
			VAR _GoodColor = "#2F855A"
			VAR _BadColor = "#C53D3D"
			VAR _NeutralColor = "#7A7480"
			
			VAR _ProductsDeltaColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _ProductsDelta ), _NeutralColor,
			        _ProductsDelta > 0,         _BadColor,
			        _ProductsDelta < 0,         _GoodColor,
			        _NeutralColor
			    )
			
			VAR _AlertsDeltaColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _AlertsDelta ), _NeutralColor,
			        _AlertsDelta > 0,         _BadColor,
			        _AlertsDelta < 0,         _GoodColor,
			        _NeutralColor
			    )
			
			VAR _AlertRateDeltaColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _AlertRateDelta ), _NeutralColor,
			        _AlertRateDelta > 0,         _BadColor,
			        _AlertRateDelta < 0,         _GoodColor,
			        _NeutralColor
			    )
			
			VAR _AverageRiskDeltaColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _AverageRiskDelta ), _NeutralColor,
			        _AverageRiskDelta > 0,         _BadColor,
			        _AverageRiskDelta < 0,         _GoodColor,
			        _NeutralColor
			    )
			
			VAR _RevenueDeltaColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _RevenueDeltaPct ), _NeutralColor,
			        _RevenueDeltaPct > 0,         _BadColor,
			        _RevenueDeltaPct < 0,         _GoodColor,
			        _NeutralColor
			    )
			
			-- Formatted KPI values
			VAR _ProductsFormatted =
			    FORMAT ( _HighRiskProductsCurrent, "#,0", "de-DE" )
			
			VAR _AlertsFormatted =
			    FORMAT ( _HighRiskAlertsCurrent, "#,0", "de-DE" )
			
			VAR _AlertRateFormatted =
			    FORMAT ( _AlertRateCurrent, "0.0%", "de-DE" )
			
			VAR _AverageRiskFormatted =
			    IF (
			        ISBLANK ( _AverageRiskCurrent ),
			        "—",
			        FORMAT ( _AverageRiskCurrent, "0.0", "de-DE" )
			    )
			
			VAR _RevenueFormatted =
			    SWITCH (
			        TRUE (),
			        ABS ( _RevenueCurrent ) >= 1000000000,
			            "€ " & FORMAT ( _RevenueCurrent / 1000000000, "0.0", "de-DE" ) & "B",
			        ABS ( _RevenueCurrent ) >= 1000000,
			            "€ " & FORMAT ( _RevenueCurrent / 1000000, "0.0", "de-DE" ) & "M",
			        ABS ( _RevenueCurrent ) >= 1000,
			            "€ " & FORMAT ( _RevenueCurrent / 1000, "0.0", "de-DE" ) & "K",
			        "€ " & FORMAT ( _RevenueCurrent, "#,0", "de-DE" )
			    )
			
			-- Comparison labels
			VAR _ProductsComparison =
			    IF (
			        ISBLANK ( _ProductsDelta ),
			        "— No PM data",
			        SWITCH (
			            TRUE (),
			            _ProductsDelta > 0,
			                "▲ " & FORMAT ( ABS ( _ProductsDelta ), "#,0", "de-DE" ) & " vs PM",
			            _ProductsDelta < 0,
			                "▼ " & FORMAT ( ABS ( _ProductsDelta ), "#,0", "de-DE" ) & " vs PM",
			            "— 0 vs PM"
			        )
			    )
			
			VAR _AlertsComparison =
			    IF (
			        ISBLANK ( _AlertsDelta ),
			        "— No PM data",
			        SWITCH (
			            TRUE (),
			            _AlertsDelta > 0,
			                "▲ " & FORMAT ( ABS ( _AlertsDelta ), "#,0", "de-DE" ) & " vs PM",
			            _AlertsDelta < 0,
			                "▼ " & FORMAT ( ABS ( _AlertsDelta ), "#,0", "de-DE" ) & " vs PM",
			            "— 0 vs PM"
			        )
			    )
			
			VAR _AlertRateComparison =
			    IF (
			        ISBLANK ( _AlertRateDelta ),
			        "— No PM data",
			        SWITCH (
			            TRUE (),
			            _AlertRateDelta > 0,
			                "▲ " & FORMAT ( ABS ( _AlertRateDelta ) * 100, "0.0", "de-DE" ) & " pp vs PM",
			            _AlertRateDelta < 0,
			                "▼ " & FORMAT ( ABS ( _AlertRateDelta ) * 100, "0.0", "de-DE" ) & " pp vs PM",
			            "— 0.0 pp vs PM"
			        )
			    )
			
			VAR _AverageRiskComparison =
			    IF (
			        ISBLANK ( _AverageRiskDelta ),
			        "— No PM data",
			        SWITCH (
			            TRUE (),
			            _AverageRiskDelta > 0,
			                "▲ " & FORMAT ( ABS ( _AverageRiskDelta ), "0.0", "de-DE" ) & " pts vs PM",
			            _AverageRiskDelta < 0,
			                "▼ " & FORMAT ( ABS ( _AverageRiskDelta ), "0.0", "de-DE" ) & " pts vs PM",
			            "— 0.0 pts vs PM"
			        )
			    )
			
			VAR _RevenueComparison =
			    IF (
			        ISBLANK ( _RevenueDeltaPct ),
			        "— No baseline",
			        SWITCH (
			            TRUE (),
			            _RevenueDeltaPct > 0,
			                "▲ " & FORMAT ( ABS ( _RevenueDeltaPct ), "0.0%", "de-DE" ) & " vs PM",
			            _RevenueDeltaPct < 0,
			                "▼ " & FORMAT ( ABS ( _RevenueDeltaPct ), "0.0%", "de-DE" ) & " vs PM",
			            "— 0.0% vs PM"
			        )
			    )
			
			RETURN
			IF (
			    ISBLANK ( _CurrentMonth ),
			    "
			    <div style='
			        padding:8px;
			        background:transparent;
			        color:#7A7480;
			        font:8px Segoe UI,Arial,sans-serif;'>
			        No risk data available
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .re-grid {
			            display:grid;
			            grid-template-columns:repeat(5,minmax(0,1fr));
			            gap:6px;
			            width:100%;
			            background:transparent;
			        }
			
			        .re-card {
			            position:relative;
			            min-width:0;
			            padding:9px 10px 8px;
			            overflow:hidden;
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.12);
			            border-radius:8px;
			            box-shadow:0 1px 3px rgba(51,16,69,.08);
			        }
			
			        .re-accent {
			            position:absolute;
			            top:0;
			            left:0;
			            width:100%;
			            height:3px;
			        }
			
			        .re-label {
			            margin-bottom:4px;
			            overflow:hidden;
			            color:#000000;
			            font-size:10px;
			            font-weight:700;
			            letter-spacing:.03em;
			            text-transform:uppercase;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .re-value {
			            margin-bottom:5px;
			            overflow:hidden;
			            font-size:clamp(18px,1.8vw,24px);
			            line-height:1;
			            font-weight:700;
			            letter-spacing:-.03em;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .re-bottom {
			            display:flex;
			            align-items:center;
			            gap:4px;
			            min-width:0;
			            overflow:hidden;
			        }
			
			        .re-delta {
			            flex-shrink:0;
			            padding:1px 4px;
			            border:1px solid;
			            border-radius:3px;
			            font-size:10px;
			            font-weight:600;
			            white-space:nowrap;
			        }
			
			        .re-meta {
			            min-width:0;
			            overflow:hidden;
			            color:#7A7480;
			            font-size:10px;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			    </style>
			
			    <div class='re-grid'>
			
			        <div class='re-card'>
			            <div class='re-accent'
			                 style='background:#C53D3D'></div>
			            <div class='re-label'>High-Risk Products</div>
			            <div class='re-value'
			                 style='color:#C53D3D'>
			                " & _ProductsFormatted & "
			            </div>
			            <div class='re-bottom'>
			                <span class='re-delta'
			                      style='color:" & _ProductsDeltaColor & ";
			                             border-color:" & _ProductsDeltaColor & "55;
			                             background:" & _ProductsDeltaColor & "10'>
			                    " & _ProductsComparison & "
			                </span>
			                <span class='re-meta'>distinct products</span>
			            </div>
			        </div>
			
			        <div class='re-card'>
			            <div class='re-accent'
			                 style='background:#D45A45'></div>
			            <div class='re-label'>High-Risk Alerts</div>
			            <div class='re-value'
			                 style='color:#D45A45'>
			                " & _AlertsFormatted & "
			            </div>
			            <div class='re-bottom'>
			                <span class='re-delta'
			                      style='color:" & _AlertsDeltaColor & ";
			                             border-color:" & _AlertsDeltaColor & "55;
			                             background:" & _AlertsDeltaColor & "10'>
			                    " & _AlertsComparison & "
			                </span>
			                <span class='re-meta'>product × region</span>
			            </div>
			        </div>
			
			        <div class='re-card'>
			            <div class='re-accent'
			                 style='background:#D99A2B'></div>
			            <div class='re-label'>High-Risk Alert Rate</div>
			            <div class='re-value'
			                 style='color:#D99A2B'>
			                " & _AlertRateFormatted & "
			            </div>
			            <div class='re-bottom'>
			                <span class='re-delta'
			                      style='color:" & _AlertRateDeltaColor & ";
			                             border-color:" & _AlertRateDeltaColor & "55;
			                             background:" & _AlertRateDeltaColor & "10'>
			                    " & _AlertRateComparison & "
			                </span>
			                <span class='re-meta'>alerts / assessed</span>
			            </div>
			        </div>
			
			        <div class='re-card'>
			            <div class='re-accent'
			                 style='background:#6F4A7C'></div>
			            <div class='re-label'>AVG Risk Score</div>
			            <div class='re-value'
			                 style='color:#6F4A7C'>
			                " & _AverageRiskFormatted & "
			            </div>
			            <div class='re-bottom'>
			                <span class='re-delta'
			                      style='color:" & _AverageRiskDeltaColor & ";
			                             border-color:" & _AverageRiskDeltaColor & "55;
			                             background:" & _AverageRiskDeltaColor & "10'>
			                    " & _AverageRiskComparison & "
			                </span>
			                <span class='re-meta'>portfolio avg · 0–10</span>
			            </div>
			        </div>
			
			        <div class='re-card'>
			            <div class='re-accent'
			                 style='background:#331045'></div>
			            <div class='re-label'>Revenue Under Watch</div>
			            <div class='re-value'
			                 style='color:#331045'>
			                " & _RevenueFormatted & "
			            </div>
			            <div class='re-bottom'>
			                <span class='re-delta'
			                      style='color:" & _RevenueDeltaColor & ";
			                             border-color:" & _RevenueDeltaColor & "55;
			                             background:" & _RevenueDeltaColor & "10'>
			                    " & _RevenueComparison & "
			                </span>
			                <span class='re-meta'>flagged revenue</span>
			            </div>
			        </div>
			
			    </div>
			    "
			)
		displayFolder: 01 Risk
		lineageTag: 2e39fc44-5366-4edf-a077-65c80d16dbe2

	measure 'DQ Chronological Dataset Split HTML' =
			
			VAR _AllSplitValues =
			    CALCULATETABLE (
			        VALUES ( factMlPredictions[split] ),
			        REMOVEFILTERS ()
			    )
			
			VAR _TrainSplitValues =
			    FILTER (
			        _AllSplitValues,
			        LOWER ( TRIM ( factMlPredictions[split] ) )
			            IN { "train", "training" }
			    )
			
			VAR _ValidationSplitValues =
			    FILTER (
			        _AllSplitValues,
			        LOWER ( TRIM ( factMlPredictions[split] ) )
			            IN { "valid", "validation", "validate" }
			    )
			
			VAR _TestSplitValues =
			    FILTER (
			        _AllSplitValues,
			        LOWER ( TRIM ( factMlPredictions[split] ) ) = "test"
			    )
			
			VAR _ScoringSplitValues =
			    FILTER (
			        _AllSplitValues,
			        LOWER ( TRIM ( factMlPredictions[split] ) )
			            IN { "scoring", "score", "unlabeled" }
			    )
			
			-- Row counts
			VAR _TrainRows =
			    CALCULATE (
			        COUNTROWS ( factMlPredictions ),
			        REMOVEFILTERS (),
			        _TrainSplitValues
			    )
			
			VAR _ValidationRows =
			    CALCULATE (
			        COUNTROWS ( factMlPredictions ),
			        REMOVEFILTERS (),
			        _ValidationSplitValues
			    )
			
			VAR _TestRows =
			    CALCULATE (
			        COUNTROWS ( factMlPredictions ),
			        REMOVEFILTERS (),
			        _TestSplitValues
			    )
			
			VAR _ScoringRows =
			    CALCULATE (
			        COUNTROWS ( factMlPredictions ),
			        REMOVEFILTERS (),
			        _ScoringSplitValues
			    )
			
			-- Start dates
			VAR _TrainStart =
			    CALCULATE (
			        MIN ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        _TrainSplitValues
			    )
			
			VAR _ValidationStart =
			    CALCULATE (
			        MIN ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        _ValidationSplitValues
			    )
			
			VAR _TestStart =
			    CALCULATE (
			        MIN ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        _TestSplitValues
			    )
			
			VAR _ScoringStart =
			    CALCULATE (
			        MIN ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        _ScoringSplitValues
			    )
			
			-- End dates
			VAR _TrainEnd =
			    CALCULATE (
			        MAX ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        _TrainSplitValues
			    )
			
			VAR _ValidationEnd =
			    CALCULATE (
			        MAX ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        _ValidationSplitValues
			    )
			
			VAR _TestEnd =
			    CALCULATE (
			        MAX ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        _TestSplitValues
			    )
			
			VAR _ScoringEnd =
			    CALCULATE (
			        MAX ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        _ScoringSplitValues
			    )
			
			-- Calendar duration controls the relative segment width
			VAR _TrainMonths =
			    IF (
			        _TrainRows > 0,
			        DATEDIFF ( _TrainStart, _TrainEnd, MONTH ) + 1,
			        0
			    )
			
			VAR _ValidationMonths =
			    IF (
			        _ValidationRows > 0,
			        DATEDIFF ( _ValidationStart, _ValidationEnd, MONTH ) + 1,
			        0
			    )
			
			VAR _TestMonths =
			    IF (
			        _TestRows > 0,
			        DATEDIFF ( _TestStart, _TestEnd, MONTH ) + 1,
			        0
			    )
			
			VAR _ScoringMonths =
			    IF (
			        _ScoringRows > 0,
			        DATEDIFF ( _ScoringStart, _ScoringEnd, MONTH ) + 1,
			        0
			    )
			
			-- Formatted values
			VAR _TrainRowsFormatted =
			    FORMAT ( _TrainRows, "#,0", "de-DE" ) & " rows"
			
			VAR _ValidationRowsFormatted =
			    FORMAT ( _ValidationRows, "#,0", "de-DE" ) & " rows"
			
			VAR _TestRowsFormatted =
			    FORMAT ( _TestRows, "#,0", "de-DE" ) & " rows"
			
			VAR _ScoringRowsFormatted =
			    FORMAT ( _ScoringRows, "#,0", "de-DE" ) & " rows"
			
			VAR _TrainStartFormatted =
			    FORMAT ( _TrainStart, "MMM yyyy" )
			
			VAR _TrainEndFormatted =
			    FORMAT ( _TrainEnd, "MMM yyyy" )
			
			VAR _ValidationStartFormatted =
			    FORMAT ( _ValidationStart, "MMM yyyy" )
			
			VAR _ValidationEndFormatted =
			    FORMAT ( _ValidationEnd, "MMM yyyy" )
			
			VAR _TestStartFormatted =
			    FORMAT ( _TestStart, "MMM yyyy" )
			
			VAR _TestEndFormatted =
			    FORMAT ( _TestEnd, "MMM yyyy" )
			
			VAR _ScoringStartFormatted =
			    FORMAT ( _ScoringStart, "MMM yyyy" )
			
			VAR _ScoringEndFormatted =
			    FORMAT ( _ScoringEnd, "MMM yyyy" )
			
			-- HTML segment blocks
			VAR _TrainBlock =
			    IF (
			        _TrainRows > 0,
			        "
			        <div class='split-segment train'
			             style='flex:" & _TrainMonths & " 1 0;
			                    min-width:150px;'>
			
			            <div class='split-info'>
			                <div class='split-name'>Train</div>
			                <div class='split-rows'>" & _TrainRowsFormatted & "</div>
			            </div>
			
			            <div class='split-bar'></div>
			
			            <div class='split-dates'>
			                <span>" & _TrainStartFormatted & "</span>
			                <span>" & _TrainEndFormatted & "</span>
			            </div>
			        </div>
			        "
			    )
			
			VAR _ValidationBlock =
			    IF (
			        _ValidationRows > 0,
			        "
			        <div class='split-segment validation'
			             style='flex:" & _ValidationMonths & " 1 0;
			                    min-width:105px;'>
			
			            <div class='split-info'>
			                <div class='split-name'>Validation</div>
			                <div class='split-rows'>" & _ValidationRowsFormatted & "</div>
			            </div>
			
			            <div class='split-bar'></div>
			
			            <div class='split-dates'>
			                <span>" & _ValidationStartFormatted & "</span>
			                <span>" & _ValidationEndFormatted & "</span>
			            </div>
			        </div>
			        "
			    )
			
			VAR _TestBlock =
			    IF (
			        _TestRows > 0,
			        "
			        <div class='split-segment test'
			             style='flex:" & _TestMonths & " 1 0;
			                    min-width:95px;'>
			
			            <div class='split-info'>
			                <div class='split-name'>Test</div>
			                <div class='split-rows'>" & _TestRowsFormatted & "</div>
			            </div>
			
			            <div class='split-bar'></div>
			
			            <div class='split-dates'>
			                <span>" & _TestStartFormatted & "</span>
			                <span>" & _TestEndFormatted & "</span>
			            </div>
			        </div>
			        "
			    )
			
			VAR _ScoringBlock =
			    IF (
			        _ScoringRows > 0,
			        "
			        <div class='split-segment scoring'
			             style='flex:" & _ScoringMonths & " 1 0;
			                    min-width:78px;'>
			
			            <div class='split-info'>
			                <div class='split-name'>Scoring</div>
			                <div class='split-rows'>" & _ScoringRowsFormatted & "</div>
			                <div class='split-note'>Unlabeled</div>
			            </div>
			
			            <div class='split-bar'></div>
			
			            <div class='split-dates'>
			                <span>" & _ScoringStartFormatted & "</span>
			                <span>" & _ScoringEndFormatted & "</span>
			            </div>
			        </div>
			        "
			    )
			
			VAR _TotalRows =
			    _TrainRows
			        + _ValidationRows
			        + _TestRows
			        + _ScoringRows
			-- 7A7480
			RETURN
			IF (
			    _TotalRows = 0,
			    "
			    <style>
			        html,
			        body {
			            width:100%;
			            height:100%;
			            min-height:100%;
			            margin:0;
			            padding:0;
			            background:#FFFFFF;
			            overflow:hidden;
			        }
			
			        * {
			            box-sizing:border-box;
			        }
			    </style>
			
			    <div style='
			        width:100vw;
			        height:100vh;
			        display:flex;
			        align-items:center;
			        justify-content:center;
			        padding:12px;
			        color:#26232A;
			        background:#FFFFFF;
			        font:10px Segoe UI,Arial,sans-serif;'>
			        No dataset-split information available
			    </div>
			    ",
			    "
			    <style>
			
			        html,
			        body {
			            width:100%;
			            height:100%;
			            min-height:100%;
			            margin:0;
			            padding:0;
			            background:#FFFFFF;
			            overflow:hidden;
			        }
			
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .split-wrapper {
			            width:100%;
			            height:100vh;
			            min-height:100%;
			
			            display:flex;
			            flex-direction:column;
			
			            padding:5px 5px 5px;
			
			            overflow:hidden;
			
			            color:#000000;
			            background:#FFFFFF;
			
			            border:1px solid #E7E1E9;
			            border-radius:5px;
			        }
			
			        .split-title {
			            flex:0 0 auto;
			
			            margin-bottom:8px;
			
			            color:#000000;
			
			            font-size:15px;
			            font-weight:700;
			            text-transform:uppercase;
			        }
			
			        .split-timeline {
			            flex:1 1 auto;
			            min-height:0;
			
			            display:flex;
			            align-items:center;
			
			            width:100%;
			            min-width:600px;
			
			            overflow:hidden;
			        }
			
			        .split-segment {
			            position:relative;
			
			            display:flex;
			            flex-direction:column;
			            justify-content:center;
			
			            min-width:0;
			            min-height:0;
			        }
			        .split-info {
			            flex:1 1 auto;
			
			            display:flex;
			            flex-direction:column;
			            align-items:center;
			            justify-content:flex-end;
			            min-height:48px;
			
			            margin-bottom:8px;
			
			            text-align:center;
			            white-space:nowrap;
			        }
			
			        .split-name {
			            font-size:13px;
			            line-height:1.15;
			            font-weight:700;
			        }
			
			        .split-rows {
			            margin-top:4px;
			
			            color:#59535C;
			
			            font-size:11px;
			            line-height:1.15;
			            font-weight:600;
			        }
			
			        .split-note {
			            margin-top:3px;
			
			            color:#8A6C91;
			
			            font-size:11px;
			            line-height:1.1;
			        }
			
			        .split-bar {
			            position:relative;
			
			            flex:0 0 auto;
			
			            height:clamp(34px,12vh,70px);
			
			            border-right:1px solid rgba(255,255,255,.65);
			        }
			
			        .split-bar::before {
			            position:absolute;
			
			            top:-6px;
			            left:0;
			
			            width:1px;
			            height:calc(100% + 12px);
			
			            background:#BDB6C0;
			
			            content:'';
			        }
			
			        .split-segment:last-child .split-bar::after {
			            position:absolute;
			
			            top:-6px;
			            right:0;
			
			            width:1px;
			            height:calc(100% + 12px);
			
			            background:#BDB6C0;
			
			            content:'';
			        }
			
			        .split-dates {
			            flex:0 0 auto;
			
			            display:flex;
			            justify-content:space-between;
			
			            gap:5px;
			
			            padding:10px 6px 2px;
			
			            color:#5F5962;
			
			            font-size:11px;
			            line-height:1.1;
			            font-weight:500;
			
			            white-space:nowrap;
			        }
			
			        .train .split-name {
			            color:#331045;
			        }
			
			        .train .split-bar {
			            background:#331045;
			        }
			
			        .validation .split-name {
			            color:#6F4A7C;
			        }
			
			        .validation .split-bar {
			            background:#6F4A7C;
			        }
			
			        .test .split-name {
			            color:#946AA0;
			        }
			
			        .test .split-bar {
			            background:#946AA0;
			        }
			
			        .scoring .split-name {
			            color:#A98BAF;
			        }
			
			        .scoring .split-bar {
			            background:#C6B3CA;
			        }
			
			    </style>
			
			
			    <div class='split-wrapper'>
			
			        <div class='split-title'>
			            Chronological Dataset Split
			        </div>
			
			        <div class='split-timeline'>
			
			            " & _TrainBlock & "
			            " & _ValidationBlock & "
			            " & _TestBlock & "
			            " & _ScoringBlock & "
			
			        </div>
			
			    </div>
			    "
			)
		displayFolder: 07 Data Quality
		lineageTag: edc98af3-13cb-4a8d-ac10-7ef37754a723

	measure 'DQ Pipeline Run HTML' =
			
			VAR _LastRefresh =
			    MAX ( factPipelineRunMetadata[LastRefreshUTC] )
			
			VAR _RuntimeSeconds =
			    MAX ( factPipelineRunMetadata[RuntimeSeconds] )
			
			VAR _ModelRunID =
			    SELECTEDVALUE (
			        factPipelineRunMetadata[ModelRunID],
			        "Not available"
			    )
			
			VAR _ArtifactsCreated =
			    MAX ( factPipelineRunMetadata[ArtifactsCreated] )
			
			VAR _ArtifactsExpected =
			    MAX ( factPipelineRunMetadata[ArtifactsExpected] )
			
			VAR _Owner =
			    SELECTEDVALUE (
			        factPipelineRunMetadata[Owner],
			        "Not assigned"
			    )
			
			VAR _NextRefresh =
			    MAX ( factPipelineRunMetadata[NextRefreshUTC] )
			
			-- Pipeline status
			VAR _IsSuccessful =
			    _ArtifactsExpected > 0
			        && _ArtifactsCreated = _ArtifactsExpected
			
			VAR _StatusLabel =
			    IF (
			        _IsSuccessful,
			        "Successful",
			        "Incomplete"
			    )
			
			VAR _StatusColor =
			    IF (
			        _IsSuccessful,
			        "#2F855A",
			        "#C53D3D"
			    )
			
			VAR _StatusBackground =
			    IF (
			        _IsSuccessful,
			        "#F0F8F4",
			        "#FDF2F2"
			    )
			
			-- Runtime formatting
			VAR _RuntimeHours =
			    INT ( DIVIDE ( _RuntimeSeconds, 3600 ) )
			
			VAR _RuntimeMinutes =
			    INT (
			        DIVIDE (
			            MOD ( _RuntimeSeconds, 3600 ),
			            60
			        )
			    )
			
			VAR _RuntimeRemainingSeconds =
			    MOD ( _RuntimeSeconds, 60 )
			
			VAR _RuntimeFormatted =
			    IF (
			        _RuntimeHours > 0,
			        FORMAT ( _RuntimeHours, "00" ) & "h ",
			        ""
			    )
			        & FORMAT ( _RuntimeMinutes, "00" ) & "m "
			        & FORMAT ( _RuntimeRemainingSeconds, "00" ) & "s"
			
			-- Other formatted values
			VAR _LastRefreshFormatted =
			    FORMAT (
			        _LastRefresh,
			        "dd MMM yyyy · HH:mm"
			    )
			        & " UTC"
			
			VAR _NextRefreshFormatted =
			    FORMAT (
			        _NextRefresh,
			        "dd MMM yyyy, HH:mm"
			    )
			        & " UTC"
			
			VAR _ArtifactsFormatted =
			    FORMAT ( _ArtifactsCreated, "#,0" )
			        & " / "
			        & FORMAT ( _ArtifactsExpected, "#,0" )
			
			RETURN
			IF (
			    ISBLANK ( _LastRefresh ),
			    "
			    <div style='
			        padding:12px;
			        color:#7A7480;
			        background:#FFFFFF;
			        font:11px Segoe UI,Arial,sans-serif;'>
			        No pipeline information available
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .pipeline-card {
			            width:100%;
			            padding:5px 5px 5px;
			            color:#26232A;
			            background:#FFFFFF;
			            border:1px solid #E5E0E7;
			            border-radius:5px;
			        }
			
			        .pipeline-header {
			            display:flex;
			            align-items:center;
			            justify-content:space-between;
			            gap:12px;
			            margin-bottom:7px;
			        }
			
			        .pipeline-title {
			            font-size:15px;
			            font-weight:700;
			            color:#000000;
			            text-transform:uppercase;
			        }
			
			        .status-area {
			            display:flex;
			            align-items:center;
			            gap:6px;
			        }
			
			        .status-icon {
			            display:flex;
			            width:18px;
			            height:18px;
			            align-items:center;
			            justify-content:center;
			            flex-shrink:0;
			            color:#FFFFFF;
			            background:" & _StatusColor & ";
			            border-radius:50%;
			            font-size:12px;
			            font-weight:500;
			        }
			
			        .status-badge {
			            padding:4px 8px;
			            color:" & _StatusColor & ";
			            background:" & _StatusBackground & ";
			            border:1px solid " & _StatusColor & ";
			            border-radius:4px;
			            font-size:12px;
			            font-weight:500;
			        }
			
			        .pipeline-row {
			            display:grid;
			            grid-template-columns:minmax(125px,42%) 1fr;
			            gap:10px;
			            align-items:center;
			            padding:6px 0;
			            border-bottom:1px dashed #DDD8DF;
			            font-size:12px;
			        }
			
			        .pipeline-label {
			            overflow:hidden;
			            color:#4E4851;
			            font-weight:400;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .pipeline-value {
			            overflow:hidden;
			            color:#26232A;
			            font-weight:400;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .pipeline-row:last-of-type {
			            border-bottom:none;
			        }
			
			        .next-refresh {
			            display:flex;
			            align-items:center;
			            gap:8px;
			            margin-top:8px;
			            padding:7px 9px;
			            color:#4E4851;
			            background:#FFF9F1;
			            border:1px solid #EDA849;
			            border-radius:5px;
			            font-size:12px;
			        }
			
			        .clock {
			            position:relative;
			            width:16px;
			            height:16px;
			            flex-shrink:0;
			            border:2px solid #D98216;
			            border-radius:50%;
			        }
			
			        .clock::before {
			            position:absolute;
			            top:3px;
			            left:6px;
			            width:1.5px;
			            height:4px;
			            background:#D98216;
			            border-radius:2px;
			            content:'';
			        }
			
			        .clock::after {
			            position:absolute;
			            top:6px;
			            left:6px;
			            width:4px;
			            height:1.5px;
			            background:#D98216;
			            border-radius:2px;
			            transform:rotate(35deg);
			            transform-origin:left center;
			            content:'';
			        }
			
			        .next-label {
			            font-weight:400;
			        }
			
			        .next-separator {
			            margin:0 3px;
			            color:#A39DA6;
			        }
			
			        .next-date {
			            color:#26232A;
			            font-weight:400;
			        }
			    </style>
			
			    <div class='pipeline-card'>
			
			        <div class='pipeline-header'>
			            <div class='pipeline-title'>Pipeline Run</div>
			
			            <div class='status-area'>
			                <div class='status-icon'>
			                    " & IF ( _IsSuccessful, "&#10003;", "!" ) & "
			                </div>
			
			                <div class='status-badge'>
			                    " & _StatusLabel & "
			                </div>
			            </div>
			        </div>
			
			        <div class='pipeline-row'>
			            <div class='pipeline-label'>
			                Last successful refresh
			            </div>
			            <div class='pipeline-value'>
			                " & _LastRefreshFormatted & "
			            </div>
			        </div>
			
			        <div class='pipeline-row'>
			            <div class='pipeline-label'>Runtime</div>
			            <div class='pipeline-value'>
			                " & _RuntimeFormatted & "
			            </div>
			        </div>
			
			        <div class='pipeline-row'>
			            <div class='pipeline-label'>Model run ID</div>
			            <div class='pipeline-value'>
			                " & _ModelRunID & "
			            </div>
			        </div>
			
			        <div class='pipeline-row'>
			            <div class='pipeline-label'>Output artifacts</div>
			            <div class='pipeline-value'>
			                " & _ArtifactsFormatted & "
			            </div>
			        </div>
			
			        <div class='pipeline-row'>
			            <div class='pipeline-label'>Owner</div>
			            <div class='pipeline-value'>
			                " & _Owner & "
			            </div>
			        </div>
			
			        <div class='next-refresh'>
			            <div class='clock'></div>
			
			            <div>
			                <span class='next-label'>
			                    Next scheduled refresh
			                </span>
			
			                <span class='next-separator'>·</span>
			
			                <span class='next-date'>
			                    " & _NextRefreshFormatted & "
			                </span>
			            </div>
			        </div>
			
			    </div>
			    "
			)
		displayFolder: 07 Data Quality
		lineageTag: d4622ee3-ae91-445f-b127-5cc70ddb44d0

	measure 'Margin Profitability KPIs HTML' =
			
			VAR GrossProfitValue = [Gross Profit]
			VAR GrossProfitPY = [Gross Profit PY]
			VAR GrossProfitChange =
			    DIVIDE (
			        GrossProfitValue - GrossProfitPY,
			        ABS ( GrossProfitPY )
			    )
			
			VAR GrossMarginValue = [Gross Margin %]
			VAR GrossMarginPY = [Gross Margin % PY]
			VAR GrossMarginChangePP =
			    GrossMarginValue - GrossMarginPY
			
			VAR ASPValue = [ASP]
			VAR ASPPY = [ASP PY]
			VAR ASPChange =
			    DIVIDE (
			        ASPValue - ASPPY,
			        ABS ( ASPPY )
			    )
			
			VAR MarginUnitValue = [Margin per Unit]
			VAR MarginUnitPY = [Margin per Unit PY]
			VAR MarginUnitChange =
			    DIVIDE (
			        MarginUnitValue - MarginUnitPY,
			        ABS ( MarginUnitPY )
			    )
			
			VAR DiscountValue = [Discount % avg]
			VAR DiscountPY = [Discount % avg PY]
			VAR DiscountChangePP =
			    DiscountValue - DiscountPY
			
			
			-- VALUE FORMATTING
			
			VAR GrossProfitFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( GrossProfitValue ), "–",
			        ABS ( GrossProfitValue ) >= 1000000000,
			            FORMAT ( GrossProfitValue / 1000000000, "€0.0","de-DE" ) & "B",
			        ABS ( GrossProfitValue ) >= 1000000,
			            FORMAT ( GrossProfitValue / 1000000, "€0.0","de-DE" ) & "M",
			        ABS ( GrossProfitValue ) >= 1000,
			            FORMAT ( GrossProfitValue / 1000, "€0.0","de-DE" ) & "K",
			        FORMAT ( GrossProfitValue, "€#,0","de-DE" )
			    )
			
			VAR GrossProfitPYFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( GrossProfitPY ), "–",
			        ABS ( GrossProfitPY ) >= 1000000000,
			            FORMAT ( GrossProfitPY / 1000000000, "€0.0","de-DE" ) & "B",
			        ABS ( GrossProfitPY ) >= 1000000,
			            FORMAT ( GrossProfitPY / 1000000, "€0.0","de-DE" ) & "M",
			        ABS ( GrossProfitPY ) >= 1000,
			            FORMAT ( GrossProfitPY / 1000, "€0.0","de-DE" ) & "K",
			        FORMAT ( GrossProfitPY, "€#,0","de-DE" )
			    )
			
			VAR GrossMarginFormatted =
			    IF (
			        ISBLANK ( GrossMarginValue ),
			        "–",
			        FORMAT ( GrossMarginValue, "0.0%","de-DE" )
			    )
			
			VAR GrossMarginPYFormatted =
			    IF (
			        ISBLANK ( GrossMarginPY ),
			        "–",
			        FORMAT ( GrossMarginPY, "0.0%","de-DE" )
			    )
			
			VAR ASPFormatted =
			    IF (
			        ISBLANK ( ASPValue ),
			        "–",
			        FORMAT ( ASPValue, "€#,0.0","de-DE" )
			    )
			
			VAR ASPPYFormatted =
			    IF (
			        ISBLANK ( ASPPY ),
			        "–",
			        FORMAT ( ASPPY, "€#,0.0","de-DE" )
			    )
			
			VAR MarginUnitFormatted =
			    IF (
			        ISBLANK ( MarginUnitValue ),
			        "–",
			        FORMAT ( MarginUnitValue, "€#,0.0","de-DE" )
			    )
			
			VAR MarginUnitPYFormatted =
			    IF (
			        ISBLANK ( MarginUnitPY ),
			        "–",
			        FORMAT ( MarginUnitPY, "€#,0.0","de-DE" )
			    )
			
			VAR DiscountFormatted =
			    IF (
			        ISBLANK ( DiscountValue ),
			        "–",
			        FORMAT ( DiscountValue, "0.0%","de-DE" )
			    )
			
			VAR DiscountPYFormatted =
			    IF (
			        ISBLANK ( DiscountPY ),
			        "–",
			        FORMAT ( DiscountPY, "0.0%","de-DE" )
			    )
			
			
			-- COMPARISON TEXT
			
			VAR GrossProfitComparison =
			    IF (
			        ISBLANK ( GrossProfitPY ),
			        "No PY comparison",
			        SWITCH (
			            TRUE (),
			            GrossProfitChange > 0,
			                "&#9650; " & FORMAT ( ABS ( GrossProfitChange ), "0.0%", "de-DE" ) & " vs PY",
			            GrossProfitChange < 0,
			                "&#9660; " & FORMAT ( ABS ( GrossProfitChange ), "0.0%","de-DE" ) & " vs PY",
			            "&#8226; No change vs PY"
			        )
			    )
			
			VAR GrossMarginComparison =
			    IF (
			        ISBLANK ( GrossMarginPY ),
			        "No PY comparison",
			        SWITCH (
			            TRUE (),
			            GrossMarginChangePP > 0,
			                "&#9650; " & FORMAT ( ABS ( GrossMarginChangePP ) * 100, "0.0","de-DE" ) & " pp vs PY",
			            GrossMarginChangePP < 0,
			                "&#9660; " & FORMAT ( ABS ( GrossMarginChangePP ) * 100, "0.0","de-DE" ) & " pp vs PY",
			            "&#8226; No change vs PY"
			        )
			    )
			
			VAR ASPComparison =
			    IF (
			        ISBLANK ( ASPPY ),
			        "No PY comparison",
			        SWITCH (
			            TRUE (),
			            ASPChange > 0,
			                "&#9650; " & FORMAT ( ABS ( ASPChange ), "0.0%","de-DE" ) & " vs PY",
			            ASPChange < 0,
			                "&#9660; " & FORMAT ( ABS ( ASPChange ), "0.0%","de-DE" ) & " vs PY",
			            "&#8226; No change vs PY"
			        )
			    )
			
			VAR MarginUnitComparison =
			    IF (
			        ISBLANK ( MarginUnitPY ),
			        "No PY comparison",
			        SWITCH (
			            TRUE (),
			            MarginUnitChange > 0,
			                "&#9650; " & FORMAT ( ABS ( MarginUnitChange ), "0.0%","de-DE" ) & " vs PY",
			            MarginUnitChange < 0,
			                "&#9660; " & FORMAT ( ABS ( MarginUnitChange ), "0.0%", "de-DE" ) & " vs PY",
			            "&#8226; No change vs PY"
			        )
			    )
			
			-- Lower discount is considered positive
			VAR DiscountComparison =
			    IF (
			        ISBLANK ( DiscountPY ),
			        "No PY comparison",
			        SWITCH (
			            TRUE (),
			            DiscountChangePP < 0,
			                "&#9660; " & FORMAT ( ABS ( DiscountChangePP ) * 100, "0.0", "de-DE" ) & " pp vs PY",
			            DiscountChangePP > 0,
			                "&#9650; " & FORMAT ( ABS ( DiscountChangePP ) * 100, "0.0","de-DE" ) & " pp vs PY",
			            "&#8226; No change vs PY"
			        )
			    )
			
			
			-- COMPARISON COLORS
			
			VAR GrossProfitColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( GrossProfitPY ), "#7A737E",
			        GrossProfitChange > 0, "#2F855A",
			        GrossProfitChange < 0, "#C53D3D",
			        "#7A737E"
			    )
			
			VAR GrossMarginColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( GrossMarginPY ), "#7A737E",
			        GrossMarginChangePP > 0, "#2F855A",
			        GrossMarginChangePP < 0, "#C53D3D",
			        "#7A737E"
			    )
			
			VAR ASPColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( ASPPY ), "#7A737E",
			        ASPChange > 0, "#2F855A",
			        ASPChange < 0, "#C53D3D",
			        "#7A737E"
			    )
			
			VAR MarginUnitColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( MarginUnitPY ), "#7A737E",
			        MarginUnitChange > 0, "#2F855A",
			        MarginUnitChange < 0, "#C53D3D",
			        "#7A737E"
			    )
			
			VAR DiscountColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( DiscountPY ), "#7A737E",
			        DiscountChangePP < 0, "#2F855A",
			        DiscountChangePP > 0, "#C53D3D",
			        "#7A737E"
			    )
			
			RETURN
			IF (
			    ISBLANK ( GrossProfitValue )
			        && ISBLANK ( GrossMarginValue )
			        && ISBLANK ( ASPValue )
			        && ISBLANK ( MarginUnitValue )
			        && ISBLANK ( DiscountValue ),
			    "
			    <div style='
			        padding:8px;
			        background:transparent;
			        color:#7A7480;
			        font:8px Segoe UI,Arial,sans-serif;'>
			        No profitability data
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .pf-grid {
			            display:grid;
			            grid-template-columns:repeat(5,minmax(0,1fr));
			            gap:6px;
			            width:100%;
			            background:transparent;
			        }
			
			        .pf-card {
			            position:relative;
			            min-width:0;
			            padding:9px 10px 8px;
			            overflow:hidden;
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.14);
			            border-radius:8px;
			        }
			
			        .pf-accent {
			            position:absolute;
			            top:0;
			            left:0;
			            width:100%;
			            height:3px;
			        }
			
			        .pf-label {
			            margin-bottom:4px;
			            overflow:hidden;
			            color:#000000;
			            font-size:10px;
			            font-weight:700;
			            letter-spacing:.035em;
			            text-transform:uppercase;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .pf-value {
			            margin-bottom:5px;
			            overflow:hidden;
			            font-size:clamp(18px,1.7vw,24px);
			            font-weight:700;
			            letter-spacing:-.03em;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .pf-bottom {
			            display:flex;
			            align-items:center;
			            gap:4px;
			            min-width:0;
			            overflow:hidden;
			        }
			
			        .pf-delta {
			            flex-shrink:0;
			            padding:1px 4px;
			            border:1px solid;
			            border-radius:3px;
			            font-size:10px;
			            font-weight:600;
			            white-space:nowrap;
			        }
			
			        .pf-meta {
			            min-width:0;
			            overflow:hidden;
			            color:#7A7480;
			            font-size:10px;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			    </style>
			
			    <div class='pf-grid'>
			
			        <div class='pf-card'>
			            <div class='pf-accent'
			                 style='background:#331045'></div>
			
			            <div class='pf-label'>
			                Gross Profit
			            </div>
			
			            <div class='pf-value'
			                 style='color:#331045'>
			                " & GrossProfitFormatted & "
			            </div>
			
			            <div class='pf-bottom'>
			                <span class='pf-delta'
			                      style='
			                          color:" & GrossProfitColor & ";
			                          border-color:" & GrossProfitColor & "55;
			                          background:" & GrossProfitColor & "10;'>
			                    " & GrossProfitComparison & "
			                </span>
			
			                <span class='pf-meta'>
			                    profit after costs
			                </span>
			            </div>
			        </div>
			
			
			        <div class='pf-card'>
			            <div class='pf-accent'
			                 style='background:#6F4A7C'></div>
			
			            <div class='pf-label'>
			                Gross Margin
			            </div>
			
			            <div class='pf-value'
			                 style='color:#6F4A7C'>
			                " & GrossMarginFormatted & "
			            </div>
			
			            <div class='pf-bottom'>
			                <span class='pf-delta'
			                      style='
			                          color:" & GrossMarginColor & ";
			                          border-color:" & GrossMarginColor & "55;
			                          background:" & GrossMarginColor & "10;'>
			                    " & GrossMarginComparison & "
			                </span>
			
			                <span class='pf-meta'>
			                    profit / revenue
			                </span>
			            </div>
			        </div>
			
			
			        <div class='pf-card'>
			            <div class='pf-accent'
			                 style='background:#2F855A'></div>
			
			            <div class='pf-label'>
			                ASP
			            </div>
			
			            <div class='pf-value'
			                 style='color:#2F855A'>
			                " & ASPFormatted & "
			            </div>
			
			            <div class='pf-bottom'>
			                <span class='pf-delta'
			                      style='
			                          color:" & ASPColor & ";
			                          border-color:" & ASPColor & "55;
			                          background:" & ASPColor & "10;'>
			                    " & ASPComparison & "
			                </span>
			
			                <span class='pf-meta'>
			                    revenue / unit
			                </span>
			            </div>
			        </div>
			
			
			        <div class='pf-card'>
			            <div class='pf-accent'
			                 style='background:#4F7664'></div>
			
			            <div class='pf-label'>
			                Margin per Unit
			            </div>
			
			            <div class='pf-value'
			                 style='color:#4F7664'>
			                " & MarginUnitFormatted & "
			            </div>
			
			            <div class='pf-bottom'>
			                <span class='pf-delta'
			                      style='
			                          color:" & MarginUnitColor & ";
			                          border-color:" & MarginUnitColor & "55;
			                          background:" & MarginUnitColor & "10;'>
			                    " & MarginUnitComparison & "
			                </span>
			
			                <span class='pf-meta'>
			                    profit / unit
			                </span>
			            </div>
			        </div>
			
			
			        <div class='pf-card'>
			            <div class='pf-accent'
			                 style='background:#D99A2B'></div>
			
			            <div class='pf-label'>
			                AVG Discount
			            </div>
			
			            <div class='pf-value'
			                 style='color:#D99A2B'>
			                " & DiscountFormatted & "
			            </div>
			
			            <div class='pf-bottom'>
			                <span class='pf-delta'
			                      style='
			                          color:" & DiscountColor & ";
			                          border-color:" & DiscountColor & "55;
			                          background:" & DiscountColor & "10;'>
			                    " & DiscountComparison & "
			                </span>
			
			                <span class='pf-meta'>
			                    weighted discount
			                </span>
			            </div>
			        </div>
			
			    </div>
			    "
			)
		displayFolder: 02 Margin
		lineageTag: 8a828771-bd99-4c29-9013-6193cc1be90b

	measure 'Customer KPIs - HTML' =
			
			VAR ActiveValue = [Customers Active]
			VAR ActivePY = [Customer Active PY]
			VAR ActiveChange =
			    DIVIDE (
			        ActiveValue - ActivePY,
			        ABS ( ActivePY )
			    )
			
			VAR NewValue = [Customers New]
			VAR NewPY = [Customers New PY]
			VAR NewChange =
			    DIVIDE (
			        NewValue - NewPY,
			        ABS ( NewPY )
			    )
			
			VAR ChurnValue = [Customers Churn]
			VAR ChurnPY = [Customers Churn PY]
			VAR ChurnChange =
			    DIVIDE (
			        ChurnValue - ChurnPY,
			        ABS ( ChurnPY )
			    )
			
			VAR RetentionValue = [Customer Retention %]
			VAR RetentionPY = [Customer Retention % PY]
			VAR RetentionChangePP =
			    RetentionValue - RetentionPY
			
			VAR NRRValue = [NRR %]
			VAR NRRPY = [NRR % PY]
			VAR NRRChangePP =
			    NRRValue - NRRPY
			
			
			-- FORMATTED VALUES
			
			VAR ActiveFormatted =
			    COALESCE ( FORMAT ( ActiveValue, "#,0" ), "–" )
			VAR ActivePYFormatted =
			    COALESCE ( FORMAT ( ActivePY, "#,0" ), "–" )
			
			VAR NewFormatted =
			    COALESCE ( FORMAT ( NewValue, "#,0" ), "–" )
			VAR NewPYFormatted =
			    COALESCE ( FORMAT ( NewPY, "#,0" ), "–" )
			
			VAR ChurnFormatted =
			    COALESCE ( FORMAT ( ChurnValue, "#,0" ), "–" )
			VAR ChurnPYFormatted =
			    COALESCE ( FORMAT ( ChurnPY, "#,0" ), "–" )
			
			VAR RetentionFormatted =
			    COALESCE ( FORMAT ( RetentionValue, "0.0%" ), "–" )
			VAR RetentionPYFormatted =
			    COALESCE ( FORMAT ( RetentionPY, "0.0%" ), "–" )
			
			VAR NRRFormatted =
			    COALESCE ( FORMAT ( NRRValue, "0.0%" ), "–" )
			VAR NRRPYFormatted =
			    COALESCE ( FORMAT ( NRRPY, "0.0%" ), "–" )
			
			
			-- COMPARISON TEXT
			
			VAR ActiveComparison =
			    IF (
			        ISBLANK ( ActiveChange ),
			        "No PY comparison",
			        SWITCH (
			            TRUE (),
			            ActiveChange > 0,
			                "&#9650; " & FORMAT ( ABS ( ActiveChange ), "0.0%" ) & " vs PY",
			            ActiveChange < 0,
			                "&#9660; " & FORMAT ( ABS ( ActiveChange ), "0.0%" ) & " vs PY",
			            "&#8226; No change vs PY"
			        )
			    )
			
			VAR NewComparison =
			    IF (
			        ISBLANK ( NewChange ),
			        "No PY comparison",
			        SWITCH (
			            TRUE (),
			            NewChange > 0,
			                "&#9650; " & FORMAT ( ABS ( NewChange ), "0.0%" ) & " vs PY",
			            NewChange < 0,
			                "&#9660; " & FORMAT ( ABS ( NewChange ), "0.0%" ) & " vs PY",
			            "&#8226; No change vs PY"
			        )
			    )
			
			VAR ChurnComparison =
			    IF (
			        ISBLANK ( ChurnChange ),
			        "No PY comparison",
			        SWITCH (
			            TRUE (),
			            ChurnChange < 0,
			                "&#9660; " & FORMAT ( ABS ( ChurnChange ), "0.0%" ) & " vs PY",
			            ChurnChange > 0,
			                "&#9650; " & FORMAT ( ABS ( ChurnChange ), "0.0%" ) & " vs PY",
			            "&#8226; No change vs PY"
			        )
			    )
			
			VAR RetentionComparison =
			    IF (
			        ISBLANK ( RetentionPY ),
			        "No PY comparison",
			        SWITCH (
			            TRUE (),
			            RetentionChangePP > 0,
			                "&#9650; " & FORMAT ( ABS ( RetentionChangePP ) * 100, "0.0" ) & " pp vs PY",
			            RetentionChangePP < 0,
			                "&#9660; " & FORMAT ( ABS ( RetentionChangePP ) * 100, "0.0" ) & " pp vs PY",
			            "&#8226; No change vs PY"
			        )
			    )
			
			VAR NRRComparison =
			    IF (
			        ISBLANK ( NRRPY ),
			        "No PY comparison",
			        SWITCH (
			            TRUE (),
			            NRRChangePP > 0,
			                "&#9650; " & FORMAT ( ABS ( NRRChangePP ) * 100, "0.0" ) & " pp vs PY",
			            NRRChangePP < 0,
			                "&#9660; " & FORMAT ( ABS ( NRRChangePP ) * 100, "0.0" ) & " pp vs PY",
			            "&#8226; No change vs PY"
			        )
			    )
			
			
			-- COMPARISON COLORS
			
			VAR ActiveColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( ActiveChange ), "#7A737E",
			        ActiveChange > 0, "#2F855A",
			        ActiveChange < 0, "#C53D3D",
			        "#7A737E"
			    )
			
			VAR NewColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( NewChange ), "#7A737E",
			        NewChange > 0, "#2F855A",
			        NewChange < 0, "#C53D3D",
			        "#7A737E"
			    )
			
			-- Less churn is positive
			VAR ChurnColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( ChurnChange ), "#7A737E",
			        ChurnChange < 0, "#2F855A",
			        ChurnChange > 0, "#C53D3D",
			        "#7A737E"
			    )
			
			VAR RetentionColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( RetentionPY ), "#7A737E",
			        RetentionChangePP > 0, "#2F855A",
			        RetentionChangePP < 0, "#C53D3D",
			        "#7A737E"
			    )
			
			VAR NRRColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( NRRPY ), "#7A737E",
			        NRRChangePP > 0, "#2F855A",
			        NRRChangePP < 0, "#C53D3D",
			        "#7A737E"
			    )
			
			
			RETURN
			    "
			    <style>
			        .lumora-customer-kpis {
			            width: 100%;
			            box-sizing: border-box;
			            font-family: 'Segoe UI', Arial, sans-serif;
			            color: #26232A;
			        }
			
			        .customer-kpi-grid {
			            display: grid;
			            grid-template-columns: repeat(5, minmax(0, 1fr));
			            gap: 10px;
			            width: 100%;
			        }
			
			        .customer-kpi-card {
			            position: relative;
			            box-sizing: border-box;
			            min-width: 0;
			            min-height: 132px;
			            padding: 14px 14px 12px 17px;
			            overflow: hidden;
			            background: #FFFFFF;
			            border: 1px solid #E8E2EA;
			            border-radius: 12px;
			            box-shadow: 0 2px 8px rgba(51,16,69,0.06);
			        }
			
			        .customer-kpi-card::before {
			            content: '';
			            position: absolute;
			            top: 0;
			            bottom: 0;
			            left: 0;
			            width: 4px;
			            background: #331045;
			        }
			
			        .customer-kpi-label {
			            margin-bottom: 6px;
			            color: #625B66;
			            font-size: 11px;
			            font-weight: 600;
			            line-height: 1.25;
			            letter-spacing: 0.2px;
			        }
			
			        .customer-kpi-value {
			            margin-bottom: 6px;
			            color: #331045;
			            font-size: 23px;
			            font-weight: 700;
			            line-height: 1.1;
			            white-space: nowrap;
			        }
			
			        .customer-kpi-comparison {
			            margin-bottom: 4px;
			            font-size: 10px;
			            font-weight: 700;
			            line-height: 1.3;
			        }
			
			        .customer-kpi-py {
			            color: #817985;
			            font-size: 9px;
			            font-weight: 500;
			            line-height: 1.3;
			        }
			
			        .customer-kpi-explanation {
			            margin-top: 7px;
			            color: #817985;
			            font-size: 9px;
			            line-height: 1.3;
			        }
			
			        @media (max-width: 850px) {
			            .customer-kpi-grid {
			                grid-template-columns: repeat(2, minmax(0, 1fr));
			            }
			        }
			
			        @media (max-width: 450px) {
			            .customer-kpi-grid {
			                grid-template-columns: 1fr;
			            }
			        }
			    </style>
			
			    <div class='lumora-customer-kpis'>
			        <div class='customer-kpi-grid'>
			
			            <div class='customer-kpi-card'>
			                <div class='customer-kpi-label'>Active Customers</div>
			                <div class='customer-kpi-value'>" & ActiveFormatted & "</div>
			                <div class='customer-kpi-comparison' style='color:" & ActiveColor & ";'>
			                    " & ActiveComparison & "
			                </div>
			                <div class='customer-kpi-py'>PY " & ActivePYFormatted & "</div>
			                <div class='customer-kpi-explanation'>Customers purchasing in the selected period</div>
			            </div>
			
			            <div class='customer-kpi-card'>
			                <div class='customer-kpi-label'>New Customers</div>
			                <div class='customer-kpi-value'>" & NewFormatted & "</div>
			                <div class='customer-kpi-comparison' style='color:" & NewColor & ";'>
			                    " & NewComparison & "
			                </div>
			                <div class='customer-kpi-py'>PY " & NewPYFormatted & "</div>
			                <div class='customer-kpi-explanation'>Customers making their first-ever purchase</div>
			            </div>
			
			            <div class='customer-kpi-card'>
			                <div class='customer-kpi-label'>Churn Customers</div>
			                <div class='customer-kpi-value'>" & ChurnFormatted & "</div>
			                <div class='customer-kpi-comparison' style='color:" & ChurnColor & ";'>
			                    " & ChurnComparison & "
			                </div>
			                <div class='customer-kpi-py'>PY " & ChurnPYFormatted & "</div>
			                <div class='customer-kpi-explanation'>PY customers no longer purchasing</div>
			            </div>
			
			            <div class='customer-kpi-card'>
			                <div class='customer-kpi-label'>Customer Retention</div>
			                <div class='customer-kpi-value'>" & RetentionFormatted & "</div>
			                <div class='customer-kpi-comparison' style='color:" & RetentionColor & ";'>
			                    " & RetentionComparison & "
			                </div>
			                <div class='customer-kpi-py'>PY " & RetentionPYFormatted & "</div>
			                <div class='customer-kpi-explanation'>Share of PY customers still active</div>
			            </div>
			
			            <div class='customer-kpi-card'>
			                <div class='customer-kpi-label'>Net Revenue Retention</div>
			                <div class='customer-kpi-value'>" & NRRFormatted & "</div>
			                <div class='customer-kpi-comparison' style='color:" & NRRColor & ";'>
			                    " & NRRComparison & "
			                </div>
			                <div class='customer-kpi-py'>PY " & NRRPYFormatted & "</div>
			                <div class='customer-kpi-explanation'>Revenue retained from the PY customer cohort</div>
			            </div>
			
			        </div>
			    </div>
			    "
		displayFolder: 04 Customers
		lineageTag: 50f17025-3eb0-460f-b2d3-f3077ad46838

	measure 'Customer Performance HTML' = ```
			
			VAR _CurrentStart =
			    MIN ( dimDate[Date] )
			
			VAR _CurrentEnd =
			    MAX ( dimDate[Date] )
			
			VAR _PreviousStart =
			    CALCULATE (
			        MIN ( dimDate[Date] ),
			        DATEADD ( dimDate[Date], -1, YEAR )
			    )
			
			VAR _PreviousEnd =
			    CALCULATE (
			        MAX ( dimDate[Date] ),
			        DATEADD ( dimDate[Date], -1, YEAR )
			    )
			
			-- Customer cohorts
			VAR _CurrentCustomers =
			    FILTER (
			        VALUES ( factSales[customer_id] ),
			        NOT ISBLANK ( factSales[customer_id] )
			    )
			
			VAR _PreviousCustomers =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( factSales[customer_id] ),
			            DATEADD ( dimDate[Date], -1, YEAR )
			        ),
			        NOT ISBLANK ( factSales[customer_id] )
			    )
			
			VAR _PreviousPreviousCustomers =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( factSales[customer_id] ),
			            DATEADD ( dimDate[Date], -2, YEAR )
			        ),
			        NOT ISBLANK ( factSales[customer_id] )
			    )
			
			VAR _CurrentCustomerRows =
			    COUNTROWS ( _CurrentCustomers )
			
			VAR _PreviousCustomerRows =
			    COUNTROWS ( _PreviousCustomers )
			
			VAR _PreviousPreviousCustomerRows =
			    COUNTROWS ( _PreviousPreviousCustomers )
			
			VAR _HasCurrentData =
			    _CurrentCustomerRows > 0
			
			VAR _HasPreviousYear =
			    _PreviousCustomerRows > 0
			
			VAR _HasPreviousPreviousYear =
			    _PreviousPreviousCustomerRows > 0
			
			
			-- Active customers
			VAR _ActiveCurrent =
			    _CurrentCustomerRows
			
			VAR _ActivePrevious =
			    _PreviousCustomerRows
			
			
			-- New customers: first-ever purchase falls within period
			VAR _NewCurrent = [Customers New]
			
			VAR _NewPrevious = [Customers New PY]
			
			-- Churn customers
			-- Active in PY but not active in current period
			VAR _ChurnCurrent =
			    IF (
			        _HasPreviousYear,
			        COUNTROWS (
			            EXCEPT (
			                _PreviousCustomers,
			                _CurrentCustomers
			            )
			        )
			    )
			
			-- Active two years ago but not active in PY
			VAR _ChurnPrevious =
			    IF (
			        _HasPreviousPreviousYear,
			        COUNTROWS (
			            EXCEPT (
			                _PreviousPreviousCustomers,
			                _PreviousCustomers
			            )
			        )
			    )
			
			
			-- Retained customers
			VAR _RetainedCurrent =
			    IF (
			        _HasPreviousYear,
			        COUNTROWS (
			            INTERSECT (
			                _PreviousCustomers,
			                _CurrentCustomers
			            )
			        )
			    )
			
			VAR _RetainedPrevious =
			    IF (
			        _HasPreviousPreviousYear,
			        COUNTROWS (
			            INTERSECT (
			                _PreviousPreviousCustomers,
			                _PreviousCustomers
			            )
			        )
			    )
			
			
			-- Customer retention rates
			VAR _RetentionCurrent =
			    DIVIDE (
			        _RetainedCurrent,
			        _PreviousCustomerRows
			    )
			
			VAR _RetentionPrevious =
			    DIVIDE (
			        _RetainedPrevious,
			        _PreviousPreviousCustomerRows
			    )
			
			VAR _NRRCurrent = [NRR %]
			VAR _NRRPrevious = [NRR % PY]
			
			
			-- Year-over-year changes
			VAR _ActiveDelta =
			    DIVIDE (
			        _ActiveCurrent - _ActivePrevious,
			        ABS ( _ActivePrevious )
			    )
			
			VAR _NewDelta =
			    DIVIDE (
			        _NewCurrent - _NewPrevious,
			        ABS ( _NewPrevious )
			    )
			
			VAR _ChurnDelta =
			    DIVIDE (
			        _ChurnCurrent - _ChurnPrevious,
			        ABS ( _ChurnPrevious )
			    )
			
			VAR _RetentionDelta =
			    _RetentionCurrent - _RetentionPrevious
			
			VAR _NRRDelta =
			    _NRRCurrent - _NRRPrevious
			
			
			-- Availability of comparable PY baselines
			VAR _CanCompareActive =
			    _HasPreviousYear
			        && _ActivePrevious <> 0
			
			VAR _CanCompareNew =
			    _HasPreviousYear
			        && NOT ISBLANK ( _NewPrevious )
			        && _NewPrevious <> 0
			
			VAR _CanCompareChurn =
			    _HasPreviousPreviousYear
			        && NOT ISBLANK ( _ChurnPrevious )
			        && _ChurnPrevious <> 0
			
			VAR _CanCompareRetention =
			    NOT ISBLANK ( _RetentionCurrent )
			        && NOT ISBLANK ( _RetentionPrevious )
			
			VAR _CanCompareNRR =
			    NOT ISBLANK ( _NRRCurrent )
			        && NOT ISBLANK ( _NRRPrevious )
			
			
			-- Trend colors
			VAR _ActiveDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareActive ), "#7A7480",
			        _ActiveDelta > 0,           "#2F855A",
			        _ActiveDelta < 0,           "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _NewDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareNew ), "#7A7480",
			        _NewDelta > 0,          "#2F855A",
			        _NewDelta < 0,          "#C53D3D",
			        "#7A7480"
			    )
			
			-- Lower churn is better
			VAR _ChurnDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareChurn ), "#7A7480",
			        _ChurnDelta < 0,           "#2F855A",
			        _ChurnDelta > 0,           "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _RetentionDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareRetention ), "#7A7480",
			        _RetentionDelta > 0,           "#2F855A",
			        _RetentionDelta < 0,           "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _NRRDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareNRR ), "#7A7480",
			        _NRRDelta > 0,          "#2F855A",
			        _NRRDelta < 0,          "#C53D3D",
			        "#7A7480"
			    )
			
			
			-- Direction arrows
			VAR _ActiveArrow =
			    IF (
			        _ActiveDelta > 0,
			        "▲ ",
			        IF ( _ActiveDelta < 0, "▼ ", "— " )
			    )
			
			VAR _NewArrow =
			    IF (
			        _NewDelta > 0,
			        "▲ ",
			        IF ( _NewDelta < 0, "▼ ", "— " )
			    )
			
			VAR _ChurnArrow =
			    IF (
			        _ChurnDelta > 0,
			        "▲ ",
			        IF ( _ChurnDelta < 0, "▼ ", "— " )
			    )
			
			VAR _RetentionArrow =
			    IF (
			        _RetentionDelta > 0,
			        "▲ ",
			        IF ( _RetentionDelta < 0, "▼ ", "— " )
			    )
			
			VAR _NRRArrow =
			    IF (
			        _NRRDelta > 0,
			        "▲ ",
			        IF ( _NRRDelta < 0, "▼ ", "— " )
			    )
			
			
			-- KPI values
			VAR _ActiveFormatted =
			    IF (
			        NOT ( _HasCurrentData ),
			        "—",
			        FORMAT ( _ActiveCurrent, "#,0", "de-DE")
			    )
			
			VAR _NewFormatted =
			    IF (
			        NOT ( _HasCurrentData ),
			        "—",
			        FORMAT ( _NewCurrent, "#,0", "de-DE" )
			    )
			
			VAR _ChurnFormatted =
			    IF (
			        ISBLANK ( _ChurnCurrent ),
			        "—",
			        FORMAT ( _ChurnCurrent, "#,0", "de-DE" )
			    )
			
			VAR _RetentionFormatted =
			    IF (
			        ISBLANK ( _RetentionCurrent ),
			        "—",
			        FORMAT ( _RetentionCurrent, "0.0%", "de-DE" )
			    )
			
			VAR _NRRFormatted =
			    IF (
			        ISBLANK ( _NRRCurrent ),
			        "—",
			        FORMAT ( _NRRCurrent, "0.0%", "de-DE" )
			    )
			
			
			-- Comparison labels
			VAR _ActiveComparison =
			    IF (
			        NOT ( _CanCompareActive ),
			        "— No PY data",
			        _ActiveArrow
			            & FORMAT ( ABS ( _ActiveDelta ), "0.0%", "de-DE" )
			            & " vs PY"
			    )
			
			VAR _NewComparison =
			    IF (
			        NOT ( _CanCompareNew ),
			        "— No PY data",
			        _NewArrow
			            & FORMAT ( ABS ( _NewDelta ), "0.0%", "de-DE" )
			            & " vs PY"
			    )
			
			VAR _ChurnComparison =
			    IF (
			        NOT ( _CanCompareChurn ),
			        "— No PY data",
			        _ChurnArrow
			            & FORMAT ( ABS ( _ChurnDelta ), "0.0%", "de-DE" )
			            & " vs PY"
			    )
			
			VAR _RetentionComparison =
			    IF (
			        NOT ( _CanCompareRetention ),
			        "— No PY data",
			        _RetentionArrow
			            & FORMAT ( ABS ( _RetentionDelta ) * 100, "0.0", "de-DE" )
			            & " pp vs PY"
			    )
			
			VAR _NRRComparison =
			    IF (
			        NOT ( _CanCompareNRR ),
			        "— No PY data",
			        _NRRArrow
			            & FORMAT ( ABS ( _NRRDelta ) * 100, "0.0", "de-DE" )
			            & " pp vs PY"
			    )
			
			
			RETURN
			IF (
			    NOT ( _HasCurrentData ),
			    "
			    <div style='
			        padding:8px;
			        background:transparent;
			        color:#7A7480;
			        font:8px Segoe UI,Arial,sans-serif;'>
			        No customer data
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .cp-grid {
			            display:grid;
			            grid-template-columns:repeat(5,minmax(0,1fr));
			            gap:6px;
			            width:100%;
			            background:transparent;
			        }
			
			        .cp-card {
			            position:relative;
			            min-width:0;
			            padding:9px 10px 8px;
			            overflow:hidden;
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.14);
			            border-radius:5px;
			        }
			
			        .cp-accent {
			            position:absolute;
			            top:0;
			            left:0;
			            width:100%;
			            height:3px;
			        }
			
			        .cp-label {
			            margin-bottom:4px;
			            overflow:hidden;
			            color:#000000;
			            font-size:10px;
			            font-weight:700;
			            letter-spacing:.035em;
			            text-transform:uppercase;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .cp-value {
			            margin-bottom:5px;
			            overflow:hidden;
			            font-size:clamp(18px,1.7vw,24px);
			            line-height:1;
			            font-weight:700;
			            letter-spacing:-.03em;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .cp-bottom {
			            display:flex;
			            align-items:center;
			            gap:4px;
			            min-width:0;
			            overflow:hidden;
			        }
			
			        .cp-delta {
			            flex-shrink:0;
			            padding:1px 4px;
			            border:1px solid;
			            border-radius:3px;
			            font-size:10px;
			            font-weight:600;
			            white-space:nowrap;
			        }
			
			        .cp-meta {
			            min-width:0;
			            overflow:hidden;
			            color:#7A7480;
			            font-size:10px;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			    </style>
			
			    <div class='cp-grid'>
			
			        <div class='cp-card'>
			            <div class='cp-accent'
			                 style='background:#331045'></div>
			            <div class='cp-label'>Active Customers</div>
			            <div class='cp-value'
			                 style='color:#331045'>
			                " & _ActiveFormatted & "
			            </div>
			            <div class='cp-bottom'>
			                <span class='cp-delta'
			                      style='color:" & _ActiveDeltaColor & ";
			                             border-color:" & _ActiveDeltaColor & "55;
			                             background:" & _ActiveDeltaColor & "10'>
			                    " & _ActiveComparison & "
			                </span>
			                <span class='cp-meta'>purchased in period</span>
			            </div>
			        </div>
			
			        <div class='cp-card'>
			            <div class='cp-accent'
			                 style='background:#2F855A'></div>
			            <div class='cp-label'>New Customers</div>
			            <div class='cp-value'
			                 style='color:#2F855A'>
			                " & _NewFormatted & "
			            </div>
			            <div class='cp-bottom'>
			                <span class='cp-delta'
			                      style='color:" & _NewDeltaColor & ";
			                             border-color:" & _NewDeltaColor & "55;
			                             background:" & _NewDeltaColor & "10'>
			                    " & _NewComparison & "
			                </span>
			                <span class='cp-meta'>first-ever buyers</span>
			            </div>
			        </div>
			
			        <div class='cp-card'>
			            <div class='cp-accent'
			                 style='background:#C53D3D'></div>
			            <div class='cp-label'>Churn Customers</div>
			            <div class='cp-value'
			                 style='color:#C53D3D'>
			                " & _ChurnFormatted & "
			            </div>
			            <div class='cp-bottom'>
			                <span class='cp-delta'
			                      style='color:" & _ChurnDeltaColor & ";
			                             border-color:" & _ChurnDeltaColor & "55;
			                             background:" & _ChurnDeltaColor & "10'>
			                    " & _ChurnComparison & "
			                </span>
			                <span class='cp-meta'>PY customers lost</span>
			            </div>
			        </div>
			
			        <div class='cp-card'>
			            <div class='cp-accent'
			                 style='background:#6F4A7C'></div>
			            <div class='cp-label'>Customer Retention</div>
			            <div class='cp-value'
			                 style='color:#6F4A7C'>
			                " & _RetentionFormatted & "
			            </div>
			            <div class='cp-bottom'>
			                <span class='cp-delta'
			                      style='color:" & _RetentionDeltaColor & ";
			                             border-color:" & _RetentionDeltaColor & "55;
			                             background:" & _RetentionDeltaColor & "10'>
			                    " & _RetentionComparison & "
			                </span>
			                <span class='cp-meta'>PY customers retained</span>
			            </div>
			        </div>
			
			        <div class='cp-card'>
			            <div class='cp-accent'
			                 style='background:#D99A2B'></div>
			            <div class='cp-label'>NRR</div>
			            <div class='cp-value'
			                 style='color:#D99A2B'>
			                " & _NRRFormatted & "
			            </div>
			            <div class='cp-bottom'>
			                <span class='cp-delta'
			                      style='color:" & _NRRDeltaColor & ";
			                             border-color:" & _NRRDeltaColor & "55;
			                             background:" & _NRRDeltaColor & "10'>
			                    " & _NRRComparison & "
			                </span>
			                <span class='cp-meta'>existing customer revenue</span>
			            </div>
			        </div>
			
			    </div>
			    "
			)
			
			```
		displayFolder: 04 Customers
		lineageTag: 05ca09a3-9e7e-4e7c-b3bb-f047b8656d03

	measure 'FC Performance HTML' =
			
			-- ============================================================
			-- CURRENT PERIOD DATA
			-- ============================================================
			
			-- Current-period forecast data across all forecast versions
			VAR _CurrentData =
			    CALCULATETABLE (
			        factForecast,
			        REMOVEFILTERS ( factForecast[forecast_version] )
			    )
			
			VAR _CurrentRows =
			    COUNTROWS ( _CurrentData )
			
			VAR _HasCurrentData =
			    _CurrentRows > 0
			
			
			-- ============================================================
			-- CURRENT PERIOD VALUES
			-- ============================================================
			
			VAR _ForecastRevenueCurrent = [Revenue FC]
			
			VAR _ActualRevenueCurrent = [Revenue]
			
			VAR _VarianceCurrent =
			    _ActualRevenueCurrent
			        - _ForecastRevenueCurrent
			
			VAR _VariancePctCurrent =
			    DIVIDE (
			        _VarianceCurrent,
			        _ForecastRevenueCurrent
			    )
			
			VAR _AccuracyCurrent = [Revenue FC Accuracy %]
			
			
			-- ============================================================
			-- KPI FORMATTING
			-- ============================================================
			
			VAR _ForecastRevenueFormatted =
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( _ForecastRevenueCurrent ),
			            "—",
			
			        ABS ( _ForecastRevenueCurrent ) >= 1000000000,
			            FORMAT (
			                _ForecastRevenueCurrent / 1000000000,
			                "€0.0",
			                "de-DE"
			            ) & "B",
			
			        ABS ( _ForecastRevenueCurrent ) >= 1000000,
			            FORMAT (
			                _ForecastRevenueCurrent / 1000000,
			                "€0.0",
			                "de-DE"
			            ) & "M",
			
			        ABS ( _ForecastRevenueCurrent ) >= 1000,
			            FORMAT (
			                _ForecastRevenueCurrent / 1000,
			                "€0.0",
			                "de-DE"
			            ) & "K",
			
			        FORMAT (
			            _ForecastRevenueCurrent,
			            "€#,0",
			            "de-DE"
			        )
			    )
			
			
			VAR _ActualRevenueFormatted =
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( _ActualRevenueCurrent ),
			            "—",
			
			        ABS ( _ActualRevenueCurrent ) >= 1000000000,
			            FORMAT (
			                _ActualRevenueCurrent / 1000000000,
			                "€0.0",
			                "de-DE"
			            ) & "B",
			
			        ABS ( _ActualRevenueCurrent ) >= 1000000,
			            FORMAT (
			                _ActualRevenueCurrent / 1000000,
			                "€0.0",
			                "de-DE"
			            ) & "M",
			
			        ABS ( _ActualRevenueCurrent ) >= 1000,
			            FORMAT (
			                _ActualRevenueCurrent / 1000,
			                "€0.0",
			                "de-DE"
			            ) & "K",
			
			        FORMAT (
			            _ActualRevenueCurrent,
			            "€#,0",
			            "de-DE"
			        )
			    )
			
			
			VAR _VarianceSign =
			    SWITCH (
			        TRUE (),
			        _VarianceCurrent > 0, "+",
			        _VarianceCurrent < 0, "−",
			        ""
			    )
			
			
			VAR _VarianceFormatted =
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( _VarianceCurrent ),
			            "—",
			
			        ABS ( _VarianceCurrent ) >= 1000000000,
			            _VarianceSign
			                & FORMAT (
			                    ABS ( _VarianceCurrent ) / 1000000000,
			                    "€0.0",
			                    "de-DE"
			                )
			                & "B",
			
			        ABS ( _VarianceCurrent ) >= 1000000,
			            _VarianceSign
			                & FORMAT (
			                    ABS ( _VarianceCurrent ) / 1000000,
			                    "€0.0",
			                    "de-DE"
			                )
			                & "M",
			
			        ABS ( _VarianceCurrent ) >= 1000,
			            _VarianceSign
			                & FORMAT (
			                    ABS ( _VarianceCurrent ) / 1000,
			                    "€0.0",
			                    "de-DE"
			                )
			                & "K",
			
			        _VarianceSign
			            & FORMAT (
			                ABS ( _VarianceCurrent ),
			                "€#,0",
			                "de-DE"
			            )
			    )
			
			
			VAR _VariancePctFormatted =
			    IF (
			        ISBLANK ( _VariancePctCurrent ),
			        "—",
			        FORMAT (
			            _VariancePctCurrent,
			            "+0.0%;−0.0%;0.0%",
			            "de-DE"
			        )
			    )
			
			
			VAR _AccuracyFormatted =
			    IF (
			        ISBLANK ( _AccuracyCurrent ),
			        "—",
			        FORMAT (
			            _AccuracyCurrent,
			            "0.0%",
			            "de-DE"
			        )
			    )
			
			
			-- ============================================================
			-- HTML
			-- ============================================================
			
			RETURN
			    IF (
			        NOT ( _HasCurrentData ),
			
			        "
			        <div style='
			            padding:8px;
			            background:transparent;
			            color:#7A7480;
			            font:10px Segoe UI,Arial,sans-serif;'>
			            No forecast data
			        </div>
			        ",
			
			        "
			        <style>
			
			            * {
			                box-sizing:border-box;
			                margin:0;
			                padding:0;
			                font-family:'Segoe UI',Arial,sans-serif;
			            }
			
			            .fp-grid {
			                display:grid;
			                grid-template-columns:repeat(5,minmax(0,1fr));
			                gap:6px;
			                width:100%;
			                height:100%;
			                background:transparent;
			            }
			
			            .fp-card {
			                position:relative;
			                display:flex;
			                flex-direction:column;
			                justify-content:flex-start;
			                min-width:0;
			                padding:10px 10px 9px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border:1px solid rgba(51,16,69,.14);
			                border-radius:8px;
			            }
			
			            .fp-accent {
			                position:absolute;
			                top:0;
			                left:0;
			                width:100%;
			                height:3px;
			            }
			
			            .fp-label {
			                margin-top:2px;
			                margin-bottom:5px;
			                overflow:hidden;
			                color:#26232A;
			                font-size:10px;
			                line-height:1.2;
			                font-weight:700;
			                letter-spacing:.035em;
			                text-transform:uppercase;
			                white-space:nowrap;
			                text-overflow:ellipsis;
			            }
			
			            .fp-value {
			                margin-bottom:7px;
			                overflow:hidden;
			                font-size:clamp(18px,1.7vw,24px);
			                line-height:1.05;
			                font-weight:700;
			                letter-spacing:-.03em;
			                white-space:nowrap;
			                text-overflow:ellipsis;
			            }
			
			            .fp-bottom {
			                display:flex;
			                align-items:center;
			                min-width:0;
			                margin-top:auto;
			                overflow:hidden;
			            }
			
			            .fp-meta {
			                min-width:0;
			                overflow:hidden;
			                color:#7A7480;
			                font-size:9px;
			                line-height:1.2;
			                white-space:nowrap;
			                text-overflow:ellipsis;
			            }
			
			        </style>
			
			
			        <div class='fp-grid'>
			
			
			            <!-- ============================================= -->
			            <!-- FORECAST REVENUE -->
			            <!-- ============================================= -->
			
			            <div class='fp-card'>
			
			                <div
			                    class='fp-accent'
			                    style='background:#331045'>
			                </div>
			
			                <div class='fp-label'>
			                    FC Revenue
			                </div>
			
			                <div
			                    class='fp-value'
			                    style='color:#331045'>
			                    " & _ForecastRevenueFormatted & "
			                </div>
			
			                <div class='fp-bottom'>
			                    <span class='fp-meta'>
			                        all forecast versions
			                    </span>
			                </div>
			
			            </div>
			
			
			            <!-- ============================================= -->
			            <!-- ACTUAL REVENUE -->
			            <!-- ============================================= -->
			
			            <div class='fp-card'>
			
			                <div
			                    class='fp-accent'
			                    style='background:#2F855A'>
			                </div>
			
			                <div class='fp-label'>
			                    Actual Revenue
			                </div>
			
			                <div
			                    class='fp-value'
			                    style='color:#2F855A'>
			                    " & _ActualRevenueFormatted & "
			                </div>
			
			                <div class='fp-bottom'>
			                    <span class='fp-meta'>
			                        realized revenue
			                    </span>
			                </div>
			
			            </div>
			
			
			            <!-- ============================================= -->
			            <!-- FORECAST VARIANCE EUR -->
			            <!-- ============================================= -->
			
			            <div class='fp-card'>
			
			                <div
			                    class='fp-accent'
			                    style='background:#D99A2B'>
			                </div>
			
			                <div class='fp-label'>
			                    FC Variance EUR
			                </div>
			
			                <div
			                    class='fp-value'
			                    style='color:#D99A2B'>
			                    " & _VarianceFormatted & "
			                </div>
			
			                <div class='fp-bottom'>
			                    <span class='fp-meta'>
			                        actual − forecast
			                    </span>
			                </div>
			
			            </div>
			
			
			            <!-- ============================================= -->
			            <!-- FORECAST VARIANCE % -->
			            <!-- ============================================= -->
			
			            <div class='fp-card'>
			
			                <div
			                    class='fp-accent'
			                    style='background:#C53D3D'>
			                </div>
			
			                <div class='fp-label'>
			                    FC Variance %
			                </div>
			
			                <div
			                    class='fp-value'
			                    style='color:#C53D3D'>
			                    " & _VariancePctFormatted & "
			                </div>
			
			                <div class='fp-bottom'>
			                    <span class='fp-meta'>
			                        variance / forecast
			                    </span>
			                </div>
			
			            </div>
			
			
			            <!-- ============================================= -->
			            <!-- FORECAST ACCURACY -->
			            <!-- ============================================= -->
			
			            <div class='fp-card'>
			
			                <div
			                    class='fp-accent'
			                    style='background:#6F4A7C'>
			                </div>
			
			                <div class='fp-label'>
			                    FC Accuracy
			                </div>
			
			                <div
			                    class='fp-value'
			                    style='color:#6F4A7C'>
			                    " & _AccuracyFormatted & "
			                </div>
			
			                <div class='fp-bottom'>
			                    <span class='fp-meta'>
			                        1 − absolute variance
			                    </span>
			                </div>
			
			            </div>
			
			
			        </div>
			        "
			    )
		displayFolder: 03 Forecasting
		lineageTag: 848bdb22-906f-48e2-9ae4-8494b29fd0a4

	measure 'Revenue Performance HTML' =
			
			-- Customer cohorts
			VAR _CurrentCustomers =
			    FILTER (
			        VALUES ( factSales[customer_id] ),
			        NOT ISBLANK ( factSales[customer_id] )
			    )
			
			VAR _PreviousCustomers =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( factSales[customer_id] ),
			            DATEADD ( dimDate[Date], -1, YEAR )
			        ),
			        NOT ISBLANK ( factSales[customer_id] )
			    )
			
			VAR _PreviousPreviousCustomers =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( factSales[customer_id] ),
			            DATEADD ( dimDate[Date], -2, YEAR )
			        ),
			        NOT ISBLANK ( factSales[customer_id] )
			    )
			
			VAR _ActiveCustomersCurrent =
			    COUNTROWS ( _CurrentCustomers )
			
			VAR _ActiveCustomersPrevious =
			    COUNTROWS ( _PreviousCustomers )
			
			VAR _ActiveCustomersPreviousPrevious =
			    COUNTROWS ( _PreviousPreviousCustomers )
			
			VAR _HasCurrentData =
			    _ActiveCustomersCurrent > 0
			
			VAR _HasPreviousYear =
			    _ActiveCustomersPrevious > 0
			
			VAR _HasPreviousPreviousYear =
			    _ActiveCustomersPreviousPrevious > 0
			
			
			-- Revenue
			VAR _RevenueCurrent =
			    SUM ( factSales[revenue_eur] )
			
			VAR _RevenuePrevious = [Revenue PY]
			
			
			-- Units
			VAR _UnitsCurrent =
			    SUM ( factSales[units] )
			
			VAR _UnitsPrevious =
			    CALCULATE (
			        SUM ( factSales[units] ),
			        DATEADD ( dimDate[Date], -1, YEAR )
			    )
			
			
			-- Revenue per customer
			VAR _RevenuePerCustomerCurrent =
			    DIVIDE (
			        _RevenueCurrent,
			        _ActiveCustomersCurrent
			    )
			
			VAR _RevenuePerCustomerPrevious =
			    DIVIDE (
			        _RevenuePrevious,
			        _ActiveCustomersPrevious
			    )
			
			VAR _NRRCurrent = [NRR %]
			VAR _NRRPrevious = [NRR % PY]
			
			
			-- PY changes
			VAR _RevenueDelta =
			    DIVIDE (
			        _RevenueCurrent - _RevenuePrevious,
			        ABS ( _RevenuePrevious )
			    )
			
			VAR _UnitsDelta =
			    DIVIDE (
			        _UnitsCurrent - _UnitsPrevious,
			        ABS ( _UnitsPrevious )
			    )
			
			VAR _ActiveCustomersDelta =
			    DIVIDE (
			        _ActiveCustomersCurrent - _ActiveCustomersPrevious,
			        ABS ( _ActiveCustomersPrevious )
			    )
			
			VAR _RevenuePerCustomerDelta =
			    DIVIDE (
			        _RevenuePerCustomerCurrent - _RevenuePerCustomerPrevious,
			        ABS ( _RevenuePerCustomerPrevious )
			    )
			
			VAR _NRRDelta =
			    _NRRCurrent - _NRRPrevious
			
			
			-- Comparable PY baselines
			VAR _CanCompareRevenue =
			    _HasPreviousYear
			        && NOT ISBLANK ( _RevenuePrevious )
			        && _RevenuePrevious <> 0
			
			VAR _CanCompareUnits =
			    _HasPreviousYear
			        && NOT ISBLANK ( _UnitsPrevious )
			        && _UnitsPrevious <> 0
			
			VAR _CanCompareCustomers =
			    _HasPreviousYear
			        && _ActiveCustomersPrevious <> 0
			
			VAR _CanCompareRevenuePerCustomer =
			    _HasPreviousYear
			        && NOT ISBLANK ( _RevenuePerCustomerPrevious )
			        && _RevenuePerCustomerPrevious <> 0
			
			VAR _CanCompareNRR =
			    _HasPreviousPreviousYear
			        && NOT ISBLANK ( _NRRCurrent )
			        && NOT ISBLANK ( _NRRPrevious )
			
			
			-- Trend colors
			VAR _RevenueDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareRevenue ), "#7A7480",
			        _RevenueDelta > 0,          "#2F855A",
			        _RevenueDelta < 0,          "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _UnitsDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareUnits ), "#7A7480",
			        _UnitsDelta > 0,          "#2F855A",
			        _UnitsDelta < 0,          "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _CustomersDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareCustomers ), "#7A7480",
			        _ActiveCustomersDelta > 0,    "#2F855A",
			        _ActiveCustomersDelta < 0,    "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _RevenuePerCustomerDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareRevenuePerCustomer ), "#7A7480",
			        _RevenuePerCustomerDelta > 0,           "#2F855A",
			        _RevenuePerCustomerDelta < 0,           "#C53D3D",
			        "#7A7480"
			    )
			
			VAR _NRRDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareNRR ), "#7A7480",
			        _NRRDelta > 0,          "#2F855A",
			        _NRRDelta < 0,          "#C53D3D",
			        "#7A7480"
			    )
			
			
			-- Direction arrows
			VAR _RevenueArrow =
			    IF (
			        _RevenueDelta > 0,
			        "▲ ",
			        IF ( _RevenueDelta < 0, "▼ ", "— " )
			    )
			
			VAR _UnitsArrow =
			    IF (
			        _UnitsDelta > 0,
			        "▲ ",
			        IF ( _UnitsDelta < 0, "▼ ", "— " )
			    )
			
			VAR _CustomersArrow =
			    IF (
			        _ActiveCustomersDelta > 0,
			        "▲ ",
			        IF ( _ActiveCustomersDelta < 0, "▼ ", "— " )
			    )
			
			VAR _RevenuePerCustomerArrow =
			    IF (
			        _RevenuePerCustomerDelta > 0,
			        "▲ ",
			        IF ( _RevenuePerCustomerDelta < 0, "▼ ", "— " )
			    )
			
			VAR _NRRArrow =
			    IF (
			        _NRRDelta > 0,
			        "▲ ",
			        IF ( _NRRDelta < 0, "▼ ", "— " )
			    )
			
			
			-- KPI value formatting
			VAR _RevenueFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _RevenueCurrent ), "—",
			        ABS ( _RevenueCurrent ) >= 1000000000,
			            FORMAT ( _RevenueCurrent / 1000000000, "€0.0", "de-DE" ) & "B",
			        ABS ( _RevenueCurrent ) >= 1000000,
			            FORMAT ( _RevenueCurrent / 1000000, "€0.0", "de-DE" ) & "M",
			        ABS ( _RevenueCurrent ) >= 1000,
			            FORMAT ( _RevenueCurrent / 1000, "€0.0", "de-DE" ) & "K",
			        FORMAT ( _RevenueCurrent, "€#,0", "de-DE" )
			    )
			
			VAR _UnitsFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _UnitsCurrent ), "—",
			        ABS ( _UnitsCurrent ) >= 1000000,
			            FORMAT ( _UnitsCurrent / 1000000, "0.0", "de-DE" ) & "M",
			        ABS ( _UnitsCurrent ) >= 1000,
			            FORMAT ( _UnitsCurrent / 1000, "0.0", "de-DE" ) & "K",
			        FORMAT ( _UnitsCurrent, "#,0", "de-DE" )
			    )
			
			VAR _CustomersFormatted =
			    IF (
			        NOT ( _HasCurrentData ),
			        "—",
			        FORMAT ( _ActiveCustomersCurrent, "#,0", "de-DE" )
			    )
			
			VAR _RevenuePerCustomerFormatted =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _RevenuePerCustomerCurrent ), "—",
			        ABS ( _RevenuePerCustomerCurrent ) >= 1000000,
			            FORMAT ( _RevenuePerCustomerCurrent / 1000000, "€0.0", "de-DE" ) & "M",
			        ABS ( _RevenuePerCustomerCurrent ) >= 1000,
			            FORMAT ( _RevenuePerCustomerCurrent / 1000, "€0.0", "de-DE" ) & "K",
			        FORMAT ( _RevenuePerCustomerCurrent, "€#,0", "de-DE" )
			    )
			
			VAR _NRRFormatted =
			    IF (
			        ISBLANK ( _NRRCurrent ),
			        "—",
			        FORMAT ( _NRRCurrent, "0.0%", "de-DE" )
			    )
			
			
			-- Comparison labels
			VAR _RevenueComparison =
			    IF (
			        NOT ( _CanCompareRevenue ),
			        "— No PY data",
			        _RevenueArrow
			            & FORMAT ( ABS ( _RevenueDelta ), "0.0%", "de-DE" )
			            & " vs PY"
			    )
			
			VAR _UnitsComparison =
			    IF (
			        NOT ( _CanCompareUnits ),
			        "— No PY data",
			        _UnitsArrow
			            & FORMAT ( ABS ( _UnitsDelta ), "0.0%", "de-DE" )
			            & " vs PY"
			    )
			
			VAR _CustomersComparison =
			    IF (
			        NOT ( _CanCompareCustomers ),
			        "— No PY data",
			        _CustomersArrow
			            & FORMAT ( ABS ( _ActiveCustomersDelta ), "0.0%", "de-DE" )
			            & " vs PY"
			    )
			
			VAR _RevenuePerCustomerComparison =
			    IF (
			        NOT ( _CanCompareRevenuePerCustomer ),
			        "— No PY data",
			        _RevenuePerCustomerArrow
			            & FORMAT ( ABS ( _RevenuePerCustomerDelta ), "0.0%", "de-DE" )
			            & " vs PY"
			    )
			
			VAR _NRRComparison =
			    IF (
			        NOT ( _CanCompareNRR ),
			        "— No PY data",
			        _NRRArrow
			            & FORMAT ( ABS ( _NRRDelta ) * 100, "0.0", "de-DE" )
			            & " pp vs PY"
			    )
			
			
			RETURN
			IF (
			    NOT ( _HasCurrentData ),
			    "
			    <div style='
			        padding:8px;
			        background:transparent;
			        color:#7A7480;
			        font:8px Segoe UI,Arial,sans-serif;'>
			        No sales data
			    </div>
			    ",
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			            margin:0;
			            padding:0;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .sp-grid {
			            display:grid;
			            grid-template-columns:repeat(5,minmax(0,1fr));
			            gap:6px;
			            width:100%;
			            background:transparent;
			        }
			
			        .sp-card {
			            position:relative;
			            min-width:0;
			            padding:9px 10px 8px;
			            overflow:hidden;
			            background:#FFFFFF;
			            border:1px solid rgba(51,16,69,.14);
			            border-radius:8px;
			        }
			
			        .sp-accent {
			            position:absolute;
			            top:0;
			            left:0;
			            width:100%;
			            height:3px;
			        }
			
			        .sp-label {
			            margin-bottom:4px;
			            overflow:hidden;
			            color:#000000;
			            font-size:10px;
			            font-weight:700;
			            letter-spacing:.035em;
			            text-transform:uppercase;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .sp-value {
			            margin-bottom:5px;
			            overflow:hidden;
			            font-size:clamp(18px,1.7vw,24px);
			            line-height:1;
			            font-weight:700;
			            letter-spacing:-.03em;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .sp-bottom {
			            display:flex;
			            align-items:center;
			            gap:4px;
			            min-width:0;
			            overflow:hidden;
			        }
			
			        .sp-delta {
			            flex-shrink:0;
			            padding:1px 4px;
			            border:1px solid;
			            border-radius:3px;
			            font-size:10px;
			            font-weight:600;
			            white-space:nowrap;
			        }
			
			        .sp-meta {
			            min-width:0;
			            overflow:hidden;
			            color:#7A7480;
			            font-size:10px;
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			    </style>
			
			    <div class='sp-grid'>
			
			        <div class='sp-card'>
			            <div class='sp-accent'
			                 style='background:#331045'></div>
			            <div class='sp-label'>Revenue</div>
			            <div class='sp-value'
			                 style='color:#331045'>
			                " & _RevenueFormatted & "
			            </div>
			            <div class='sp-bottom'>
			                <span class='sp-delta'
			                      style='color:" & _RevenueDeltaColor & ";
			                             border-color:" & _RevenueDeltaColor & "55;
			                             background:" & _RevenueDeltaColor & "10'>
			                    " & _RevenueComparison & "
			                </span>
			                <span class='sp-meta'>net sales value</span>
			            </div>
			        </div>
			
			        <div class='sp-card'>
			            <div class='sp-accent'
			                 style='background:#6F4A7C'></div>
			            <div class='sp-label'>Units</div>
			            <div class='sp-value'
			                 style='color:#6F4A7C'>
			                " & _UnitsFormatted & "
			            </div>
			            <div class='sp-bottom'>
			                <span class='sp-delta'
			                      style='color:" & _UnitsDeltaColor & ";
			                             border-color:" & _UnitsDeltaColor & "55;
			                             background:" & _UnitsDeltaColor & "10'>
			                    " & _UnitsComparison & "
			                </span>
			                <span class='sp-meta'>units sold</span>
			            </div>
			        </div>
			
			        <div class='sp-card'>
			            <div class='sp-accent'
			                 style='background:#2F855A'></div>
			            <div class='sp-label'>Customers Active</div>
			            <div class='sp-value'
			                 style='color:#2F855A'>
			                " & _CustomersFormatted & "
			            </div>
			            <div class='sp-bottom'>
			                <span class='sp-delta'
			                      style='color:" & _CustomersDeltaColor & ";
			                             border-color:" & _CustomersDeltaColor & "55;
			                             background:" & _CustomersDeltaColor & "10'>
			                    " & _CustomersComparison & "
			                </span>
			                <span class='sp-meta'>purchased in period</span>
			            </div>
			        </div>
			
			        <div class='sp-card'>
			            <div class='sp-accent'
			                 style='background:#D99A2B'></div>
			            <div class='sp-label'>Revenue per Customer</div>
			            <div class='sp-value'
			                 style='color:#D99A2B'>
			                " & _RevenuePerCustomerFormatted & "
			            </div>
			            <div class='sp-bottom'>
			                <span class='sp-delta'
			                      style='color:" & _RevenuePerCustomerDeltaColor & ";
			                             border-color:" & _RevenuePerCustomerDeltaColor & "55;
			                             background:" & _RevenuePerCustomerDeltaColor & "10'>
			                    " & _RevenuePerCustomerComparison & "
			                </span>
			                <span class='sp-meta'>average customer value</span>
			            </div>
			        </div>
			
			        <div class='sp-card'>
			            <div class='sp-accent'
			                 style='background:#4F7664'></div>
			            <div class='sp-label'>NRR</div>
			            <div class='sp-value'
			                 style='color:#4F7664'>
			                " & _NRRFormatted & "
			            </div>
			            <div class='sp-bottom'>
			                <span class='sp-delta'
			                      style='color:" & _NRRDeltaColor & ";
			                             border-color:" & _NRRDeltaColor & "55;
			                             background:" & _NRRDeltaColor & "10'>
			                    " & _NRRComparison & "
			                </span>
			                <span class='sp-meta'>Existing customer revenue</span>
			            </div>
			        </div>
			
			    </div>
			    "
			)
		displayFolder: 00 Core Measures
		lineageTag: 122ef899-5ce0-4f50-8294-6a5f4d2aefdd

	measure 'Margin per Unit PY' = CALCULATE([Margin per Unit], SAMEPERIODLASTYEAR(dimDate[Date]))
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 00 Core Measures
		lineageTag: b57f8dbb-3fae-412a-8a61-30c8e34e0bb8

		annotation PBI_FormatHint = {"currencyCulture":"en-DE"}

	measure 'Executive Performance HTML' =
			
			-- ============================================================
			-- KPI VALUES
			-- ============================================================
			
			VAR _Revenue =
			    [Revenue]
			
			VAR _RevenuePY =
			    [Revenue PY]
			
			
			VAR _GrossMargin =
			    [Gross Margin %]
			
			VAR _GrossMarginPY =
			    [Gross Margin % PY]
			
			
			VAR _ForecastAccuracy =
			    [Revenue FC Accuracy %]
			
			VAR _ForecastAccuracyPY =
			    [Revenue FC Accuracy % PY]
			
			
			VAR _ActiveCustomers =
			    [Customers Active]
			
			VAR _ActiveCustomersPY =
			    [Customer Active PY]
			
			
			VAR _NRR =
			    [NRR %]
			
			VAR _NRRPY =
			    [NRR % PY]
			
			
			-- ============================================================
			-- PY CHANGES
			-- ============================================================
			
			VAR _RevenueDelta =
			    DIVIDE (
			        _Revenue - _RevenuePY,
			        ABS ( _RevenuePY )
			    )
			
			
			VAR _GrossMarginDelta =
			    _GrossMargin - _GrossMarginPY
			
			
			VAR _ForecastAccuracyDelta =
			    _ForecastAccuracy - _ForecastAccuracyPY
			
			
			VAR _ActiveCustomersDelta =
			    DIVIDE (
			        _ActiveCustomers - _ActiveCustomersPY,
			        ABS ( _ActiveCustomersPY )
			    )
			
			
			VAR _NRRDelta =
			    _NRR - _NRRPY
			
			
			-- ============================================================
			-- COMPARABLE PY BASELINES
			-- ============================================================
			
			VAR _CanCompareRevenue =
			    NOT ISBLANK ( _Revenue )
			        && NOT ISBLANK ( _RevenuePY )
			        && _RevenuePY <> 0
			
			
			VAR _CanCompareGrossMargin =
			    NOT ISBLANK ( _GrossMargin )
			        && NOT ISBLANK ( _GrossMarginPY )
			
			
			VAR _CanCompareForecastAccuracy =
			    NOT ISBLANK ( _ForecastAccuracy )
			        && NOT ISBLANK ( _ForecastAccuracyPY )
			
			
			VAR _CanCompareActiveCustomers =
			    NOT ISBLANK ( _ActiveCustomers )
			        && NOT ISBLANK ( _ActiveCustomersPY )
			        && _ActiveCustomersPY <> 0
			
			
			VAR _CanCompareNRR =
			    NOT ISBLANK ( _NRR )
			        && NOT ISBLANK ( _NRRPY )
			
			
			-- ============================================================
			-- TREND COLORS
			-- ============================================================
			
			VAR _RevenueDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareRevenue ), "#7A7480",
			        _RevenueDelta > 0, "#2F855A",
			        _RevenueDelta < 0, "#C53D3D",
			        "#7A7480"
			    )
			
			
			VAR _GrossMarginDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareGrossMargin ), "#7A7480",
			        _GrossMarginDelta > 0, "#2F855A",
			        _GrossMarginDelta < 0, "#C53D3D",
			        "#7A7480"
			    )
			
			
			VAR _ForecastAccuracyDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareForecastAccuracy ), "#7A7480",
			        _ForecastAccuracyDelta > 0, "#2F855A",
			        _ForecastAccuracyDelta < 0, "#C53D3D",
			        "#7A7480"
			    )
			
			
			VAR _ActiveCustomersDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareActiveCustomers ), "#7A7480",
			        _ActiveCustomersDelta > 0, "#2F855A",
			        _ActiveCustomersDelta < 0, "#C53D3D",
			        "#7A7480"
			    )
			
			
			VAR _NRRDeltaColor =
			    SWITCH (
			        TRUE (),
			        NOT ( _CanCompareNRR ), "#7A7480",
			        _NRRDelta > 0, "#2F855A",
			        _NRRDelta < 0, "#C53D3D",
			        "#7A7480"
			    )
			
			
			-- ============================================================
			-- DIRECTION ARROWS
			-- ============================================================
			
			VAR _RevenueArrow =
			    IF (
			        _RevenueDelta > 0,
			        "▲ ",
			        IF (
			            _RevenueDelta < 0,
			            "▼ ",
			            "— "
			        )
			    )
			
			
			VAR _GrossMarginArrow =
			    IF (
			        _GrossMarginDelta > 0,
			        "▲ ",
			        IF (
			            _GrossMarginDelta < 0,
			            "▼ ",
			            "— "
			        )
			    )
			
			
			VAR _ForecastAccuracyArrow =
			    IF (
			        _ForecastAccuracyDelta > 0,
			        "▲ ",
			        IF (
			            _ForecastAccuracyDelta < 0,
			            "▼ ",
			            "— "
			        )
			    )
			
			
			VAR _ActiveCustomersArrow =
			    IF (
			        _ActiveCustomersDelta > 0,
			        "▲ ",
			        IF (
			            _ActiveCustomersDelta < 0,
			            "▼ ",
			            "— "
			        )
			    )
			
			
			VAR _NRRArrow =
			    IF (
			        _NRRDelta > 0,
			        "▲ ",
			        IF (
			            _NRRDelta < 0,
			            "▼ ",
			            "— "
			        )
			    )
			
			
			-- ============================================================
			-- KPI VALUE FORMATTING
			-- ============================================================
			
			VAR _RevenueFormatted =
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( _Revenue ),
			            "—",
			
			        ABS ( _Revenue ) >= 1000000000,
			            FORMAT (
			                _Revenue / 1000000000,
			                "€0.0",
			                "de-DE"
			            ) & "B",
			
			        ABS ( _Revenue ) >= 1000000,
			            FORMAT (
			                _Revenue / 1000000,
			                "€0.0",
			                "de-DE"
			            ) & "M",
			
			        ABS ( _Revenue ) >= 1000,
			            FORMAT (
			                _Revenue / 1000,
			                "€0.0",
			                "de-DE"
			            ) & "K",
			
			        FORMAT (
			            _Revenue,
			            "€#,0",
			            "de-DE"
			        )
			    )
			
			
			VAR _GrossMarginFormatted =
			    IF (
			        ISBLANK ( _GrossMargin ),
			        "—",
			        FORMAT (
			            _GrossMargin,
			            "0.0%",
			            "de-DE"
			        )
			    )
			
			
			VAR _ForecastAccuracyFormatted =
			    IF (
			        ISBLANK ( _ForecastAccuracy ),
			        "—",
			        FORMAT (
			            _ForecastAccuracy,
			            "0.0%",
			            "de-DE"
			        )
			    )
			
			
			VAR _ActiveCustomersFormatted =
			    IF (
			        ISBLANK ( _ActiveCustomers ),
			        "—",
			        FORMAT (
			            _ActiveCustomers,
			            "#,0",
			            "de-DE"
			        )
			    )
			
			
			VAR _NRRFormatted =
			    IF (
			        ISBLANK ( _NRR ),
			        "—",
			        FORMAT (
			            _NRR,
			            "0.0%",
			            "de-DE"
			        )
			    )
			
			
			-- ============================================================
			-- COMPARISON LABELS
			-- ============================================================
			
			VAR _RevenueComparison =
			    IF (
			        NOT ( _CanCompareRevenue ),
			        "— No PY data",
			        _RevenueArrow
			            & FORMAT (
			                ABS ( _RevenueDelta ),
			                "0.0%",
			                "de-DE"
			            )
			            & " vs PY"
			    )
			
			
			VAR _GrossMarginComparison =
			    IF (
			        NOT ( _CanCompareGrossMargin ),
			        "— No PY data",
			        _GrossMarginArrow
			            & FORMAT (
			                ABS ( _GrossMarginDelta ) * 100,
			                "0.0",
			                "de-DE"
			            )
			            & " pp vs PY"
			    )
			
			
			VAR _ForecastAccuracyComparison =
			    IF (
			        NOT ( _CanCompareForecastAccuracy ),
			        "— No PY data",
			        _ForecastAccuracyArrow
			            & FORMAT (
			                ABS ( _ForecastAccuracyDelta ) * 100,
			                "0.0",
			                "de-DE"
			            )
			            & " pp vs PY"
			    )
			
			
			VAR _ActiveCustomersComparison =
			    IF (
			        NOT ( _CanCompareActiveCustomers ),
			        "— No PY data",
			        _ActiveCustomersArrow
			            & FORMAT (
			                ABS ( _ActiveCustomersDelta ),
			                "0.0%",
			                "de-DE"
			            )
			            & " vs PY"
			    )
			
			
			VAR _NRRComparison =
			    IF (
			        NOT ( _CanCompareNRR ),
			        "— No PY data",
			        _NRRArrow
			            & FORMAT (
			                ABS ( _NRRDelta ) * 100,
			                "0.0",
			                "de-DE"
			            )
			            & " pp vs PY"
			    )
			
			
			-- ============================================================
			-- HTML
			-- ============================================================
			
			RETURN
			    IF (
			        ISBLANK ( _Revenue )
			            && ISBLANK ( _GrossMargin )
			            && ISBLANK ( _ForecastAccuracy )
			            && ISBLANK ( _ActiveCustomers )
			            && ISBLANK ( _NRR ),
			
			        "
			        <div style='
			            padding:8px;
			            background:transparent;
			            color:#7A7480;
			            font:8px Segoe UI,Arial,sans-serif;'>
			            No executive KPI data
			        </div>
			        ",
			
			        "
			        <style>
			
			            * {
			                box-sizing:border-box;
			                margin:0;
			                padding:0;
			                font-family:'Segoe UI',Arial,sans-serif;
			            }
			
			
			            .ex-grid {
			                display:grid;
			                grid-template-columns:repeat(5,minmax(0,1fr));
			                gap:6px;
			                width:100%;
			                height:100%;
			                background:transparent;
			            }
			
			
			            .ex-card {
			                position:relative;
			                display:flex;
			                flex-direction:column;
			                min-width:0;
			                width:100%;
			                padding:9px 10px 8px;
			                overflow:hidden;
			                background:#FFFFFF;
			                border-radius:5px;
			            }
			
			
			            .ex-accent {
			                position:absolute;
			                top:0;
			                left:0;
			                width:100%;
			                height:3px;
			            }
			
			
			            .ex-label {
			                margin-bottom:4px;
			                overflow:hidden;
			                color:#000000;
			                font-size:10px;
			                line-height:1.2;
			                font-weight:700;
			                letter-spacing:.035em;
			                text-transform:uppercase;
			                white-space:nowrap;
			                text-overflow:ellipsis;
			            }
			
			
			            .ex-value {
			                margin-bottom:5px;
			                overflow:hidden;
			                font-size:clamp(18px,1.7vw,24px);
			                line-height:1;
			                font-weight:700;
			                letter-spacing:-.03em;
			                white-space:nowrap;
			                text-overflow:ellipsis;
			            }
			
			
			            .ex-bottom {
			                display:flex;
			                align-items:center;
			                gap:4px;
			                min-width:0;
			                margin-top:auto;
			                overflow:hidden;
			            }
			
			
			            .ex-delta {
			                flex-shrink:0;
			                padding:1px 4px;
			                border:1px solid;
			                border-radius:3px;
			                font-size:10px;
			                line-height:1.2;
			                font-weight:600;
			                white-space:nowrap;
			            }
			
			
			            .ex-meta {
			                min-width:0;
			                overflow:hidden;
			                color:#7A7480;
			                font-size:10px;
			                line-height:1.2;
			                white-space:nowrap;
			                text-overflow:ellipsis;
			            }
			
			        </style>
			
			
			        <div class='ex-grid'>
			
			
			            <!-- REVENUE -->
			
			            <div class='ex-card'>
			
			                <div
			                    class='ex-accent'
			                    style='background:#331045'>
			                </div>
			
			                <div class='ex-label'>
			                    Revenue
			                </div>
			
			                <div
			                    class='ex-value'
			                    style='color:#331045'>
			                    " & _RevenueFormatted & "
			                </div>
			
			                <div class='ex-bottom'>
			
			                    <span
			                        class='ex-delta'
			                        style='
			                            color:" & _RevenueDeltaColor & ";
			                            border-color:" & _RevenueDeltaColor & "55;
			                            background:" & _RevenueDeltaColor & "10;'>
			
			                        " & _RevenueComparison & "
			
			                    </span>
			
			                    <span class='ex-meta'>
			                        net sales value
			                    </span>
			
			                </div>
			
			            </div>
			
			
			            <!-- GROSS MARGIN -->
			
			            <div class='ex-card'>
			
			                <div
			                    class='ex-accent'
			                    style='background:#6F4A7C'>
			                </div>
			
			                <div class='ex-label'>
			                    Gross Margin
			                </div>
			
			                <div
			                    class='ex-value'
			                    style='color:#6F4A7C'>
			                    " & _GrossMarginFormatted & "
			                </div>
			
			                <div class='ex-bottom'>
			
			                    <span
			                        class='ex-delta'
			                        style='
			                            color:" & _GrossMarginDeltaColor & ";
			                            border-color:" & _GrossMarginDeltaColor & "55;
			                            background:" & _GrossMarginDeltaColor & "10;'>
			
			                        " & _GrossMarginComparison & "
			
			                    </span>
			
			                    <span class='ex-meta'>
			                        profit / revenue
			                    </span>
			
			                </div>
			
			            </div>
			
			
			            <!-- FC ACCURACY -->
			
			            <div class='ex-card'>
			
			                <div
			                    class='ex-accent'
			                    style='background:#2F855A'>
			                </div>
			
			                <div class='ex-label'>
			                    FC Accuracy
			                </div>
			
			                <div
			                    class='ex-value'
			                    style='color:#2F855A'>
			                    " & _ForecastAccuracyFormatted & "
			                </div>
			
			                <div class='ex-bottom'>
			
			                    <span
			                        class='ex-delta'
			                        style='
			                            color:" & _ForecastAccuracyDeltaColor & ";
			                            border-color:" & _ForecastAccuracyDeltaColor & "55;
			                            background:" & _ForecastAccuracyDeltaColor & "10;'>
			
			                        " & _ForecastAccuracyComparison & "
			
			                    </span>
			
			                    <span class='ex-meta'>
			                        1 − absolute error
			                    </span>
			
			                </div>
			
			            </div>
			
			
			            <!-- ACTIVE CUSTOMERS -->
			
			            <div class='ex-card'>
			
			                <div
			                    class='ex-accent'
			                    style='background:#4F7664'>
			                </div>
			
			                <div class='ex-label'>
			                    Active Customers
			                </div>
			
			                <div
			                    class='ex-value'
			                    style='color:#4F7664'>
			                    " & _ActiveCustomersFormatted & "
			                </div>
			
			                <div class='ex-bottom'>
			
			                    <span
			                        class='ex-delta'
			                        style='
			                            color:" & _ActiveCustomersDeltaColor & ";
			                            border-color:" & _ActiveCustomersDeltaColor & "55;
			                            background:" & _ActiveCustomersDeltaColor & "10;'>
			
			                        " & _ActiveCustomersComparison & "
			
			                    </span>
			
			                    <span class='ex-meta'>
			                        purchased in period
			                    </span>
			
			                </div>
			
			            </div>
			
			
			            <!-- NRR -->
			
			            <div class='ex-card'>
			
			                <div
			                    class='ex-accent'
			                    style='background:#D99A2B'>
			                </div>
			
			                <div class='ex-label'>
			                    NRR
			                </div>
			
			                <div
			                    class='ex-value'
			                    style='color:#D99A2B'>
			                    " & _NRRFormatted & "
			                </div>
			
			                <div class='ex-bottom'>
			
			                    <span
			                        class='ex-delta'
			                        style='
			                            color:" & _NRRDeltaColor & ";
			                            border-color:" & _NRRDeltaColor & "55;
			                            background:" & _NRRDeltaColor & "10;'>
			
			                        " & _NRRComparison & "
			
			                    </span>
			
			                    <span class='ex-meta'>
			                        existing customer revenue
			                    </span>
			
			                </div>
			
			            </div>
			
			
			        </div>
			        "
			    )
		displayFolder: 08 Executive
		lineageTag: 54747a6d-6f7f-43e3-9105-31032469507b

	measure 'Revenue FC Accuracy % PY' = CALCULATE([Revenue FC Accuracy %], SAMEPERIODLASTYEAR(dimDate[Date]))
		displayFolder: 03 Forecasting
		lineageTag: a491fc7e-eda2-4365-bd63-ede7c9fdb5c7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue at Risk PY' = CALCULATE([Revenue at Risk])
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		displayFolder: 01 Risk
		lineageTag: 9fd1ae84-a7f3-42fe-9c50-b495030192f8

		annotation PBI_FormatHint = {"currencyCulture":"en-DE"}

	measure 'DQ Data Volumes by Pipeline Stage HTML' =
			
			VAR _RawSalesRows =
			    CALCULATE (
			        COUNTROWS ( factSales ),
			        REMOVEFILTERS ()
			    )
			
			-- Not currently available as a table in the semantic model
			VAR _PreprocessedRows =
			    120000
			
			VAR _FeatureDatasetRows =
			    CALCULATE (
			        COUNTROWS ( factMlPredictions ),
			        REMOVEFILTERS ()
			    )
			
			VAR _TestPredictions =
			    CALCULATE (
			        COUNTROWS ( factMlPredictions ),
			        REMOVEFILTERS (),
			        FILTER (
			            ALL ( factMlPredictions[split] ),
			            LOWER ( TRIM ( factMlPredictions[split] ) ) = "test"
			        )
			    )
			
			VAR _MaximumRows =
			    MAX (
			        _RawSalesRows,
			        MAX (
			            _PreprocessedRows,
			            MAX (
			                _FeatureDatasetRows,
			                _TestPredictions
			            )
			        )
			    )
			
			VAR _RawWidth =
			    ROUND (
			        DIVIDE ( _RawSalesRows, _MaximumRows, 0 ) * 100,
			        0
			    )
			
			VAR _PreprocessedWidth =
			    ROUND (
			        DIVIDE ( _PreprocessedRows, _MaximumRows, 0 ) * 100,
			        0
			    )
			
			VAR _FeatureWidth =
			    ROUND (
			        DIVIDE ( _FeatureDatasetRows, _MaximumRows, 0 ) * 100,
			        0
			    )
			
			VAR _TestWidth =
			    ROUND (
			        DIVIDE ( _TestPredictions, _MaximumRows, 0 ) * 100,
			        0
			    )
			
			VAR _ReconciliationWarning =
			    _FeatureDatasetRows > _PreprocessedRows
			        || _PreprocessedRows > _RawSalesRows
			
			VAR _WarningHTML =
			    IF (
			        _ReconciliationWarning,
			        "
			        <div class='dv-warning dv-warning-bad'>
			            <span class='dv-warning-icon'>!</span>
			            <span>Row-count reconciliation required</span>
			        </div>
			        ",
			        "
			        <div class='dv-warning dv-warning-good'>
			            <span class='dv-warning-icon'>✓</span>
			            <span>Row counts reconciled</span>
			        </div>
			        "
			    )
			
			RETURN
			    "
			    <style>
			        * {
			            box-sizing:border-box;
			        }
			
			        html,
			        body {
			            width:100%;
			            height:290px;
			            margin:0;
			            padding:0;
			        }
			
			        .dv-container {
			            width:100%;
			            height:280px;
			
			            display:flex;
			            flex-direction:column;
			
			            padding:5px, 5px, 5px;
			            overflow:hidden;
			            background:#FFFFFF;
			            border:1px solid #E3DEE6;
			            border-radius:5px;
			            font-family:'Segoe UI',Arial,sans-serif;
			        }
			
			        .dv-title {
			            color:#211D22;
			            font-size: 15px;
			            font-weight:700;
			            text-transform:uppercase;
			        }
			
			        .dv-content {
			            flex:1 1 auto;
			
			            display:flex;
			            flex-direction:column;
			            justify-content:space-between;
			
			            min-height:0;
			        }
			
			        .dv-row {
			            display:grid;
			
			            grid-template-columns:
			                minmax(120px, 1.35fr)
			                minmax(80px, 2fr)
			                minmax(55px, .55fr);
			
			            align-items:center;
			
			            column-gap:
			                clamp(6px, 1vw, 14px);
			
			            min-height:
			                clamp(25px, 7vh, 48px);
			        }
			
			        .dv-label {
			            min-width:0;
			
			            overflow:hidden;
			
			            color:#514B53;
			
			            font-size:11px;
			
			            font-weight:400;
			
			            white-space:nowrap;
			            text-overflow:ellipsis;
			        }
			
			        .dv-track {
			            position:relative;
			
			            width:100%;
			            height:
			                clamp(7px, 1.5vh, 13px);
			
			            overflow:hidden;
			
			            background:#F0EDF2;
			            border-radius:999px;
			        }
			
			        .dv-bar {
			            height:100%;
			            min-width:4px;
			            border-radius:999px;
			        }
			
			        .dv-value {
			            color:#302B31;
			
			            font-size:12px;
			            font-weight:400;
			
			            text-align:right;
			
			            white-space:nowrap;
			        }
			
			        .dv-warning {
			            display:flex;
			            align-items:center;
			
			            gap:
			                clamp(4px, .5vw, 7px);
			
			            width:100%;
			
			            padding:
			                clamp(4px, .8vh, 7px)
			                clamp(6px, .7vw, 10px);
			
			            border-radius:5px;
			
			            font-size:12px;
			            font-weight:400;
			        }
			
			        .dv-warning-icon {
			            display:flex;
			            align-items:center;
			            justify-content:center;
			
			            flex:0 0 auto;
			
			            width:
			                clamp(14px, 1.5vw, 18px);
			
			            height:
			                clamp(14px, 1.5vw, 18px);
			
			            border-radius:50%;
			
			            font-size:12px;
			
			            font-weight:400;
			        }
			
			        .dv-warning-bad {
			            color:#A43737;
			            background:#FBECEC;
			            border:1px solid #F0CACA;
			        }
			
			        .dv-warning-bad .dv-warning-icon {
			            color:#FFFFFF;
			            background:#C53D3D;
			        }
			
			        .dv-warning-good {
			            color:#276749;
			            background:#EDF7F1;
			            border:1px solid #CBE6D5;
			        }
			
			        .dv-warning-good .dv-warning-icon {
			            color:#FFFFFF;
			            background:#2F855A;
			        }
			
			        .dv-note {
			            display:flex;
			            align-items:center;
			
			            gap:
			                clamp(4px, .6vw, 7px);
			
			            margin-top:
			                clamp(5px, 1vh, 10px);
			
			            color:#7A7480;
			
			            font-size:12px;
			        }
			
			        .dv-info {
			            display:flex;
			            align-items:center;
			            justify-content:center;
			
			            flex:0 0 auto;
			
			            width:
			                clamp(13px, 1.4vw, 17px);
			
			            height:
			                clamp(13px, 1.4vw, 17px);
			
			            border:1px solid #AFA9B2;
			            border-radius:50%;
			
			            font-size:10px;
			
			            font-weight:400;
			        }
			
			        @media (max-width:600px) {
			
			            .dv-container {
			                padding:7px 8px;
			            }
			
			            .dv-row {
			                grid-template-columns:
			                    minmax(90px, 1.2fr)
			                    minmax(60px, 1.5fr)
			                    minmax(42px, .5fr);
			
			                column-gap:5px;
			            }
			        }
			
			        @media (max-height:300px) {
			
			            .dv-container {
			                padding-top:5px;
			                padding-bottom:5px;
			            }
			
			            .dv-title {
			                margin-bottom:4px;
			            }
			
			            .dv-row {
			                min-height:21px;
			            }
			
			            .dv-warning {
			                padding-top:2px;
			                padding-bottom:2px;
			            }
			
			            .dv-note {
			                margin-top:3px;
			            }
			        }
			    </style>
			
			    <div class='dv-container'>
			
			        <div class='dv-title'>
			            Data Volumes by Pipeline Stage
			        </div>
			
			        <div class='dv-content'>
			
			            <div class='dv-row'>
			                <div class='dv-label'>
			                    Raw Sales Transactions
			                </div>
			
			                <div class='dv-track'>
			                    <div class='dv-bar'
			                         style='width:"
			                            & FORMAT ( _RawWidth, "0" )
			                            & "%; background:#331045;'>
			                    </div>
			                </div>
			
			                <div class='dv-value'>
			                    "
			                        & FORMAT ( _RawSalesRows, "#,0" )
			                        & "
			                </div>
			            </div>
			
			            <div class='dv-row'>
			                <div class='dv-label'>
			                    Preprocessed Modeling Rows
			                </div>
			
			                <div class='dv-track'>
			                    <div class='dv-bar'
			                         style='width:"
			                            & FORMAT ( _PreprocessedWidth, "0" )
			                            & "%; background:#6F4A7C;'>
			                    </div>
			                </div>
			
			                <div class='dv-value'>
			                    "
			                        & FORMAT ( _PreprocessedRows, "#,0" )
			                        & "
			                </div>
			            </div>
			
			            "
			                & _WarningHTML
			                & "
			
			            <div class='dv-row'>
			                <div class='dv-label'>
			                    Feature Dataset Rows
			                </div>
			
			                <div class='dv-track'>
			                    <div class='dv-bar'
			                         style='width:"
			                            & FORMAT ( _FeatureWidth, "0" )
			                            & "%; background:#805991;'>
			                    </div>
			                </div>
			
			                <div class='dv-value'>
			                    "
			                        & FORMAT ( _FeatureDatasetRows, "#,0" )
			                        & "
			                </div>
			            </div>
			
			            <div class='dv-row'>
			                <div class='dv-label'>
			                    Test Predictions
			                </div>
			
			                <div class='dv-track'>
			                    <div class='dv-bar'
			                         style='width:"
			                            & FORMAT ( _TestWidth, "0" )
			                            & "%; background:#A989C1;'>
			                    </div>
			                </div>
			
			                <div class='dv-value'>
			                    "
			                        & FORMAT ( _TestPredictions, "#,0" )
			                        & "
			                </div>
			            </div>
			
			        </div>
			    </div>
			    "
		displayFolder: 07 Data Quality
		lineageTag: 60c3b1e5-af49-48fa-9d43-869715d79818

	measure 'DQ Top Feature Missing Rates HTML' =
			
			-- Source-data profile results
			VAR _MarginMissingRate =
			    0.068
			
			VAR _ProductShareMissingRate =
			    0.014
			
			VAR _CustomerShareMissingRate =
			    0.014
			
			VAR _MarketTailwindMissingRate =
			    0
			
			VAR _CampaignSpendMissingRate =
			    0
			
			VAR _Threshold =
			    0.02
			
			VAR _AxisMaximum =
			    0.07
			
			-- CSS widths
			VAR _MarginWidth =
			    ROUND (
			        DIVIDE ( _MarginMissingRate, _AxisMaximum, 0 ) * 100,
			        0
			    )
			
			VAR _ProductShareWidth =
			    ROUND (
			        DIVIDE ( _ProductShareMissingRate, _AxisMaximum, 0 ) * 100,
			        0
			    )
			
			VAR _CustomerShareWidth =
			    ROUND (
			        DIVIDE ( _CustomerShareMissingRate, _AxisMaximum, 0 ) * 100,
			        0
			    )
			
			VAR _MarketTailwindWidth =
			    ROUND (
			        DIVIDE ( _MarketTailwindMissingRate, _AxisMaximum, 0 ) * 100,
			        0
			    )
			
			VAR _CampaignSpendWidth =
			    ROUND (
			        DIVIDE ( _CampaignSpendMissingRate, _AxisMaximum, 0 ) * 100,
			        0
			    )
			
			VAR _ThresholdPosition =
			    ROUND (
			        DIVIDE ( _Threshold, _AxisMaximum, 0 ) * 100,
			        0
			    )
			
			RETURN
			"
			<style>
			    * {
			        box-sizing:border-box;
			        margin:0;
			        padding:0;
			        font-family:'Segoe UI',Arial,sans-serif;
			    }
			
			    .mr-card {
			        width:100%;
			        height:280px;
			        padding:5px 5px 5px;
			        color:#26232A;
			        background:#FFFFFF;
			        border:1px solid #E5E0E7;
			        border-radius:5px;
			    }
			
			    .mr-header {
			        display:flex;
			        align-items:flex-start;
			        justify-content:space-between;
			        gap:10px;
			        margin-bottom:9px;
			    }
			
			    .mr-title {
			        font-size:15px;
			        font-weight:700;
			        text-transform:uppercase;
			    }
			
			    .mr-threshold-label {
			        color:#6F6972;
			        font-size:13px;
			        white-space:nowrap;
			    }
			
			    .mr-row {
			        display:grid;
			        grid-template-columns:minmax(140px,41%) 1fr 34px;
			        gap:6px;
			        align-items:center;
			        min-height:24px;
			    }
			
			    .mr-label {
			        overflow:hidden;
			        color:#413B44;
			        font-size:12px;
			        white-space:nowrap;
			        text-overflow:ellipsis;
			    }
			
			    .mr-chart {
			        position:relative;
			        height:15px;
			        background:#F4F1F5;
			        border-bottom:1px solid #CDC7CF;
			    }
			
			    .mr-bar {
			        position:relative;
			        z-index:2;
			        height:100%;
			        min-width:2px;
			    }
			
			    .mr-threshold {
			        position:absolute;
			        z-index:3;
			        top:-5px;
			        bottom:-5px;
			        width:1px;
			        border-left:1px dashed #777078;
			    }
			
			    .mr-value {
			        font-size:12px;
			        font-weight:400;
			        white-space:nowrap;
			    }
			
			    .mr-axis {
			        display:grid;
			        grid-template-columns:repeat(8,1fr);
			        margin:2px 34px 0 calc(41% + 6px);
			        color:#79727B;
			        font-size:12px;
			    }
			
			    .mr-axis span {
			        text-align:center;
			    }
			
			    .mr-axis span:first-child {
			        text-align:left;
			    }
			
			    .mr-axis span:last-child {
			        text-align:right;
			    }
			
			    .mr-axis-title {
			        margin:2px 34px 0 calc(41% + 6px);
			        color:#514B54;
			        font-size:12px;
			        font-weight:400;
			        text-align:center;
			    }
			
			    .mr-note {
			        display:flex;
			        align-items:center;
			        gap:7px;
			        margin-top:8px;
			        padding-top:7px;
			        color:#6F6972;
			        border-top:1px solid #EEE9EF;
			        font-size:12px;
			        font-style:italic;
			    }
			
			    .mr-info {
			        display:flex;
			        width:16px;
			        height:16px;
			        align-items:center;
			        justify-content:center;
			        flex-shrink:0;
			        color:#331045;
			        border:1.5px solid #331045;
			        border-radius:50%;
			        font-size:12px;
			        font-style:normal;
			        font-weight:400;
			    }
			</style>
			
			<div class='mr-card'>
			
			    <div class='mr-header'>
			        <div class='mr-title'>Top Feature Missing Rates</div>
			    </div>
			
			    <div class='mr-row'>
			        <div class='mr-label'>estimated_gross_margin_pct</div>
			        <div class='mr-chart'>
			            <div class='mr-threshold'
			                 style='left:" & FORMAT ( _ThresholdPosition, "0" ) & "%'>
			            </div>
			            <div class='mr-bar'
			                 style='width:" & FORMAT ( _MarginWidth, "0" ) & "%;
			                        background:#D7191C'>
			            </div>
			        </div>
			        <div class='mr-value' style='color:#D7191C'>
			            " & FORMAT ( _MarginMissingRate, "0.0%" ) & "
			        </div>
			    </div>
			
			    <div class='mr-row'>
			        <div class='mr-label'>product_unit_share_category_region</div>
			        <div class='mr-chart'>
			            <div class='mr-threshold'
			                 style='left:" & FORMAT ( _ThresholdPosition, "0" ) & "%'>
			            </div>
			            <div class='mr-bar'
			                 style='width:" & FORMAT ( _ProductShareWidth, "0" ) & "%;
			                        background:#D99A2B'>
			            </div>
			        </div>
			        <div class='mr-value'>
			            " & FORMAT ( _ProductShareMissingRate, "0.0%" ) & "
			        </div>
			    </div>
			
			    <div class='mr-row'>
			        <div class='mr-label'>customer_share_category_region</div>
			        <div class='mr-chart'>
			            <div class='mr-threshold'
			                 style='left:" & FORMAT ( _ThresholdPosition, "0" ) & "%'>
			            </div>
			            <div class='mr-bar'
			                 style='width:" & FORMAT ( _CustomerShareWidth, "0" ) & "%;
			                        background:#D99A2B'>
			            </div>
			        </div>
			        <div class='mr-value'>
			            " & FORMAT ( _CustomerShareMissingRate, "0.0%" ) & "
			        </div>
			    </div>
			
			    <div class='mr-row'>
			        <div class='mr-label'>market_tailwind_score</div>
			        <div class='mr-chart'>
			            <div class='mr-threshold'
			                 style='left:" & FORMAT ( _ThresholdPosition, "0" ) & "%'>
			            </div>
			            <div class='mr-bar'
			                 style='width:2px;background:#2F855A'>
			            </div>
			        </div>
			        <div class='mr-value' style='color:#2F855A'>
			            " & FORMAT ( _MarketTailwindMissingRate, "0.0%" ) & "
			        </div>
			    </div>
			
			    <div class='mr-row'>
			        <div class='mr-label'>campaign_spend_rolling_3m</div>
			        <div class='mr-chart'>
			            <div class='mr-threshold'
			                 style='left:" & FORMAT ( _ThresholdPosition, "0" ) & "%'>
			            </div>
			            <div class='mr-bar'
			                 style='width:2px;background:#2F855A'>
			            </div>
			        </div>
			        <div class='mr-value' style='color:#2F855A'>
			            " & FORMAT ( _CampaignSpendMissingRate, "0.0%" ) & "
			        </div>
			    </div>
			
			    <div class='mr-axis'>
			        <span>0%</span><span>1%</span><span>2%</span><span>3%</span>
			        <span>4%</span><span>5%</span><span>6%</span><span>7%</span>
			    </div>
			
			    <div class='mr-axis-title'>Missing Rate (%)</div>
			
			</div>
			"
		displayFolder: 07 Data Quality
		lineageTag: 14142419-5bb6-4a90-a12c-fb4a9c774825

	measure 'DQ QA Check Status HTML' =
			
			-- Check 1: Composite key uniqueness
			VAR _PredictionRows =
			    CALCULATE (
			        COUNTROWS ( factMlPredictions ),
			        REMOVEFILTERS ()
			    )
			
			VAR _DistinctCompositeKeys =
			    COUNTROWS (
			        CALCULATETABLE (
			            SUMMARIZE (
			                factMlPredictions,
			                factMlPredictions[year_month],
			                factMlPredictions[product_id],
			                factMlPredictions[region_id]
			            ),
			            REMOVEFILTERS ()
			        )
			    )
			
			VAR _CompositeKeyPassed =
			    _PredictionRows = _DistinctCompositeKeys
			
			-- Check 2: Orphan products
			VAR _OrphanProductCount =
			    COUNTROWS (
			        EXCEPT (
			            CALCULATETABLE (
			                VALUES ( factMlPredictions[product_id] ),
			                REMOVEFILTERS ()
			            ),
			            CALCULATETABLE (
			                VALUES ( dimProduct[product_id] ),
			                REMOVEFILTERS ()
			            )
			        )
			    )
			
			VAR _OrphanProductsPassed =
			    _OrphanProductCount = 0
			
			-- Check 3: Orphan customers
			VAR _OrphanCustomerCount =
			    COUNTROWS (
			        EXCEPT (
			            CALCULATETABLE (
			                VALUES ( factSales[customer_id] ),
			                REMOVEFILTERS ()
			            ),
			            CALCULATETABLE (
			                VALUES ( dimCustomer[customer_id] ),
			                REMOVEFILTERS ()
			            )
			        )
			    )
			
			VAR _OrphanCustomersPassed =
			    _OrphanCustomerCount = 0
			
			-- Check 4: Chronological split
			VAR _TrainEnd =
			    CALCULATE (
			        MAX ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        FILTER (
			            ALL ( factMlPredictions[split] ),
			            LOWER ( TRIM ( factMlPredictions[split] ) )
			                IN { "train", "training" }
			        )
			    )
			
			VAR _ValidationStart =
			    CALCULATE (
			        MIN ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        FILTER (
			            ALL ( factMlPredictions[split] ),
			            LOWER ( TRIM ( factMlPredictions[split] ) )
			                IN { "valid", "validation", "validate" }
			        )
			    )
			
			VAR _ValidationEnd =
			    CALCULATE (
			        MAX ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        FILTER (
			            ALL ( factMlPredictions[split] ),
			            LOWER ( TRIM ( factMlPredictions[split] ) )
			                IN { "valid", "validation", "validate" }
			        )
			    )
			
			VAR _TestStart =
			    CALCULATE (
			        MIN ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        FILTER (
			            ALL ( factMlPredictions[split] ),
			            LOWER ( TRIM ( factMlPredictions[split] ) ) = "test"
			        )
			    )
			
			VAR _TestEnd =
			    CALCULATE (
			        MAX ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        FILTER (
			            ALL ( factMlPredictions[split] ),
			            LOWER ( TRIM ( factMlPredictions[split] ) ) = "test"
			        )
			    )
			
			VAR _ScoringStart =
			    CALCULATE (
			        MIN ( factMlPredictions[year_month] ),
			        REMOVEFILTERS (),
			        FILTER (
			            ALL ( factMlPredictions[split] ),
			            LOWER ( TRIM ( factMlPredictions[split] ) )
			                IN { "scoring", "score", "unlabeled" }
			        )
			    )
			
			VAR _ChronologicalSplitPassed =
			    NOT ISBLANK ( _TrainEnd )
			        && NOT ISBLANK ( _ValidationStart )
			        && NOT ISBLANK ( _ValidationEnd )
			        && NOT ISBLANK ( _TestStart )
			        && _TrainEnd < _ValidationStart
			        && _ValidationEnd < _TestStart
			
			-- Check 5: Result imported from the feature-engineering QA process
			VAR _TargetLeakagePassed =
			    TRUE ()
			
			-- Check 6: One split per month
			VAR _MonthSplitSummary =
			    CALCULATETABLE (
			        SUMMARIZE (
			            factMlPredictions,
			            factMlPredictions[year_month],
			            "SplitCount",
			                DISTINCTCOUNT ( factMlPredictions[split] )
			        ),
			        REMOVEFILTERS ()
			    )
			
			VAR _SplitIsolationPassed =
			    MAXX (
			        _MonthSplitSummary,
			        [SplitCount]
			    ) <= 1
			
			VAR _ReconciliationWarning =
			    FALSE ()
			
			-- Summary counts
			VAR _PassedCount =
			      IF ( _CompositeKeyPassed,      1, 0 )
			    + IF ( _OrphanProductsPassed,   1, 0 )
			    + IF ( _OrphanCustomersPassed,  1, 0 )
			    + IF ( _ChronologicalSplitPassed, 1, 0 )
			    + IF ( _TargetLeakagePassed,    1, 0 )
			    + IF ( _SplitIsolationPassed,   1, 0 )
			    + IF ( NOT _ReconciliationWarning, 1, 0 )
			
			VAR _WarningCount =
			    IF ( _ReconciliationWarning, 1, 0 )
			
			VAR _FailedCount =
			      IF ( NOT _CompositeKeyPassed,       1, 0 )
			    + IF ( NOT _OrphanProductsPassed,     1, 0 )
			    + IF ( NOT _OrphanCustomersPassed,    1, 0 )
			    + IF ( NOT _ChronologicalSplitPassed, 1, 0 )
			    + IF ( NOT _TargetLeakagePassed,      1, 0 )
			    + IF ( NOT _SplitIsolationPassed,     1, 0 )
			
			VAR _PassedColor = "#2F855A"
			VAR _WarningColor = "#D97706"
			VAR _FailedColor = "#C53D3D"
			
			RETURN
			"
			<style>
			    * {
			        box-sizing:border-box;
			        margin:0;
			        padding:0;
			        font-family:'Segoe UI',Arial,sans-serif;
			    }
			
			    .qa-card {
			        width:100%;
			        padding:5px 5px 5px;
			        color:#26232A;
			        background:#FFFFFF;
			        border:1px solid #E5E0E7;
			        border-radius:5px;
			    }
			
			    .qa-title {
			        font-size:15px;
			        font-weight:700;
			        text-transform:uppercase;
			    }
			
			    .qa-summary {
			        display:grid;
			        grid-template-columns:repeat(3,1fr);
			        gap:13px;
			        margin-bottom:7px;
			    }
			
			    .qa-badge {
			        padding:4px 5px;
			        border:1px solid;
			        border-radius:4px;
			        font-size:12px;
			        font-weight:600;
			        text-align:center;
			        white-space:nowrap;
			    }
			
			    .qa-table {
			        overflow:hidden;
			        border:1px solid #E5E0E7;
			        border-radius:4px;
			    }
			
			    .qa-row {
			        display:grid;
			        grid-template-columns:1fr 83px;
			        align-items:center;
			        min-height:22px;
			        border-bottom:1px solid #E8E3E9;
			        font-size:12px;
			    }
			
			    .qa-row:last-child {
			        border-bottom:none;
			    }
			
			    .qa-check {
			        padding:4px 7px;
			        color:#433D46;
			    }
			
			    .qa-result {
			        display:flex;
			        align-items:center;
			        gap:5px;
			        align-self:stretch;
			        padding:4px 7px;
			        border-left:1px solid #E8E3E9;
			        font-weight:400;
			    }
			
			    .qa-icon {
			        display:flex;
			        width:12px;
			        height:12px;
			        align-items:center;
			        justify-content:center;
			        flex-shrink:0;
			        color:#FFFFFF;
			        border-radius:50%;
			        font-size:12px;
			        line-height:1;
			        font-weight:400;
			    }
			
			    .qa-warning-icon {
			        display:flex;
			        width:14px;
			        height:14px;
			        align-items:center;
			        justify-content:center;
			        flex-shrink:0;
			        color:#D97706;
			        border:1.3px solid #D97706;
			        border-radius:50%;
			        font-size:12px;
			        font-weight:400;
			    }
			</style>
			
			<div class='qa-card'>
			
			    <div class='qa-title'>QA Check Status</div>
			
			    <div class='qa-summary'>
			        <div class='qa-badge'
			             style='color:#2F855A;
			                    background:#F0F8F4;
			                    border-color:#2F855A'>
			            " & FORMAT ( _PassedCount, "0" ) & " Passed
			        </div>
			
			        <div class='qa-badge'
			             style='color:#D97706;
			                    background:#FFF8EE;
			                    border-color:#D97706'>
			            " & FORMAT ( _WarningCount, "0" ) & " Warning
			        </div>
			
			        <div class='qa-badge'
			             style='color:#5F5962;
			                    background:#F5F3F6;
			                    border-color:#8A838C'>
			            " & FORMAT ( _FailedCount, "0" ) & " Failed
			        </div>
			    </div>
			
			    <div class='qa-table'>
			
			        <div class='qa-row'>
			            <div class='qa-check'>Composite key uniqueness</div>
			            <div class='qa-result'
			                 style='color:"
			                    & IF ( _CompositeKeyPassed, _PassedColor, _FailedColor )
			                    & "'>
			                <span class='qa-icon'
			                      style='background:"
			                        & IF ( _CompositeKeyPassed, _PassedColor, _FailedColor )
			                        & "'>
			                    " & IF ( _CompositeKeyPassed, "&#10003;", "&#10005;" ) & "
			                </span>
			                " & IF ( _CompositeKeyPassed, "Passed", "Failed" ) & "
			            </div>
			        </div>
			
			        <div class='qa-row'>
			            <div class='qa-check'>Orphan product IDs</div>
			            <div class='qa-result'
			                 style='color:"
			                    & IF ( _OrphanProductsPassed, _PassedColor, _FailedColor )
			                    & "'>
			                <span class='qa-icon'
			                      style='background:"
			                        & IF ( _OrphanProductsPassed, _PassedColor, _FailedColor )
			                        & "'>
			                    " & IF ( _OrphanProductsPassed, "&#10003;", "&#10005;" ) & "
			                </span>
			                " & IF ( _OrphanProductsPassed, "Passed", "Failed" ) & "
			            </div>
			        </div>
			
			        <div class='qa-row'>
			            <div class='qa-check'>Orphan customer IDs</div>
			            <div class='qa-result'
			                 style='color:"
			                    & IF ( _OrphanCustomersPassed, _PassedColor, _FailedColor )
			                    & "'>
			                <span class='qa-icon'
			                      style='background:"
			                        & IF ( _OrphanCustomersPassed, _PassedColor, _FailedColor )
			                        & "'>
			                    " & IF ( _OrphanCustomersPassed, "&#10003;", "&#10005;" ) & "
			                </span>
			                " & IF ( _OrphanCustomersPassed, "Passed", "Failed" ) & "
			            </div>
			        </div>
			
			        <div class='qa-row'>
			            <div class='qa-check'>Chronological split</div>
			            <div class='qa-result'
			                 style='color:"
			                    & IF ( _ChronologicalSplitPassed, _PassedColor, _FailedColor )
			                    & "'>
			                <span class='qa-icon'
			                      style='background:"
			                        & IF ( _ChronologicalSplitPassed, _PassedColor, _FailedColor )
			                        & "'>
			                    " & IF ( _ChronologicalSplitPassed, "&#10003;", "&#10005;" ) & "
			                </span>
			                " & IF ( _ChronologicalSplitPassed, "Passed", "Failed" ) & "
			            </div>
			        </div>
			
			        <div class='qa-row'>
			            <div class='qa-check'>Target leakage scan</div>
			            <div class='qa-result'
			                 style='color:#2F855A'>
			                <span class='qa-icon' style='background:#2F855A'>
			                    &#10003;
			                </span>
			                Passed
			            </div>
			        </div>
			
			        <div class='qa-row'>
			            <div class='qa-check'>Split isolation</div>
			            <div class='qa-result'
			                 style='color:"
			                    & IF ( _SplitIsolationPassed, _PassedColor, _FailedColor )
			                    & "'>
			                <span class='qa-icon'
			                      style='background:"
			                        & IF ( _SplitIsolationPassed, _PassedColor, _FailedColor )
			                        & "'>
			                    " & IF ( _SplitIsolationPassed, "&#10003;", "&#10005;" ) & "
			                </span>
			                " & IF ( _SplitIsolationPassed, "Passed", "Failed" ) & "
			            </div>
			        </div>
			
			        <div class='qa-row'>
			            <div class='qa-check'>Row-count reconciliation</div>
			            <div class='qa-result'
			                 style='color:#2F855A'>
			                <span class='qa-icon'>!</span>
			                Passed
			            </div>
			        </div>
			
			    </div>
			
			</div>
			"
		displayFolder: 07 Data Quality
		lineageTag: d9f36f08-26ff-4aaa-a505-3a6938dadbeb

	measure 'MQ Confusion Matrix HTML' = ```
			
			-- Ignore filters on prediction classes so the complete
			-- 3 × 3 matrix is always displayed.
			VAR _MatrixData =
			    CALCULATETABLE (
			        factMlPredictions,
			        REMOVEFILTERS (
			            factMlPredictions[actual_risk_label_num],
			            factMlPredictions[predicted_risk_label_num]
			        )
			    )
			
			-- Actual Low
			VAR _LowLow =
			    COUNTROWS (
			        FILTER (
			            _MatrixData,
			            factMlPredictions[actual_risk_label_num] = 0
			                && factMlPredictions[predicted_risk_label_num] = 0
			        )
			    )
			
			VAR _LowMedium =
			    COUNTROWS (
			        FILTER (
			            _MatrixData,
			            factMlPredictions[actual_risk_label_num] = 0
			                && factMlPredictions[predicted_risk_label_num] = 1
			        )
			    )
			
			VAR _LowHigh =
			    COUNTROWS (
			        FILTER (
			            _MatrixData,
			            factMlPredictions[actual_risk_label_num] = 0
			                && factMlPredictions[predicted_risk_label_num] = 2
			        )
			    )
			
			-- Actual Medium
			VAR _MediumLow =
			    COUNTROWS (
			        FILTER (
			            _MatrixData,
			            factMlPredictions[actual_risk_label_num] = 1
			                && factMlPredictions[predicted_risk_label_num] = 0
			        )
			    )
			
			VAR _MediumMedium =
			    COUNTROWS (
			        FILTER (
			            _MatrixData,
			            factMlPredictions[actual_risk_label_num] = 1
			                && factMlPredictions[predicted_risk_label_num] = 1
			        )
			    )
			
			VAR _MediumHigh =
			    COUNTROWS (
			        FILTER (
			            _MatrixData,
			            factMlPredictions[actual_risk_label_num] = 1
			                && factMlPredictions[predicted_risk_label_num] = 2
			        )
			    )
			
			-- Actual High
			VAR _HighLow =
			    COUNTROWS (
			        FILTER (
			            _MatrixData,
			            factMlPredictions[actual_risk_label_num] = 2
			                && factMlPredictions[predicted_risk_label_num] = 0
			        )
			    )
			
			VAR _HighMedium =
			    COUNTROWS (
			        FILTER (
			            _MatrixData,
			            factMlPredictions[actual_risk_label_num] = 2
			                && factMlPredictions[predicted_risk_label_num] = 1
			        )
			    )
			
			VAR _HighHigh =
			    COUNTROWS (
			        FILTER (
			            _MatrixData,
			            factMlPredictions[actual_risk_label_num] = 2
			                && factMlPredictions[predicted_risk_label_num] = 2
			        )
			    )
			
			-- Summary metrics
			VAR _TotalRecords =
			    COUNTROWS ( _MatrixData )
			
			VAR _TrueHighRisk =
			    _HighHigh
			
			VAR _MissedHighRisk =
			    _HighLow + _HighMedium
			
			VAR _FalseAlarms =
			    _LowHigh + _MediumHigh
			
			VAR _HighRiskRecall =
			    DIVIDE (
			        _TrueHighRisk,
			        _TrueHighRisk + _MissedHighRisk
			    )
			
			VAR _HighRiskPrecision =
			    DIVIDE (
			        _TrueHighRisk,
			        _TrueHighRisk + _FalseAlarms
			    )
			
			-- Formatting
			VAR _LowLowFormatted =
			    FORMAT ( _LowLow, "#,0" )
			
			VAR _LowMediumFormatted =
			    FORMAT ( _LowMedium, "#,0" )
			
			VAR _LowHighFormatted =
			    FORMAT ( _LowHigh, "#,0" )
			
			VAR _MediumLowFormatted =
			    FORMAT ( _MediumLow, "#,0" )
			
			VAR _MediumMediumFormatted =
			    FORMAT ( _MediumMedium, "#,0" )
			
			VAR _MediumHighFormatted =
			    FORMAT ( _MediumHigh, "#,0" )
			
			VAR _HighLowFormatted =
			    FORMAT ( _HighLow, "#,0" )
			
			VAR _HighMediumFormatted =
			    FORMAT ( _HighMedium, "#,0" )
			
			VAR _HighHighFormatted =
			    FORMAT ( _HighHigh, "#,0" )
			
			VAR _TotalRecordsFormatted =
			    FORMAT ( _TotalRecords, "#,0" ) & " test records"
			
			VAR _TrueHighRiskFormatted =
			    FORMAT ( _TrueHighRisk, "#,0" )
			
			VAR _MissedHighRiskFormatted =
			    FORMAT ( _MissedHighRisk, "#,0" )
			
			VAR _FalseAlarmsFormatted =
			    FORMAT ( _FalseAlarms, "#,0" )
			
			VAR _RecallFormatted =
			    IF (
			        ISBLANK ( _HighRiskRecall ),
			        "—",
			        FORMAT ( _HighRiskRecall, "0.0%" )
			    )
			
			VAR _PrecisionFormatted =
			    IF (
			        ISBLANK ( _HighRiskPrecision ),
			        "—",
			        FORMAT ( _HighRiskPrecision, "0.0%" )
			    )
			
			RETURN
			IF (
			    _TotalRecords = 0,
			    "
			    <div style='
			        padding:8px;
			        background:transparent;
			        color:#FFFFFF;
			        font:11px Segoe UI,Arial,sans-serif;'>
