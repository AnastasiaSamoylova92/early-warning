		annotation SummarizationSetBy = Automatic

	partition factPipelineRunMetadata = calculated
		mode: import
		source =
				
				VAR _RefreshUTC =
				    UTCNOW ()
				
				-- Daily scheduled refresh at 23:00 UTC
				VAR _TodayAt23UTC =
				    DATE (
				        YEAR ( _RefreshUTC ),
				        MONTH ( _RefreshUTC ),
				        DAY ( _RefreshUTC )
				    )
				        + TIME ( 23, 0, 0 )
				
				VAR _NextRefreshUTC =
				    IF (
				        _RefreshUTC < _TodayAt23UTC,
				        _TodayAt23UTC,
				        _TodayAt23UTC + 1
				    )
				
				RETURN
				    ROW (
				        "LastRefreshUTC",       _RefreshUTC,
				        "RuntimeSeconds",       462,
				        "ModelRunID",           "RF_" & FORMAT ( _RefreshUTC, "yyyymmdd_HHmm" ),
				        "ArtifactsCreated",     7,
				        "ArtifactsExpected",    7,
				        "Owner",                "Anastasia Samoylova",
				        "NextRefreshUTC",       _NextRefreshUTC
				    )

	annotation PBI_Id = 14d0288fce8f4cbeb2f1fa257f1db148

